<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="LoanCalculatorMaui.Themes.LightTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Colors  -->
    <Color x:Key="DefaultForegroundColor">Black</Color>

    <Color x:Key="TabBarBackgroundGradientStart">#a9cce3</Color>
    <Color x:Key="TabBarBackgroundGradientEnd">#7fb3d5</Color>
    <Color x:Key="TabIndicatorStrokeColor">#2471a3</Color>


    <Color x:Key="ExpanderHeaderIconExpandColor">#EBF5FB</Color>
    <!--  Not used  -->
    <Color x:Key="ExpanderHeaderIconCollapseColor">#D5D8DC</Color>
    <!--  Not used  -->
    <Color x:Key="ExpanderHeaderTextColor">#212F3C</Color>
    <Color x:Key="HighlightFgColor">#34495e</Color>

    <Color x:Key="InputTextFgColor">#17202A</Color>
    <Color x:Key="InputTextWhenFocusedColor">#566573</Color>
    <Color x:Key="InputTextWhenUnFocusedColor">#17202A</Color>
    <Color x:Key="InputErrorTextFgColor">#CA6F1E</Color>

    <Color x:Key="SegBgColor">#F7F9F9</Color>
    <Color x:Key="SegBorderColor">#34495E</Color>
    <Color x:Key="SegTextFgColor">#808B96</Color>
    <Color x:Key="SegSelectedTextFgColor">#212F3C</Color>
    <!--  Not used  -->
    <Color x:Key="SegSelectedBgColor">#AED6F1</Color>

    <Color x:Key="SliderKnobColor">Red</Color>
    <Color x:Key="RangeSliderTrackColor">#AED6F1</Color>
    <Color x:Key="RangeSliderTrackSelectionColor">#2980B9</Color>
    <Color x:Key="RangeSliderLabelTextColor">#17202A</Color>

    <Color x:Key="DataGridHeaderBackgroundColor">Red</Color>
    <Color x:Key="DataGridHeaderForegroundColor">Green</Color>
    <Color x:Key="DataGridGridCellBorderColor">#7F8C8D</Color>
    <!--  Not used  -->
    <Color x:Key="DataGridRowBackgroundColor">LightPink</Color>
    <Color x:Key="DataGridRowAlternateBackgroundColor">DarkGoldenrod</Color>
    <Color x:Key="DataGridRowForegroundColor">DarkBlue</Color>

    <Color x:Key="ComboDropDownBackgroundColor">#BDC3C7</Color>
    <Color x:Key="ComboDropDownTextColor">#17202A</Color>
    <Color x:Key="ComboHighlightedTextColor">#EBEDEF</Color>
    <Color x:Key="ComboSelectedDropDownItemColor">#5D6D7E</Color>
    <Color x:Key="ComboTextColor">#17202A</Color>

    <Color x:Key="SwitchBusyIndicatorColorON">Transparent</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchThumbBorderColorON">Transparent</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchThumbColorON">#D6EAF8</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchTrackBorderColorON">Transparent</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchTrackColorON">#1A5276</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchBusyIndicatorColorOFF">Transparent</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchThumbBorderColorOFF">Transparent</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchThumbColorOFF">#1A5276</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchTrackBorderColorOFF">Transparent</Color>
    <!--  Not used  -->
    <Color x:Key="SwitchTrackColorOFF">#D6EAF8</Color>
    <!--  Not used  -->

    <Color x:Key="AppShellBgColor">#B3B6B7</Color>
    <Color x:Key="AppShellFgColor">#283747</Color>
    <Color x:Key="AppShellTitleColor">#283747</Color>
    <Color x:Key="AppShellDisabledColor">#979A9A</Color>
    <Color x:Key="AppShellUnselectedColor">#5D6D7E</Color>
    <Color x:Key="AppShellTabBarBackgroundColor">#B3B6B7</Color>
    <Color x:Key="AppShellTabBarForegroundColor">#283747</Color>
    <Color x:Key="AppShellTabBarUnselectedColor">#5D6D7E</Color>
    <Color x:Key="AppShellTabBarDisabledColor">#979A9A</Color>
    <Color x:Key="AppShellTabBarTitleColor">#21618C</Color>

    <Color x:Key="LstForegroundColor">#17202A</Color>
    <Color x:Key="NotificationBgColor">Black</Color>
    <Color x:Key="ButtonFgColor">#d4e6f1</Color>
    <Color x:Key="ButtonBgColor">#154360</Color>

    <!--  Charts  -->
    <Color x:Key="ChartAxisTextColor">#2E4053</Color>
    <Color x:Key="ChartLegendTextColor">#2E4053</Color>
    <Color x:Key="ChartTitleTextColor">#1B2631</Color>
    <Color x:Key="ChartDataMarkerTextColor">#2E4053</Color>
    <Color x:Key="ChartOuterBorderGradientStart">Green</Color>
    <Color x:Key="ChartOuterBorderGradientEnd">Purple</Color>
    <Color x:Key="ChartInnerBorderGradientStart">#ebf5fb</Color>
    <Color x:Key="ChartInnerBorderGradientEnd">#d6eaf8</Color>
    <Color x:Key="ChartColor1">#F5B041</Color>
    <Color x:Key="ChartColor2">#73C6B6</Color>
    <Color x:Key="ChartColor3">#BB8FCE</Color>


    <!--  Borders  -->
    <Color x:Key="BorderTopGradientOuterLineStart">#566573</Color>
    <Color x:Key="BorderTopGradientOuterLineEnd">#34495e</Color>
    <Color x:Key="BorderTopGradientBackgroundStart">#d7dbdd</Color>
    <Color x:Key="BorderTopGradientBackgroundEnd">#a6acaf</Color>

    <!--  Border controls box styles  -->
    <Color x:Key="BorderControlGradientOuterLineStart">#d4e6f1</Color>
    <Color x:Key="BorderControlGradientOuterLineEnd">#1a5276</Color>
    <Color x:Key="BorderControlGradientBackgroundStart">#d4e6f1</Color>
    <Color x:Key="BorderControlGradientBackgroundEnd">#a9cce3</Color>

    <!--  Insights controls box styles  -->
    <Color x:Key="BorderInsightsGradientOuterLineStart">#d4e6f1</Color>
    <Color x:Key="BorderInsightsGradientOuterLineEnd">#1a5276</Color>
    <Color x:Key="BorderInsightsGradientBackgroundStart">#bdc3c7</Color>
    <Color x:Key="BorderInsightsGradientBackgroundEnd">#eaecee</Color>

    <!--  Expander styles  -->
    <Color x:Key="ExpanderExpandedGradientStart">#FFB3E5FC</Color>
    <Color x:Key="ExpanderExpandedGradientEnd">#FFFFF9C4</Color>
    <Color x:Key="ExpanderCollapsedGradientStart">#bdc3c7</Color>
    <Color x:Key="ExpanderCollapsedGradientEnd">#eaecee</Color>

    <!--  Expander styles - cannot move this cuz of the initialization failure, need to repeat in all themes  -->
    <LinearGradientBrush x:Key="ExpanderExpandedGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource ExpanderExpandedGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource ExpanderExpandedGradientEnd}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ExpanderCollapsedGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource ExpanderCollapsedGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource ExpanderCollapsedGradientEnd}" />
    </LinearGradientBrush>


</ResourceDictionary>