                            Deliberately empty. WhatIfView.RefreshInsights() inflates
                            InsightsTabView into this host the first time the tab is entered, so
                            the 34 heavy Syncfusion controls in it are not built as part of
                            constructing the page. See InsightsTabView.xaml.
                        -->
                        <ContentView x:Name="InsightsHost" />
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

            </tabView:SfTabView>

            <!--
                Last child of the root Grid so it is topmost, and spanning both rows so the title
                is covered too — a half-covered page reads as a rendering fault rather than as
                loading. Starts hidden; OnAppearing shows it around its own work.
            -->
            <customControls:BusyOverlayView
                x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="2" />

        </Grid>
    </ContentPage.Content>
</ContentPage>
