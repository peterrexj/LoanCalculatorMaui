<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Warm = a LIGHT rose theme. Pale rose page, deep rose-brown text, cream cards,
          rose accents with white text. Tuned for WCAG: body text >=4.5, secondary/UI >=3.  -->

    <!--  Colors  -->
    <Color x:Key="LoanAppDefaultForegroundColor">#4A2424</Color>
    <Color x:Key="LoanAppDefaultBackgroundColor">#F1D9D9</Color>

    <Color x:Key="LoanAppTabBarBackgroundGradientStart">#C2706B</Color>
    <Color x:Key="LoanAppTabBarBackgroundGradientEnd">#A85951</Color>
    <Color x:Key="LoanAppTabIndicatorStrokeColor">#8F4A45</Color>
    <Color x:Key="LoanAppTabTextColorSelected">#F5EBEB</Color>
    <Color x:Key="LoanAppTabTextColorNormal">#F3D2C8</Color>

    <Color x:Key="LoanAppHighlightFgColor">#8F4A45</Color>

    <Color x:Key="LoanAppInputTextFgColor">#4A2424</Color>
    <Color x:Key="LoanAppInputTextWhenFocusedColor">#8F4A45</Color>
    <Color x:Key="LoanAppInputTextWhenUnFocusedColor">#7d4a4a</Color>
    <Color x:Key="LoanAppInputErrorTextFgColor">#B3261E</Color>

    <Color x:Key="LoanAppSegBgColor">#F6E0E0</Color>
