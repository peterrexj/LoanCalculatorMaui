    <!--  Progress  -->
    <Color x:Key="LoanAppProgressTrackColor">#E0B8B8</Color>
    <Color x:Key="LoanAppProgressColor">#B5635D</Color>

    <!--  Purchase  -->
    <Color x:Key="LoanAppPurchaseTextFontColor">#4A2424</Color>
    <Color x:Key="LoanAppPurchaseButtonPrimaryFgColor">#F5EBEB</Color>
    <Color x:Key="LoanAppPurchaseButtonPrimaryBgColor">#B5635D</Color>
    <Color x:Key="LoanAppPurchaseButtonSecondaryFgColor">#8F4A45</Color>
