<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoanCalculatorMaui.View.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <!--  Brand gradient backdrop (theme-independent — this is a brand moment)  -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#0A1A20" />
                <GradientStop Offset="0.55" Color="#0E3340" />
                <GradientStop Offset="1.0" Color="#10545C" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--  Everything here is composed at its RESTING state: no element starts hidden,
              offset or scaled, because there is no entrance animation to run it in. That is
              deliberate — see SplashPage.xaml.cs. Do not reintroduce Opacity="0"/Scale/
              TranslationY start values without reading the note there first.  -->

        <!--  Soft glow behind the logo. A plain low-opacity solid ellipse — NOT a
              RadialGradientBrush, which misrenders on Android (collapses to a ring).  -->
        <Ellipse
            x:Name="GlowEllipse"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="0,-140,0,0"
            WidthRequest="300"
            HeightRequest="300"
            Fill="#16BAC5"
            Opacity="0.22" />

        <Grid
            RowDefinitions="*,Auto,Auto,Auto,*"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Padding="32,0">

            <!--  Logo card. No colored Shadow: MAUI renders a colored shadow with a large
                  radius as a diagonal streak on Android.  -->
            <Border
                x:Name="LogoCard"
                Grid.Row="1"
                HorizontalOptions="Center"
                VerticalOptions="End"
                WidthRequest="148"
                HeightRequest="148"
                Padding="20"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="34" />
                </Border.StrokeShape>
                <Image
                    Source="splash_icon.png"
                    Aspect="AspectFit"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            </Border>

            <!--  App name  -->
            <Label
                x:Name="TitleLabel"
                Grid.Row="2"
                Margin="0,28,0,0"
                Text="Loan Affordability Calculator"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center" />

            <!--  Tagline  -->
            <Label
                x:Name="TaglineLabel"
                Grid.Row="3"
                Margin="0,8,0,0"
                Text="Plan smarter, borrow wiser"
                FontSize="14"
                TextColor="#9FD9DE"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center" />

            <!--  Loading dots — pulse while the app pre-warms  -->
            <HorizontalStackLayout
                x:Name="DotsLayout"
                Grid.Row="4"
                Margin="0,0,0,56"
                Spacing="10"
                HorizontalOptions="Center"
                VerticalOptions="End">
                <Ellipse x:Name="Dot1" WidthRequest="9" HeightRequest="9" Fill="#16BAC5" />
                <Ellipse x:Name="Dot2" WidthRequest="9" HeightRequest="9" Fill="#16BAC5" />
                <Ellipse x:Name="Dot3" WidthRequest="9" HeightRequest="9" Fill="#16BAC5" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
