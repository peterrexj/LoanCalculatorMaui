<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoanCalculatorMaui.View.LoanView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:customControls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:income="clr-namespace:LoanCalculator.Core.Models.Income;assembly=LoanCalculator.Core"
    xmlns:models="clr-namespace:LoanCalculator.Core.Models;assembly=LoanCalculator.Core"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:primaryModels="clr-namespace:LoanCalculator.Core.Models.ViewModels.PrimaryModels;assembly=LoanCalculator.Core"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:range="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:sfList="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:LoanCalculator.Core.Models.ViewModels;assembly=LoanCalculator.Core"
    Title="LoanView"
    x:DataType="primaryModels:LoanViewModel">
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" IsEnabled="{Binding IsFree}">
            <customControls:PopupDisclaimerView />
            <customControls:InAppPurchaseView x:Name="PremiumWindow" />

            <tabView:SfTabView
                x:Name="TabView"
                HeaderHorizontalTextAlignment="Center"
                SelectionChanging="TabView_OnSelectionChanging">
                <tabView:SfTabItem Header="Property">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <StackLayout>
                                <customControls:DisclaimerBannerView
                                    BannerType="Warning"
                                    HeaderText="Disclaimer"
                                    Text="This loan calculator app is intended for informational purposes only and should not be considered a substitute for professional financial advice. It is highly recommended that you consult with your financial adviser before making any financial decisions." />

                                <customControls:ThreeColumnBorderedContentView>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding HomeLoanInfo.PaymentSummary.Payment.TermPaymentRoundedWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding RepaymentFrequencySelected}" />
                                            <Span Text=" " />
                                            <Span
                                                FontSize="{OnPlatform Android={OnIdiom Phone=15,
                                                                                       Tablet=26,
                                                                                       Desktop=26,
                                                                                       TV=26,
                                                                                       Watch=13},
                                                                      iOS={OnIdiom Phone=15,
                                                                                   Tablet=26,
                                                                                   Desktop=26,
                                                                                   TV=26,
                                                                                   Watch=13},
                                                                      Default=15}"
                                                Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                                Text="{Binding LoanTermInYears}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" years with a deposit of " />
                                            <Span
                                                FontSize="{OnPlatform Android={OnIdiom Phone=15,
                                                                                       Tablet=26,
                                                                                       Desktop=26,
                                                                                       TV=26,
                                                                                       Watch=13},
                                                                      iOS={OnIdiom Phone=15,
                                                                                   Tablet=26,
                                                                                   Desktop=26,
                                                                                   TV=26,
                                                                                   Watch=13},
                                                                      Default=15}"
                                                Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                                Text="{Binding DepositAmountStrFormatted}" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding HomeLoanInfo.PaymentSummary.Payment.TotalInterestPaymentRoundedWithComma}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" total interest payable over " />
                                            <Span
                                                FontSize="{OnPlatform Android={OnIdiom Phone=15,
                                                                                       Tablet=26,
                                                                                       Desktop=26,
                                                                                       TV=26,
                                                                                       Watch=13},
                                                                      iOS={OnIdiom Phone=15,
                                                                                   Tablet=26,
                                                                                   Desktop=26,
                                                                                   TV=26,
                                                                                   Watch=13},
                                                                      Default=15}"
                                                Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                                Text="{Binding LoanTermInYears}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" years" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText3>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding AffordabilityCurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Affordability}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding AffordabilityTextDescription}" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText3>
                                </customControls:ThreeColumnBorderedContentView>

                                <FlexLayout>
                                    <Border Style="{DynamicResource BorderControlHighlightBox}">
                                        <StackLayout Margin="{OnPlatform Android={OnIdiom Phone='5,0,5,0', Tablet='20,10,20,10', Desktop='20,10,20,10', TV='20,10,20,10'}, iOS={OnIdiom Phone='5,0,5,0', Tablet='20,10,20,10', Desktop='20,10,20,10', TV='20,10,20,10'}, Default='5,0,5,0'}">

                                            <Grid Margin="5,0,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>

                                                <core:SfTextInputLayout
                                                    Grid.Column="0"
                                                    Margin="0,0,0,-15"
                                                    Hint="Property Value"
                                                    HorizontalOptions="Start"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c0"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
                                                        MaximumNumberDecimalDigits="0"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        Value="{Binding PropertyAmount}" />
                                                </core:SfTextInputLayout>

                                                <StackLayout
                                                    Grid.Column="1"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                               Tablet=17,
                                                                                               Desktop=17,
                                                                                               TV=17,
                                                                                               Watch=10},
                                                                              iOS={OnIdiom Phone=12,
                                                                                           Tablet=17,
                                                                                           Desktop=17,
                                                                                           TV=17,
                                                                                           Watch=10},
                                                                              Default=12}"
                                                        HorizontalOptions="Start"
                                                        Text="Total property amount"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=16,
                                                                                               Tablet=21,
                                                                                               Desktop=21,
                                                                                               TV=21,
                                                                                               Watch=14},
                                                                              iOS={OnIdiom Phone=16,
                                                                                           Tablet=21,
                                                                                           Desktop=21,
                                                                                           TV=21,
                                                                                           Watch=14},
                                                                              Default=16}"
                                                        HorizontalOptions="Start"
                                                        Text="{Binding PropertyTotalAmount}"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        VerticalOptions="Center" />
                                                </StackLayout>

                                            </Grid>

                                            <Grid Margin="5,0,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Margin="0,0,0,-10"  -->
                                                <!--  PercentDisplayMode="Value"  -->
                                                <core:SfTextInputLayout
                                                    Grid.Column="0"
                                                    Padding="2,0,2,0"
                                                    Hint="Interest Rate"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="##0.##'%'"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
                                                        HorizontalTextAlignment="Center"
                                                        LargeChange="1"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        ShowClearButton="False"
                                                        SmallChange="0.05"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        UpDownButtonAlignment="Both"
                                                        UpDownPlacementMode="Inline"
                                                        Value="{Binding InterestRate}" />
                                                </core:SfTextInputLayout>

                                                <!--  Margin="0,0,0,-10"  -->
                                                <core:SfTextInputLayout
                                                    Grid.Column="1"
                                                    Hint="Loan Term"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="00"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
                                                        HorizontalTextAlignment="Center"
                                                        LargeChange="5"
                                                        Maximum="30"
                                                        MaximumNumberDecimalDigits="0"
                                                        Minimum="0"
                                                        ShowClearButton="False"
                                                        SmallChange="1"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        UpDownButtonAlignment="Both"
                                                        UpDownPlacementMode="Inline"
                                                        Value="{Binding LoanTermInYears}" />

                                                </core:SfTextInputLayout>
                                            </Grid>

                                            <buttons:SfSegmentedControl
                                                x:Name="SegmentedRepaymentFrequency"
                                                Margin="15,0,15,10"
                                                ItemsSource="{Binding RepaymentFrequencyCollection}"
                                                SelectedIndex="{Binding RepaymentFrequencySelectedIndex}"
                                                Style="{DynamicResource SegmentDefaultStyle}"
                                                VisibleSegmentsCount="3" />
                                        </StackLayout>
                                    </Border>
                                </FlexLayout>

                                <expander:SfExpander
                                    Margin="0,0,0,5"
                                    HeaderIconPosition="End"
                                    Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Deposit: " />
                                                        <Span Text="{Binding DepositAmountStrFormatted}" />
                                                        <Span Text=" (" />
                                                        <Span Text="{Binding DepositPercentage, StringFormat='{0:F2}'}" />
                                                        <Span Text=" %)" />

                                                        <Span Text="  " />

                                                        <Span Text="Loan: " />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding LoanAmountStrFormatted}" />
                                                        <Span Text=" (" />
                                                        <Span Text="{Binding LoanAmountPercentage, StringFormat='{0:F2}'}" />
                                                        <Span Text=" %)" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <Border Style="{DynamicResource BorderControlHighlightBox}">
                                            <Grid Margin="{OnPlatform Android={OnIdiom Phone='5,0,5,0', Tablet='20,10,20,10', Desktop='20,10,20,10', TV='20,10,20,10'}, iOS={OnIdiom Phone='5,0,5,0', Tablet='20,10,20,10', Desktop='20,10,20,10', TV='20,10,20,10'}, Default='5,0,5,0'}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!--  Margin="0,0,0,-20"  -->
                                                <core:SfTextInputLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Hint="Deposit value (direct)"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c0"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        Value="{Binding DepositAmountDirectInput}" />
                                                </core:SfTextInputLayout>


                                                <!--  Margin="0,0,0,-10"  -->
                                                <core:SfTextInputLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Hint="Loan Amount (direct)"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="C0"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        Value="{Binding LoanAmountDirectInput}" />
                                                </core:SfTextInputLayout>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    BackgroundColor="Transparent">
                                                    <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Start">
                                                        <CheckBox
                                                            x:Name="EnableSliderCheckBox"
                                                            IsChecked="{Binding IsDepositPercentageSliderEnabled}"
                                                            VerticalOptions="Center"
                                                            Color="{DynamicResource LoanAppCheckboxBackColor}" />
                                                        <Label
                                                            Margin="0,0,0,0"
                                                            FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                   Tablet=17,
                                                                                                   Desktop=17,
                                                                                                   TV=17,
                                                                                                   Watch=10},
                                                                                  iOS={OnIdiom Phone=12,
                                                                                               Tablet=17,
                                                                                               Desktop=17,
                                                                                               TV=17,
                                                                                               Watch=10},
                                                                                  Default=12}"
                                                            Text="Enable"
                                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                            VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnLabelTapped" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </HorizontalStackLayout>
                                                    <Label
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                               Tablet=17,
                                                                                               Desktop=17,
                                                                                               TV=17,
                                                                                               Watch=10},
                                                                              iOS={OnIdiom Phone=12,
                                                                                           Tablet=17,
                                                                                           Desktop=17,
                                                                                           TV=17,
                                                                                           Watch=10},
                                                                              Default=12}"
                                                        Text="Deposit Percentage"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                        VerticalOptions="Center" />

                                                    <range:SfSlider
                                                        Margin="0,-17,0,0"
                                                        HeightRequest="70"
                                                        IsEnabled="{Binding IsDepositPercentageSliderEnabled}"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        ShowLabels="True"
                                                        StepSize="1"
                                                        Value="{Binding DepositPercentage}">
                                                        <range:SfRangeSlider.ThumbStyle>
                                                            <range:SliderThumbStyle
                                                                Fill="{DynamicResource LoanAppSliderKnobFillColor}"
                                                                OverlapStroke="{DynamicResource LoanAppSliderKnobOverlapColor}"
                                                                Stroke="{DynamicResource LoanAppSliderKnobBorderColor}"
                                                                StrokeThickness="2" />
                                                        </range:SfRangeSlider.ThumbStyle>
                                                        <range:SfSlider.LabelStyle>
                                                            <range:SliderLabelStyle
                                                                ActiveFontFamily="{DynamicResource DefaultFontFamily}"
                                                                ActiveFontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                             Tablet=17,
                                                                                                             Desktop=17,
                                                                                                             TV=17,
                                                                                                             Watch=10},
                                                                                            iOS={OnIdiom Phone=12,
                                                                                                         Tablet=17,
                                                                                                         Desktop=17,
                                                                                                         TV=17,
                                                                                                         Watch=10},
                                                                                            Default=12}"
                                                                ActiveTextColor="{DynamicResource LoanAppRangeSliderLabelTextColor}"
                                                                InactiveFontFamily="{DynamicResource DefaultFontFamily}"
                                                                InactiveFontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                               Tablet=17,
                                                                                                               Desktop=17,
                                                                                                               TV=17,
                                                                                                               Watch=10},
                                                                                              iOS={OnIdiom Phone=12,
                                                                                                           Tablet=17,
                                                                                                           Desktop=17,
                                                                                                           TV=17,
                                                                                                           Watch=10},
                                                                                              Default=12}"
                                                                InactiveTextColor="{DynamicResource LoanAppRangeSliderLabelTextColor}" />
                                                        </range:SfSlider.LabelStyle>
                                                        <range:SfSlider.TrackStyle>
                                                            <range:SliderTrackStyle
                                                                ActiveFill="{DynamicResource LoanAppRangeSliderTrackActiveFillColor}"
                                                                ActiveSize="5"
                                                                InactiveFill="{DynamicResource LoanAppRangeSliderTrackInActiveFillColor}"
                                                                InactiveSize="1" />
                                                        </range:SfSlider.TrackStyle>
                                                    </range:SfSlider>
                                                </StackLayout>
                                            </Grid>
                                        </Border>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>


                                <expander:SfExpander HeaderIconPosition="End" Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Upfront costs: " />
                                                        <Span FontFamily="{DynamicResource DefaultFontFamily}" Text="{Binding OtherExpenseTotalAmount}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <Border Style="{DynamicResource BorderControlHighlightBox}">
                                            <Grid Margin="{OnPlatform Android={OnIdiom Phone='5,0,5,0', Tablet='20,10,20,10', Desktop='20,10,20,10', TV='20,10,20,10'}, iOS={OnIdiom Phone='5,0,5,0', Tablet='20,10,20,10', Desktop='20,10,20,10', TV='20,10,20,10'}, Default='5,0,5,0'}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding HeightOfGridRowToggledByCountryOnStampDuty}" />
                                                    <RowDefinition Height="{OnPlatform Android={OnIdiom Phone=70, Tablet=85, Desktop=85, TV=85, Watch=85}, iOS={OnIdiom Phone=70, Tablet=85, Desktop=85, TV=85, Watch=70}, Default=70}" />
                                                    <RowDefinition Height="{OnPlatform Android={OnIdiom Phone=70, Tablet=85, Desktop=85, TV=85, Watch=85}, iOS={OnIdiom Phone=70, Tablet=85, Desktop=85, TV=85, Watch=70}, Default=70}" />
                                                    <RowDefinition Height="{OnPlatform Android={OnIdiom Phone=70, Tablet=85, Desktop=85, TV=85, Watch=85}, iOS={OnIdiom Phone=70, Tablet=85, Desktop=85, TV=85, Watch=70}, Default=70}" />
                                                </Grid.RowDefinitions>

                                                <buttons:SfSegmentedControl
                                                    x:Name="SegmentedAustraliaStates"
                                                    Grid.Row="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="10,5"
                                                    IsVisible="{Binding ShowAustralianStateSelectorOnStampDuty}"
                                                    ItemsSource="{Binding AustraliaStateCollection}"
                                                    SelectedIndex="{Binding AustraliaStateSelectedIndex}"
                                                    Style="{DynamicResource SegmentDefaultStyle}"
                                                    VisibleSegmentsCount="8" />

                                                <core:SfTextInputLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,-15"
                                                    Hint="Property stamp duty (estimate)"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c0"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        Value="{Binding StampDuty}" />
                                                </core:SfTextInputLayout>

                                                <core:SfTextInputLayout
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,-15"
                                                    Hint="Mortgage charges"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c0"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        Value="{Binding MortgageCharges}" />
                                                </core:SfTextInputLayout>

                                                <core:SfTextInputLayout
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,-15"
                                                    Hint="Conveyance / solicitor fee"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c0"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        Value="{Binding ConveyancerFee}" />
                                                </core:SfTextInputLayout>

                                                <core:SfTextInputLayout
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,-15"
                                                    Hint="Bank fees"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c0"
                                                        FontSize="{OnPlatform Android={OnIdiom Phone=20,
                                                                                               Tablet=25,
                                                                                               Desktop=25,
                                                                                               TV=25,
                                                                                               Watch=18},
                                                                              iOS={OnIdiom Phone=20,
                                                                                           Tablet=25,
                                                                                           Desktop=25,
                                                                                           TV=25,
                                                                                           Watch=18},
                                                                              Default=20}"
