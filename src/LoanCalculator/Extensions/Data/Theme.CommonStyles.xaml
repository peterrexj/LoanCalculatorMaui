<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView">


    <!--  Font Families  -->
    <x:String x:Key="DefaultFontFamily">Lato</x:String>

    <!--  ═══════════════════════════════════════════════════════
          Advisory / disclaimer copy — single source of truth so the
          same wording is reused across pages and cannot drift.
          ═══════════════════════════════════════════════════════ -->
    <x:String x:Key="LoanAppDisclaimerBannerText">This app is a calculator for informational purposes only. Every figure is an estimate based on the information you enter — not financial advice, and not an offer of any loan or financial product. Consult a qualified financial adviser before making any financial decision.</x:String>
    <x:String x:Key="LoanAppEstimateMicrocopy">Estimates only — not financial advice. Figures depend on the information you enter. Consult a qualified financial adviser before deciding.</x:String>

    <!--  ═══════════════════════════════════════════════════════
          Responsive size tokens — use StaticResource instead of
          repeating OnIdiom inline throughout every view file.
          ═══════════════════════════════════════════════════════ -->

    <!--  Font sizes  -->
    <OnIdiom x:Key="FontSizeXS"
             x:TypeArguments="x:Double"
             Phone="10" Tablet="15" Desktop="15" TV="15" Watch="8" Default="10" />
    <OnIdiom x:Key="FontSizeSmall"
             x:TypeArguments="x:Double"
             Phone="11" Tablet="16" Desktop="16" TV="16" Watch="9" Default="11" />
    <OnIdiom x:Key="FontSizeBody"
             x:TypeArguments="x:Double"
             Phone="12" Tablet="18" Desktop="18" TV="18" Watch="10" Default="12" />
    <OnIdiom x:Key="FontSizeMedium"
             x:TypeArguments="x:Double"
             Phone="14" Tablet="20" Desktop="20" TV="20" Watch="12" Default="14" />
    <OnIdiom x:Key="FontSizeLarge"
             x:TypeArguments="x:Double"
             Phone="15" Tablet="22" Desktop="22" TV="22" Watch="13" Default="15" />
    <OnIdiom x:Key="FontSizeXL"
             x:TypeArguments="x:Double"
             Phone="18" Tablet="26" Desktop="26" TV="26" Watch="15" Default="18" />
    <OnIdiom x:Key="FontSizeHeading"
             x:TypeArguments="x:Double"
             Phone="20" Tablet="28" Desktop="28" TV="28" Watch="16" Default="20" />

    <!--
        The editable-figure size — app.css `.fig .n` is a literal 22px, deliberately larger than
        FontSizeHeading because these are the numbers the page exists to show (deposit, loan
        amount). It is its own token rather than a literal so the two figures cannot drift apart,
        and because it is NOT on the 10/11/12/14/15/18/20 ramp.
    -->
    <OnIdiom x:Key="FontSizeFigure"
             x:TypeArguments="x:Double"
             Phone="22" Tablet="34" Desktop="34" TV="34" Watch="18" Default="22" />

    <!--
        Tracking for uppercase labels, converted from app.css's em values at their own font size:
        `.section` is .08em on 11px ≈ 0.9, and `.fig .k` is .06em on 11px ≈ 0.7. MAUI
        CharacterSpacing is in device-independent units, not em, so these cannot be copied across
        verbatim. Their absence is why uppercase labels read tighter than the prototype's.
    -->
    <x:Double x:Key="TrackingSectionHeader">0.9</x:Double>
    <x:Double x:Key="TrackingFigureLabel">0.7</x:Double>

    <!--  Margins  -->
    <OnIdiom x:Key="MarginSection"
             x:TypeArguments="Thickness"
             Phone="5,0,5,0" Tablet="20,10,20,10" Desktop="20,10,20,10" TV="20,10,20,10" Default="5,0,5,0" />
    <OnIdiom x:Key="MarginSectionFlat"
             x:TypeArguments="Thickness"
             Phone="8,0,8,0" Tablet="20,0,20,0" Desktop="20,0,20,0" TV="20,0,20,0" Default="8,0,8,0" />
    <OnIdiom x:Key="MarginItem"
             x:TypeArguments="Thickness"
             Phone="5" Tablet="10" Desktop="10" TV="10" Default="5" />
    <!--  Global style for Label  -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for Span  -->
    <Style TargetType="Span">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for Button  -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for Entry  -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
    </Style>

    <!--  Global style for SfNumericEntry  -->
    <Style TargetType="editors:SfNumericEntry">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
    </Style>

    <!--  Border top highlight box styles  -->
    <Style x:Key="BorderTopDangerHighlightBox" TargetType="Border">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderTopDangerGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderTopDangerBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="VerticalOptions" Value="FillAndExpand" />
    </Style>
    <Style x:Key="BorderTopHighlightBox" TargetType="Border">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderTopGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderTopBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="VerticalOptions" Value="FillAndExpand" />
    </Style>

    <Style x:Key="BorderTopSingleHighlightBox" TargetType="Border">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderTopGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderTopBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  Border controls box styles  -->
    <Style x:Key="BorderControlHighlightBox" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 3,3,3,3" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource BorderControlGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderControlBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="12,5,12,2" />
    </Style>

    <!--  Border insights box styles  -->
    <!--
        The rows card inside an Insights expander.

        Corner radius was 3 and the margin 12 on every side, which read as a separate slab dropped
        inside the panel rather than as the panel's own content — the expander card around it is
        `RoundRectangle 12`, and its content area is already inset. Now 12 to match every other
        card in the app, with the horizontal margin dropped so the rows use the width they have
        (the fixed 150pt figure column was squeezing long names against a doubled inset).
    -->
    <Style x:Key="BorderInsightsHighlightBox" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource BorderInsightsGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource BorderInsightsBackgroundGradientBrush}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Padding" Value="14,4" />
        <!--
            Horizontally flush with the expander card that holds it. Any horizontal margin here
            shows as a channel of page background down both sides of the rows, which is what the
            12 on each side used to produce.
        -->
        <Setter Property="Margin" Value="0,6" />
    </Style>

    <!--  Expander styles  -->
    <!--
        Card wrapper for an SfExpander. Settings carried this as ten copies of the same inline
        Border while the Loan page's expanders had none, which is why the two pages looked
        different despite using the same control and the same CommonExpanderStyle.

        The vertical margin belongs HERE, not on the expander inside. An inner margin insets the
        header's gradient from the Border, so a strip of card background shows above and below it —
        which reads as a mismatched header fill — and it leaves the cards themselves touching,
        because all the spacing ends up inside them.
        Do not reuse BorderControlHighlightBox — same brushes, but RoundRectangle 3, thickness 2
        and centred.
    -->
    <Style x:Key="ExpanderCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,5" />
        <!--  Background, not BackgroundColor: the value is a LinearGradientBrush. See CLAUDE.md.  -->
        <Setter Property="Background" Value="{DynamicResource BorderControlBackgroundGradientBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderControlGradientBrush}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!--
        ═══════════════════════════════════════════════════════════════════════
        Separators. There used to be 55 inline BoxViews across the views at five
        different opacities (0.08 / 0.1 / 0.12 / 0.15 / 0.20) with no shared style,
        so the same visual element was four different weights depending on which
        file you were in. 0.1 is the value these settled on, being by far the most
        common, so most instances did not visibly change when they moved here.

        Two things that LOOK like separators and are not — do not sweep them onto
        these styles:
          • WhatIfView has 4pt VERTICAL accent stripes in a Grid ColumnDefinitions="4,*".
            They are BoxViews, they are not rules, and they carry a chart colour.
          • A BoxView with no HeightRequest is not necessarily a rule either; check
            before converting.
        ═══════════════════════════════════════════════════════════════════════
    -->
    <Style x:Key="LoanAppSeparatorStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Opacity" Value="0.1" />
        <Setter Property="Color" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <!--
        For a rule BETWEEN ROWS INSIDE A CARD. The 16 margin is row alignment: it matches
        the Padding="16,…" of the rows it divides, so the rule starts where the row text
        starts rather than running to the card edge. It is NOT page-edge padding, and
        changing the page inset must not change this. Settings alone has 17 of these.
    -->
    <Style x:Key="LoanAppSeparatorInsetStyle" TargetType="BoxView" BasedOn="{StaticResource LoanAppSeparatorStyle}">
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <Style x:Key="CommonExpanderStyle" TargetType="expander:SfExpander">
        <Setter Property="HeaderIconColor" Value="{DynamicResource LoanAppExpanderHeaderTextColor}" />
        <!--
            Expand/collapse animation. Nothing used to set these, so every expander ran
            Syncfusion's defaults: 200ms at ExpanderAnimationEasing.Linear. A linear height
            reveal starts and stops abruptly, which is what makes it read as a jerk rather than
            a slide.

            AnimationEasing takes Syncfusion's ExpanderAnimationEasing enum (None, Linear, SinIn,
            SinOut, SinInOut) — NOT a MAUI Easing. `{x:Static Easing.CubicOut}` will not bind
            here, whatever it does on SfLinearProgressBar a few hundred lines away in LoanView.
            Set AnimationEasing="None" to turn the animation off outright.
        -->
        <Setter Property="AnimationDuration" Value="250" />
        <Setter Property="AnimationEasing" Value="SinInOut" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState Name="Expanded">
                            <VisualState.Setters>
                                <Setter Property="HeaderBackground" Value="{DynamicResource LoanAppExpanderExpandedGradientBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Collapsed">
                            <VisualState.Setters>
                                <Setter Property="HeaderBackground" Value="{DynamicResource LoanAppExpanderCollapsedGradientBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Expander header label  -->
    <Style x:Key="ExpanderHeaderLabelStyle" TargetType="Label">
        <Setter Property="Margin" Value="15,0,0,0" />
        <!--<Setter Property="HeightRequest" Value="30" />-->
        <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=30, Tablet=60, Desktop=40, TV=60, Watch=15, Default=30}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppExpanderHeaderTextColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
    </Style>

    <!--
        Expander header subtitle — the muted one-line description under the header title.

        It must derive from LoanAppExpanderHeaderTextColor, NOT LoanAppDefaultForegroundColor:
        it sits on the header gradient, not on the page background. Warm is the theme that
        exposes the difference — its default foreground is a dark maroon (#4A2424) on a maroon
        header, which is unreadable.
    -->
    <Style x:Key="ExpanderHeaderSubLabelStyle" TargetType="Label">
        <Setter Property="Margin" Value="15,0,0,4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppExpanderHeaderTextColor}" />
    </Style>


    <!--  Tab View  -->
    <Style TargetType="tabView:SfTabView">
        <Setter Property="HeaderHorizontalTextAlignment" Value="Center" />
        <Setter Property="IndicatorCornerRadius" Value="1" />
        <Setter Property="IndicatorStrokeThickness" Value="5" />
        <Setter Property="IndicatorPlacement" Value="Bottom" />
        <Setter Property="IndicatorWidthMode" Value="Stretch" />
        <Setter Property="IndicatorBackground" Value="{DynamicResource LoanAppTabIndicatorStrokeColor}" />
        <Setter Property="TabBarBackground" Value="{DynamicResource TabBarBackgroundGradientBrush}" />
    </Style>


    <!--  Tab Item  -->
    <Style TargetType="tabView:SfTabItem">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup>
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource LoanAppTabTextColorNormal}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource LoanAppTabTextColorSelected}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--  Input Text styles  -->
    <Style x:Key="CommonTextInputLayoutStyle" TargetType="core:SfTextInputLayout">
        <Setter Property="ContainerBackground" Value="Transparent" />
        <Setter Property="IsHintAlwaysFloated" Value="True" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="ContainerType" Value="None" />
        <Setter Property="FocusedStrokeThickness" Value="3" />
        <Setter Property="UnfocusedStrokeThickness" Value="0" />
        <!--<Setter Property="OutlineCornerRadius" Value="8" />-->
        <!--<Setter Property="Margin" Value="5" />-->
        <Setter Property="Stroke" Value="{DynamicResource LoanAppInputTextWhenFocusedColor}" />
        <Setter Property="HintLabelStyle">
            <Setter.Value>
                <core:LabelStyle
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{StaticResource FontSizeLarge}"
                    TextColor="{DynamicResource LoanAppInputTextFgColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="ErrorLabelStyle">
            <Setter.Value>
                <core:LabelStyle FontAttributes="Italic" FontFamily="{DynamicResource DefaultFontFamily}" />
            </Setter.Value>
        </Setter>
        <Setter Property="HelperLabelStyle">
            <Setter.Value>
                <core:LabelStyle FontFamily="{DynamicResource DefaultFontFamily}" TextColor="{DynamicResource LoanAppInputTextFgColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{DynamicResource LoanAppInputTextWhenUnFocusedColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Focused">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{DynamicResource LoanAppInputTextWhenFocusedColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Error">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{DynamicResource LoanAppInputErrorTextFgColor}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Segment styles  -->
    <Style x:Key="SegmentDefaultStyle" TargetType="buttons:SfSegmentedControl">
        <!--  SelectedSegmentTextColor="{Binding DefaultStyle.SegSelectedTextFgColor, Converter={StaticResource StringToColorConverter}}"  -->
        <!--  SelectionTextColor="{Binding DefaultStyle.SegSelectedTextFgColor, Converter={StaticResource StringToColorConverter}}"  -->
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Stroke" Value="{DynamicResource LoanAppSegBorderColor}" />
        <Setter Property="Background" Value="{DynamicResource LoanAppSegBgColor}" />
        <Setter Property="SegmentHeight" Value="{OnIdiom Phone=40, Tablet=54, Desktop=54, TV=54, Default=40}" />
        <Setter Property="buttons:SfSegmentedControl.TextStyle">
            <Setter.Value>
                <buttons:SegmentTextStyle
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{OnIdiom Phone=12,
                                       Tablet=17,
                                       Desktop=17,
                                       TV=17,
                                       Watch=10,
                                       Default=12}"
                    TextColor="{DynamicResource LoanAppSegTextFgColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="buttons:SfSegmentedControl.SelectionIndicatorSettings">
            <Setter.Value>
                <buttons:SelectionIndicatorSettings Background="{DynamicResource LoanAppSegSelectedBgColor}" SelectionIndicatorPlacement="Fill" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style for transaction expense income list item border  -->
    <Style x:Key="TransactionListItemBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,5,12,2" />
        <Setter Property="Background" Value="{DynamicResource LoanAppLstBgBrush}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Stroke" Value="{DynamicResource LoanAppLstBorderBrush}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8,8,8,8" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  Style for Chart border  -->
    <Style x:Key="LoanAppChartBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,5,12,2" />
        <Setter Property="Background" Value="{DynamicResource LoanAppChartInnerBorderGradientBrush}" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=250, Tablet=350, Desktop=350, TV=350, Default=250}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Stroke" Value="{DynamicResource LoanAppChartOuterBorderGradientBrush}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12,12,12,12" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  Chart Insights data marker style  -->
    <Style x:Key="InsightsChartDataLabelStyle" TargetType="chart:ChartDataLabelStyle">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="LabelFormat" Value="c" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor}" />
    </Style>
    <!--  Wizard entry — transparent bg when editable, subtle tinted bg when read-only  -->
    <Style x:Key="WizardEntryStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Style.Triggers>
            <Trigger TargetType="Entry" Property="IsReadOnly" Value="True">
                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppAppShellBgColor}" />
                <Setter Property="Opacity" Value="0.75" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MauiButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MaximumHeightRequest" Value="50" />
        <Setter Property="Background" Value="{DynamicResource LoanAppButtonBgColor}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppButtonFgColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=20, Desktop=20, TV=20, Watch=12, Default=14}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>
    <!--  ── Shared popup (input form) styles — the "Quick Input" look ──────────  -->
    <!--  Uppercase field label sitting above a bordered input.  -->
    <!--
        The micro-label above a form field, and the same treatment the card foot's caption uses.
        CharacterSpacing is the prototype's `letter-spacing: .06em` — a flat 0.7 rather than an
        OnIdiom pair, since .06em is 0.66pt at the phone's 11pt and 0.96pt at the tablet's 16pt
        and the third of a point between them is not worth a second resource. The uppercasing is
        in the Text itself, not a TextTransform, so it stays visible in the markup.
    -->
    <Style x:Key="PopupFieldLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="CharacterSpacing" Value="0.7" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <!--
        Rounded container that wraps an Entry / SfComboBox inside a popup.
        Mirrors the prototype's `.field .box`, including its 6pt gap below the field label — which
        lived as a per-element Margin before, so the three entry pages each set it (or forgot to).
    -->
    <Style x:Key="PopupInputBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppAppShellBgColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

    <!--
        ══ Data-entry form cards ══════════════════════════════════════════════════════════════

        The four entry pages (TransactionEntry, LoanDetails ×2 states, UpfrontCosts) group their
        fields in a card closed by a summary row. These styles are the prototype's `.card` and
        `.card-foot` rules, kept here rather than per page so the pattern cannot drift between
        them — it did before, which is how one page ended up with its total built from a bare
        separator div and four inline overrides.
    -->

    <!--  `.card` — the field group. Padding 14 matches the prototype; the horizontal page inset
          stays on the page container, per the 12pt rule in CLAUDE.md.  -->
    <Style x:Key="FormCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="Padding" Value="14" />
        <!--  Background, not BackgroundColor: the value is a LinearGradientBrush. See CLAUDE.md.  -->
        <Setter Property="Background" Value="{DynamicResource BorderControlBackgroundGradientBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource LoanAppBorderControlGradientBorderLineEnd}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!--  `.card-foot`'s top hairline. Carries the row's 14pt lead-in and 12pt gap as its own
          Margin, so the foot content needs no spacing of its own.  -->
    <Style x:Key="FormCardFootRuleStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Margin" Value="0,14,0,12" />
        <Setter Property="Color" Value="{DynamicResource LoanAppBorderControlGradientBorderLineEnd}" />
    </Style>

    <!--  `.card-foot .lead` — the figure the foot exists to state.  -->
    <Style x:Key="FormCardFootLeadStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <!--  `.card-foot .sub` — the secondary framing or breakdown beside it.  -->
    <Style x:Key="FormCardFootSubStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <!--  `.field .hint` — the muted line under an input. The word form of an amount goes here;
          it is the anti-typo device for that one field, so it is not a place for figures about
          the form as a whole, which belong in the foot.  -->
    <Style x:Key="PopupFieldHintStyle" TargetType="Label">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <!--
        There is deliberately no shared style for the VALUE inside an input container. The
        prototype gives every `.field .box` one treatment (font-size-xl / 700), but the three
        field types are an Entry, an SfComboBox and an SfSegmentedControl — no single TargetType
        covers them, so each sets FontSize/FontAttributes on the instance. The one that matters is
        the combo: SfComboBoxStyle supplies 14pt regular, which is right for Settings' pickers and
        wrong for a form field between two 18pt bold Entries, so TransactionEntryPage overrides it
        there rather than changing the style Settings depends on.
    -->

    <!--  Full-width primary action button at the bottom of a popup (the "Apply" button).  -->
    <Style x:Key="PopupPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="16,10,16,16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppNavigationButtonBackgroundColor}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppNavigationButtonIconColor}" />
    </Style>

    <!--  Transparent secondary button used for Cancel / Back inside a popup footer row.  -->
    <Style x:Key="PopupSecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <!--  Small ✕ dismiss button in a popup's top-right header corner.  -->
    <Style x:Key="PopupDismissButtonStyle" TargetType="Button">
        <Setter Property="Text" Value="✕" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
        <!--  app.css `.modal-head .x` is 0.6 — the dismiss glyph recedes.  -->
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!--  Inline validation error shown under a bordered input.  -->
    <Style x:Key="PopupErrorLabelStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Italic" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppInputErrorTextFgColor}" />
    </Style>

    <!--  Popup title (left side of the header row).  -->
    <Style x:Key="PopupTitleLabelStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <!--
        The − / + buttons inside a What If scenario's stepper pill.

        One style because there are eighteen of these across the five scenario views, each
        previously carrying the same six attributes by hand — and they had already drifted: the four
        pills in CombinedScenarioView used WidthRequest 34 while every other scenario used 36.

        HeightRequest is the point of it. None of the eighteen set one, so each pill's height came
        from the platform Button's implicit sizing and from the font metrics of whatever sat beside
        it in the row — which is why the offset-rate pill, the only one with an extra "Rate:" label
        in it, came out a different height from its neighbours. An explicit, shared height makes
        the pills deterministic instead of a product of their contents.

        Square (36x36) on purpose: these are icon-sized tap targets, and a glyph that is 36 wide
        and some other height reads as misaligned next to the value between them.

        Geometry and font only — deliberately NO TextColor. Each scenario tints its stepper with
        its own accent (LoanAppChartColor1, LoanAppChartColor2 and LoanAppChartColorSeries3 are all
        in use), so TextColor stays inline on each button. A Setter for it here would silently
        repaint three scenarios to a fourth one's colour.
    -->
    <Style x:Key="ScenarioStepperButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ExportButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="10,4,10,4" />
        <!--<Setter Property="MaximumHeightRequest" Value="60" />-->
        <Setter Property="MinimumHeightRequest" Value="{OnIdiom Phone=50, Tablet=70, Desktop=70, TV=70, Watch=30, Default=50}" />
        <Setter Property="Background" Value="{DynamicResource LoanAppExportButtonBgColor}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppExportButtonFgColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=18, Tablet=26, Desktop=26, TV=26, Watch=16, Default=18}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>
    <Style x:Key="ButtonStyle" TargetType="core:SfButton">
        <Setter Property="Background" Value="{DynamicResource LoanAppButtonBgColor}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MaximumHeightRequest" Value="50" />
        <!--<Setter Property="HeightRequest" Value="50" />-->
    </Style>
    <Style x:Key="ButtonLabelStyle" TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppButtonFgColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=20, Desktop=20, TV=20, Watch=12, Default=14}" />
    </Style>
    <Style x:Key="ListIconButtonStyle" TargetType="core:SfButton">
        <Setter Property="Background" Value="{DynamicResource LoanAppButtonBgColor}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Margin" Value="3,0,0,0" />
        <Setter Property="ShowIcon" Value="True" />
    </Style>

    <!--  Style for SfAutocomplete  -->
    <Style x:Key="SfAutocompleteStyle" TargetType="editors:SfAutocomplete">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Margin" Value="5,3,5,0" />
        <Setter Property="SelectionTextHighlightColor" Value="{DynamicResource LoanAppAutoCompleteSelectionTextHighlightColor}" />
        <Setter Property="SelectedDropDownItemBackground" Value="{DynamicResource LoanAppAutoCompleteSelectedDropDownItemBackground}" />
        <Setter Property="ClearButtonIconColor" Value="{DynamicResource LoanAppAutoCompleteClearButtonColor}" />
        <Setter Property="DropDownBackground" Value="{DynamicResource LoanAppAutoCompleteDropdownBackgroundColor}" />
        <Setter Property="DropDownItemFontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="DropDownItemTextColor" Value="{DynamicResource LoanAppAutoCompleteDropdownTextColor}" />
        <Setter Property="DropDownStroke" Value="{DynamicResource LoanAppAutoCompleteDropdownBorderColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="HighlightedTextColor" Value="{DynamicResource LoanAppAutoCompleteHighlightedTextColor}" />
        <Setter Property="HighlightedTextFontAttributes" Value="Bold" />
        <Setter Property="IsClearButtonVisible" Value="True" />
        <Setter Property="MinimumPrefixCharacters" Value="2" />
        <Setter Property="NoResultsFoundText" Value="No Results Found" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource LoanAppAutoCompleteWaterColor}" />
        <Setter Property="Placeholder" Value="Enter here to search" />
        <Setter Property="ShowBorder" Value="False" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppAutoCompleteTextColor}" />
        <Setter Property="TextHighlightMode" Value="MultipleOccurrence" />
        <Setter Property="TextSearchMode" Value="Contains" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=20, Desktop=20, TV=20, Watch=12, Default=14}" />
        <Setter Property="DropDownItemFontSize" Value="{StaticResource FontSizeMedium}" />
        <Setter Property="NoResultsFoundTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid BackgroundColor="{DynamicResource LoanAppAutoCompleteDropdownBackgroundColor}">
                        <Label
                            Margin="16,10"
                            FontAttributes="Italic"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="No matches found"
                            TextColor="{DynamicResource LoanAppAutoCompleteDropdownTextColor}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Schedule decade rows. Plain labels now the schedule is expanders rather than an SfDataGrid.  -->
    <Style x:Key="LabelScheduleColumnHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <Style x:Key="LabelScheduleCell" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppDefaultForegroundColor}" />
    </Style>

    <!--
        The three Budget filter boxes, which are a different shape from the autocompletes used
        for data entry: the prototype draws them as one short row inside a card, so they take the
        body size (12 on phone) rather than the 14 the entry fields use, and no vertical margin.

        The base style's `Margin="5,3,5,0"` is 3 at the top and 0 at the bottom, which sits the
        text visibly above the centre of the card it is in — fine against a label above a field,
        wrong when the card IS the control.
    -->
    <Style
        x:Key="SfAutocompleteFilterStyle"
        BasedOn="{StaticResource SfAutocompleteStyle}"
        TargetType="editors:SfAutocomplete">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinimumPrefixCharacters" Value="1" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!--  Style for SfComboBox  -->
    <Style x:Key="SfComboBoxStyle" TargetType="editors:SfComboBox">
        <Setter Property="DropDownBackground" Value="{DynamicResource LoanAppComboDropDownBackgroundColor}" />
        <Setter Property="DropDownItemFontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="DropDownItemTextColor" Value="{DynamicResource LoanAppComboDropDownTextColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=20, Desktop=20, TV=20, Watch=12, Default=14}" />
        <Setter Property="DropDownItemFontSize" Value="{OnIdiom Phone=14, Tablet=20, Desktop=20, TV=20, Watch=12, Default=14}" />
        <Setter Property="HighlightedTextColor" Value="{DynamicResource LoanAppComboHighlightedTextColor}" />
        <Setter Property="IsClearButtonVisible" Value="False" />
        <Setter Property="IsFilteringEnabled" Value="False" />
        <Setter Property="SelectedDropDownItemBackground" Value="{DynamicResource LoanAppComboSelectedDropDownItemColor}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppComboTextColor}" />
        <Setter Property="TextHighlightMode" Value="MultipleOccurrence" />
        <Setter Property="TextSearchMode" Value="Contains" />
    </Style>

    <!--  Span Three Box on top  -->
    <Style x:Key="SpanThreeBoxCurrencyStyle" TargetType="Span">
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=26, Desktop=26, TV=26, Watch=26, Default=15}" />
    </Style>
    <Style x:Key="SpanThreeBoxAmountStyle" TargetType="Span">
        <Setter Property="CharacterSpacing" Value="{OnIdiom Phone=-1, Tablet=0.5, Desktop=1, TV=1, Default=-1}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=18, Tablet=32, Desktop=32, TV=32, Watch=14, Default=18}" />
    </Style>
    <Style x:Key="SpanThreeBoxTextStyle" TargetType="Span">
        <Setter Property="CharacterSpacing" Value="{OnIdiom Phone=-0.2, Tablet=0, Desktop=1, TV=1, Default=-0.2}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=12, Tablet=20, Desktop=16, TV=16, Watch=10, Default=12}" />
        <!--
            app.css `.boxes .lbl` is opacity 0.85 and this style has no equivalent, deliberately:
            Span is not a VisualElement, so it has no Opacity property at all. Matching it would
            need an 85%-alpha colour key added to all four theme files (which
            ThemeFiles_ShouldHave_EqualKeys would then require in every one) for a 15% difference
            on a caption. Left as-is; the Label twin below can use Opacity because it is a
            VisualElement.
        -->
    </Style>

    <!--
        Label twins of the two Span styles above, for three-box rows built from plain Labels
        rather than a FormattedString. Same sizes and tracking, so a box reads identically
        whichever way it is composed — these mirror app.css's `.boxes .amt` / `.boxes .lbl`
        (18px bold / -1px tracking, and 12px / -0.2px tracking at 0.85 opacity).
        Keep the four in step: changing one Span size without its Label twin splits the look.
    -->
    <Style x:Key="LabelThreeBoxAmountStyle" TargetType="Label">
        <Setter Property="CharacterSpacing" Value="{OnIdiom Phone=-1, Tablet=0.5, Desktop=1, TV=1, Default=-1}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=18, Tablet=32, Desktop=32, TV=32, Watch=14, Default=18}" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppHighlightFgColor}" />
    </Style>
    <Style x:Key="LabelThreeBoxTextStyle" TargetType="Label">
        <Setter Property="CharacterSpacing" Value="{OnIdiom Phone=-0.2, Tablet=0, Desktop=1, TV=1, Default=-0.2}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=12, Tablet=20, Desktop=16, TV=16, Watch=10, Default=12}" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="TextColor" Value="{DynamicResource LoanAppHighlightFgColor}" />
    </Style>


