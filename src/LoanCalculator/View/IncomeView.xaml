<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="thisPage"
    x:Class="LoanCalculatorMaui.View.IncomeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:customControls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:income="clr-namespace:LoanCalculator.Core.Models.Income;assembly=LoanCalculator.Core"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:range="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:sfList="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
    xmlns:summary="clr-namespace:LoanCalculator.Core.Models.Income.Summary;assembly=LoanCalculator.Core"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:viewModels="clr-namespace:LoanCalculator.Core.Models.ViewModels;assembly=LoanCalculator.Core"
    Title="Income">
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
            <!--<customControls:PopupDisclaimerView />-->
            <customControls:InAppPurchaseView x:Name="PremiumWindow" />

            <!--  Add/Edit income popup — lives at page level so it overlays correctly  -->
            <sfPopup:SfPopup
                x:Name="AddIncomePopup"
                Padding="0"
                AnimationMode="Fade"
                AutoSizeMode="Height"
                HeightRequest="{OnIdiom Phone=470, Tablet=560, Desktop=560, Default=470}"
                WidthRequest="{OnIdiom Phone=340, Tablet=560, Desktop=560, Default=340}"
                BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                IsOpen="{Binding IsAddFormVisible, Mode=TwoWay}"
                ShowCloseButton="False"
                ShowFooter="False"
                ShowHeader="False"
                StaysOpen="False">
                <sfPopup:SfPopup.ContentTemplate>
                    <DataTemplate>
                        <Grid
                            BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                            BindingContext="{Binding Source={x:Reference thisPage}, Path=BindingContext}"
                            RowDefinitions="Auto,*,Auto">

                            <!--  Title row  -->
                            <Grid Grid.Row="0" Padding="16,14,8,4" ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    Style="{DynamicResource PopupTitleLabelStyle}"
                                    Text="{Binding IsEditMode, Converter={StaticResource BoolToEditAddTitleConverter}, ConverterParameter='Income'}" />
                                <Button
                                    Grid.Column="1"
                                    Clicked="ResetButton_Clicked"
                                    Style="{DynamicResource PopupDismissButtonStyle}" />
                            </Grid>

                            <!--  Fields  -->
                            <ScrollView Grid.Row="1">
                                <VerticalStackLayout Padding="16,4,16,0" Spacing="10">

                                    <!--  Name  -->
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="INCOME NAME" />
                                        <Border Style="{DynamicResource PopupInputBorderStyle}">
                                            <Entry
                                                BackgroundColor="Transparent"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Placeholder="e.g. Salary"
                                                PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                                Text="{Binding IncomeEntryName}"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </Border>
                                        <Label
                                            IsVisible="{Binding ShowErrorIncomeDescription}"
                                            Style="{DynamicResource PopupErrorLabelStyle}"
                                            Text="Required" />
                                    </VerticalStackLayout>

                                    <!--  Amount  -->
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="AMOUNT" />
                                        <Border Style="{DynamicResource PopupInputBorderStyle}">
                                            <Entry
                                                BackgroundColor="Transparent"
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeXL}"
                                                Keyboard="Numeric"
                                                Placeholder="0"
                                                PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                                Text="{Binding IncomeEntryAmountText, Mode=TwoWay}"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </Border>
                                        <Label
                                            IsVisible="{Binding ShowErrorIncomeAmount}"
                                            Style="{DynamicResource PopupErrorLabelStyle}"
                                            Text="Must be &gt; 0" />
                                    </VerticalStackLayout>

                                    <!--  Frequency  -->
                                    <VerticalStackLayout Spacing="4">
                                        <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="FREQUENCY" />
                                        <editors:SfComboBox
                                            BackgroundColor="Transparent"
                                            ItemsSource="{Binding IncomeFrequencyCollection}"
                                            SelectedItem="{Binding IncomeExpenseFrequencySelectedIndex, Mode=TwoWay}"
                                            Style="{DynamicResource SfComboBoxStyle}"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </ScrollView>

                            <!--  Primary action  -->
                            <Button
                                Grid.Row="2"
                                Clicked="AddNewIncome_Clicked"
                                Style="{DynamicResource PopupPrimaryButtonStyle}"
                                Text="{Binding IsEditMode, Converter={StaticResource BoolToAddUpdateConverter}}" />

                        </Grid>
                    </DataTemplate>
                </sfPopup:SfPopup.ContentTemplate>
            </sfPopup:SfPopup>

            <tabView:SfTabView
                x:Name="tabView"
                HeaderHorizontalTextAlignment="Center"
                SelectionChanging="TabView_OnSelectionChanging">
                <tabView:SfTabItem x:Name="tabIncomeDetails" Header="Income">
                    <tabView:SfTabItem.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  ── Top section (summary + switches) ──  -->
                            <VerticalStackLayout Grid.Row="0" Spacing="0">

                                <customControls:ThreeColumnBorderedContentView>
                                <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalMonthlyIncomeWithComma}" />
                                        <Span Text="{Binding NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding StringMonthlyTextOnTopBox}" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalYearlyIncomeWithComma}" />
                                        <Span Text="{Binding NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding StringYearlyTextOnTopBox}" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                <customControls:ThreeColumnBorderedContentView.FormattedText3>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalMonthlySumExpenseWithComma}" />
                                        <Span
                                            FontSize="{StaticResource FontSizeXS}"
                                            Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                            Text="{Binding TotalMonthlyExpenseBreakdownWithComma}" />
                                        <Span Text="{Binding NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding StringMonthlyExpenseOnTopBox}" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText3>
                            </customControls:ThreeColumnBorderedContentView>

                            <Border
                                    Margin="12,8,12,0"
                                    Padding="14,10"
                                    BackgroundColor="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <VerticalStackLayout Spacing="10">

                                        <!--  Show income after expense  -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <buttons:SfSwitch Grid.Column="0" HorizontalOptions="Start" IsOn="{Binding ShowIncomeAfterExpense}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="SwitchStates1">
                                                        <VisualState x:Name="On">
                                                            <VisualState.Setters>
                                                                <Setter Property="SwitchSettings">
                                                                    <Setter.Value>
                                                                        <buttons:SwitchSettings
                                                                            ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                            ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                            TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                            TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Off">
                                                            <VisualState.Setters>
                                                                <Setter Property="SwitchSettings">
                                                                    <Setter.Value>
                                                                        <buttons:SwitchSettings
                                                                            ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                            ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                            TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                            TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </buttons:SfSwitch>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label FontSize="{StaticResource FontSizeBody}" Text="Show income after expenses" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.7" Text="Display remaining income in summary" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1" Opacity="0.12" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                        <!--  Income after new asset expense  -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <buttons:SfSwitch Grid.Column="0" HorizontalOptions="Start" IsOn="{Binding ShowIncomeAfterPropertyExpense}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="SwitchStates2">
                                                        <VisualState x:Name="On">
                                                            <VisualState.Setters>
                                                                <Setter Property="SwitchSettings">
                                                                    <Setter.Value>
                                                                        <buttons:SwitchSettings
                                                                            ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                            ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                            TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                            TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Off">
                                                            <VisualState.Setters>
                                                                <Setter Property="SwitchSettings">
                                                                    <Setter.Value>
                                                                        <buttons:SwitchSettings
                                                                            ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                            ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                            TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                            TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </buttons:SfSwitch>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label FontSize="{StaticResource FontSizeBody}" Text="Income after new asset expense" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.7" Text="Include property loan costs in calculation" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>

                            <!--  ── Bottom section: search + list (fills remaining height) ──  -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Search / filter bar  -->
                                <Border
                                    Grid.Row="0"
                                    Margin="12,10,12,0"
                                    Padding="14,4"
                                    BackgroundColor="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            FontSize="{StaticResource FontSizeBody}"
                                            Opacity="0.45"
                                            Text="🔍"
                                            VerticalOptions="Center" />
                                        <editors:SfAutocomplete
                                            x:Name="autoComplete"
                                            Grid.Column="1"
                                            BackgroundColor="Transparent"
                                            Completed="autoComplete_Completed"
                                            ItemsSource="{Binding AutocompleteNameList}"
                                            MinimumPrefixCharacters="1"
                                            Placeholder="Filter income..."
                                            PlaceholderColor="{DynamicResource LoanAppAutoCompleteWaterColor}"
                                            SelectionChanged="autoComplete_SelectionChanged"
                                            Style="{DynamicResource SfAutocompleteStyle}" />
                                    </Grid>
                                </Border>

                                <!--  Empty state  -->
                                <Border
                                    Grid.Row="1"
                                    Margin="12,10,12,0"
                                    Padding="24,32"
                                    BackgroundColor="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    IsVisible="{Binding FilteredTransactions.Count, Converter={StaticResource IntToIsEmptyConverter}}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Text="No income yet"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label
                                            FontSize="{StaticResource FontSizeBody}"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Opacity="0.7"
                                            Text="Add your first income entry above to get started"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!--  List  -->
                                <sfList:SfListView
                                    x:Name="lstEntry"
                                    Grid.Row="2"
                                    Margin="12,8,12,12"
                                    AutoFitMode="Height"
                                    ItemsSource="{Binding FilteredTransactions}"
                                    SelectionMode="None"
                                    VerticalOptions="Fill">
                                    <sfList:SfListView.ItemTemplate>
                                        <DataTemplate x:DataType="income:IncomeExpense">
                                            <Border
                                                Margin="0,0,0,6"
                                                Padding="14,12"
                                                BackgroundColor="{DynamicResource BorderControlBackgroundGradientBrush}"
                                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="1">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Name + Frequency  -->
                                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                        <Label
                                                            FontSize="{StaticResource FontSizeBody}"
                                                            LineBreakMode="TailTruncation"
                                                            Text="{Binding Name}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                        <Label
                                                            FontSize="{StaticResource FontSizeSmall}"
                                                            Opacity="0.7"
                                                            Text="{Binding Frequency}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                    </VerticalStackLayout>

                                                    <!--  Amount  -->
                                                    <Label
                                                        Grid.Column="1"
                                                        FontAttributes="Bold"
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        Text="{Binding AmountString}"
                                                        TextColor="{DynamicResource LstForegroundColor}"
                                                        VerticalOptions="Center" />

                                                    <!--  Edit  -->
                                                    <buttons:SfButton
                                                        Grid.Column="2"
                                                        AutomationId="{Binding Id}"
                                                        Clicked="btnEditEntry_Clicked"
                                                        Style="{DynamicResource ListIconButtonStyle}">
                                                        <core:SfButton.Content>
                                                            <DataTemplate>
                                                                <Image Margin="6" Source="icon_edit.png" />
                                                            </DataTemplate>
                                                        </core:SfButton.Content>
                                                    </buttons:SfButton>

                                                    <!--  Delete  -->
                                                    <buttons:SfButton
                                                        Grid.Column="3"
                                                        AutomationId="{Binding Id}"
                                                        Clicked="btnDeleteEntry_Clicked"
                                                        Style="{DynamicResource ListIconButtonStyle}">
                                                        <core:SfButton.Content>
                                                            <DataTemplate>
                                                                <Image Margin="6" Source="icon_delete.png" />
                                                            </DataTemplate>
                                                        </core:SfButton.Content>
                                                    </buttons:SfButton>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </sfList:SfListView.ItemTemplate>
                                </sfList:SfListView>

                                <!--  FAB — last child, spans full height, anchored bottom-right  -->
                                <Button
                                    x:Name="FabAddIncome"
                                    Grid.RowSpan="3"
                                    Margin="0,0,20,20"
                                    BackgroundColor="{DynamicResource LoanAppInputTextFgColor}"
                                    Clicked="OnAddIncomeFab_Clicked"
                                    CornerRadius="28"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeHeading}"
                                    HeightRequest="56"
                                    HorizontalOptions="End"
                                    Text="+"
                                    TextColor="{DynamicResource LoanAppAppShellBgColor}"
                                    VerticalOptions="End"
                                    WidthRequest="56">
                                    <Button.Shadow>
                                        <Shadow Brush="#000000" Offset="0,4" Opacity="0.35" Radius="10" />
                                    </Button.Shadow>
                                    <Button.GestureRecognizers>
                                        <PanGestureRecognizer PanUpdated="OnFabPanUpdated" />
                                    </Button.GestureRecognizers>
                                </Button>

                            </Grid>

                        </Grid>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <tabView:SfTabItem x:Name="tabIncomeProjection" Header="Projection">
                    <tabView:SfTabItem.Content>
                        <ScrollView Scrolled="OnProjectionScrolled">
                            <VerticalStackLayout Spacing="0">
                                <!--  ── Summary bar  ────────────────────────────────────────  -->
                                <customControls:ThreeColumnBorderedContentView>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalProjectedYearlyIncomeWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Projected yearly" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                        <FormattedString>
                                            <Span FontAttributes="Bold" Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalYearsToProject}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Years projected" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText3>
                                        <FormattedString>
                                            <Span FontAttributes="Bold" Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding AnnualGrowthRate}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="%" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Annual growth" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText3>
                                </customControls:ThreeColumnBorderedContentView>
                                <!--  ── Controls card  ──────────────────────────────────────  -->
                                <Border
                                    Margin="12,10,12,0"
                                    Padding="14,12"
                                    BackgroundColor="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <VerticalStackLayout Spacing="10">

                                        <!--  Growth rate stepper — no keyboard  -->
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.7" Text="Annual growth %" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                            <Button Grid.Column="1" BackgroundColor="Transparent" Clicked="OnGrowthRateDecrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeHeading}" Text="−" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                Grid.Column="2"
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeHeading}"
                                                HorizontalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                MinimumWidthRequest="48"
                                                Text="{Binding AnnualGrowthRatePercentage, StringFormat='{0}%'}"
                                                TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                VerticalOptions="Center" />
                                            <Button Grid.Column="3" BackgroundColor="Transparent" Clicked="OnGrowthRateIncrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeHeading}" Text="+" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </Grid>

                                        <BoxView HeightRequest="1" Opacity="0.12" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                        <!--  Include expenses switch  -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <buttons:SfSwitch Grid.Column="0" HorizontalOptions="Start" IsOn="{Binding IncludeExpenses}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="ProjSwitchStates1">
                                                        <VisualState x:Name="On">
                                                            <VisualState.Setters>
                                                                <Setter Property="SwitchSettings">
                                                                    <Setter.Value>
                                                                        <buttons:SwitchSettings
                                                                            ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                            ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                            TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                            TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Off">
                                                            <VisualState.Setters>
                                                                <Setter Property="SwitchSettings">
                                                                    <Setter.Value>
                                                                        <buttons:SwitchSettings
                                                                            ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                            ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                            TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                            TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </buttons:SfSwitch>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label FontSize="{StaticResource FontSizeBody}" Text="Include expenses" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.7" Text="Deduct living expenses from projection" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1" Opacity="0.12" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                        <!--  Include property expenses switch  -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <buttons:SfSwitch Grid.Column="0" HorizontalOptions="Start" IsOn="{Binding IncludePropertyExpenses}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="ProjSwitchStates2">
                                                        <VisualState x:Name="On">
                                                            <VisualState.Setters>
                                                                <Setter Property="SwitchSettings">
                                                                    <Setter.Value>
                                                                        <buttons:SwitchSettings
                                                                            ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                            ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                            TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                            TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Off">
                                                            <VisualState.Setters>
                                                                <Setter Property="SwitchSettings">
                                                                    <Setter.Value>
                                                                        <buttons:SwitchSettings
                                                                            ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                            ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                            TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                            TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </buttons:SfSwitch>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label FontSize="{StaticResource FontSizeBody}" Text="Include new asset expenses" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.7" Text="Add property loan costs to projection" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>

                                <!--  ── Years to project card  ──────────────────────────────  -->
                                <Border
                                    Margin="12,10,12,0"
                                    Padding="14,10"
                                    BackgroundColor="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Column="0"
                                                FontSize="{StaticResource FontSizeBody}"
                                                Text="Years to project"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="{Binding TotalYearsToProject}"
                                                TextColor="{DynamicResource LoanAppHighlightFgColor}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                        <range:SfSlider
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            Interval="4"
                                            Maximum="25"
                                            Minimum="1"
                                            MinorTicksPerInterval="3"
                                            ShowLabels="True"
                                            ShowTicks="True"
                                            StepSize="1"
                                            Value="{Binding TotalYearsToProject}">
                                            <range:SfRangeSlider.ThumbStyle>
                                                <range:SliderThumbStyle
                                                    Fill="{DynamicResource LoanAppSliderKnobFillColor}"
                                                    OverlapStroke="{DynamicResource LoanAppSliderKnobOverlapColor}"
                                                    Stroke="{DynamicResource LoanAppSliderKnobBorderColor}"
                                                    StrokeThickness="2" />
                                            </range:SfRangeSlider.ThumbStyle>
                                            <range:SfSlider.LabelStyle>
                                                <range:SliderLabelStyle
                                                    ActiveFontFamily="{DynamicResource DefaultFontFamily}"
                                                    ActiveFontSize="{StaticResource FontSizeBody}"
                                                    ActiveTextColor="{DynamicResource LoanAppRangeSliderLabelTextColor}"
                                                    InactiveFontFamily="{DynamicResource DefaultFontFamily}"
                                                    InactiveFontSize="{StaticResource FontSizeBody}"
                                                    InactiveTextColor="{DynamicResource LoanAppRangeSliderLabelTextColor}" />
                                            </range:SfSlider.LabelStyle>
                                            <range:SfSlider.TrackStyle>
                                                <range:SliderTrackStyle
                                                    ActiveFill="{DynamicResource LoanAppRangeSliderTrackActiveFillColor}"
                                                    ActiveSize="5"
                                                    InactiveFill="{DynamicResource LoanAppRangeSliderTrackInActiveFillColor}"
                                                    InactiveSize="1" />
                                            </range:SfSlider.TrackStyle>
                                        </range:SfSlider>
                                    </VerticalStackLayout>
                                </Border>

                                <!--  ── Income Projection chart  ────────────────────────────  -->
                                <Label
                                    Margin="20,16,20,4"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.7"
                                    Text="INCOME PROJECTION"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Border Style="{DynamicResource LoanAppChartBorderStyle}">
                                        <Border.Content>
                                            <chart:SfCartesianChart
                                                Margin="{StaticResource MarginSection}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="FillAndExpand"
                                                PaletteBrushes="{Binding CustomChartColors}"
                                                VerticalOptions="FillAndExpand">
                                                <chart:SfCartesianChart.XAxes>
                                                    <chart:CategoryAxis
                                                        EdgeLabelsDrawingMode="Fit"
                                                        LabelPlacement="BetweenTicks"
                                                        ShowMajorGridLines="False">
                                                        <chart:CategoryAxis.LabelStyle>
                                                            <chart:ChartAxisLabelStyle
                                                                FontAttributes="Bold"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{StaticResource FontSizeBody}"
                                                                TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                        </chart:CategoryAxis.LabelStyle>
                                                        <chart:CategoryAxis.MajorTickStyle>
                                                            <chart:ChartAxisTickStyle TickSize="8" />
                                                        </chart:CategoryAxis.MajorTickStyle>
                                                    </chart:CategoryAxis>
                                                </chart:SfCartesianChart.XAxes>

                                                <chart:SfCartesianChart.YAxes>
                                                    <chart:NumericalAxis>
                                                        <chart:NumericalAxis.LabelStyle>
                                                            <chart:ChartAxisLabelStyle
                                                                x:Name="amortYearSecondaryAxisLabelStyle"
                                                                FontAttributes="Bold"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{StaticResource FontSizeBody}"
                                                                TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                        </chart:NumericalAxis.LabelStyle>
                                                        <chart:NumericalAxis.AxisLineStyle>
                                                            <chart:ChartLineStyle StrokeWidth="0" />
                                                        </chart:NumericalAxis.AxisLineStyle>
                                                        <chart:NumericalAxis.MajorTickStyle>
                                                            <chart:ChartAxisTickStyle TickSize="0" />
                                                        </chart:NumericalAxis.MajorTickStyle>
                                                    </chart:NumericalAxis>
                                                </chart:SfCartesianChart.YAxes>
                                                <chart:SfCartesianChart.Legend>
                                                    <chart:ChartLegend Placement="Bottom" ToggleSeriesVisibility="True">
                                                        <chart:ChartLegend.LabelStyle>
                                                            <chart:ChartLegendLabelStyle
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{StaticResource FontSizeXS}"
                                                                TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                        </chart:ChartLegend.LabelStyle>
                                                    </chart:ChartLegend>
                                                </chart:SfCartesianChart.Legend>
                                                <chart:SfCartesianChart.Series>
                                                    <chart:StackingColumnSeries
                                                        EnableAnimation="True"
                                                        ItemsSource="{Binding ChartProjectionTermStartAmountAxis}"
                                                        Label="Start"
                                                        LegendIcon="Rectangle"
                                                        Stroke="{DynamicResource LoanAppChartColor1}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />
                                                    <chart:StackingColumnSeries
                                                        EnableAnimation="True"
                                                        ItemsSource="{Binding ChartProjectionDeductionAmountAxis}"
                                                        Label="After Expense"
                                                        LegendIcon="Rectangle"
                                                        Stroke="{DynamicResource LoanAppChartColor2}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />
                                                    <chart:StackingColumnSeries
                                                        EnableAnimation="True"
                                                        ItemsSource="{Binding ChartProjectionIncomeExpenseAmountAxis}"
                                                        Label="Sum"
                                                        LegendIcon="Rectangle"
                                                        Stroke="{DynamicResource LoanAppChartColor3}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />
                                                </chart:SfCartesianChart.Series>
                                            </chart:SfCartesianChart>
                                        </Border.Content>
                                    </Border>

                                <!--  ── Year-by-Year section  ────────────────────────────────  -->
                                <Label
                                    Margin="20,16,20,4"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.7"
                                    Text="YEAR-BY-YEAR BREAKDOWN"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Grid Margin="0,8,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <pager:SfDataPager
                                        x:Name="dataPager"
                                        Grid.Row="0"
                                        Margin="0,3,0,3"
                                        ButtonFontSize="{StaticResource FontSizeSmall}"
                                        ButtonShape="Circle"
                                        HorizontalOptions="Center"
                                        NumericButtonsGenerateMode="Auto"
                                        PageSize="5"
                                        Source="{Binding IncomeProjectList}"
                                        Style="{DynamicResource LoanAppDataGridPagerStyle}">
                                        <pager:SfDataPager.DefaultStyle>
                                            <pager:DataPagerStyle
                                                NavigationButtonBackgroundColor="{DynamicResource LoanAppNavigationButtonBackgroundColor}"
                                                NavigationButtonDisableBackgroundColor="{DynamicResource LoanAppNavigationButtonDisableBackgroundColor}"
                                                NavigationButtonDisableIconColor="{DynamicResource LoanAppNavigationButtonDisableIconColor}"
                                                NavigationButtonIconColor="{DynamicResource LoanAppNavigationButtonIconColor}"
                                                NumericButtonBackgroundColor="{DynamicResource LoanAppNumericButtonBackgroundColor}"
                                                NumericButtonSelectionBackgroundColor="{DynamicResource LoanAppNumericButtonSelectionBackgroundColor}"
                                                NumericButtonSelectionTextColor="{DynamicResource LoanAppNumericButtonSelectionTextColor}"
                                                NumericButtonTextColor="{DynamicResource LoanAppNumericButtonTextColor}" />
                                        </pager:SfDataPager.DefaultStyle>
                                    </pager:SfDataPager>
                                    <datagrid:SfDataGrid
                                        x:Name="dataGrid"
                                        Grid.Row="1"
                                        AutoGenerateColumnsMode="None"
                                        ColumnWidthMode="Fill"
                                        HorizontalOptions="Fill"
                                        ItemsSource="{Binding PagedSource, Source={x:Reference dataPager}}"
                                        VerticalOptions="Fill">
                                        <datagrid:SfDataGrid.Columns>

                                            <datagrid:DataGridTemplateColumn HeaderText="Period" MappingName="PaymentPeriod">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Period" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell01}">
                                                            <Label
                                                                x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                Style="{DynamicResource LabelCellDataGrid01}"
                                                                Text="{Binding PaymentPeriod}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Start" MappingName="TermStartAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Start" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell02}">
                                                            <Label
                                                                x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                Style="{DynamicResource LabelCellDataGrid02}"
                                                                Text="{Binding TermStartAmountRounded}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Growth" MappingName="TermGrowthAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Growth" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell03}">
                                                            <Label
                                                                x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                Style="{DynamicResource LabelCellDataGrid03}"
                                                                Text="{Binding TermGrowthAmountRounded}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Deduction" MappingName="TermExpenseDeductionAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Deduction" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell04}">
                                                            <Label
                                                                x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                Style="{DynamicResource LabelCellDataGrid04}"
                                                                Text="{Binding TermAdjustmentAmountRounded}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Sum" MappingName="IncomeExpenseAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Sum" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell05}">
                                                            <Label
                                                                x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                Style="{DynamicResource LabelCellDataGrid05}"
                                                                Text="{Binding IncomeExpenseAmountRounded}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>
                                        </datagrid:SfDataGrid.Columns>
                                    </datagrid:SfDataGrid>
                                </Grid>

                                <!--  Scroll hint  -->
                                <Label
                                    Margin="0,8,0,20"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    HorizontalOptions="Center"
                                    Opacity="0.4"
                                    Text="↑ Scroll up to adjust settings · Swipe table to see all columns ↓"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

            </tabView:SfTabView>

            <!--  Loading overlay — covers content while loading  -->
            <Grid IsVisible="{Binding IsPageBusy}"
                  BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                  Opacity="0.85"
                  InputTransparent="False">
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12">
                    <ActivityIndicator
                        IsRunning="{Binding IsPageBusy}"
                        Color="{DynamicResource LoanAppAppShellFgColor}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Loading..."
                        TextColor="{DynamicResource LoanAppPrimaryTextColor}"
                        FontSize="{StaticResource FontSizeMedium}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>