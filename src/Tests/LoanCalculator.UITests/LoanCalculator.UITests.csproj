<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>LoanCalculator.UITests</RootNamespace>

    <!--
      These tests drive a real simulator/emulator over Appium, so they are slow and
      require external tooling. They are excluded from a plain `dotnet test` over the
      solution and must be run explicitly (see run-uitests.sh / README.md).
    -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.2.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!--
    No ProjectReference to the MAUI app on purpose: these tests talk to an installed
    binary through Appium and must not drag the MAUI workload into a host-only build.
  -->

</Project>
