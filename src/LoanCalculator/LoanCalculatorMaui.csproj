<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- On Windows: include Android and Windows (iOS requires a Mac build host) -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
			net10.0-android36.0;net10.0-windows10.0.19041.0
		</TargetFrameworks>

		<!-- On non-Windows (Mac/Linux): include Android for emulator testing -->
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">
			net10.0-android36.0;net10.0-ios26.5;net10.0-maccatalyst
		</TargetFrameworks>
		
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>LoanCalculatorMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Loan Affordability Calculator</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.pj.loan.afford.calc</ApplicationId>

		<!-- Versions - update per platform independently before each store release -->
		<ApplicationDisplayVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">1.12.0</ApplicationDisplayVersion>
		<ApplicationDisplayVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">1.12.0</ApplicationDisplayVersion>
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">1</ApplicationVersion>
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<DefaultLanguage>en-au</DefaultLanguage>
		<MauiVersion>10.0.90</MauiVersion>

		<AndroidPackageFormat Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormat>
		<AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
	</PropertyGroup>

	<!-- Windows (UAP) Configurations-->
	<!--<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'">
		<TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion> 
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion> 
	</PropertyGroup>-->

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
		<None Include="Resources\AppIcon\appiconfg.png">
			<Pack>true</Pack>
			<PackagePath>Resources\AppIcon\</PackagePath>
		</None>
		<Content Include="Resources\Splash\splash.png">
			<Pack>true</Pack>
			<PackagePath>Resources\Splash\</PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<!--End of Windows (UAP)-->

	<!-- Android Release signing (Play Store AAB) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and ($(TargetFramework.StartsWith('net10.0-android')))">
	  <AndroidKeyStore>true</AndroidKeyStore>
	  <AndroidSigningKeyStore>catholicsaints.keystore</AndroidSigningKeyStore>
	  <AndroidSigningKeyAlias>keyalias.alias</AndroidSigningKeyAlias>
	  <AndroidSigningStorePass>CatholicSaintsPassword@01</AndroidSigningStorePass>
	  <AndroidSigningKeyPass>CatholicSaintsPassword@01</AndroidSigningKeyPass>
	</PropertyGroup>

	<!-- iOS Debug (simulator) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net10.0-ios26.5'">
		<RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
		<CodesignKey>-</CodesignKey>
		<CodesignProvision></CodesignProvision>
		<CodesignEntitlements></CodesignEntitlements>
		<MtouchLink>None</MtouchLink>
		<ValidateXcodeVersion>false</ValidateXcodeVersion>
	</PropertyGroup>

	<!-- iOS Release (App Store) -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios26.5' and '$(Configuration)' == 'Release'">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<CodesignKey>iPhone Distribution</CodesignKey>
		<CodesignProvision>LoanAffordabilityCalculator</CodesignProvision>

		<MauiEnableLinking>false</MauiEnableLinking>
		<PublishTrimmed>false</PublishTrimmed>
		<UseInterpreter>true</UseInterpreter>
		<Optimize>False</Optimize>
		<MtouchLink>None</MtouchLink>
		<MtouchExtraArgs>--optimize:-static-block-to-delegate-lookup</MtouchExtraArgs>
		<ValidateXcodeVersion>false</ValidateXcodeVersion>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
	  <CodesignKey>iPhone Developer</CodesignKey>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#E0F7F7" />

		<!-- Splash Screen — centered app-icon glyph on the dark brand color. Matches the
		     MAUI SplashPage (centered logo on #0A1A20) so the native launch screen flows
		     seamlessly into it, with no white/black flash and no dated wide banner. -->
		<MauiSplashScreen Include="Resources\AppIcon\appiconfg.png" Color="#0A1A20" BaseSize="160,160" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Note: MauiFont puts font files in the app bundle root on all platforms in .NET 10,
		     making them accessible via FileSystem.OpenAppPackageFileAsync. Do NOT add a
		     duplicate MauiAsset entry for the same font files — in .NET 10 this causes the
		     font to be silently dropped from the bundle entirely. -->

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Remove="Extensions\Data\Theme.CommonDataGridStyles.xaml" />
	  <MauiXaml Remove="Extensions\Data\Theme.CommonStyles.xaml" />
	  <MauiXaml Remove="Extensions\Data\Theme.Dark.xaml" />
	  <MauiXaml Remove="Extensions\Data\Theme.Forest.xaml" />
	  <MauiXaml Remove="Extensions\Data\Theme.Light.xaml" />
	  <MauiXaml Remove="Extensions\Data\Theme.Warm.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Extensions\DisclaimerData\AppLaunchDisclaimerData.txt" />
	  <None Remove="Resources\AppIcon\appiconfg.png" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Extensions\Data\Theme.Warm.xaml">
	    <Generator></Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Extensions\Data\Theme.Forest.xaml">
	    <Generator></Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Extensions\Data\Theme.CommonDataGridStyles.xaml">
	    <Generator></Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Extensions\Data\Theme.CommonStyles.xaml">
	    <Generator></Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Extensions\Data\Theme.Dark.xaml">
	    <Generator></Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Extensions\Data\Theme.Light.xaml">
	    <Generator></Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Extensions\DisclaimerData\AppLaunchDisclaimerData.html" />
	  <EmbeddedResource Include="Extensions\DisclaimerData\AppLaunchDisclaimerData.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
		<PackageReference Include="Sentry.Maui" Version="5.9.0" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.152.1" />
		<PackageReference Include="Syncfusion.Maui.Core" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Expander" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Popup" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.ProgressBar" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.DataGrid" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.TabView" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.ListView" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Buttons" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Sliders" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Inputs" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Maui.Charts" Version="33.2.6" />
		<PackageReference Include="Syncfusion.Pdf.NET" Version="33.2.6" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\LoanCalculator.Core\LoanCalculator.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Controls\DisclaimerBannerView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\InsightsItemView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\InAppPurchaseView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\PopupDisclaimerView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Resources\Styles\Colors.xaml">
	    <Generator></Generator>
	  </MauiXaml>
	  <MauiXaml Update="Resources\Styles\Styles.xaml">
	    <Generator></Generator>
	  </MauiXaml>
	  <MauiXaml Update="View\ExpenseView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="View\IncomeView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="View\LoanView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\ThreeColumnBorderedContentView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="View\SettingsView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Platforms\MacCatalyst\Services\" />
	  <Folder Include="Platforms\Tizen\Services\" />
	</ItemGroup>

	<ItemGroup>
	  <MauiAsset Include="Resources\AppIcon\appiconfg.png" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Controls\InAppPurchaseView.xaml.cs">
	    <DependentUpon>PremiumBuyView.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>
</Project>
