<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="LoanCalculatorMaui.Controls.PopupDisclaimerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup">
    <sfPopup:SfPopup
        Padding="10,25,10,20"
        AcceptButtonText="Accept"
        AnimationMode="Zoom"
        AppearanceMode="OneButton"
        BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
        IsFullScreen="True"
        IsOpen="{Binding IsPopupRequired}"
        ShowCloseButton="False"
        ShowFooter="True"
        ShowHeader="True"
        StaysOpen="True">
        <sfPopup:SfPopup.HeaderTemplate>
            <DataTemplate>
                <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
                    <Label
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="{DynamicResource DefaultFontFamily}"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        Text="Disclaimer"
                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                        VerticalTextAlignment="Center" />
                </Grid>
            </DataTemplate>
        </sfPopup:SfPopup.HeaderTemplate>
        <sfPopup:SfPopup.FooterTemplate>
            <DataTemplate>
                <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
                    <Button
                        BackgroundColor="Transparent"
                        Command="{Binding PopupAcceptCommand}"
                        FontAttributes="Bold"
                        FontFamily="{DynamicResource DefaultFontFamily}"
                        FontSize="16"
                        IsVisible="{Binding IsActive}"
                        Text="Accept"
                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                </Grid>
            </DataTemplate>
        </sfPopup:SfPopup.FooterTemplate>
        <sfPopup:SfPopup.ContentTemplate>
            <DataTemplate>
                <Grid>
                    <ScrollView>
                        <WebView x:Name="htmlWebViewer">
                            <WebView.Source>
                                <HtmlWebViewSource Html="{Binding AppLaunchDisclaimerData}" />
                            </WebView.Source>
                        </WebView>
                    </ScrollView>
                </Grid>
            </DataTemplate>
        </sfPopup:SfPopup.ContentTemplate>
    </sfPopup:SfPopup>
</ContentView>
