<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="thisPage"
    x:Class="LoanCalculatorMaui.View.WhatIfView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:customControls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:primaryModels="clr-namespace:LoanCalculator.Core.Models.ViewModels.PrimaryModels;assembly=LoanCalculator.Core"
    Title="What If"
    x:DataType="primaryModels:WhatIfViewModel">
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
            <customControls:InAppPurchaseView x:Name="PremiumWindow" />

            <ScrollView>
                <VerticalStackLayout Padding="16,16,16,32" Spacing="0">

                    <!--  Page title  -->
                    <Label
                        Margin="0,0,0,2"
                        FontAttributes="Bold"
                        FontSize="{StaticResource FontSizeHeading}"
                        Text="What If?"
                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                    <Label
                        Margin="0,0,0,20"
                        FontSize="{StaticResource FontSizeSmall}"
                        Opacity="0.55"
                        Text="Explore scenarios based on your current loan"
                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                    <!--  No data placeholder  -->
                    <Border
                        IsVisible="{Binding HasNoLoanData}"
                        Margin="0,20,0,0"
                        Padding="20"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label
                                FontSize="{StaticResource FontSizeLarge}"
                                HorizontalTextAlignment="Center"
                                Text="No loan data yet"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            <Label
                                FontSize="{StaticResource FontSizeBody}"
                                HorizontalTextAlignment="Center"
                                Opacity="0.6"
                                Text="Enter your asset value and loan details on the Loan tab first."
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  ── Card 1: Rate Change ────────────────────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <!--  Teal accent bar  -->
                            <BoxView
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource LoanAppChartColor1}"
                                CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">

                                <!--  Header  -->
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeMedium}"
                                    Text="Rate Change Impact"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label
                                    Margin="0,-6,0,0"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.6"
                                    Text="What happens if rates move?"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  Stepper pill  -->
                                <Border
                                    Padding="4,2"
                                    BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                                    HorizontalOptions="Start"
                                    StrokeShape="RoundRectangle 24"
                                    StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Margin="6,0,0,0"
                                            Opacity="0.7"
                                            Text="Change:"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                        <Button
                                            BackgroundColor="Transparent"
                                            Clicked="OnRateDeltaDecrease"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeXL}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            WidthRequest="36" Text="−" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeLarge}"
                                            HorizontalTextAlignment="Center"
                                            MinimumWidthRequest="72"
                                            Text="{Binding RateChangeDelta, StringFormat='{0:+0.00;-0.00;0.00}%'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Button
                                            BackgroundColor="Transparent"
                                            Clicked="OnRateDeltaIncrease"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeXL}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            WidthRequest="36" Text="+" />
                                    </HorizontalStackLayout>
                                </Border>

                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  Impact tiles  -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--  New Rate  -->
                                    <Border Grid.Column="0" Padding="10,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="NEW RATE" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" Text="{Binding RateChangeNewRate}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <!--  Monthly change — tinted amber (increase) or teal (saving)  -->
                                    <Border Grid.Column="1" Padding="10,8" BackgroundColor="{DynamicResource LoanAppChartColor2}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding RateChangeDiffIsPositive}" TargetType="Border" Value="False">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor1}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.85" Text="MONTHLY CHANGE" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor2}">
                                                <Label.Triggers>
                                                    <DataTrigger Binding="{Binding RateChangeDiffIsPositive}" TargetType="Label" Value="False">
                                                        <Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" Text="{Binding RateChangeMonthlyDiff}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor2}">
                                                <Label.Triggers>
                                                    <DataTrigger Binding="{Binding RateChangeDiffIsPositive}" TargetType="Label" Value="False">
                                                        <Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="NEW MONTHLY" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="{Binding RateChangeMonthlyRepayment}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="TOTAL INTEREST" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="{Binding RateChangeTotalInterest}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!--  Chart: Annual principal/interest breakdown + balance at new rate  -->
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="8,8,8,4"
                                    BackgroundColor="{DynamicResource LoanAppChartCardBackground}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="220"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Label Text="Annual Repayment" HorizontalOptions="Start" FontSize="{StaticResource FontSizeXS}" TextColor="{DynamicResource LoanAppChartAxisTextColor}" Opacity="0.7"/>
                                            <Label Text="Remaining Balance" HorizontalOptions="End" FontSize="{StaticResource FontSizeXS}" TextColor="{DynamicResource LoanAppChartAxisTextColor}" Opacity="0.7"/>
                                        </Grid>
                                        <chart:SfCartesianChart Grid.Row="1">
                                            <chart:SfCartesianChart.Legend>
                                                <chart:ChartLegend Placement="Bottom" LabelStyle="{chart:ChartLegendLabelStyle TextColor={DynamicResource LoanAppChartLegendTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.Legend>
                                            <chart:SfCartesianChart.XAxes>
                                                <chart:CategoryAxis Name="rateXAxis" ShowMajorGridLines="False" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis Name="rateLeftAxis" RangePadding="None" LabelCreated="OnWhatIfAxisLabelCreated" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                                <chart:NumericalAxis Name="rateRightAxis" CrossAxisName="rateXAxis" CrossesAt="1.7976931348623157E+308" RenderNextToCrossingValue="True" ShowMajorGridLines="False" LabelCreated="OnWhatIfAxisLabelCreated" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.YAxes>
                                            <chart:StackingColumnSeries ItemsSource="{Binding RateChangePrincipalData}" XBindingPath="Name" YBindingPath="Value" YAxisName="rateLeftAxis" Label="Principal" LegendIcon="Rectangle" Fill="{DynamicResource LoanAppChartColorSeries1}"/>
                                            <chart:StackingColumnSeries ItemsSource="{Binding RateChangeInterestData}" XBindingPath="Name" YBindingPath="Value" YAxisName="rateLeftAxis" Label="Interest" LegendIcon="Rectangle" Fill="{DynamicResource LoanAppChartColorSeries2}"/>
                                            <chart:SplineSeries ItemsSource="{Binding RateChangeBalanceData}" XBindingPath="Name" YBindingPath="Value" YAxisName="rateRightAxis" StrokeWidth="2.5" Label="Balance" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries3}"/>
                                        </chart:SfCartesianChart>
                                    </Grid>
                                </Border>

                                <!--  Affordability headroom — only when income/expense data exists  -->
                                <Border
                                    IsVisible="{Binding RateChangeShowHeadroom}"
                                    Padding="10,8"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{DynamicResource LoanAppChartColor1}">
                                    <Border.Triggers>
                                        <DataTrigger Binding="{Binding RateChangeHeadroomStatus}" TargetType="Border" Value="0">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor2}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RateChangeHeadroomStatus}" TargetType="Border" Value="1">
                                            <Setter Property="BackgroundColor" Value="#CC3333" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Text="{Binding RateChangeHeadroom}"
                                        TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding RateChangeHeadroomStatus}" TargetType="Label" Value="0">
                                                <Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor2}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RateChangeHeadroomStatus}" TargetType="Label" Value="1">
                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ── Card 2: Extra Repayment ────────────────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <!--  Amber accent bar  -->
                            <BoxView
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource LoanAppChartColor2}"
                                CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">

                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="Extra Repayment Savings" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label Margin="0,-6,0,0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="How much time and interest could you save?" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  Stepper pill  -->
                                <Border
                                    Padding="4,2"
                                    BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                                    HorizontalOptions="Start"
                                    StrokeShape="RoundRectangle 24"
                                    StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Margin="6,0,0,0"
                                            Opacity="0.7"
                                            Text="Extra/mo:"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                        <Button
                                            BackgroundColor="Transparent"
                                            Padding="0"
                                            Clicked="OnExtraRepaymentDecrease"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeXL}"
                                            TextColor="{DynamicResource LoanAppChartColor2}"
                                            WidthRequest="36" Text="−" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeLarge}"
                                            HorizontalTextAlignment="Center"
                                            MinimumWidthRequest="72"
                                            Text="{Binding ExtraRepaymentMonthly, StringFormat='{0:N0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor2}"
                                            VerticalOptions="Center" />
                                        <Button
                                            BackgroundColor="Transparent"
                                            Padding="0"
                                            Clicked="OnExtraRepaymentIncrease"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeXL}"
                                            TextColor="{DynamicResource LoanAppChartColor2}"
                                            WidthRequest="36" Text="+" />
                                    </HorizontalStackLayout>
                                </Border>

                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,10" BackgroundColor="{DynamicResource LoanAppChartColor1}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.85" Text="TIME SAVED" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" Text="{Binding ExtraRepaymentTimeSaved}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,10" BackgroundColor="{DynamicResource LoanAppChartColor1}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.85" Text="INTEREST SAVED" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" Text="{Binding ExtraRepaymentInterestSaved}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!--  Chart: Loan Balance Over Time — standard vs accelerated  -->
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="8,8,8,4"
                                    BackgroundColor="{DynamicResource LoanAppChartCardBackground}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Text="Loan Balance Over Time" FontSize="{StaticResource FontSizeXS}" TextColor="{DynamicResource LoanAppChartAxisTextColor}" Opacity="0.7" Margin="0,0,0,2"/>
                                        <chart:SfCartesianChart Grid.Row="1">
                                            <chart:SfCartesianChart.Legend>
                                                <chart:ChartLegend LabelStyle="{chart:ChartLegendLabelStyle TextColor={DynamicResource LoanAppChartLegendTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.Legend>
                                            <chart:SfCartesianChart.XAxes>
                                                <chart:NumericalAxis ShowMajorGridLines="False" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis RangePadding="None" LabelCreated="OnWhatIfAxisLabelCreated" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.YAxes>
                                            <chart:SplineSeries ItemsSource="{Binding ExtraRepaymentOriginalBalanceData}" XBindingPath="Name" YBindingPath="Value" Fill="{DynamicResource LoanAppChartColorSeries1}" StrokeWidth="2.5" Label="Standard"/>
                                            <chart:SplineSeries ItemsSource="{Binding ExtraRepaymentAcceleratedBalanceData}" XBindingPath="Name" YBindingPath="Value" Fill="{DynamicResource LoanAppChartColorSeries2}" StrokeWidth="2.5" Label="With Extra"/>
                                        </chart:SfCartesianChart>
                                    </Grid>
                                </Border>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ── Card 3: Loan Term Comparison ──────────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor3}" CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">
                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="Loan Term Comparison" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label Margin="0,-6,0,0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="Same loan, different terms  ·  highlighted = yours" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Col A  -->
                                    <Border Grid.Column="0" Padding="6,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding TermIsCurrentColA}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor3}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="{Binding TermColALabel}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColA}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding TermColAMonthly}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColA}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.65" Text="{Binding TermColAInterest}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColA}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="1" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.45" Text="interest" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColA}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="0.75" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" IsVisible="{Binding TermIsCurrentColA}" Text="YOUR TERM" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor3}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!--  Col B  -->
                                    <Border Grid.Column="1" Padding="6,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding TermIsCurrentColB}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor3}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="{Binding TermColBLabel}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColB}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding TermColBMonthly}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColB}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.65" Text="{Binding TermColBInterest}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColB}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="1" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.45" Text="interest" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColB}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="0.75" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" IsVisible="{Binding TermIsCurrentColB}" Text="YOUR TERM" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor3}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!--  Col C  -->
                                    <Border Grid.Column="2" Padding="6,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding TermIsCurrentColC}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor3}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="{Binding TermColCLabel}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColC}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding TermColCMonthly}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColC}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.65" Text="{Binding TermColCInterest}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColC}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="1" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.45" Text="interest" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding TermIsCurrentColC}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="0.75" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" IsVisible="{Binding TermIsCurrentColC}" Text="YOUR TERM" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor3}" />
                                        </VerticalStackLayout>
                                    </Border>

                                </Grid>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ── Card 4: Deposit Scenarios ──────────────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor1}" CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">
                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="Deposit Scenarios" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label Margin="0,-6,0,0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="Impact of different deposit percentages  ·  highlighted = yours" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Col A: lower deposit  -->
                                    <Border Grid.Column="0" Padding="6,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="{Binding DepositColALabel}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.65" Text="{Binding DepositColALoan}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding DepositColAMonthly}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!--  Col B: YOUR DEPOSIT — always highlighted  -->
                                    <Border Grid.Column="1" Padding="6,8" BackgroundColor="{DynamicResource LoanAppChartColor1}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="{Binding DepositColBLabel}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="{Binding DepositColBLoan}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding DepositColBMonthly}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" Text="YOUR DEPOSIT" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!--  Col C: higher deposit (dimmed/unavailable when already at max)  -->
                                    <Border Grid.Column="2" Padding="6,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding DepositColCAvailable}" TargetType="Border" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="{Binding DepositColCLabel}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.65" Text="{Binding DepositColCLoan}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding DepositColCMonthly}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" IsVisible="False" Text="MAX DEPOSIT" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers>
                                                    <DataTrigger Binding="{Binding DepositColCAvailable}" TargetType="Label" Value="False">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>

                                </Grid>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ── Card 5: Lump Sum Payment ──────────────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor2}" CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">

                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="Lump Sum Payment" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label Margin="0,-6,0,0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="What if you put a windfall directly onto your loan?" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  Stepper pill  -->
                                <Border
                                    Padding="4,2"
                                    BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                                    HorizontalOptions="Start"
                                    StrokeShape="RoundRectangle 24"
                                    StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeSmall}" Margin="6,0,0,0" Opacity="0.7" Text="Amount:" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                        <Button BackgroundColor="Transparent" Padding="0" Clicked="OnLumpSumDecrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColor2}" WidthRequest="36" Text="−" />
                                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" HorizontalTextAlignment="Center" MinimumWidthRequest="96" Text="{Binding LumpSumAmount, StringFormat='{0:N0}'}" TextColor="{DynamicResource LoanAppChartColor2}" VerticalOptions="Center" />
                                        <Button BackgroundColor="Transparent" Padding="0" Clicked="OnLumpSumIncrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColor2}" WidthRequest="36" Text="+" />
                                    </HorizontalStackLayout>
                                </Border>

                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,10" BackgroundColor="{DynamicResource LoanAppChartColor1}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.85" Text="TIME SAVED" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" Text="{Binding LumpSumTimeSaved}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,10" BackgroundColor="{DynamicResource LoanAppChartColor1}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.85" Text="INTEREST SAVED" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" Text="{Binding LumpSumInterestSaved}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!--  Chart: Balance payoff trajectory — standard vs after lump sum  -->
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="8,8,8,4"
                                    BackgroundColor="{DynamicResource LoanAppChartCardBackground}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Text="Loan Balance Over Time" FontSize="{StaticResource FontSizeXS}" TextColor="{DynamicResource LoanAppChartAxisTextColor}" Opacity="0.7" Margin="0,0,0,2"/>
                                        <chart:SfCartesianChart Grid.Row="1">
                                            <chart:SfCartesianChart.Legend>
                                                <chart:ChartLegend Placement="Bottom" LabelStyle="{chart:ChartLegendLabelStyle TextColor={DynamicResource LoanAppChartLegendTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.Legend>
                                            <chart:SfCartesianChart.XAxes>
                                                <chart:NumericalAxis ShowMajorGridLines="False" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis RangePadding="None" LabelCreated="OnWhatIfAxisLabelCreated" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.YAxes>
                                            <chart:SplineSeries ItemsSource="{Binding LumpSumOriginalBalanceData}" XBindingPath="Name" YBindingPath="Value" StrokeWidth="2.5" Label="Standard" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries1}"/>
                                            <chart:SplineSeries ItemsSource="{Binding LumpSumReducedBalanceData}" XBindingPath="Name" YBindingPath="Value" StrokeWidth="2.5" Label="With Lump Sum" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries2}"/>
                                        </chart:SfCartesianChart>
                                    </Grid>
                                </Border>

                                <Border Padding="10,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="NEW LOAN BALANCE" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="{Binding LumpSumNewBalance}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ── Card 6: Repayment Frequency ───────────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor3}" CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">

                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="Repayment Frequency" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label Margin="0,-6,0,0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="Compare monthly, fortnightly and weekly  ·  highlighted = yours" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Monthly  -->
                                    <Border Grid.Column="0" Padding="6,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding FreqIsMonthly}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor3}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="Monthly" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsMonthly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding FreqMonthlyPayment}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsMonthly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.65" Text="{Binding FreqMonthlyTimeSaved}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsMonthly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="1" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.45" Text="{Binding FreqMonthlyIntSaved}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsMonthly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="0.75" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" IsVisible="{Binding FreqIsMonthly}" Text="YOUR FREQUENCY" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor3}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!--  Fortnightly  -->
                                    <Border Grid.Column="1" Padding="6,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding FreqIsFortnightly}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor3}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="Fortnightly" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsFortnightly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding FreqFortPayment}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsFortnightly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.65" Text="{Binding FreqFortTimeSaved}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsFortnightly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="1" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.45" Text="{Binding FreqFortIntSaved}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsFortnightly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="0.75" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" IsVisible="{Binding FreqIsFortnightly}" Text="YOUR FREQUENCY" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor3}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!--  Weekly  -->
                                    <Border Grid.Column="2" Padding="6,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding FreqIsWeekly}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor3}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Text="Weekly" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsWeekly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding FreqWeeklyPayment}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsWeekly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.65" Text="{Binding FreqWeeklyTimeSaved}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsWeekly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="1" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontSize="{StaticResource FontSizeSmall}" HorizontalTextAlignment="Center" Opacity="0.45" Text="{Binding FreqWeeklyIntSaved}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                <Label.Triggers><DataTrigger Binding="{Binding FreqIsWeekly}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor3}" /><Setter Property="Opacity" Value="0.75" /></DataTrigger></Label.Triggers>
                                            </Label>
                                            <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" IsVisible="{Binding FreqIsWeekly}" Text="YOUR FREQUENCY" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor3}" />
                                        </VerticalStackLayout>
                                    </Border>

                                </Grid>

                                <!--  Chart: Balance payoff trajectory across frequencies  -->
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="8,8,8,4"
                                    BackgroundColor="{DynamicResource LoanAppChartCardBackground}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Text="Loan Balance Over Time" FontSize="{StaticResource FontSizeXS}" TextColor="{DynamicResource LoanAppChartAxisTextColor}" Opacity="0.7" Margin="0,0,0,2"/>
                                        <chart:SfCartesianChart Grid.Row="1">
                                            <chart:SfCartesianChart.Legend>
                                                <chart:ChartLegend Placement="Bottom" LabelStyle="{chart:ChartLegendLabelStyle TextColor={DynamicResource LoanAppChartLegendTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.Legend>
                                            <chart:SfCartesianChart.XAxes>
                                                <chart:NumericalAxis ShowMajorGridLines="False" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis RangePadding="None" LabelCreated="OnWhatIfAxisLabelCreated" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.YAxes>
                                            <chart:SplineSeries ItemsSource="{Binding FreqMonthlyBalanceData}" XBindingPath="Name" YBindingPath="Value" StrokeWidth="2.5" Label="Monthly" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries1}"/>
                                            <chart:SplineSeries ItemsSource="{Binding FreqFortBalanceData}" XBindingPath="Name" YBindingPath="Value" StrokeWidth="2.5" Label="Fortnightly" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries2}"/>
                                            <chart:SplineSeries ItemsSource="{Binding FreqWeeklyBalanceData}" XBindingPath="Name" YBindingPath="Value" StrokeWidth="2.5" Label="Weekly" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries3}"/>
                                        </chart:SfCartesianChart>
                                    </Grid>
                                </Border>

                                <Button
                                    Text="ⓘ  How does repayment frequency save time?"
                                    Clicked="OnFrequencyInfoTapped"
                                    BackgroundColor="Transparent"
                                    BorderColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                    BorderWidth="0.5"
                                    CornerRadius="8"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                    Opacity="0.6"
                                    Padding="10,6"
                                    HorizontalOptions="Start" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ── Card 7: Offset Account ────────────────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor1}" CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">

                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="Offset Account" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label Margin="0,-6,0,0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="How much does your savings offset reduce your interest?" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  Stepper pill  -->
                                <Border
                                    Padding="4,2"
                                    BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                                    HorizontalOptions="Start"
                                    StrokeShape="RoundRectangle 24"
                                    StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeSmall}" Margin="6,0,0,0" Opacity="0.7" Text="Balance:" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                        <Button BackgroundColor="Transparent" Padding="0" Clicked="OnOffsetDecrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColor1}" WidthRequest="36" Text="−" />
                                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" HorizontalTextAlignment="Center" MinimumWidthRequest="96" Text="{Binding OffsetBalance, StringFormat='{0:N0}'}" TextColor="{DynamicResource LoanAppChartColor1}" VerticalOptions="Center" />
                                        <Button BackgroundColor="Transparent" Padding="0" Clicked="OnOffsetIncrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColor1}" WidthRequest="36" Text="+" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border
                                    Padding="4,2"
                                    Margin="0,4,0,0"
                                    BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                                    HorizontalOptions="Start"
                                    StrokeShape="RoundRectangle 24"
                                    StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeSmall}" Margin="6,0,0,0" Opacity="0.7" Text="Rate:" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                        <Button BackgroundColor="Transparent" Padding="0" Clicked="OnOffsetRateDecrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColor1}" WidthRequest="36" Text="−" />
                                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" HorizontalTextAlignment="Center" MinimumWidthRequest="72" Text="{Binding OffsetRate, StringFormat='{0:0.00}%'}" TextColor="{DynamicResource LoanAppChartColor1}" VerticalOptions="Center" />
                                        <Button BackgroundColor="Transparent" Padding="0" Clicked="OnOffsetRateIncrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColor1}" WidthRequest="36" Text="+" />
                                    </HorizontalStackLayout>
                                </Border>

                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,10" BackgroundColor="{DynamicResource LoanAppChartColor1}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.85" Text="TIME SAVED" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" Text="{Binding OffsetTimeSaved}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,10" BackgroundColor="{DynamicResource LoanAppChartColor1}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.85" Text="INTEREST SAVED" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" Text="{Binding OffsetInterestSaved}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <Border Padding="10,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="MONTHLY INTEREST SAVING" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="{Binding OffsetMonthlySaving}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.5" Text="{Binding OffsetRateNote}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Chart: Balance payoff trajectory — without vs with offset  -->
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="8,8,8,4"
                                    BackgroundColor="{DynamicResource LoanAppChartCardBackground}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="200"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Text="Loan Balance Over Time" FontSize="{StaticResource FontSizeXS}" TextColor="{DynamicResource LoanAppChartAxisTextColor}" Opacity="0.7" Margin="0,0,0,2"/>
                                        <chart:SfCartesianChart Grid.Row="1">
                                            <chart:SfCartesianChart.Legend>
                                                <chart:ChartLegend Placement="Bottom" LabelStyle="{chart:ChartLegendLabelStyle TextColor={DynamicResource LoanAppChartLegendTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.Legend>
                                            <chart:SfCartesianChart.XAxes>
                                                <chart:NumericalAxis ShowMajorGridLines="False" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis RangePadding="None" LabelCreated="OnWhatIfAxisLabelCreated" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.YAxes>
                                            <chart:SplineSeries ItemsSource="{Binding OffsetWithoutBalanceData}" XBindingPath="Name" YBindingPath="Value" StrokeWidth="2.5" Label="No Offset" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries1}"/>
                                            <chart:SplineSeries ItemsSource="{Binding OffsetWithBalanceData}" XBindingPath="Name" YBindingPath="Value" StrokeWidth="2.5" Label="With Offset" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries2}"/>
                                        </chart:SfCartesianChart>
                                    </Grid>
                                </Border>

                                <Button
                                    Text="ⓘ  How does an offset account work?"
                                    Clicked="OnOffsetInfoTapped"
                                    BackgroundColor="Transparent"
                                    BorderColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                    BorderWidth="0.5"
                                    CornerRadius="8"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                    Opacity="0.6"
                                    Padding="10,6"
                                    HorizontalOptions="Start" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ── Card 8: Affordability Stress Test ────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" BackgroundColor="#CC3333" CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">

                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="Affordability Stress Test" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label Margin="0,-6,0,0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="At what rate does this loan become unaffordable?" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  No income/expense data yet  -->
                                <Border
                                    IsVisible="{Binding StressTestUnavailable}"
                                    Padding="10,8"
                                    BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Label
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Opacity="0.7"
                                        Text="Record your income &amp; expenses to unlock this insight"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </Border>

                                <!--  Stress test results  -->
                                <VerticalStackLayout IsVisible="{Binding StressTestAvailable}" Spacing="10">
                                    <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="BREAKS EVEN AT" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" Text="{Binding StressTestBreakEvenRate}" TextColor="#CC3333" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="YOUR BUFFER" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" Text="{Binding StressTestRateBuffer}" TextColor="{DynamicResource LoanAppChartColor1}">
                                                <Label.Triggers>
                                                    <DataTrigger Binding="{Binding StressTestRisk}" TargetType="Label" Value="0">
                                                        <Setter Property="TextColor" Value="{DynamicResource LoanAppChartColor2}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StressTestRisk}" TargetType="Label" Value="1">
                                                        <Setter Property="TextColor" Value="#CC3333" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <VerticalStackLayout Spacing="2">
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="CURRENT MONTHLY SURPLUS" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="{Binding StressTestCurrentSurplus}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>

                                    <!--  Chart: Rate Capacity  -->
                                    <Border
                                        Margin="0,2,0,0"
                                        Padding="8,8,8,4"
                                        BackgroundColor="{DynamicResource LoanAppChartCardBackground}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="160"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Row="0" Text="Rate Capacity" FontSize="{StaticResource FontSizeXS}" TextColor="{DynamicResource LoanAppChartAxisTextColor}" Opacity="0.7" Margin="0,0,0,2"/>
                                            <chart:SfCartesianChart Grid.Row="1">
                                                <chart:SfCartesianChart.XAxes>
                                                    <chart:CategoryAxis ShowMajorGridLines="False" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                                </chart:SfCartesianChart.XAxes>
                                                <chart:SfCartesianChart.YAxes>
                                                    <chart:NumericalAxis RangePadding="None" LabelCreated="OnWhatIfRateAxisLabelCreated" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                                </chart:SfCartesianChart.YAxes>
                                                <chart:ColumnSeries ItemsSource="{Binding StressTestChartData}" XBindingPath="Name" YBindingPath="Value" Fill="#CC3333"/>
                                            </chart:SfCartesianChart>
                                        </Grid>
                                    </Border>

                                    <!--  Explainer info button  -->
                                    <Button
                                        Text="ⓘ  How is this calculated?"
                                        Clicked="OnStressTestInfoTapped"
                                        BackgroundColor="Transparent"
                                        BorderColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        BorderWidth="0.5"
                                        CornerRadius="8"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        Opacity="0.6"
                                        Padding="10,6"
                                        HorizontalOptions="Start" />

                                    <!--  Risk banner  -->
                                    <Border Padding="10,8" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource LoanAppChartColor1}">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding StressTestRisk}" TargetType="Border" Value="0">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColor2}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StressTestRisk}" TargetType="Border" Value="1">
                                                <Setter Property="BackgroundColor" Value="#CC3333" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding StressTestRisk}" TargetType="Label" Value="-1">
                                                    <Setter Property="Text" Value="Comfortable — your loan is well within budget" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StressTestRisk}" TargetType="Label" Value="0">
                                                    <Setter Property="Text" Value="Moderate risk — a small rate rise will stretch your budget" />
                                                    <Setter Property="TextColor" Value="{DynamicResource LoanAppChartDataMarkerTextColor2}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StressTestRisk}" TargetType="Label" Value="1">
                                                    <Setter Property="Text" Value="At risk — rates are close to your affordability limit" />
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  ── Card 9: Combined Strategy ────────────────────  -->
                    <Border
                        IsVisible="{Binding HasLoanData}"
                        Margin="0,0,0,14"
                        Padding="0"
                        BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColorSeries3}" CornerRadius="12,0,12,0" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,14,14,16" Spacing="10">

                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeMedium}" Text="Combined Strategy" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label Margin="0,-6,0,0" FontSize="{StaticResource FontSizeSmall}" Opacity="0.6" Text="Combine multiple strategies and see the full impact" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  Frequency row  -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding CombinedUseFrequency}" Color="{DynamicResource LoanAppChartColorSeries3}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="Repayment Frequency" FontSize="{StaticResource FontSizeSmall}" Opacity="0.8" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Border Padding="10,5" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{DynamicResource LoanAppChartColorSeries3}" BackgroundColor="Transparent">
                                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCombinedFreqMonthly"/></Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger Binding="{Binding CombinedFrequencyIndex}" TargetType="Border" Value="0">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColorSeries3}"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="Monthly" FontSize="{StaticResource FontSizeSmall}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                    <Label.Triggers>
                                                        <DataTrigger Binding="{Binding CombinedFrequencyIndex}" TargetType="Label" Value="0">
                                                            <Setter Property="TextColor" Value="White"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                            <Border Padding="10,5" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{DynamicResource LoanAppChartColorSeries3}" BackgroundColor="Transparent">
                                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCombinedFreqFortnightly"/></Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger Binding="{Binding CombinedFrequencyIndex}" TargetType="Border" Value="1">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColorSeries3}"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="Fortnightly" FontSize="{StaticResource FontSizeSmall}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                    <Label.Triggers>
                                                        <DataTrigger Binding="{Binding CombinedFrequencyIndex}" TargetType="Label" Value="1">
                                                            <Setter Property="TextColor" Value="White"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                            <Border Padding="10,5" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{DynamicResource LoanAppChartColorSeries3}" BackgroundColor="Transparent">
                                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCombinedFreqWeekly"/></Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger Binding="{Binding CombinedFrequencyIndex}" TargetType="Border" Value="2">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource LoanAppChartColorSeries3}"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="Weekly" FontSize="{StaticResource FontSizeSmall}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                                    <Label.Triggers>
                                                        <DataTrigger Binding="{Binding CombinedFrequencyIndex}" TargetType="Label" Value="2">
                                                            <Setter Property="TextColor" Value="White"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding CombinedFrequencyPayment}" FontSize="{StaticResource FontSizeSmall}" FontAttributes="Bold" TextColor="{DynamicResource LoanAppChartColorSeries3}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!--  Extra repayment row  -->
                                <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding CombinedUseExtra}" Color="{DynamicResource LoanAppChartColorSeries3}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="Extra repay" FontSize="{StaticResource FontSizeSmall}" Opacity="0.8" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Border Grid.Column="2" Padding="2,1" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 20" StrokeThickness="0" HorizontalOptions="Start">
                                        <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Button Text="−" Clicked="OnCombinedExtraDecrease" BackgroundColor="Transparent" Padding="0" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColorSeries3}" WidthRequest="34" />
                                            <Label Text="{Binding CombinedExtraDisplay}" FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" MinimumWidthRequest="80" HorizontalTextAlignment="Center" TextColor="{DynamicResource LoanAppChartColorSeries3}" VerticalOptions="Center" />
                                            <Button Text="+" Clicked="OnCombinedExtraIncrease" BackgroundColor="Transparent" Padding="0" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColorSeries3}" WidthRequest="34" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!--  Lump sum row  -->
                                <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding CombinedUseLumpSum}" Color="{DynamicResource LoanAppChartColorSeries3}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="Lump sum" FontSize="{StaticResource FontSizeSmall}" Opacity="0.8" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Border Grid.Column="2" Padding="2,1" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 20" StrokeThickness="0" HorizontalOptions="Start">
                                        <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Button Text="−" Clicked="OnCombinedLumpDecrease" BackgroundColor="Transparent" Padding="0" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColorSeries3}" WidthRequest="34" />
                                            <Label Text="{Binding CombinedLumpDisplay}" FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" MinimumWidthRequest="80" HorizontalTextAlignment="Center" TextColor="{DynamicResource LoanAppChartColorSeries3}" VerticalOptions="Center" />
                                            <Button Text="+" Clicked="OnCombinedLumpIncrease" BackgroundColor="Transparent" Padding="0" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColorSeries3}" WidthRequest="34" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!--  Offset row  -->
                                <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding CombinedUseOffset}" Color="{DynamicResource LoanAppChartColorSeries3}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="Offset" FontSize="{StaticResource FontSizeSmall}" Opacity="0.8" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Border Padding="2,1" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 20" StrokeThickness="0" HorizontalOptions="Start">
                                            <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Button Text="−" Clicked="OnCombinedOffsetDecrease" BackgroundColor="Transparent" Padding="0" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColorSeries3}" WidthRequest="34" />
                                                <Label Text="{Binding CombinedOffsetDisplay}" FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" MinimumWidthRequest="80" HorizontalTextAlignment="Center" TextColor="{DynamicResource LoanAppChartColorSeries3}" VerticalOptions="Center" />
                                                <Button Text="+" Clicked="OnCombinedOffsetIncrease" BackgroundColor="Transparent" Padding="0" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColorSeries3}" WidthRequest="34" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <!--  Offset interest rate stepper  -->
                                        <Border Padding="2,1" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 20" StrokeThickness="0" HorizontalOptions="Start">
                                            <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="Rate:" FontSize="{StaticResource FontSizeXS}" Opacity="0.6" Margin="6,0,0,0" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                                <Button Text="−" Clicked="OnCombinedOffsetRateDecrease" BackgroundColor="Transparent" Padding="0" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColorSeries3}" WidthRequest="34" />
                                                <Label Text="{Binding CombinedOffsetRate, StringFormat='{0:0.00}%'}" FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" MinimumWidthRequest="60" HorizontalTextAlignment="Center" TextColor="{DynamicResource LoanAppChartColorSeries3}" VerticalOptions="Center" />
                                                <Button Text="+" Clicked="OnCombinedOffsetRateIncrease" BackgroundColor="Transparent" Padding="0" FontAttributes="Bold" FontSize="{StaticResource FontSizeXL}" TextColor="{DynamicResource LoanAppChartColorSeries3}" WidthRequest="34" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Opacity="0.08" Color="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  KPI tiles — 3 columns  -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,8" BackgroundColor="{DynamicResource LoanAppChartColorSeries3}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeXS}" Opacity="0.85" Text="TIME SAVED" TextColor="White" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" Text="{Binding CombinedTimeSaved}" TextColor="White" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,8" BackgroundColor="{DynamicResource LoanAppChartColorSeries3}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeXS}" Opacity="0.85" Text="INT. SAVED" TextColor="White" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" Text="{Binding CombinedInterestSaved}" TextColor="White" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="10,8" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeXS}" Opacity="0.6" Text="PAID OFF IN" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" Text="{Binding CombinedNewTerm}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!--  Chart: Baseline vs Combined balance  -->
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="8,8,8,4"
                                    BackgroundColor="{DynamicResource LoanAppChartCardBackground}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="220"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Text="Loan Balance Over Time" FontSize="{StaticResource FontSizeXS}" TextColor="{DynamicResource LoanAppChartAxisTextColor}" Opacity="0.7" Margin="0,0,0,2"/>
                                        <chart:SfCartesianChart Grid.Row="1">
                                            <chart:SfCartesianChart.Legend>
                                                <chart:ChartLegend Placement="Bottom" LabelStyle="{chart:ChartLegendLabelStyle TextColor={DynamicResource LoanAppChartLegendTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.Legend>
                                            <chart:SfCartesianChart.XAxes>
                                                <chart:NumericalAxis ShowMajorGridLines="False" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis Minimum="0" RangePadding="None" LabelCreated="OnWhatIfAxisLabelCreated" LabelStyle="{chart:ChartAxisLabelStyle TextColor={DynamicResource LoanAppChartAxisTextColor}, FontSize=10}"/>
                                            </chart:SfCartesianChart.YAxes>
                                            <chart:SplineAreaSeries ItemsSource="{Binding CombinedBaselineData}" XBindingPath="Name" YBindingPath="Value" Opacity="0.4" StrokeWidth="2" Stroke="{DynamicResource LoanAppChartColorSeries1}" Label="Baseline" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries1}"/>
                                            <chart:SplineAreaSeries ItemsSource="{Binding CombinedStrategyData}" XBindingPath="Name" YBindingPath="Value" Opacity="0.6" StrokeWidth="2" Stroke="{DynamicResource LoanAppChartColorSeries3}" Label="Combined" LegendIcon="HorizontalLine" Fill="{DynamicResource LoanAppChartColorSeries3}"/>
                                        </chart:SfCartesianChart>
                                    </Grid>
                                </Border>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
