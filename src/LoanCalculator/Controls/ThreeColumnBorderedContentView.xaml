<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="LoanCalculatorMaui.Controls.ThreeColumnBorderedContentView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ThisControl">
    <ContentView.Content>
        <FlexLayout
            x:Name="FlexLayoutTopThreeBox"
            Margin="0,5,0,0"
            AlignItems="Stretch"
            Direction="Column"
            JustifyContent="Center">
            <!--
                Column 3 collapses to zero when Box3Visible is false, so the two remaining boxes
                take half the width each rather than two thirds with a gap. See the property for
                why a two-box mode exists.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="33*" />
                    <ColumnDefinition Width="33*" />
                    <ColumnDefinition x:Name="Box3Column" Width="33*" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  {OnIdiom Phone='0,0,0,0', Tablet='3,6,3,20', Default='0,0,0,0'}  -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{DynamicResource BorderTopHighlightBox}">
                    <ContentView>
                        <Grid HorizontalOptions="Center" VerticalOptions="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{OnIdiom Phone=10, Tablet=20, Desktop=20, Default=10}" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{OnIdiom Phone=10, Tablet=20, Desktop=20, Default=10}" />
                            </Grid.RowDefinitions>
                            <StackLayout
                                Grid.Row="1"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                                <Label
                                    x:Name="Label1"
                                    Margin="5,0,5,0"
                                    HorizontalTextAlignment="Center"
                                    LineHeight="{Binding LineHeightBox1}"
                                    TextColor="{DynamicResource LoanAppHighlightFgColor}"
                                    VerticalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString />
                                    </Label.FormattedText>
                                </Label>
                            </StackLayout>
                        </Grid>
                    </ContentView>
                </Border>

                <Border
                    Grid.Column="2"
                    Margin="{OnIdiom Phone='5,0,5,0',
                                     Tablet='10,0,10,0',
                                     Desktop='10,0,10,0',
                                     TV='10,0,10,0',
                                     Default='5,0,5,0'}"
                    Style="{DynamicResource BorderTopHighlightBox}">
                    <ContentView>
                        <Grid HorizontalOptions="Center" VerticalOptions="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{OnIdiom Phone=10, Tablet=20, Desktop=20, Default=10}" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="{OnIdiom Phone=10, Tablet=20, Desktop=20, Default=10}" />
                            </Grid.RowDefinitions>
                            <StackLayout Grid.Row="1">
                                <Label
                                    x:Name="Label2"
                                    Margin="5,0,5,0"
                                    HorizontalTextAlignment="Center"
                                    LineHeight="{Binding LineHeightBox2}"
                                    TextColor="{DynamicResource LoanAppHighlightFgColor}"
                                    VerticalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString />
                                    </Label.FormattedText>
                                </Label>
                            </StackLayout>
                        </Grid>
                    </ContentView>
                </Border>

                <!--
                    Box 3 is the only one that can be a link. The gesture is attached here rather
                    than to the whole control so boxes 1 and 2 stay inert — a tap anywhere on a
                    three-box row would otherwise navigate. Box3Command is null unless a host sets
                    it, and a TapGestureRecognizer with a null Command does nothing, so every
                    other use of this control is unaffected.
                -->
                <Border
                    x:Name="Box3Border"
                    Grid.Column="3"
                    Style="{DynamicResource BorderTopHighlightBox}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Box3Command, Source={x:Reference ThisControl}}" />
                    </Border.GestureRecognizers>
                    <ContentView>
                        <Grid HorizontalOptions="Center" VerticalOptions="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{OnIdiom Phone=10, Tablet=20, Desktop=20, Default=10}" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="{OnIdiom Phone=10, Tablet=20, Desktop=20, Default=10}" />
                            </Grid.RowDefinitions>
                            <StackLayout Grid.Row="1">
                                <Label
                                    x:Name="Label3"
                                    Margin="5,0,5,0"
                                    HorizontalTextAlignment="Center"
                                    LineHeight="{Binding LineHeightBox3}"
                                    TextColor="{DynamicResource LoanAppHighlightFgColor}"
                                    VerticalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString />
                                    </Label.FormattedText>
                                </Label>
                            </StackLayout>
                        </Grid>

                    </ContentView>
                </Border>
            </Grid>
        </FlexLayout>
    </ContentView.Content>
</ContentView>