        <GradientStop Offset="1.0" Color="{StaticResource LoanAppChartInnerBorderGradientEnd}" />
    </RadialGradientBrush>

    <!--  Border top highlight box styles  -->
    <LinearGradientBrush x:Key="BorderTopGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppBorderTopGradientOuterLineStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppBorderTopGradientOuterLineEnd}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BorderTopBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppBorderTopGradientBackgroundStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppBorderTopGradientBackgroundEnd}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BorderTopDangerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppBorderTopDangerOuterLineStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppBorderTopDangerOuterLineEnd}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BorderTopDangerBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppBorderTopDangerBackgroundStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppBorderTopDangerBackgroundEnd}" />
    </LinearGradientBrush>

    <!--  Border controls box styles  -->
    <LinearGradientBrush x:Key="BorderControlGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppBorderControlGradientBorderLineStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppBorderControlGradientBorderLineEnd}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BorderControlBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
