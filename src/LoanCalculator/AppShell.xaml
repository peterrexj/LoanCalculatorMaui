<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LoanCalculatorMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localview="clr-namespace:LoanCalculatorMaui.View"
    Shell.FlyoutBehavior="Disabled"
    NavBarIsVisible="False"
    Title="LoanCalculatorMaui">

    <TabBar>
        <ShellContent
            Title="Loan"
            ContentTemplate="{DataTemplate localview:LoanView}"
            Route="LoanView" />
        <ShellContent
            Title="Income"
            ContentTemplate="{DataTemplate localview:LoanView}"
            Route="LoanView" />
        <ShellContent
            Title="Expense"
            ContentTemplate="{DataTemplate localview:LoanView}"
            Route="LoanView" />
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate localview:LoanView}"
            Route="LoanView" />
    </TabBar>
    

</Shell>
