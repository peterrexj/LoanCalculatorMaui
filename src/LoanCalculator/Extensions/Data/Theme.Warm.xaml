    <LinearGradientBrush x:Key="LoanAppPurchaseGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppPurchaseWindowBgStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppPurchaseWindowBgEnd}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TabBarBackgroundGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppTabBarBackgroundGradientStart}" />
        <GradientStop Offset="0.7" Color="{StaticResource LoanAppTabBarBackgroundGradientEnd}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppTabBarBackgroundGradientStart}" />
    </LinearGradientBrush>
    <FileImageSource x:Key="LoanAppAssetIcon" File="assets_light.png" />
    <FileImageSource x:Key="LoanAppInsightIcon" File="insight_light.png" />

    <!--  Style for Chart border  -->
    <LinearGradientBrush x:Key="LoanAppChartOuterBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppChartOuterBorderGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppChartOuterBorderGradientEnd}" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LoanAppChartInnerBorderGradientBrush" Center="0.5,0.5" Radius="0.5">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppChartInnerBorderGradientStart}" />
