<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="thisPage"
    x:Class="LoanCalculatorMaui.View.LoanView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:customControls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:income="clr-namespace:LoanCalculator.Core.Models.Income;assembly=LoanCalculator.Core"
    xmlns:models="clr-namespace:LoanCalculator.Core.Models;assembly=LoanCalculator.Core"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:primaryModels="clr-namespace:LoanCalculator.Core.Models.ViewModels.PrimaryModels;assembly=LoanCalculator.Core"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:range="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:sfList="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:LoanCalculator.Core.Models.ViewModels;assembly=LoanCalculator.Core"
    Title="Loan Calculator"
    x:DataType="primaryModels:LoanViewModel">
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" IsEnabled="{Binding IsFree}">
            <customControls:PopupDisclaimerView />
            <customControls:InAppPurchaseView x:Name="PremiumWindow" />
            <!-- Popups rendered at window level by Syncfusion — keep them first so they overlay via SfPopup's own overlay mechanism -->

            <!--
                No tab strip. Amortisation became a pushed page, Running Cost moved to Budget
                and Insights moved to What If, so one view is left — and a one-item strip is
                chrome with nothing to switch between. What was the Asset tab is now the page.
            -->
            <Grid>
            <ScrollView>
                <!--
                    Padding, not per-card margins: every child here uses a zero
                    horizontal margin, so one value insets them all consistently and
                    matches the 16 used by the Settings cards. The group boxes sat
                    flush against the screen edge without it.
                -->
                <StackLayout Padding="12,0">
                    <customControls:DisclaimerBannerView
                        BannerType="Warning"
                        HeaderText="Disclaimer"
                        Text="{DynamicResource LoanAppDisclaimerBannerText}" />

                    <!--
                        Box 3 is a link to What If ▸ Answer, per the prototype: the verdict is
                        shown on the tab you are already configuring, and tapping it takes you to
                        the full answer. Box3Command is assigned in code-behind because the
                        navigation is a MAUI concern and this page binds LoanViewModel (Core),
                        which must not know about Shell.
                    -->
                    <customControls:ThreeColumnBorderedContentView
                        x:Name="LoanSummaryBox"
                        AutomationId="LoanSummaryBox"
                        Box3AutomationId="LoanVerdictLink"
                        IsBox3Danger="{Binding IsAffordabilityNegative}">
                        <customControls:ThreeColumnBorderedContentView.FormattedText1>
                            <FormattedString>
                                <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding CurrencySymbol}" />
                                <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TermPaymentRoundedWithComma}" />
                                <Span Text="{Binding NewLine}" />
                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding RepaymentFrequencySelected}" />
                                <Span Text=" " />
                                <Span
                                    FontSize="{StaticResource FontSizeLarge}"
                                    Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                    Text="{Binding LoanTermInYears}" />
                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" years with " />
                                <Span
                                    FontSize="{StaticResource FontSizeLarge}"
                                    Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                    Text="{Binding InterestRateFormatted}" />
                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" interest rate" />
                            </FormattedString>
                        </customControls:ThreeColumnBorderedContentView.FormattedText1>
                        <customControls:ThreeColumnBorderedContentView.FormattedText2>
                            <FormattedString>
                                <!--  LoanAmountStrFormatted / DepositAmountStrFormatted already include the
                                      currency symbol, so no separate symbol span here (avoids "$$").  -->
                                <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding LoanAmountStrFormatted}" />
                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" loan with " />
                                <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding DepositAmountStrFormatted}" />
                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" down payment" />
                            </FormattedString>
                        </customControls:ThreeColumnBorderedContentView.FormattedText2>
                        <customControls:ThreeColumnBorderedContentView.FormattedText3>
                            <FormattedString>
                                <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding AffordabilityCurrencySymbol}" />
                                <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Affordability}" />
                                <!--
                                    Underlined because this box is a link, matching the
                                    prototype's `.boxes a .lbl` rule. Without some affordance the
                                    tap target is invisible and nobody finds it.
                                -->
                                <Span
                                    Style="{DynamicResource SpanThreeBoxTextStyle}"
                                    Text="{Binding AffordabilityTextDescription}"
                                    TextDecorations="Underline" />
                            </FormattedString>
                        </customControls:ThreeColumnBorderedContentView.FormattedText3>
                    </customControls:ThreeColumnBorderedContentView>

                    <!--  ── Main input card — all inputs in one bordered box  ──  -->
                    <Border
                        Margin="0,6,0,0"
                        Padding="12,12"
                        Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                        Stroke="{DynamicResource BorderControlGradientBrush}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="12">

                            <!--  Asset Value & Total  -->
                                <Grid Margin="5,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Asset Value — same box style as Total asset amount, tappable  -->
                                    <Border
                                        Grid.Column="0"
                                        Margin="10"
                                        HorizontalOptions="Fill"
                                        Style="{DynamicResource BorderTopHighlightBox}"
                                        VerticalOptions="Fill">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAssetValueTapped" />
                                        </Border.GestureRecognizers>
                                        <StackLayout
                                            Padding="{OnIdiom Phone=10, Tablet=22, Desktop=22, Default=10}"
                                            HorizontalOptions="Center"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <Label
                                                FontSize="{StaticResource FontSizeBody}"
                                                HorizontalTextAlignment="Center"
                                                Text="Asset Value  ✎"
                                                TextColor="{DynamicResource LoanAppHighlightFgColor}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeLarge}"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding PropertyAmountFormatted}"
                                                TextColor="{DynamicResource LoanAppHighlightFgColor}" />
                                        </StackLayout>
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Margin="10"
                                        HorizontalOptions="Fill"
                                        Style="{DynamicResource BorderTopHighlightBox}"
                                        VerticalOptions="Fill">

                                        <StackLayout
                                            Padding="{OnIdiom Phone=10, Tablet=22, Desktop=22, Default=10}"
                                            HorizontalOptions="Center"
                                            Spacing="2"
                                            VerticalOptions="Center">

                                            <Label
                                                FontSize="{StaticResource FontSizeBody}"
                                                HorizontalTextAlignment="Center"
                                                Text="Total asset amount"
                                                TextColor="{DynamicResource LoanAppHighlightFgColor}" />

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeLarge}"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding PropertyTotalAmount}"
                                                TextColor="{DynamicResource LoanAppHighlightFgColor}" />

                                            <!--
                                                Accounts for the gap between this box and "Asset
                                                Value" beside it. Hidden until there is an upfront
                                                cost, because until then the two boxes show the
                                                same figure and there is nothing to explain.
                                            -->
                                            <Label
                                                AutomationId="LoanAssetTotalBreakdown"
                                                FontSize="{StaticResource FontSizeXS}"
                                                HorizontalTextAlignment="Center"
                                                IsVisible="{Binding ShowAssetTotalBreakdown}"
                                                Opacity="0.75"
                                                Text="{Binding AssetTotalBreakdown}"
                                                TextColor="{DynamicResource LoanAppHighlightFgColor}" />

                                        </StackLayout>
                                    </Border>
                                </Grid>

                            <!--  Deposit slider + Loan result  -->

                                                <VerticalStackLayout Spacing="8">

                                                    <!--  Deposit header row: label left, deposit amount right  -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            CharacterSpacing="{StaticResource TrackingFigureLabel}"
                                                            Grid.Column="0"
                                                            FontSize="{StaticResource FontSizeSmall}"
                                                            Opacity="0.55"
                                                            Text="DEPOSIT"
                                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                            VerticalOptions="Center" />
                                                        <Label
                                                            Grid.Column="1"
                                                            FontAttributes="Bold"
                                                            FontSize="{StaticResource FontSizeFigure}"
                                                            Text="{Binding DepositAmountStrFormatted, StringFormat='{0}  ✎'}"
                                                            TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                            VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnAssetValueTapped" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>

                                                    <!--  Slider with 0% left, current % right  -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            FontSize="{StaticResource FontSizeSmall}"
                                                            Opacity="0.45"
                                                            Text="0%"
                                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                            VerticalOptions="Center" />
                                                        <range:SfSlider
                                                            Grid.Column="1"
                                                            HeightRequest="44"
                                                            Maximum="99"
                                                            Minimum="0"
                                                            StepSize="1"
                                                            Value="{Binding DepositPercentage}">
                                                            <range:SfRangeSlider.ThumbStyle>
                                                                <range:SliderThumbStyle
                                                                    Fill="{DynamicResource LoanAppSliderKnobFillColor}"
                                                                    OverlapStroke="{DynamicResource LoanAppSliderKnobOverlapColor}"
                                                                    Stroke="{DynamicResource LoanAppSliderKnobBorderColor}"
                                                                    StrokeThickness="2" />
                                                            </range:SfRangeSlider.ThumbStyle>
                                                            <range:SfSlider.TrackStyle>
                                                                <range:SliderTrackStyle
                                                                    ActiveFill="{DynamicResource LoanAppRangeSliderTrackActiveFillColor}"
                                                                    ActiveSize="4"
                                                                    InactiveFill="{DynamicResource LoanAppRangeSliderTrackInActiveFillColor}"
                                                                    InactiveSize="2" />
                                                            </range:SfSlider.TrackStyle>
                                                        </range:SfSlider>
                                                        <Label
                                                            Grid.Column="2"
                                                            FontAttributes="Bold"
                                                            FontSize="{StaticResource FontSizeBody}"
                                                            Text="{Binding DepositPercentage, StringFormat='{0:0.##}%'}"
                                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                            VerticalOptions="Center" />
                                                    </Grid>

                                                    <!--  Loan amount result — the output the user cares about  -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            CharacterSpacing="{StaticResource TrackingFigureLabel}"
                                                            Grid.Column="0"
                                                            FontSize="{StaticResource FontSizeSmall}"
                                                            Opacity="0.55"
                                                            Text="LOAN AMOUNT"
                                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                            VerticalOptions="Center" />
                                                        <Label
                                                            Grid.Column="1"
                                                            FontAttributes="Bold"
                                                            FontSize="{StaticResource FontSizeFigure}"
                                                            Text="{Binding LoanAmountStrFormatted, StringFormat='{0}  ✎'}"
                                                            TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                            VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnAssetValueTapped" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>

                                                </VerticalStackLayout>

                            <!--
                                Explains the one rule users consistently misread: cost rises grow
                                the LOAN, not the deposit, so the two sum to the total cost rather
                                than to the asset price. Same rule enforced in HomeLoanInformation.
                            -->
                            <Label
                                AutomationId="LoanDepositSplitNote"
                                Margin="2,8,2,4"
                                FontSize="{StaticResource FontSizeSmall}"
                                Opacity="0.6"
                                Text="Upfront costs are folded into the loan, so deposit + loan equals the total cost above — not the asset value alone."
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                            <!--  Interest Rate, Loan Term, Frequency  -->
                    <!--  ── Interest Rate stepper  ─────────────────────────────────  -->
                    <Border
                        Padding="14,12"
                        Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                        Stroke="{DynamicResource BorderControlGradientBrush}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <Grid ColumnSpacing="4" MinimumHeightRequest="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" Text="Interest Rate" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.45" Text="±0.05% per tap · tap value to type" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            </VerticalStackLayout>
                            <Button AutomationId="LoanInterestRateMinus" Grid.Column="1" BackgroundColor="Transparent" Clicked="OnInterestRateDecrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" HeightRequest="44" Opacity="0.6" Text="−" TextColor="{DynamicResource LoanAppInputTextFgColor}" />
                            <Grid
                                Grid.Column="2"
                                MinimumWidthRequest="72"
                                VerticalOptions="Center">
                                <Label
                                    AutomationId="LoanInterestRateLabel"
                                    x:Name="lblInterestRate"
                                    FontSize="{StaticResource FontSizeMedium}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding InterestRateFormatted}"
                                    TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                    VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnInterestRateLabelTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Entry
                                    AutomationId="LoanInterestRateEntry"
                                    x:Name="entryInterestRate"
                                    BackgroundColor="Transparent"
                                    FontSize="{StaticResource FontSizeMedium}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    IsVisible="False"
                                    Keyboard="Numeric"
                                    ReturnType="Done"
                                    TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                    Unfocused="OnInterestRateEntryUnfocused"
                                    Completed="OnInterestRateEntryCompleted"
                                    WidthRequest="80" />
                            </Grid>
                            <Button AutomationId="LoanInterestRatePlus" Grid.Column="3" BackgroundColor="Transparent" Clicked="OnInterestRateIncrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" HeightRequest="44" Opacity="0.6" Text="+" TextColor="{DynamicResource LoanAppInputTextFgColor}" />
                        </Grid>
                    </Border>

                    <!--  Loan Term stepper  -->
                    <Border
                        Padding="14,12"
                        Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                        Stroke="{DynamicResource BorderControlGradientBrush}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <Grid ColumnSpacing="4" MinimumHeightRequest="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" Text="Loan Term" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.45" Text="±1 year per tap" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" BackgroundColor="Transparent" Clicked="OnLoanTermDecrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" HeightRequest="44" Opacity="0.6" Text="−" TextColor="{DynamicResource LoanAppInputTextFgColor}" />
                            <Label
                                Grid.Column="2"
                                FontSize="{StaticResource FontSizeMedium}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                MinimumWidthRequest="72"
                                Text="{Binding LoanTermInYears, StringFormat='{0} yr'}"
                                TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                VerticalOptions="Center" />
                            <Button AutomationId="LoanTermPlus" Grid.Column="3" BackgroundColor="Transparent" Clicked="OnLoanTermIncrease" FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" HeightRequest="44" Opacity="0.6" Text="+" TextColor="{DynamicResource LoanAppInputTextFgColor}" />
                        </Grid>
                    </Border>

                <buttons:SfSegmentedControl
                    AutomationId="LoanFrequencyControl"
                    x:Name="SegmentedRepaymentFrequency"
                    Margin="15,0,15,10"
                    ItemsSource="{Binding RepaymentFrequencyCollection}"
                    SelectedIndex="{Binding RepaymentFrequencySelectedIndex, Mode=TwoWay}"
                    Style="{DynamicResource SegmentDefaultStyle}"
                    VisibleSegmentsCount="3" />
                        </VerticalStackLayout>
                    </Border>


                    <!--  Upfront costs — tappable row, opens the Upfront Costs page  -->
                    <Border
                        AutomationId="LoanUpfrontCostsCard"
                        Margin="0,12,0,0"
                        Padding="16,14"
                        Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                        Stroke="{DynamicResource BorderControlGradientBrush}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUpfrontCostsTapped" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="UPFRONT COSTS" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.4" Text="Stamp duty, fees &amp; charges" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="{StaticResource FontSizeMedium}"
                                Text="{Binding OtherExpenseTotalAmount}"
                                TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="{StaticResource FontSizeXL}"
                                Margin="8,0,0,0"
                                Text="✎"
                                TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!--
                        Repayment schedule — a row, not a tab. It is a reference
                        table you read once the loan is set, so it does not earn a
                        place in the tab strip; and putting it at the point of the
                        repayment figure is how it actually gets discovered.
                    -->
                    <!--
                        Running costs moved to Budget ▸ Asset costs in the redesign. Without a
                        pointer, anyone who used to edit them here simply cannot find them.
                    -->
                    <Label
                        AutomationId="LoanRunningCostsMovedNote"
                        Margin="2,10,2,2"
                        FontSize="{StaticResource FontSizeSmall}"
                        Opacity="0.6"
                        Text="Running costs for this asset now live under Budget, alongside your other monthly outflows."
                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                    <Border
                        AutomationId="LoanScheduleCard"
                        Margin="0,12,0,0"
                        Padding="16,14"
                        Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                        Stroke="{DynamicResource BorderControlGradientBrush}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScheduleTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="REPAYMENT SCHEDULE" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.4" Text="Year by year, principal against interest" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                FontSize="{StaticResource FontSizeXL}"
                                Margin="8,0,0,0"
                                Text="›"
                                TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <FlexLayout
                        Margin="0"
                        AlignItems="Stretch"
                        Direction="Column"
                        JustifyContent="Center">
                        <Border Style="{DynamicResource LoanAppChartBorderStyle}">
                            <Border.Content>
                                <chart:SfCircularChart Margin="{StaticResource MarginSection}">
                                    <chart:SfCircularChart.Legend>
                                        <chart:ChartLegend Placement="{OnIdiom Phone=Bottom, Tablet=Left, Desktop=Left, TV=Left, Default=Bottom}" ToggleSeriesVisibility="True">
                                            <chart:ChartLegend.LabelStyle>
                                                <chart:ChartLegendLabelStyle
                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                    FontSize="{StaticResource FontSizeXS}"
                                                    TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                            </chart:ChartLegend.LabelStyle>
                                        </chart:ChartLegend>
                                    </chart:SfCircularChart.Legend>
                                    <chart:SfCircularChart.Series>
                                        <chart:DoughnutSeries
                                            ExplodeAll="False"
                                            ExplodeOnTouch="False"
                                            InnerRadius="0.5"
                                            ItemsSource="{Binding ChartPropertyValueWithInterestPayment}"
                                            LegendIcon="Circle"
                                            PaletteBrushes="{Binding CustomChartColors}"
                                            ShowDataLabels="True"
                                            XBindingPath="Category"
                                            YBindingPath="Value">
                                            <chart:DoughnutSeries.DataLabelSettings>
                                                <chart:CircularDataLabelSettings LabelPosition="Inside" UseSeriesPalette="True">
                                                    <chart:CircularDataLabelSettings.LabelStyle>
                                                        <chart:ChartDataLabelStyle
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{StaticResource FontSizeXS}"
                                                            LabelFormat="{Binding CurrencyFormat}" />
                                                    </chart:CircularDataLabelSettings.LabelStyle>
                                                </chart:CircularDataLabelSettings>
                                            </chart:DoughnutSeries.DataLabelSettings>

                                            <chart:DoughnutSeries.CenterView>
                                                <StackLayout
                                                    HorizontalOptions="Center"
                                                    Spacing="1"
                                                    VerticalOptions="Center">
                                                    <!--
                                                        "TO REPAY", not "REPAID". This is a
                                                        projection of what the loan will cost over
                                                        its whole term — the user has not paid any
                                                        of it yet, and the past tense read as a
                                                        statement about money already handed over.
                                                        The legend and the caption below the chart
                                                        both say "over N yrs", which is
                                                        future-facing; this label was the only one
                                                        out of step.
                                                    -->
                                                    <Label
                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                        FontSize="{StaticResource FontSizeXS}"
                                                        HorizontalTextAlignment="Center"
                                                        Opacity="0.6"
                                                        Text="TOTAL TO REPAY"
                                                        TextColor="{DynamicResource LoanAppChartDataMarkerTextColor}" />
                                                    <Label HorizontalTextAlignment="Center">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span
                                                                    FontAttributes="Bold"
                                                                    FontSize="{StaticResource FontSizeSmall}"
                                                                    Text="{Binding Source={x:Reference thisPage}, Path=BindingContext.CurrencySymbol}"
                                                                    TextColor="{DynamicResource LoanAppChartDataMarkerTextColor}" />
                                                                <Span
                                                                    FontAttributes="Bold"
                                                                    FontSize="{StaticResource FontSizeSmall}"
                                                                    Text="{Binding Source={x:Reference thisPage}, Path=BindingContext.TotalPaymentRoundedWithComma}"
                                                                    TextColor="{DynamicResource LoanAppChartDataMarkerTextColor}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                            </chart:DoughnutSeries.CenterView>
                                        </chart:DoughnutSeries>
                                    </chart:SfCircularChart.Series>
                                </chart:SfCircularChart>
                            </Border.Content>
                        </Border>
                        <Label
                            Margin="0,4,0,12"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="{StaticResource FontSizeXS}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Opacity="0.5"
                            Text="{Binding ChartTotalCostSubtitle}"
                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                    </FlexLayout>
                </StackLayout>
            </ScrollView>

            <!--
                Loan Details FAB — the only data-entry FAB on this tab.

                Styled to match Budget's three FABs and the prototype's .fab rule, which agree:
                background LoanAppInputTextFgColor at opacity 0.85. This one was the odd one out
                on both counts — LoanAppNavigationButtonBackgroundColor (#526D82) at 0.5 — and at
                half opacity against the Dark background it read as a disabled control.
            -->
            <Button
                x:Name="FabWizard"
                AutomationId="FabWizard"
                Margin="0,0,20,20"
                Opacity="0.85"
                BackgroundColor="{DynamicResource LoanAppInputTextFgColor}"
                Clicked="OnWizardFab_Clicked"
                CornerRadius="28"
                FontAttributes="Bold"
                FontSize="{StaticResource FontSizeHeading}"
                HeightRequest="56"
                HorizontalOptions="End"
                Text="⚡"
                TextColor="{DynamicResource LoanAppAppShellBgColor}"
                VerticalOptions="End"
                WidthRequest="56">
                <Button.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Opacity="0.35" Radius="10" />
                </Button.Shadow>
            </Button>


            </Grid>

            <!--  Loading overlay — covers content while IsPageBusy is true  -->
            <Grid IsVisible="{Binding IsPageBusy}"
                  BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                  Opacity="0.5"
                  InputTransparent="False">
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12">
                    <ActivityIndicator
                        IsRunning="{Binding IsPageBusy}"
                        Color="{DynamicResource LoanAppAppShellFgColor}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Loading..."
                        TextColor="{DynamicResource LoanAppPrimaryTextColor}"
                        FontSize="{StaticResource FontSizeMedium}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
