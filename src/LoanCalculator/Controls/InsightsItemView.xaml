<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="LoanCalculatorMaui.Controls.InsightsItemView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!--
        Layout kept as-is deliberately — figure left, rule, name and explanation right. What changed
        is only the finish, brought into line with the lists built elsewhere in the app:

          · the rule was `Gray200` (#C8C8C8), a raw MAUI template colour, so it rendered the same
            hard light-grey in all four themes and sat far too bright on Dark. It is now the theme
            foreground at the opacity `LoanAppSeparatorStyle` uses, so it follows the theme.
          · the figure takes `FontSizeFigure`, the token added for exactly this role, which also
            fixes the tablet size (34, not 30).
          · a hairline separator per row, matching the Budget and Schedule lists — nine panels of
            unseparated rows read as one block.
          · explanation at 0.55, the same muted level as every other row's sub-text.
          · the ⓘ takes the link accent, so it reads as something you can tap.
    -->
    <VerticalStackLayout Spacing="0">
        <BoxView x:Name="RowSeparator" Style="{DynamicResource LoanAppSeparatorStyle}" />
        <Grid Padding="0,11" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{OnIdiom Phone=150, Tablet=200, Desktop=200, TV=200, Default=150}" />
                <ColumnDefinition Width="2" />
                <!--  Vertical line column  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label
                x:Name="InnerInsightsValueLabel"
                Grid.Column="0"
                Margin="0,0,10,0"
                FontAttributes="Bold"
                FontSize="{DynamicResource FontSizeFigure}"
                HorizontalOptions="End"
                HorizontalTextAlignment="End"
                VerticalOptions="Center" />
            <BoxView
                Grid.Column="1"
                BackgroundColor="{DynamicResource LoanAppDefaultForegroundColor}"
                HeightRequest="34"
                HorizontalOptions="Center"
                Opacity="0.15"
                VerticalOptions="Center"
                WidthRequest="2" />

            <VerticalStackLayout
                Grid.Column="2"
                Margin="14,0,10,0"
                Spacing="2"
                VerticalOptions="Center">
                <!--  Name + tappable info toggle  -->
                <Label x:Name="InnerInsightsLabel">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span
                                x:Name="InnerInsightsNameLabel"
                                FontAttributes="Bold"
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{DynamicResource FontSizeMedium}" />
                            <Span Text="  " />
                            <Span
                                x:Name="InnerInsightsInfoToggle"
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{DynamicResource FontSizeBody}"
                                Text="ⓘ"
                                TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInfoToggleTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!--  Short summary — always visible  -->
                <Label
                    x:Name="InnerInsightsShortLabel"
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{DynamicResource FontSizeBody}"
                    Opacity="0.55" />

                <!--  Full description — collapsed by default, expands on ⓘ tap  -->
                <Label
                    x:Name="InnerInsightsDescriptionLabel"
                    FontFamily="{DynamicResource DefaultFontFamily}"
                    FontSize="{DynamicResource FontSizeBody}"
                    IsVisible="False"
                    Opacity="0.6" />
            </VerticalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentView>
