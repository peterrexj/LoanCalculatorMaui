<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="LoanCalculatorMaui.Controls.InsightsItemView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <StackLayout>
        <Label
            x:Name="InnerInsightsValueLabel"
            Margin="15,5,0,0"
            FontAttributes="Bold"
            FontSize="22"
            VerticalOptions="Center" />
        <Label
            x:Name="InnerInsightsLabel"
            Margin="15,-5,0,0"
            HorizontalOptions="Start"
            HorizontalTextAlignment="Start"
            VerticalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span
                        x:Name="InnerInsightsNameLabel"
                        FontAttributes="Bold"
                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                        FontSize="16" />
                    <Span Text="  " />
                    <Span
                        x:Name="InnerInsightsDescriptionLabel"
                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                        FontSize="12" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
    </StackLayout>
</ContentView>
