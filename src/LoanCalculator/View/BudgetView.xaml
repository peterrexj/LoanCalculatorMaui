<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoanCalculatorMaui.View.BudgetView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:customControls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:income="clr-namespace:LoanCalculator.Core.Models.Income;assembly=LoanCalculator.Core"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:primaryModels="clr-namespace:LoanCalculator.Core.Models.ViewModels.PrimaryModels;assembly=LoanCalculator.Core"
    xmlns:range="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:sfList="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:summary="clr-namespace:LoanCalculator.Core.Models.Income.Summary;assembly=LoanCalculator.Core"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:viewModels="clr-namespace:LoanCalculator.Core.Models.ViewModels;assembly=LoanCalculator.Core"
    x:Name="thisPage"
    Title="Budget">
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">

            <customControls:InAppPurchaseView x:Name="PremiumWindow" Grid.RowSpan="2" />



            <tabView:SfTabView
                x:Name="tabView"
                HeaderHorizontalTextAlignment="Center"
                SelectionChanging="TabView_OnSelectionChanging">

                <!--  ══ Tab 1: Income ══════════════════════════════════════════  -->
                <tabView:SfTabItem AutomationId="BudgetTabIncome" Header="Income">
                    <tabView:SfTabItem.Content>
                        <!--
                            Same three-part shape as the Asset costs tab, and it has to stay that
                            way: fixed header rows, then ONE flex row holding the list. The flex row
                            is what lets the FAB sit at the bottom-right of the list area — anchored
                            to an Auto row it lands against whatever that row happens to measure,
                            which is how it ended up over the section header.
                        -->
                        <Grid x:Name="IncomeTabGrid" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Summary bar  -->
                            <customControls:ThreeColumnBorderedContentView AutomationId="BudgetIncomeTabSummaryBox" Grid.Row="0">
                                <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Income.CurrencySymbol}"
                                            TextColor="{Binding Income.IsTotalMonthlyIncomeNegative, Converter={StaticResource NegativeToHighlightColorConverter}, ConverterParameter=LoanAppHighlightFgColor}" />
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Income.TotalMonthlyIncomeWithComma}"
                                            TextColor="{Binding Income.IsTotalMonthlyIncomeNegative, Converter={StaticResource NegativeToHighlightColorConverter}, ConverterParameter=LoanAppHighlightFgColor}" />
                                        <Span Text="{Binding Income.NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding Income.StringMonthlyTextOnTopBox}" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Income.CurrencySymbol}"
                                            TextColor="{Binding Income.IsTotalYearlyIncomeNegative, Converter={StaticResource NegativeToHighlightColorConverter}, ConverterParameter=LoanAppHighlightFgColor}" />
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Income.TotalYearlyIncomeWithComma}"
                                            TextColor="{Binding Income.IsTotalYearlyIncomeNegative, Converter={StaticResource NegativeToHighlightColorConverter}, ConverterParameter=LoanAppHighlightFgColor}" />
                                        <Span Text="{Binding Income.NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding Income.StringYearlyTextOnTopBox}" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                <customControls:ThreeColumnBorderedContentView.FormattedText3>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Income.CurrencySymbol}" />
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Income.TotalMonthlySumExpenseWithComma}" />
                                        <Span
                                            FontSize="{DynamicResource FontSizeXS}"
                                            Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                            Text="{Binding Income.TotalMonthlyExpenseBreakdownWithComma}" />
                                        <Span Text="{Binding Income.NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding Income.StringMonthlyExpenseOnTopBox}" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText3>
                            </customControls:ThreeColumnBorderedContentView>

                            <!--  Switches card  -->
                            <Border
                                Grid.Row="1"
                                Margin="12,8,12,0"
                                Padding="14,10"
                                Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="10">
                                    <customControls:SwitchWithInfoView
                                        DetailAutomationId="BudgetIncomeAfterExpenseDetail"
                                        InfoAutomationId="BudgetIncomeAfterExpenseInfo"
                                        IsOn="{Binding Income.ShowIncomeAfterExpense, Mode=TwoWay}"
                                        SwitchAutomationId="BudgetIncomeAfterExpenseSwitch"
                                        LiveExample="{Binding IncomeAfterExpensesLiveExample}"
                                        Toggle="IncomeAfterExpenses" />
                                    <BoxView Style="{DynamicResource LoanAppSeparatorStyle}" />
                                    <customControls:SwitchWithInfoView
                                        DetailAutomationId="BudgetIncomeAssetCostsDetail"
                                        InfoAutomationId="BudgetIncomeAssetCostsInfo"
                                        IsOn="{Binding Income.ShowIncomeAfterPropertyExpense, Mode=TwoWay}"
                                        SwitchAutomationId="BudgetIncomeAssetCostsSwitch"
                                        LiveExample="{Binding IncomeAfterLoanLiveExample}"
                                        Toggle="IncomeAfterLoanAndAssetCosts" />
                                </VerticalStackLayout>
                            </Border>

                            <!--  ── Bottom section: search + header + list + FAB ──  -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                            <!--  Search/filter bar  -->
                            <Border
                                Grid.Row="0"
                                Margin="12,8,12,0"
                                Padding="14,10"
                                Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        Opacity="0.45"
                                        Text="🔍"
                                        VerticalOptions="Center" />
                                    <editors:SfAutocomplete
                                        x:Name="IncomeAutoComplete"
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Completed="OnIncomeAutoCompleteCompleted"
                                        ItemsSource="{Binding Income.AutocompleteNameList}"
                                        MinimumPrefixCharacters="1"
                                        Placeholder="Filter income..."
                                        PlaceholderColor="{DynamicResource LoanAppAutoCompleteWaterColor}"
                                        SelectionChanged="OnIncomeAutoCompleteSelectionChanged"
                                        Style="{DynamicResource SfAutocompleteFilterStyle}" />
                                </Grid>
                            </Border>

                            <!--  Section header, per the prototype: names the list below it.  -->
                            <Label
                                Grid.Row="1"
                                AutomationId="BudgetIncomeSectionHeader"
                                Margin="4,10,4,2"
                                FontSize="{DynamicResource FontSizeSmall}"
                                Opacity="0.45"
                                Text="SOURCES"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                            <!--
                                `.rows` from app.css: ONE rounded container for the whole list, a single
                                gradient sweeping across it, one 1px border. Rows inside are transparent so
                                the gradient runs unbroken — per-row fills repeated it on every row, which
                                is what made the list look dated.

                                The ScrollView + AutoFitMode="Height" + VerticalOptions="Start" trio is
                                what makes the card hug its rows rather than stretching to a tall empty
                                box: the list measures to its content, the Border wraps that, and the
                                ScrollView supplies the scrolling the list no longer does for itself.
                                Changing any one of the three brings back one of the two bugs — a
                                stretched card, or a long list clipped with no way to scroll it.
                            -->
                            <ScrollView Grid.Row="2">
                            <Border
                                Margin="12,2,12,12"
                                Padding="0"
                                Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                VerticalOptions="Start">
                                <sfList:SfListView
                                    x:Name="IncomeList"
                                    AutoFitMode="Height"
                                    ItemsSource="{Binding Income.FilteredTransactions}"
                                    SelectionMode="None">
                                    <sfList:SfListView.ItemTemplate>
                                        <DataTemplate x:DataType="income:IncomeExpense">
                                            <Border
                                                AutomationId="{Binding Name, StringFormat='IncomeRow_{0}'}"
                                                Margin="0"
                                                Padding="16,13"
                                                BackgroundColor="Transparent"
                                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                                StrokeThickness="1">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnBudgetIncomeEdit" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <VerticalStackLayout
                                                        Grid.Column="0"
                                                        Spacing="2"
                                                        VerticalOptions="Center">
                                                        <Label
                                                            FontSize="{DynamicResource FontSizeBody}"
                                                            LineBreakMode="TailTruncation"
                                                            Text="{Binding Name}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                        <Label
                                                            FontSize="{DynamicResource FontSizeSmall}"
                                                            Opacity="0.55"
                                                            Text="{Binding Frequency}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                    </VerticalStackLayout>
                                                    <Label
                                                        Grid.Column="1"
                                                        FontAttributes="Bold"
                                                        FontSize="{DynamicResource FontSizeBody}"
                                                        Text="{Binding AmountString}"
                                                        TextColor="{DynamicResource LstForegroundColor}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="2"
                                                        FontSize="{DynamicResource FontSizeMedium}"
                                                        Opacity="0.4"
                                                        Text="&#x203A;"
                                                        TextColor="{DynamicResource LstForegroundColor}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </sfList:SfListView.ItemTemplate>
                                </sfList:SfListView>
                            </Border>
                            </ScrollView>

                            <!--  Empty state  -->
                            <Border
                                Grid.Row="2"
                                Margin="12,2,12,12"
                                Padding="24,32"
                                Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                IsVisible="{Binding Income.FilteredTransactions.Count, Converter={StaticResource IntToIsEmptyConverter}}"
                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                VerticalOptions="Start">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeMedium}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="No income yet"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    <Label
                                        FontSize="{DynamicResource FontSizeBody}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.7"
                                        Text="Add your first income entry above to get started"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </VerticalStackLayout>
                            </Border>

                            <Button
                                Grid.Row="2"
                                Margin="0,0,20,20"
                                BackgroundColor="{DynamicResource LoanAppInputTextFgColor}"
                                AutomationId="BudgetIncomeAddFab"
                                Clicked="OnAddIncomeFab_Clicked"
                                CornerRadius="28"
                                FontAttributes="Bold"
                                FontSize="{DynamicResource FontSizeHeading}"
                                HeightRequest="56"
                                HorizontalOptions="End"
                                Opacity="0.85"
                                Text="+"
                                TextColor="{DynamicResource LoanAppAppShellBgColor}"
                                VerticalOptions="End"
                                WidthRequest="56">
                                <Button.Shadow>
                                    <Shadow
                                        Brush="#000000"
                                        Opacity="0.35"
                                        Radius="10"
                                        Offset="0,4" />
                                </Button.Shadow>
                            </Button>

                            </Grid>
                        </Grid>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>
                <tabView:SfTabItem AutomationId="BudgetTabExpenses" Header="Expenses">
                    <tabView:SfTabItem.Content>
                        <!--  Same three-part shape as Income and Asset costs — see the note there.  -->
                        <Grid x:Name="ExpenseTabGrid" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Summary bar  -->
                            <customControls:ThreeColumnBorderedContentView AutomationId="BudgetExpenseTabSummaryBox" Grid.Row="0">
                                <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Expense.CurrencySymbol}" />
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Expense.TotalMonthlySumExpenseWithComma}" />
                                        <Span
                                            FontSize="{DynamicResource FontSizeXS}"
                                            Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                            Text="{Binding Expense.TotalMonthlyExpenseBreakdownWithComma}" />
                                        <Span Text="{Binding Expense.NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding Expense.StringMonthlyExpenseOnTopBox}" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Expense.CurrencySymbol}" />
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding Expense.TotalYearlyIncomeWithComma}" />
                                        <Span Text="{Binding Expense.NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Yearly Expense" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                <customControls:ThreeColumnBorderedContentView.FormattedText3>
                                    <FormattedString>
                                        <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="" />
                                        <Span
                                            Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                            Text="{Binding ExpensesTabNetMonthlyFormatted}"
                                            TextColor="{Binding ExpensesTabNetIsNegative, Converter={StaticResource NegativeToHighlightColorConverter}, ConverterParameter=LoanAppHighlightFgColor}" />
                                        <Span Text="{Binding Expense.NewLine}" />
                                        <Span
                                            FontSize="{DynamicResource FontSizeXS}"
                                            Text="{Binding ExpensesTabNetBreakdown}" />
                                        <Span Text="{Binding Expense.NewLine}" />
                                        <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="{Binding ExpensesTabNetCaption}" />
                                    </FormattedString>
                                </customControls:ThreeColumnBorderedContentView.FormattedText3>
                            </customControls:ThreeColumnBorderedContentView>

                            <!--  Switches card  -->
                            <Border
                                Grid.Row="1"
                                Margin="12,8,12,0"
                                Padding="14,10"
                                Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="10">
                                    <customControls:SwitchWithInfoView
                                        DetailAutomationId="BudgetExpenseAssetCostsDetail"
                                        InfoAutomationId="BudgetExpenseAssetCostsInfo"
                                        IsOn="{Binding Expense.ShowPropertyExpense, Mode=TwoWay}"
                                        SwitchAutomationId="BudgetExpenseAssetCostsSwitch"
                                        LiveExample="{Binding ExpenseAfterLoanLiveExample}"
                                        Toggle="ExpenseAfterLoanAndAssetCosts" />
                                </VerticalStackLayout>
                            </Border>

                            <!--  ── Bottom section: search + header + list + FAB ──  -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                            <!--  Search/filter bar  -->
                            <Border
                                Grid.Row="0"
                                Margin="12,8,12,0"
                                Padding="14,10"
                                Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        Opacity="0.45"
                                        Text="🔍"
                                        VerticalOptions="Center" />
                                    <editors:SfAutocomplete
                                        x:Name="ExpenseAutoComplete"
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Completed="OnExpenseAutoCompleteCompleted"
                                        ItemsSource="{Binding Expense.AutocompleteNameList}"
                                        MinimumPrefixCharacters="1"
                                        Placeholder="Filter expenses..."
                                        PlaceholderColor="{DynamicResource LoanAppAutoCompleteWaterColor}"
                                        SelectionChanged="OnExpenseAutoCompleteSelectionChanged"
                                        Style="{DynamicResource SfAutocompleteFilterStyle}" />
                                </Grid>
                            </Border>

                            <!--  Section header, per the prototype: names the list below it.  -->
                            <Label
                                Grid.Row="1"
                                AutomationId="BudgetExpenseSectionHeader"
                                Margin="4,10,4,2"
                                FontSize="{DynamicResource FontSizeSmall}"
                                Opacity="0.45"
                                Text="LIVING EXPENSES"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                            <!--
                                `.rows` from app.css: ONE rounded container for the whole list, a single
                                gradient sweeping across it, one 1px border. Rows inside are transparent so
                                the gradient runs unbroken — per-row fills repeated it on every row, which
                                is what made the list look dated.

                                ScrollView + AutoFitMode="Height" + VerticalOptions="Start" — see the
                                note on the Income tab for why all three are load-bearing.
                            -->
                            <ScrollView Grid.Row="2">
                            <Border
                                Margin="12,2,12,12"
                                Padding="0"
                                Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                VerticalOptions="Start">
                                <sfList:SfListView
                                    x:Name="ExpenseList"
                                    AutoFitMode="Height"
                                    ItemsSource="{Binding Expense.FilteredTransactions}"
                                    SelectionMode="None">
                                    <sfList:SfListView.ItemTemplate>
                                        <DataTemplate x:DataType="income:IncomeExpense">
                                            <Border
                                                AutomationId="{Binding Name, StringFormat='ExpenseRow_{0}'}"
                                                Margin="0"
                                                Padding="16,13"
                                                BackgroundColor="Transparent"
                                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                                StrokeThickness="1">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnBudgetExpenseEdit" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <VerticalStackLayout
                                                        Grid.Column="0"
                                                        Spacing="2"
                                                        VerticalOptions="Center">
                                                        <Label
                                                            FontSize="{DynamicResource FontSizeBody}"
                                                            LineBreakMode="TailTruncation"
                                                            Text="{Binding Name}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                        <Label
                                                            FontSize="{DynamicResource FontSizeSmall}"
                                                            Opacity="0.55"
                                                            Text="{Binding Frequency}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                    </VerticalStackLayout>
                                                    <Label
                                                        Grid.Column="1"
                                                        FontAttributes="Bold"
                                                        FontSize="{DynamicResource FontSizeBody}"
                                                        Text="{Binding AmountString}"
                                                        TextColor="{DynamicResource LstForegroundColor}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="2"
                                                        FontSize="{DynamicResource FontSizeMedium}"
                                                        Opacity="0.4"
                                                        Text="&#x203A;"
                                                        TextColor="{DynamicResource LstForegroundColor}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </sfList:SfListView.ItemTemplate>
                                </sfList:SfListView>
                            </Border>
                            </ScrollView>

                            <!--  Empty state  -->
                            <Border
                                Grid.Row="2"
                                Margin="12,2,12,12"
                                Padding="24,32"
                                Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                IsVisible="{Binding Expense.FilteredTransactions.Count, Converter={StaticResource IntToIsEmptyConverter}}"
                                Stroke="{DynamicResource BorderControlGradientBrush}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                VerticalOptions="Start">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeMedium}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="No expenses yet"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    <Label
                                        FontSize="{DynamicResource FontSizeBody}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.7"
                                        Text="Add your first expense entry above to get started"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </VerticalStackLayout>
                            </Border>

                            <Button
                                Grid.Row="2"
                                Margin="0,0,20,20"
                                BackgroundColor="{DynamicResource LoanAppInputTextFgColor}"
                                AutomationId="BudgetExpenseAddFab"
                                Clicked="OnAddExpenseFab_Clicked"
                                CornerRadius="28"
                                FontAttributes="Bold"
                                FontSize="{DynamicResource FontSizeHeading}"
                                HeightRequest="56"
                                HorizontalOptions="End"
                                Opacity="0.85"
                                Text="+"
                                TextColor="{DynamicResource LoanAppAppShellBgColor}"
                                VerticalOptions="End"
                                WidthRequest="56">
                                <Button.Shadow>
                                    <Shadow
                                        Brush="#000000"
                                        Opacity="0.35"
                                        Radius="10"
                                        Offset="0,4" />
                                </Button.Shadow>
                            </Button>

                            </Grid>
                        </Grid>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <!--
                    Tab ORDER is not load-bearing any more. TabView_OnSelectionChanging used to
                    switch on e.Index, so moving a tab silently moved its premium gate onto a
                    different tab — it had already drifted once when Projection left for What If.
                    It now switches on each tab's AutomationId, so these can be reordered freely.
                -->
                <!--  ══ Tab 3: Asset costs ═════════════════════════════════════  -->
                <tabView:SfTabItem AutomationId="BudgetTabAssetCosts" Header="Asset costs">
                    <tabView:SfTabItem.Content>
                        <Grid x:Name="AssetCostsRoot" x:DataType="primaryModels:LoanViewModel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  ── Top section (banner + 3-box summary — untouched) ──  -->
                            <VerticalStackLayout Padding="12,0" Grid.Row="0" Spacing="0">
                                <customControls:DisclaimerBannerView
                                    BannerType="Information"
                                    HeaderText="What goes on this tab?"
                                    Text="List the ongoing costs you expect to have once you own this asset — things like maintenance, insurance, service charges and taxes. These have not happened yet; they are what you are planning for.&#10;&#10;Leave out the loan repayment itself. That is worked out from the loan details and is added separately, so entering it here would count it twice." />

                                <customControls:ThreeColumnBorderedContentView LineHeightBox3="2.0">
                                    <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalMonthlyExpenseWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Expected monthly cost" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalYearlyExpenseWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Expected yearly cost" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText3>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalMonthlyOverallExpense}" />
                                            <Span FontSize="{DynamicResource FontSizeXS}" Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalMonthlyOverallExpenseBreakdownWithComma}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" monthly new asset overall expense" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText3>
                                </customControls:ThreeColumnBorderedContentView>
                            </VerticalStackLayout>

                            <!--  ── Bottom section: search + header + list + FAB ──  -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Search / filter bar  -->
                                <Border
                                    Grid.Row="0"
                                    Margin="12,10,12,0"
                                    Padding="14,10"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            FontSize="{DynamicResource FontSizeBody}"
                                            Opacity="0.45"
                                            Text="🔍"
                                            VerticalOptions="Center" />
                                        <editors:SfAutocomplete
                                            x:Name="autoComplete"
                                            AutomationId="LoanRunningCostFilter"
                                            Grid.Column="1"
                                            BackgroundColor="Transparent"
                                            Completed="autoComplete_Completed"
                                            ItemsSource="{Binding AutocompleteNameList}"
                                            MinimumPrefixCharacters="1"
                                            Placeholder="Filter expenses..."
                                            PlaceholderColor="{DynamicResource LoanAppAutoCompleteWaterColor}"
                                            SelectionChanged="autoComplete_SelectionChanged"
                                            Style="{DynamicResource SfAutocompleteFilterStyle}" />
                                    </Grid>
                                </Border>

                                <!--  Empty state  -->
                                <Border
                                    Grid.Row="2"
                                    Margin="12,2,12,12"
                                    Padding="24,32"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    IsVisible="{Binding FilteredTransactions.Count, Converter={StaticResource IntToIsEmptyConverter}}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    VerticalOptions="Start">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Text="No expected costs yet"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label
                                            FontSize="{DynamicResource FontSizeBody}"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Opacity="0.55"
                                            Text="Tap + to add a cost you expect once you own this asset"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!--  List  -->
                                <!--  Section header, per the prototype: names the list below it.  -->
                                <Label
                                    Grid.Row="1"
                                    AutomationId="BudgetAssetSectionHeader"
                                    Margin="4,10,4,2"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Opacity="0.45"
                                    Text="EXPECTED ONGOING COSTS"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--
                                    `.rows` from app.css: ONE rounded container for the whole list, a single
                                    gradient sweeping across it, one 1px border. Rows inside are transparent so
                                    the gradient runs unbroken — per-row fills repeated it on every row, which
                                    is what made the list look dated.

                                    ScrollView + AutoFitMode="Height" + VerticalOptions="Start" — see
                                    the note on the Income tab for why all three are load-bearing.
                                -->
                                <ScrollView Grid.Row="2">
                                <Border
                                    Margin="12,2,12,12"
                                    Padding="0"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    VerticalOptions="Start">
                                    <sfList:SfListView
                                        x:Name="lstEntry"
                                        AutoFitMode="Height"
                                        ItemsSource="{Binding FilteredTransactions}"
                                        SelectionMode="None">
                                        <sfList:SfListView.ItemTemplate>
                                            <DataTemplate x:DataType="income:IncomeExpense">
                                                <Border
                                                    Margin="0"
                                                    Padding="16,13"
                                                    BackgroundColor="Transparent"
                                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                                    StrokeThickness="1"
                                                    AutomationId="{Binding Name, StringFormat='AssetRow_{0}'}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="btnEditEntry_Clicked" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                            <Label
                                                                FontSize="{DynamicResource FontSizeBody}"
                                                                LineBreakMode="TailTruncation"
                                                                Text="{Binding Name}"
                                                                TextColor="{DynamicResource LstForegroundColor}" />
                                                            <Label
                                                                FontSize="{DynamicResource FontSizeSmall}"
                                                                Opacity="0.55"
                                                                Text="{Binding Frequency}"
                                                                TextColor="{DynamicResource LstForegroundColor}" />
                                                        </VerticalStackLayout>
                                                        <Label
                                                            Grid.Column="1"
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource FontSizeBody}"
                                                            Text="{Binding AmountString}"
                                                            TextColor="{DynamicResource LstForegroundColor}"
                                                            VerticalOptions="Center" />
                                                        <Label
                                                            Grid.Column="2"
                                                            FontSize="{DynamicResource FontSizeMedium}"
                                                            Opacity="0.4"
                                                            Text="&#x203A;"
                                                            TextColor="{DynamicResource LstForegroundColor}"
                                                            VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </sfList:SfListView.ItemTemplate>
                                    </sfList:SfListView>
                                </Border>
                                </ScrollView>

                                <!--  FAB  -->
                                <Button
                                    x:Name="FabAddAssetExpense"
                                    Grid.Row="2"
                                    Margin="0,0,20,20"
                                    Opacity="0.85"
                                    BackgroundColor="{DynamicResource LoanAppInputTextFgColor}"
                                    Clicked="OnAddAssetExpenseFab_Clicked"
                                    CornerRadius="28"
                                    FontAttributes="Bold"
                                    FontSize="{DynamicResource FontSizeHeading}"
                                    HeightRequest="56"
                                    HorizontalOptions="End"
                                    Text="+"
                                    TextColor="{DynamicResource LoanAppAppShellBgColor}"
                                    VerticalOptions="End"
                                    WidthRequest="56">
                                    <Button.Shadow>
                                        <Shadow Brush="#000000" Offset="0,4" Opacity="0.35" Radius="10" />
                                    </Button.Shadow>
                                    <Button.GestureRecognizers>
                                        <PanGestureRecognizer PanUpdated="OnAssetFabPanUpdated" />
                                    </Button.GestureRecognizers>
                                </Button>

                            </Grid>
                        </Grid>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <!--  ══ Tab 4: Summary ══════════════════════════════════════════  -->
                <tabView:SfTabItem AutomationId="BudgetTabSummary" Header="Summary">
                    <tabView:SfTabItem.Content>
                        <ScrollView BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
                            <VerticalStackLayout
                                x:Name="SummaryPanel"
                                Padding="12,8,12,32"
                                Spacing="12">

                                <!--  No data placeholder  -->
                                <Border
                                    x:Name="SummaryNoData"
                                    Padding="20"
                                    BackgroundColor="{DynamicResource LoanAppAppShellBgColor}"
                                    IsVisible="False"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Label
                                            FontSize="{DynamicResource FontSizeLarge}"
                                            HorizontalTextAlignment="Center"
                                            Text="No budget data yet"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label
                                            FontSize="{DynamicResource FontSizeBody}"
                                            HorizontalTextAlignment="Center"
                                            Opacity="0.6"
                                            Text="Add income and expense entries in the tabs above."
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Hero card: NET EVERY MONTH  -->
                                <Border
                                    x:Name="SummaryHeroCard"
                                    Padding="16"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <VerticalStackLayout Spacing="4">
                                        <!--
                                            Heading plus a tappable ⓘ. An ⓘ rather than an
                                            SfExpander for the same reason the switch rows on this
                                            page use one: BudgetView applies the Syncfusion iOS
                                            touch fix to the tab view but not to expanders, so an
                                            expander here would silently refuse to open on iOS.
                                            See SwitchWithInfoView and CLAUDE.md.
                                        -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Grid.Column="0"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="NET EVERY MONTH"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                VerticalOptions="Center" />
                                            <!--
                                                Padded, because the padding IS the tap target: at
                                                this font size the glyph alone is far under the
                                                44pt minimum.
                                            -->
                                            <Label
                                                Grid.Column="1"
                                                Padding="12,8"
                                                AutomationId="BudgetSummaryInfo"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="ⓘ"
                                                TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}"
                                                VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnSummaryInfoTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                        <!--  Red only when the net is actually negative.  -->
                                        <Label
                                            AutomationId="BudgetNetMonthly"
                                            x:Name="LblNetMonthlyHero"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource LoanAppTextHeroNet}"
                                            Text="{Binding NetAfterOutgoingsMonthlyFormatted}"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding NetAfterOutgoingsIsPositive}"
                                                    TargetType="Label"
                                                    Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource LoanAppNegativeValueColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            AutomationId="BudgetNetYearly"
                                            x:Name="LblNetYearlyHero"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Opacity="0.7"
                                            Text="{Binding NetAfterOutgoingsYearlyFormatted, StringFormat='{0} a year'}"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                        <!--  Hidden until the ⓘ above is tapped.  -->
                                        <Label
                                            x:Name="SummaryExplanationLabel"
                                            Margin="0,10,0,0"
                                            AutomationId="BudgetSummaryInfoDetail"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            IsVisible="False"
                                            Opacity="0.8"
                                            Text="{Binding SummaryExplanationDetail}"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Three-box row: In / Out / Spare  -->
                                <customControls:ThreeColumnBorderedContentView x:Name="SummaryThreeBoxes">
                                    <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalIncomeMonthlyFormatted}" />
                                            <Span Text="{Binding Income.NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="in monthly" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalOutgoingsMonthlyFormatted}" />
                                            <Span Text="{Binding Income.NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="out monthly" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText3>
                                        <FormattedString>
                                            <Span
                                                Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                                Text="{Binding SpareAfterLoanFormatted}"
                                                TextColor="{Binding IsSpareAfterLoanNegative, Converter={StaticResource NegativeToThemeColorConverter}, ConverterParameter=LoanAppChartColor1}" />
                                            <Span Text="{Binding Income.NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="spare after loan" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText3>
                                </customControls:ThreeColumnBorderedContentView>

                                <!--  Income vs Expense donut chart  -->
                                <Border
                                    x:Name="SummaryChartCard"
                                    HeightRequest="360"
                                    Style="{DynamicResource LoanAppChartBorderStyle}">
                                    <Border.Content>
                                        <chart:SfCircularChart Margin="8,8,8,0">
                                            <chart:SfCircularChart.Legend>
                                                <chart:ChartLegend Placement="Bottom" ToggleSeriesVisibility="True">
                                                    <chart:ChartLegend.LabelStyle>
                                                        <chart:ChartLegendLabelStyle
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{DynamicResource LoanAppTextChartLegend}"
                                                            TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                    </chart:ChartLegend.LabelStyle>
                                                </chart:ChartLegend>
                                            </chart:SfCircularChart.Legend>
                                            <chart:SfCircularChart.Series>
                                                <chart:DoughnutSeries
                                                    x:Name="SummaryDonutSeries"
                                                    ExplodeAll="False"
                                                    ExplodeOnTouch="False"
                                                    InnerRadius="0.5"
                                                    ItemsSource="{Binding SummaryDonutData}"
                                                    LegendIcon="Circle"
                                                    PaletteBrushes="{Binding CustomChartColors}"
                                                    ShowDataLabels="True"
                                                    XBindingPath="Name"
                                                    YBindingPath="Value">
                                                    <chart:DoughnutSeries.DataLabelSettings>
                                                        <chart:CircularDataLabelSettings LabelPosition="Inside" UseSeriesPalette="True">
                                                            <chart:CircularDataLabelSettings.LabelStyle>
                                                                <chart:ChartDataLabelStyle
                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                    FontSize="{DynamicResource FontSizeXS}"
                                                                    LabelFormat="{Binding CurrencyFormat}" />
                                                            </chart:CircularDataLabelSettings.LabelStyle>
                                                        </chart:CircularDataLabelSettings>
                                                    </chart:DoughnutSeries.DataLabelSettings>
                                                    <chart:DoughnutSeries.CenterView>
                                                        <StackLayout
                                                            HorizontalOptions="Center"
                                                            Spacing="1"
                                                            VerticalOptions="Center">
                                                            <Label
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{DynamicResource FontSizeXS}"
                                                                HorizontalTextAlignment="Center"
                                                                Opacity="0.6"
                                                                Text="NET / MONTH"
                                                                TextColor="{DynamicResource LoanAppDonutCenterTextColor}" />
                                                            <Label
                                                                FontAttributes="Bold"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{DynamicResource FontSizeSmall}"
                                                                HorizontalTextAlignment="Center"
                                                                Text="{Binding Source={x:Reference thisPage}, Path=BindingContext.NetAfterOutgoingsMonthlyFormatted}"
                                                                TextColor="{DynamicResource LoanAppDonutCenterTextColor}" />
                                                        </StackLayout>
                                                    </chart:DoughnutSeries.CenterView>
                                                </chart:DoughnutSeries>
                                            </chart:SfCircularChart.Series>
                                        </chart:SfCircularChart>
                                    </Border.Content>
                                </Border>
                                <Label
                                    AutomationId="BudgetSummaryCaption"
                                    Margin="0,4,0,12"
                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                    FontSize="{DynamicResource FontSizeXS}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Opacity="0.5"
                                    Text="Monthly income vs expenses"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--  Insights section  -->
                                <Label
                                    Margin="4,8,4,2"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Opacity="0.45"
                                    Text="INSIGHTS"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Border
                                    Padding="0"
                                    Margin="0"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <VerticalStackLayout Spacing="0">
                                        <!--  Income  -->
                                        <Border
                                            Padding="16,12"
                                            BackgroundColor="Transparent"
                                            Stroke="{DynamicResource BorderControlGradientBrush}"
                                            StrokeThickness="1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label
                                                        FontSize="{DynamicResource FontSizeBody}"
                                                        Text="Income"
                                                        TextColor="{DynamicResource LstForegroundColor}" />
                                                    <Label
                                                        FontSize="{DynamicResource FontSizeSmall}"
                                                        Opacity="0.55"
                                                        Text="{Binding IncomeSourceCountText}"
                                                        TextColor="{DynamicResource LstForegroundColor}" />
                                                </VerticalStackLayout>
                                                <Label
                                                    AutomationId="BudgetInsightsIncome"
                                                    Grid.Column="1"
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource FontSizeBody}"
                                                    Text="{Binding TotalIncomeMonthlySigned}"
                                                    TextColor="{DynamicResource LoanAppChartColor1}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                        <!--  Living expenses  -->
                                        <Border
                                            Padding="16,12"
                                            BackgroundColor="Transparent"
                                            Stroke="{DynamicResource BorderControlGradientBrush}"
                                            StrokeThickness="1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label
                                                        FontSize="{DynamicResource FontSizeBody}"
                                                        Text="Living expenses"
                                                        TextColor="{DynamicResource LstForegroundColor}" />
                                                    <Label
                                                        FontSize="{DynamicResource FontSizeSmall}"
                                                        Opacity="0.55"
                                                        Text="{Binding ExpenseRecordCountText}"
                                                        TextColor="{DynamicResource LstForegroundColor}" />
                                                </VerticalStackLayout>
                                                <Label
                                                    AutomationId="BudgetInsightsLivingExpenses"
                                                    Grid.Column="1"
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource FontSizeBody}"
                                                    Text="{Binding TotalExpenseMonthlySigned}"
                                                    TextColor="{DynamicResource LoanAppChartColor2}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                        <!--  Asset running costs  -->
                                        <Border
                                            Padding="16,12"
                                            BackgroundColor="Transparent"
                                            Stroke="{DynamicResource BorderControlGradientBrush}"
                                            StrokeThickness="1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label
                                                        FontSize="{DynamicResource FontSizeBody}"
                                                        Text="Asset running costs"
                                                        TextColor="{DynamicResource LstForegroundColor}" />
                                                    <Label
                                                        FontSize="{DynamicResource FontSizeSmall}"
                                                        Opacity="0.55"
                                                        Text="Maintenance, insurance, rates"
                                                        TextColor="{DynamicResource LstForegroundColor}" />
                                                </VerticalStackLayout>
                                                <Label
                                                    AutomationId="BudgetInsightsAssetCosts"
                                                    Grid.Column="1"
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource FontSizeBody}"
                                                    Text="{Binding AssetRunningCostMonthlyFormatted}"
                                                    TextColor="{DynamicResource LoanAppChartColor2}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                        <!--  Net  -->
                                        <Border
                                            Padding="16,12"
                                            BackgroundColor="Transparent"
                                            Stroke="{DynamicResource BorderControlGradientBrush}"
                                            StrokeThickness="1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource FontSizeBody}"
                                                    Text="Net"
                                                    TextColor="{DynamicResource LstForegroundColor}" />
                                                <!--
                                                    The Net row is a verdict, so it changes colour.
                                                    The Income / Living expenses / Asset costs rows
                                                    above deliberately do NOT: those are categories,
                                                    always signed the same way, and colouring them
                                                    red would say something is wrong when nothing is.
                                                -->
                                                <Label
                                                    AutomationId="BudgetInsightsNet"
                                                    Grid.Column="1"
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource FontSizeBody}"
                                                    Text="{Binding NetAfterOutgoingsMonthlyFormatted}"
                                                    TextColor="{DynamicResource LoanAppChartColor1}"
                                                    VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding NetAfterOutgoingsIsPositive}"
                                                            TargetType="Label"
                                                            Value="False">
                                                            <Setter Property="TextColor" Value="{DynamicResource LoanAppNegativeValueColor}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Top expenses section  -->
                                <Label
                                    Margin="4,8,4,2"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Opacity="0.45"
                                    Text="TOP EXPENSES"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Border
                                    x:Name="TopExpensesCard"
                                    Padding="16"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <VerticalStackLayout Spacing="8">
                                        <sfList:SfListView
                                            x:Name="TopExpensesList"
                                            AutoFitMode="Height"
                                            SelectionMode="None">
                                            <sfList:SfListView.ItemTemplate>
                                                <DataTemplate x:DataType="income:IncomeExpense">
                                                    <Grid Padding="0,6" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            FontSize="{DynamicResource FontSizeBody}"
                                                            Text="{Binding Name}"
                                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                        <Label
                                                            Grid.Column="1"
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource FontSizeBody}"
                                                            Text="{Binding AmountString}"
                                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </sfList:SfListView.ItemTemplate>
                                        </sfList:SfListView>
                                    </VerticalStackLayout>
                                </Border>

                                <!--
                                    "See the projection ›" — the contextual link promised in
                                    NAVIGATION-PROPOSAL.md, sited at the figure it explains.
                                    It matters more here than Loan's schedule link does, because
                                    Projection *left* Budget for What If: without this nothing on
                                    this page points at where it went.
                                -->
                                <Label
                                    AutomationId="BudgetProjectionLink"
                                    Margin="0,4,0,0"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Text="See the projection ›"
                                    TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}"
                                    TextDecorations="Underline">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSeeProjectionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <!--
                                    The net figure above does NOT include the loan repayment, so
                                    on its own this page overstates what is actually spare. The
                                    prototype calls this out as an accuracy matter rather than a
                                    nicety, which is why it is a banner and not microcopy.
                                    Hidden until there is a loan to talk about.
                                -->
                                <Border
                                    x:Name="LoanNotCountedBanner"
                                    Margin="0,8,0,0"
                                    Padding="12"
                                    BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                    IsVisible="False"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0">
                                    <Label
                                        AutomationId="BudgetLoanNotCountedBanner"
                                        x:Name="LblLoanNotCounted"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </Border>

                                <!--  Affordability (if loan data available)  -->
                                <Border
                                    x:Name="AffordabilityCard"
                                    Padding="16"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    IsVisible="False"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <VerticalStackLayout Spacing="8">
                                        <Label
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Opacity="0.6"
                                            Text="LOAN AFFORDABILITY"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label
                                            AutomationId="BudgetAffordabilityVerdict"
                                            x:Name="LblAffordability"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource LoanAppTextHeroVerdict}"
                                            TextColor="{DynamicResource LoanAppNavigationButtonBackgroundColor}" />
                                        <Label
                                            x:Name="LblAffordabilityDesc"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Opacity="0.7"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label
                                            Margin="0,4,0,0"
                                            FontSize="{DynamicResource FontSizeXS}"
                                            Opacity="0.5"
                                            Text="{DynamicResource LoanAppEstimateMicrocopy}"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

            </tabView:SfTabView>

            <!--  Last child of the root Grid so it is topmost. See BusyOverlayView.  -->
            <customControls:BusyOverlayView x:Name="BusyOverlay" Grid.RowSpan="2" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
