    <Color x:Key="LoanAppDataGridCellFg1">#4A2424</Color>
    <Color x:Key="LoanAppDataGridCellFg2">#4A2424</Color>
    <Color x:Key="LoanAppDataGridCellFg3">#4A2424</Color>
    <Color x:Key="LoanAppDataGridCellFg4">#3A1C1C</Color>
    <Color x:Key="LoanAppDataGridCellFg5">#3A1C1C</Color>

    <Color x:Key="LoanAppNavigationButtonBackgroundColor">#B5635D</Color>
    <Color x:Key="LoanAppNavigationButtonDisableBackgroundColor">Transparent</Color>
    <Color x:Key="LoanAppNavigationButtonDisableIconColor">#C99A9A</Color>
    <Color x:Key="LoanAppNavigationButtonIconColor">#F5EBEB</Color>
    <Color x:Key="LoanAppNumericButtonBackgroundColor">#B5635D</Color>
    <Color x:Key="LoanAppNumericButtonSelectionBackgroundColor">#8F4A45</Color>
    <Color x:Key="LoanAppNumericButtonSelectionTextColor">#F5EBEB</Color>
    <Color x:Key="LoanAppNumericButtonTextColor">#F5EBEB</Color>

    <Color x:Key="LoanAppComboDropDownBackgroundColor">#FBEDED</Color>
    <Color x:Key="LoanAppComboDropDownTextColor">#4A2424</Color>
    <Color x:Key="LoanAppComboHighlightedTextColor">#8F4A45</Color>
    <Color x:Key="LoanAppComboSelectedDropDownItemColor">#B5635D</Color>
    <Color x:Key="LoanAppComboTextColor">#4A2424</Color>

    <Color x:Key="LoanAppSwitchThumbBorderColorOn">#8F4A45</Color>
    <Color x:Key="LoanAppSwitchThumbColorOn">#FBEDED</Color>
    <Color x:Key="LoanAppSwitchTrackBorderColorOn">#8F4A45</Color>
    <Color x:Key="LoanAppSwitchTrackColorOn">#B5635D</Color>
    <Color x:Key="LoanAppSwitchThumbBorderColorOff">#C99A9A</Color>
    <Color x:Key="LoanAppSwitchThumbColorOff">#FBEDED</Color>
    <Color x:Key="LoanAppSwitchTrackBorderColorOff">#C99A9A</Color>
    <Color x:Key="LoanAppSwitchTrackColorOff">#E0B8B8</Color>

    <!--  AutoComplete  -->
    <Color x:Key="LoanAppAutoCompleteSelectionTextHighlightColor">#8F4A45</Color>
    <Color x:Key="LoanAppAutoCompleteSelectedDropDownItemBackground">#F6E0E0</Color>
    <Color x:Key="LoanAppAutoCompleteClearButtonColor">#8F4A45</Color>
    <Color x:Key="LoanAppAutoCompleteDropdownBackgroundColor">#FBEDED</Color>
    <Color x:Key="LoanAppAutoCompleteDropdownTextColor">#4A2424</Color>
    <Color x:Key="LoanAppAutoCompleteDropdownBorderColor">#D5B4B4</Color>
    <Color x:Key="LoanAppAutoCompleteHighlightedTextColor">#8F4A45</Color>
    <Color x:Key="LoanAppAutoCompleteWaterColor">#7d4a4a</Color>
    <Color x:Key="LoanAppAutoCompleteTextColor">#4A2424</Color>
    <Color x:Key="LoanAppAutoCompleteNoResultsFoundTextColor">#7d4a4a</Color>

    <!--  AppShell  -->
    <Color x:Key="LoanAppAppShellBgColor">#FBEDED</Color>
    <Color x:Key="LoanAppAppShellFgColor">#4A2424</Color>
    <Color x:Key="LoanAppAppShellTitleColor">#8F4A45</Color>
    <Color x:Key="LoanAppAppShellDisabledColor">#C99A9A</Color>
    <Color x:Key="LoanAppAppShellUnselectedColor">#A87B7B</Color>

    <!--  Modal popup / bottom sheet — matches warm theme  -->
    <Color x:Key="LoanAppPopupBg">#FBEDED</Color>
    <Color x:Key="LoanAppPopupFg">#4A2424</Color>
    <Color x:Key="LoanAppPopupSurface">#F6E0E0</Color>
    <Color x:Key="LoanAppPopupMuted">#7d4a4a</Color>
    <Color x:Key="LoanAppPopupAccent">#B5635D</Color>
    <Color x:Key="LoanAppPopupButtonBg">#B5635D</Color>
    <Color x:Key="LoanAppPopupButtonFg">#F5EBEB</Color>
    <Color x:Key="LoanAppAppShellTabBarBackgroundColor">#FBEDED</Color>
    <Color x:Key="LoanAppAppShellTabBarForegroundColor">#B5635D</Color>
    <Color x:Key="LoanAppAppShellTabBarUnselectedColor">#A87B7B</Color>
    <Color x:Key="LoanAppAppShellTabBarDisabledColor">#C99A9A</Color>
