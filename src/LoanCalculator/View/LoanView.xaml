                                                            TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                    </StackLayout>
                                                </Grid>
                                            </Border>
                                        </StackLayout>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>

                                <expander:SfExpander
                                    Margin="0,5,0,5"
                                    HeaderIconPosition="End"
                                    Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Loan Insights" />
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <StackLayout>
                                            <Border Style="{DynamicResource BorderInsightsHighlightBox}">
