<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoanCalculatorMaui.View.LoanView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:controls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:income="clr-namespace:LoanCalculator.Models.Income;assembly=LoanCalculator.Models"
    xmlns:models="clr-namespace:LoanCalculator.Models;assembly=LoanCalculator.Models"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:range="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:sfList="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:viewmodel="clr-namespace:LoanCalculatorMaui.ViewModel"
    Title="LoanView"
    x:DataType="viewmodel:LoanViewModel">
    <ContentPage.Content>
        <Grid>
            <controls:PopupDisclaimerView />

            <tabView:SfTabView
                x:Name="TabView"
                HeaderHorizontalTextAlignment="Center"
                SelectionChanged="OnTabSelectionChanged">
                <tabView:SfTabItem x:Name="tabDefinitions" Header="Property">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <StackLayout>
                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="20,5,20,5"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="This loan calculator app is intended for informational purposes only and should not be considered a substitute for professional financial advice. It is highly recommended that you consult with your financial adviser before making any financial decisions."
                                        TextColor="{DynamicResource NotificationBgColor}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Grid>

                                <controls:ThreeColumnBorderedContentView>
                                    <controls:ThreeColumnBorderedContentView.FormattedText1>
                                        <FormattedString>
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemCurrencyFontSize}"
                                                Text="{Binding CurrencySymbol}" />
                                            <!--<Span Text=" " />-->
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemHighlightNumberFontSize}"
                                                Text="{Binding HomeLoanInfo.PaymentSummary.Payment.TermPaymentRoundedWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span FontSize="12" Text="{Binding RepaymentFrequencySelected}" />
                                            <Span Text=" " />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                Text="{Binding LoanTermInYears}" />
                                            <Span Text=" " />
                                            <Span FontSize="12" Text=" years" />
                                        </FormattedString>
                                    </controls:ThreeColumnBorderedContentView.FormattedText1>
                                    <controls:ThreeColumnBorderedContentView.FormattedText2>
                                        <FormattedString>
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="17"
                                                Text="{Binding CurrencySymbol}" />
                                            <Span Text="" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                Text="{Binding HomeLoanInfo.PaymentSummary.Payment.TotalInterestPaymentRoundedWithComma}" />
                                            <Span FontSize="12" Text=" total interest payable over " />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                Text="{Binding LoanTermInYears}" />
                                            <Span FontSize="12" Text=" years" />
                                        </FormattedString>
                                    </controls:ThreeColumnBorderedContentView.FormattedText2>
                                    <controls:ThreeColumnBorderedContentView.FormattedText3>
                                        <FormattedString>
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="17"
                                                Text="{Binding CurrencySymbol}" />
                                            <Span Text="" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                Text="{Binding HomeLoanInfo.PaymentSummary.Payment.TotalPaymentRoundedWithComma}" />
                                            <Span FontSize="12" Text=" total repayment (principal + interest)" />
                                        </FormattedString>
                                    </controls:ThreeColumnBorderedContentView.FormattedText3>
                                </controls:ThreeColumnBorderedContentView>

                                <FlexLayout>
                                    <Border Style="{DynamicResource BorderControlHighlightBox}">
                                        <StackLayout>

                                            <Grid Margin="5,0,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>
                                                <core:SfTextInputLayout
                                                    Grid.Column="0"
                                                    Margin="0,0,0,-15"
                                                    Hint="Property Value"
                                                    HorizontalOptions="Start"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c"
                                                        MaximumNumberDecimalDigits="0"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding PropertyAmount}" />
                                                </core:SfTextInputLayout>

                                                <Label
                                                    Grid.Column="1"
                                                    Margin="0,0,0,0"
                                                    HorizontalOptions="Start"
                                                    TextColor="{DynamicResource InputTextFgColor}"
                                                    VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span FontSize="12" Text="Total property amount" />
                                                            <Span Text="{x:Static system:Environment.NewLine}" />
                                                            <Span
                                                                FontAttributes="Bold"
                                                                FontSize="16"
                                                                Text="{Binding PropertyTotalAmount}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="5,0,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Margin="0,0,0,-10"  -->
                                                <!--  PercentDisplayMode="Value"  -->
                                                <core:SfTextInputLayout
                                                    Grid.Column="0"
                                                    Padding="2,0,2,0"
                                                    Hint="Interest Rate"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="##0.##'%'"
                                                        FontSize="14"
                                                        HorizontalTextAlignment="Center"
                                                        LargeChange="1"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        ShowClearButton="False"
                                                        SmallChange="0.05"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        UpDownButtonAlignment="Both"
                                                        UpDownPlacementMode="Inline"
                                                        Value="{Binding InterestRate}" />
                                                </core:SfTextInputLayout>

                                                <!--  Margin="0,0,0,-10"  -->
                                                <core:SfTextInputLayout
                                                    Grid.Column="1"
                                                    Hint="Loan Term"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="00"
                                                        FontSize="14"
                                                        HorizontalTextAlignment="Center"
                                                        LargeChange="5"
                                                        Maximum="30"
                                                        MaximumNumberDecimalDigits="0"
                                                        Minimum="0"
                                                        ShowClearButton="False"
                                                        SmallChange="1"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        UpDownButtonAlignment="Both"
                                                        UpDownPlacementMode="Inline"
                                                        Value="{Binding LoanTermInYears}" />

                                                </core:SfTextInputLayout>
                                            </Grid>

                                            <buttons:SfSegmentedControl
                                                x:Name="SegmentedRepaymentFrequency"
                                                Grid.Row="2"
                                                Margin="15,0,15,10"
                                                ItemsSource="{Binding RepaymentFrequencyCollection}"
                                                SelectedIndex="{Binding RepaymentFrequencySelectedIndex}"
                                                Style="{DynamicResource SegmentDefaultStyle}"
                                                VisibleSegmentsCount="3" />
                                        </StackLayout>
                                    </Border>
                                </FlexLayout>

                                <expander:SfExpander
                                    Margin="0,0,0,5"
                                    HeaderIconPosition="End"
                                    Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span FontSize="10" Text="Deposit: " />
                                                        <Span Text="{Binding DepositAmountStrFormatted}" />
                                                        <Span FontSize="10" Text=" (" />
                                                        <Span FontSize="10" Text="{Binding DepositPercentage, StringFormat='{0:F2}'}" />
                                                        <Span FontSize="10" Text=" %)" />

                                                        <Span FontSize="Micro" Text="  " />

                                                        <Span FontSize="10" Text="Loan: " />
                                                        <Span FontSize="10" Text=" " />
                                                        <Span Text="{Binding LoanAmountStrFormatted}" />
                                                        <Span FontSize="10" Text=" (" />
                                                        <Span FontSize="10" Text="{Binding LoanAmountPercentage, StringFormat='{0:F2}'}" />
                                                        <Span FontSize="10" Text=" %)" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <Border Style="{DynamicResource BorderControlHighlightBox}">
                                            <Grid Margin="5,0,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!--  Margin="0,0,0,-20"  -->
                                                <core:SfTextInputLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Hint="Deposit value (direct)"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c2"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding DepositAmountDirectInput}" />
                                                </core:SfTextInputLayout>


                                                <!--  Margin="0,0,0,-10"  -->
                                                <core:SfTextInputLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Hint="Loan Amount (direct)"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c2"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding LoanAmountDirectInput}" />
                                                </core:SfTextInputLayout>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    BackgroundColor="Transparent">
                                                    <Label FontFamily="{DynamicResource DefaultFontFamily}" Text="Deposit Percentage" />
                                                    <range:SfSlider
                                                        Margin="0,-17,0,0"
                                                        HeightRequest="70"
                                                        IsEnabled="{Binding IsFree}"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        ShowLabels="True"
                                                        StepSize="1"
                                                        Value="{Binding DepositPercentage}">
                                                        <!--
                                                            ShowRange="False"
                                                            StepFrequency="1"
                                                            ShowValueLabel="True"
                                                        -->
                                                        <range:SliderThumbStyle
                                                            Fill="{DynamicResource RangeSliderKnobColor}"
                                                            Stroke="#EE3F3F"
                                                            StrokeThickness="2" />
                                                        <range:SfSlider.LabelStyle>
                                                            <range:SliderLabelStyle
                                                                ActiveFontFamily="{DynamicResource DefaultFontFamily}"
                                                                ActiveFontSize="12"
                                                                ActiveTextColor="{DynamicResource RangeSliderLabelTextColor}"
                                                                InactiveFontFamily="{DynamicResource DefaultFontFamily}"
                                                                InactiveFontSize="12"
                                                                InactiveTextColor="{DynamicResource RangeSliderLabelTextColor}" />
                                                        </range:SfSlider.LabelStyle>
                                                        <range:SfSlider.TrackStyle>
                                                            <range:SliderTrackStyle
                                                                ActiveFill="{DynamicResource RangeSliderTrackSelectionColor}"
                                                                ActiveSize="5"
                                                                InactiveFill="{DynamicResource RangeSliderTrackColor}"
                                                                InactiveSize="1" />
                                                        </range:SfSlider.TrackStyle>
                                                    </range:SfSlider>
                                                </StackLayout>
                                            </Grid>
                                        </Border>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>


                                <expander:SfExpander HeaderIconPosition="End" Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span FontSize="Micro" Text="Upfront costs: " />
                                                        <Span FontFamily="{DynamicResource DefaultFontFamily}" Text="{Binding OtherExpenseTotalAmount}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <Border Style="{DynamicResource BorderControlHighlightBox}">
                                            <Grid Margin="5,0,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding HeightOfGridRowToggledByCountryOnStampDuty}" />
                                                    <RowDefinition Height="70" />
                                                    <RowDefinition Height="70" />
                                                    <RowDefinition Height="70" />
                                                </Grid.RowDefinitions>

                                                <buttons:SfSegmentedControl
                                                    x:Name="SegmentedAustraliaStates"
                                                    Grid.Row="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="10,5"
                                                    IsVisible="{Binding ShowAustralianStateSelectorOnStampDuty}"
                                                    ItemsSource="{Binding AustraliaStateCollection}"
                                                    SelectedIndex="{Binding AustraliaStateSelectedIndex}"
                                                    Style="{DynamicResource SegmentDefaultStyle}"
                                                    VisibleSegmentsCount="8" />

                                                <core:SfTextInputLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,-15"
                                                    Hint="Property stamp duty (estimate)"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding StampDuty}" />
                                                </core:SfTextInputLayout>

                                                <core:SfTextInputLayout
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,-15"
                                                    Hint="Mortgage charges"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding MortgageCharges}" />
                                                </core:SfTextInputLayout>

                                                <core:SfTextInputLayout
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,-15"
                                                    Hint="Conveyance / solicitor fee"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding ConveyancerFee}" />
                                                </core:SfTextInputLayout>

                                                <core:SfTextInputLayout
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,-15"
                                                    BackgroundColor="Transparent"
                                                    ContainerBackground="Transparent"
                                                    Hint="Bank fees"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding BankFee}" />
                                                </core:SfTextInputLayout>

                                                <core:SfTextInputLayout
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,-15"
                                                    Hint="Inspection fee"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding InspectionFee}" />
                                                </core:SfTextInputLayout>

                                                <core:SfTextInputLayout
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,-15"
                                                    Hint="Other expenses"
                                                    Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                    <editors:SfNumericEntry
                                                        CustomFormat="c"
                                                        MaximumNumberDecimalDigits="0"
                                                        ShowClearButton="False"
                                                        TextColor="{DynamicResource InputTextFgColor}"
                                                        Value="{Binding OtherExpenses}" />
                                                </core:SfTextInputLayout>
                                            </Grid>
                                        </Border>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>

                                <FlexLayout
                                    Margin="0"
                                    AlignItems="Stretch"
                                    Direction="Column"
                                    JustifyContent="Center">
                                    <Border
                                        Margin="12,5,12,2"
                                        Background="{DynamicResource ChartInnerBorderGradientBrush}"
                                        HeightRequest="250"
                                        HorizontalOptions="Fill"
                                        Stroke="{DynamicResource ChartOuterBorderGradientBrush}"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        StrokeThickness="2"
                                        VerticalOptions="Center">
                                        <!--  Stroke="{Binding DefaultStyle.ChartBorderColor, Converter={StaticResource StringToColorConverter}}"  -->

                                        <Border.Content>
                                            <!--<Grid Padding="10" HorizontalOptions="Fill">-->
                                            <chart:SfCircularChart>

                                                <!--<chart:SfCircularChart.Resources>
                                                        <DataTemplate x:Key="labelTemplate">
                                                            <StackLayout Orientation="Vertical">
                                                                <Label>
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                                FontSize="10"
                                                                                Text="{Binding Converter={StaticResource doubleToMoneyConverter}}"
                                                                                TextColor="{DynamicResource ChartDataMarkerColor}" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                            </StackLayout>
                                                        </DataTemplate>
                                                    </chart:SfCircularChart.Resources>-->


                                                <chart:SfCircularChart.Legend>
                                                    <chart:ChartLegend Placement="{OnPlatform Android={OnIdiom Phone=Bottom, Tablet=Left}, iOS={OnIdiom Phone=Bottom, Tablet=Left}, UWP=Left}" ToggleSeriesVisibility="True">
                                                        <chart:ChartLegend.LabelStyle>
                                                            <chart:ChartLegendLabelStyle
                                                                FontAttributes="Bold"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                TextColor="{DynamicResource ChartLegendTextColor}" />
                                                        </chart:ChartLegend.LabelStyle>
                                                    </chart:ChartLegend>
                                                </chart:SfCircularChart.Legend>
                                                <chart:SfCircularChart.Series>
                                                    <chart:DoughnutSeries
                                                        ExplodeAll="False"
                                                        ExplodeOnTouch="False"
                                                        InnerRadius="0.5"
                                                        ItemsSource="{Binding ChartPropertyValueWithInterestPayment}"
                                                        LegendIcon="Circle"
                                                        PaletteBrushes="{Binding CustomChartColors}"
                                                        ShowDataLabels="True"
                                                        XBindingPath="Category"
                                                        YBindingPath="Value">
                                                        <!--<chart:DoughnutSeries.SelectionBehavior>
                                                                <chart:DataPointSelectionBehavior SelectionBrush="#314A6E" />
                                                            </chart:DoughnutSeries.SelectionBehavior>-->
                                                        <chart:DoughnutSeries.DataLabelSettings>
                                                            <chart:CircularDataLabelSettings LabelPosition="Inside" UseSeriesPalette="True">
                                                                <!--<chart:CircularDataLabelSettings.ConnectorLineSettings>
                                                                        <chart:ConnectorLineStyle
                                                                            ConnectorType="Curve"
                                                                            Stroke="DarkGray"
                                                                            StrokeWidth="3" />
                                                                    </chart:CircularDataLabelSettings.ConnectorLineSettings>-->
                                                                <chart:CircularDataLabelSettings.LabelStyle>
                                                                    <chart:ChartDataLabelStyle
                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                        FontSize="10"
                                                                        LabelFormat="c" />
                                                                </chart:CircularDataLabelSettings.LabelStyle>
                                                            </chart:CircularDataLabelSettings>
                                                        </chart:DoughnutSeries.DataLabelSettings>


                                                        <chart:DoughnutSeries.CenterView>
                                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                <Label>
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span
                                                                                FontAttributes="Bold"
                                                                                FontSize="10"
                                                                                Text="$"
                                                                                TextColor="{DynamicResource ChartDataMarkerTextColor}" />
                                                                            <Span
                                                                                FontAttributes="Bold"
                                                                                FontSize="10"
                                                                                Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.HomeLoanInfo.PaymentSummary.Payment.TotalPaymentRoundedWithComma}"
                                                                                TextColor="{DynamicResource ChartDataMarkerTextColor}" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                            </StackLayout>
                                                        </chart:DoughnutSeries.CenterView>



                                                        <!--<chart:DoughnutSeries.DataMarker>
                                                            <chart:ChartDataMarker ="True">
                                                                <chart:ChartDataMarker.LabelTemplate>
                                                                    <DataTemplate>
                                                                        <StackLayout Orientation="Vertical">
                                                                            <Label>
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span
                                                                                            FontAttributes="Bold"
                                                                                            FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamily}"
                                                                                            FontSize="10"
                                                                                            Text="{Binding Converter={StaticResource doubleToMoneyConverter}}"
                                                                                            TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.ChartDataMarkerColor, Converter={StaticResource StringToColorConverter}}" />
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                        </StackLayout>
                                                                    </DataTemplate>
                                                                </chart:ChartDataMarker.LabelTemplate>
                                                            </chart:ChartDataMarker>
                                                        </chart:DoughnutSeries.DataMarker>-->
                                                    </chart:DoughnutSeries>
                                                </chart:SfCircularChart.Series>
                                            </chart:SfCircularChart>

                                            <!--</Grid>-->
                                        </Border.Content>



                                    </Border>
                                </FlexLayout>
                            </StackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>
                <tabView:SfTabItem Header="Amortisation">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <StackLayout VerticalOptions="Fill">

                                <buttons:SfSegmentedControl
                                    x:Name="AmortizationBreadDownFrequencySegmentCtrl"
                                    Margin="5"
                                    ItemsSource="{Binding AmortizationBreakdownFrequencyCollection}"
                                    SelectedIndex="{Binding AmortizationBreakdownFrequencySelectedIndex}"
                                    Style="{DynamicResource SegmentDefaultStyle}"
                                    VisibleSegmentsCount="2" />

                                <FlexLayout
                                    Margin="0"
                                    AlignItems="Stretch"
                                    Direction="Column"
                                    JustifyContent="Center">
                                    <Border
                                        Margin="12,5,12,2"
                                        Background="{DynamicResource ChartInnerBorderGradientBrush}"
                                        HeightRequest="250"
                                        HorizontalOptions="Fill"
                                        Stroke="{DynamicResource ChartOuterBorderGradientBrush}"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        StrokeThickness="2"
                                        VerticalOptions="Center">
                                        <Border.Content>
                                            <Grid Padding="10" HorizontalOptions="Fill">
                                                <chart:SfCartesianChart
                                                    BackgroundColor="Transparent"
                                                    HeightRequest="200"
                                                    HorizontalOptions="FillAndExpand"
                                                    IsVisible="{Binding IsAmortizationYearBased}"
                                                    PaletteBrushes="{Binding CustomChartColors}"
                                                    VerticalOptions="FillAndExpand">
                                                    <chart:SfCartesianChart.Margin>
                                                        <OnPlatform x:TypeArguments="Thickness">
                                                            <On Platform="Windows" Value="0,0,20,0" />
                                                            <On Platform="Android" Value="0,0,20,0" />
                                                            <On Platform="iOS" Value="0,0,20,0" />
                                                        </OnPlatform>
                                                    </chart:SfCartesianChart.Margin>

                                                    <chart:SfCartesianChart.Title>
                                                        <Label
                                                            BackgroundColor="Transparent"
                                                            FontSize="9"
                                                            Text="Loan repayment breakdown"
                                                            TextColor="{DynamicResource ChartTitleTextColor}" />
                                                    </chart:SfCartesianChart.Title>
                                                    <chart:SfCartesianChart.XAxes>
                                                        <chart:CategoryAxis
                                                            EdgeLabelsDrawingMode="Fit"
                                                            LabelPlacement="BetweenTicks"
                                                            ShowMajorGridLines="False">
                                                            <chart:CategoryAxis.LabelStyle>
                                                                <chart:ChartAxisLabelStyle
                                                                    FontAttributes="Bold"
                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                    FontSize="12"
                                                                    TextColor="{DynamicResource ChartAxisTextColor}" />
                                                            </chart:CategoryAxis.LabelStyle>
                                                            <chart:CategoryAxis.MajorTickStyle>
                                                                <chart:ChartAxisTickStyle TickSize="8" />
                                                            </chart:CategoryAxis.MajorTickStyle>
                                                        </chart:CategoryAxis>
                                                    </chart:SfCartesianChart.XAxes>
                                                    <chart:SfCartesianChart.YAxes>
                                                        <chart:NumericalAxis>
                                                            <chart:NumericalAxis.LabelStyle>
                                                                <chart:ChartAxisLabelStyle
                                                                    x:Name="amortYearSecondaryAxisLabelStyle"
                                                                    FontAttributes="Bold"
                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                    FontSize="12"
                                                                    TextColor="{DynamicResource ChartAxisTextColor}" />
                                                            </chart:NumericalAxis.LabelStyle>
                                                            <chart:NumericalAxis.AxisLineStyle>
                                                                <chart:ChartLineStyle StrokeWidth="0" />
                                                            </chart:NumericalAxis.AxisLineStyle>
                                                            <chart:NumericalAxis.MajorTickStyle>
                                                                <chart:ChartAxisTickStyle TickSize="0" />
                                                            </chart:NumericalAxis.MajorTickStyle>
                                                        </chart:NumericalAxis>
                                                    </chart:SfCartesianChart.YAxes>
                                                    <chart:SfCartesianChart.Legend>
                                                        <chart:ChartLegend Placement="{OnPlatform Android={OnIdiom Phone=Bottom, Tablet=Left}, iOS={OnIdiom Phone=Bottom, Tablet=Left}, UWP=Left}" ToggleSeriesVisibility="True" />
                                                        <!--
                                                            IconHeight="14"
                                                            IconWidth="14"
                                                        -->
                                                    </chart:SfCartesianChart.Legend>
                                                    <chart:SfCartesianChart.Series>
                                                        <chart:StackingColumnSeries
                                                            EnableAnimation="True"
                                                            ItemsSource="{Binding AmortizationChartInterestAmountAxis}"
                                                            LegendIcon="Rectangle"
                                                            Stroke="{DynamicResource ChartColor1}"
                                                            XBindingPath="Name"
                                                            YBindingPath="Value" />

                                                        <chart:StackingColumnSeries
                                                            EnableAnimation="True"
                                                            ItemsSource="{Binding AmortizationChartPrincipalAmountAxis}"
                                                            LegendIcon="Rectangle"
                                                            Stroke="{DynamicResource ChartColor2}"
                                                            XBindingPath="Name"
                                                            YBindingPath="Value" />
                                                    </chart:SfCartesianChart.Series>
                                                </chart:SfCartesianChart>

                                                <chart:SfCartesianChart
                                                    BackgroundColor="Transparent"
                                                    HeightRequest="200"
                                                    HorizontalOptions="FillAndExpand"
                                                    IsVisible="{Binding IsAmortizationTermBased}"
                                                    PaletteBrushes="{Binding CustomChartColors}"
                                                    VerticalOptions="FillAndExpand">
                                                    <!--<chart:SfCartesianChart.Margin>
                                                    <OnPlatform x:TypeArguments="Thickness" WinPhone="0,0,20,0" />
                                                </chart:SfCartesianChart.Margin>-->
                                                    <chart:SfCartesianChart.Title>
                                                        <Label
                                                            BackgroundColor="Transparent"
                                                            FontSize="9"
                                                            Text="Loan repayment breakdown"
                                                            TextColor="{DynamicResource ChartTitleTextColor}" />

                                                    </chart:SfCartesianChart.Title>
                                                    <chart:SfCartesianChart.XAxes>
                                                        <chart:CategoryAxis
                                                            EdgeLabelsDrawingMode="Shift"
                                                            LabelPlacement="BetweenTicks"
                                                            ShowMajorGridLines="False">
                                                            <chart:CategoryAxis.LabelStyle>
                                                                <chart:ChartAxisLabelStyle
                                                                    FontAttributes="Bold"
                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                    FontSize="12"
                                                                    TextColor="{DynamicResource ChartAxisTextColor}" />
                                                            </chart:CategoryAxis.LabelStyle>
                                                            <chart:CategoryAxis.MajorTickStyle>
                                                                <chart:ChartAxisTickStyle TickSize="0" />
                                                            </chart:CategoryAxis.MajorTickStyle>
                                                        </chart:CategoryAxis>
                                                    </chart:SfCartesianChart.XAxes>
                                                    <chart:SfCartesianChart.YAxes>
                                                        <chart:NumericalAxis>
                                                            <chart:NumericalAxis.LabelStyle>
                                                                <chart:ChartAxisLabelStyle
                                                                    x:Name="amortTermSecondaryAxisLabelStyle"
                                                                    FontAttributes="Bold"
                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                    FontSize="12"
                                                                    TextColor="{DynamicResource ChartAxisTextColor}" />
                                                            </chart:NumericalAxis.LabelStyle>
                                                            <chart:NumericalAxis.AxisLineStyle>
                                                                <chart:ChartLineStyle StrokeWidth="0" />
                                                            </chart:NumericalAxis.AxisLineStyle>
                                                            <chart:NumericalAxis.MajorTickStyle>
                                                                <chart:ChartAxisTickStyle TickSize="0" />
                                                            </chart:NumericalAxis.MajorTickStyle>
                                                        </chart:NumericalAxis>
                                                    </chart:SfCartesianChart.YAxes>
                                                    <chart:SfCartesianChart.Legend>
                                                        <chart:ChartLegend Placement="{OnPlatform Android={OnIdiom Phone=Bottom, Tablet=Left}, iOS={OnIdiom Phone=Bottom, Tablet=Left}, UWP=Left}" ToggleSeriesVisibility="True" />
                                                    </chart:SfCartesianChart.Legend>
                                                    <chart:SfCartesianChart.Series>

                                                        <chart:StackingAreaSeries
                                                            EnableAnimation="True"
                                                            ItemsSource="{Binding AmortizationChartAreaInterestAmountAxis}"
                                                            LegendIcon="Rectangle"
                                                            Stroke="{DynamicResource ChartColor1}"
                                                            XBindingPath="Name"
                                                            YBindingPath="Value" />
                                                        <chart:StackingAreaSeries
                                                            EnableAnimation="True"
                                                            ItemsSource="{Binding AmortizationChartAreaPrincipalAmountAxis}"
                                                            LegendIcon="Rectangle"
                                                            Stroke="{DynamicResource ChartColor2}"
                                                            XBindingPath="Name"
                                                            YBindingPath="Value" />

                                                    </chart:SfCartesianChart.Series>
                                                </chart:SfCartesianChart>
                                            </Grid>
                                        </Border.Content>
                                    </Border>



                                </FlexLayout>

                                <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <pager:SfDataPager
                                        x:Name="dataPager"
                                        Grid.Row="0"
                                        NumericButtonsGenerateMode="Auto"
                                        PageSize="15"
                                        Source="{Binding PaymentAmortization}" />

                                    <datagrid:SfDataGrid
                                        x:Name="dataGrid"
                                        Grid.Row="1"
                                        AutoGenerateColumnsMode="None"
                                        ColumnWidthMode="Fill"
                                        ItemsSource="{Binding Source={x:Reference dataPager}, Path=PagedSource}"
                                        VerticalOptions="Fill">
                                        <datagrid:SfDataGrid.Columns>

                                            <datagrid:DataGridTemplateColumn HeaderText="Period" MappingName="PaymentPeriod">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label
                                                            BackgroundColor="#154360"
                                                            HorizontalTextAlignment="Center"
                                                            Text="Period"
                                                            TextColor="#eaf2f8"
                                                            VerticalTextAlignment="Center" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Frame
                                                            Margin="0"
                                                            Padding="0"
                                                            BackgroundColor="#d4e6f1"
                                                            BorderColor="Transparent"
                                                            HasShadow="False">
                                                            <Label
                                                                x:DataType="models:PaymentAmortisationOutput"
                                                                HorizontalTextAlignment="Center"
                                                                Text="{Binding PaymentPeriod}"
                                                                TextColor="#154360"
                                                                VerticalTextAlignment="Center" />
                                                        </Frame>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Principal" MappingName="PrincipalAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label
                                                            BackgroundColor="#154360"
                                                            HorizontalTextAlignment="Center"
                                                            Text="Principal"
                                                            TextColor="#eaf2f8"
                                                            VerticalTextAlignment="Center" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Frame
                                                            Margin="0"
                                                            Padding="0"
                                                            BackgroundColor="#a9cce3"
                                                            BorderColor="Transparent"
                                                            HasShadow="False">
                                                            <Label
                                                                x:DataType="models:PaymentAmortisationOutput"
                                                                HorizontalTextAlignment="Center"
                                                                Text="{Binding PrincipalAmountRounded}"
                                                                TextColor="#154360"
                                                                VerticalTextAlignment="Center" />
                                                        </Frame>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Interest" MappingName="InterestAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label
                                                            BackgroundColor="#154360"
                                                            HorizontalTextAlignment="Center"
                                                            Text="Interest"
                                                            TextColor="#eaf2f8"
                                                            VerticalTextAlignment="Center" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Frame
                                                            Margin="0"
                                                            Padding="0"
                                                            BackgroundColor="#5499c7"
                                                            BorderColor="Transparent"
                                                            HasShadow="False">
                                                            <Label
                                                                x:DataType="models:PaymentAmortisationOutput"
                                                                HorizontalTextAlignment="Center"
                                                                Text="{Binding InterestAmountRounded}"
                                                                TextColor="#154360"
                                                                VerticalTextAlignment="Center" />
                                                        </Frame>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Balance" MappingName="BalanceAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label
                                                            BackgroundColor="#154360"
                                                            HorizontalTextAlignment="Center"
                                                            Text="Balance"
                                                            TextColor="#eaf2f8"
                                                            VerticalTextAlignment="Center" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Frame
                                                            Margin="0"
                                                            Padding="0"
                                                            BackgroundColor="#2980b9"
                                                            BorderColor="Transparent"
                                                            HasShadow="False">
                                                            <Label
                                                                x:DataType="models:PaymentAmortisationOutput"
                                                                HorizontalTextAlignment="Center"
                                                                Text="{Binding BalanceAmountRounded}"
                                                                TextColor="#154360"
                                                                VerticalTextAlignment="Center" />
                                                        </Frame>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>
                                        </datagrid:SfDataGrid.Columns>

                                        <!--  AlternatingRowColor="Yellow"  -->
                                        <!--<datagrid:SfDataGrid.DefaultStyle>
                                            <core:DataGridStyle
                                                AlternateRowBackground="{DynamicResource DataGridRowAlternateBackgroundColor}"
                                                GridLineStrokeThickness="3"
                                                HeaderRowBackground="{DynamicResource DataGridHeaderBackgroundColor}"
                                                HeaderRowFontFamily="{DynamicResource DefaultFontFamily}"
                                                HeaderRowFontSize="10"
                                                HeaderRowTextColor="{DynamicResource DataGridHeaderForegroundColor}"
                                                RowBackground="{DynamicResource DataGridRowBackgroundColor}"
                                                RowFontFamily="{DynamicResource DefaultFontFamily}"
                                                RowTextColor="{DynamicResource DataGridRowForegroundColor}" />
                                        </datagrid:SfDataGrid.DefaultStyle>-->

                                        <!--  GridCellBorderColor="{Binding DefaultStyle.DataGridGridCellBorderColor, Converter={StaticResource StringToColorConverter}}"  -->
                                        <!--  GridCellBorderWidth="1"  -->
                                        <!--  GridLinesVisibility="Horizontal"  -->
                                    </datagrid:SfDataGrid>

                                </Grid>
                            </StackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <tabView:SfTabItem Header="Expense on Property">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <StackLayout>
                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="20,5,20,5"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="Enter the anticipated ongoing costs for this property (such as maintenance, insurance, and taxes) after purchase, excluding mortgage payments."
                                        TextColor="{DynamicResource NotificationBgColor}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Grid>

                                <controls:ThreeColumnBorderedContentView>
                                    <controls:ThreeColumnBorderedContentView.FormattedText1>
                                        <FormattedString>
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemCurrencyFontSize}"
                                                Text="{Binding CurrencySymbol}" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemHighlightNumberFontSize}"
                                                Text="{Binding TotalMonthlyExpenseWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemHighlightNumberFontSize}"
                                                Text="Monthly this property (expense)"
                                                TextColor="Red" />
                                        </FormattedString>
                                    </controls:ThreeColumnBorderedContentView.FormattedText1>
                                    <controls:ThreeColumnBorderedContentView.FormattedText2>
                                        <FormattedString>
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemCurrencyFontSize}"
                                                Text="{Binding CurrencySymbol}" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemHighlightNumberFontSize}"
                                                Text="{Binding TotalYearlyExpenseWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemHighlightNumberFontSize}"
                                                Text="Yearly this property (expense)"
                                                TextColor="Red" />
                                        </FormattedString>
                                    </controls:ThreeColumnBorderedContentView.FormattedText2>
                                    <controls:ThreeColumnBorderedContentView.FormattedText3>
                                        <FormattedString>
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemCurrencyFontSize}"
                                                Text="{Binding CurrencySymbol}" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding DefaultStyle.BoxItemHighlightNumberFontSize}"
                                                Text="{Binding TotalMonthlyOverallExpense}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding CurrencySymbol}" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                Text="{Binding TotalMonthlyExpenseWithComma}" />
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text=" + " />
                                            <Span
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding CurrencySymbol}" />
                                            <Span
                                                CharacterSpacing="-1"
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                Text="{Binding TotalMonthlyExistingExpense}" />
                                        </FormattedString>
                                    </controls:ThreeColumnBorderedContentView.FormattedText3>
                                </controls:ThreeColumnBorderedContentView>

                                <FlexLayout>
                                    <Border Style="{DynamicResource BorderControlHighlightBox}">
                                        <Border.Content>
                                            <Grid>
                                                <StackLayout>
                                                    <Grid Margin="5,0,5,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="25*" />
                                                            <ColumnDefinition Width="25*" />
                                                            <ColumnDefinition Width="25*" />
                                                            <ColumnDefinition Width="25*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="80" />
                                                            <RowDefinition Height="10" />
                                                            <RowDefinition Height="80" />
                                                        </Grid.RowDefinitions>

                                                        <core:SfTextInputLayout
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,0,5,0"
                                                            ErrorText="Describe your income type"
                                                            HasError="{Binding HasErrorIncomeDescription}"
                                                            HelperText="Describe your expense type"
                                                            Hint="Expense"
                                                            Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                            <Entry
                                                                x:Name="txtIncomeDescription"
                                                                FontSize="14"
                                                                Placeholder="Salaray Primary - Sample"
                                                                Text="{Binding IncomeEntryName}"
                                                                TextColor="{DynamicResource InputTextFgColor}" />

                                                        </core:SfTextInputLayout>

                                                        <core:SfTextInputLayout
                                                            Grid.Row="0"
                                                            Grid.Column="2"
                                                            Grid.ColumnSpan="2"
                                                            ErrorText="Amount should be &gt; 0"
                                                            HasError="{Binding HasErrorIncomeAmount}"
                                                            HelperText="Income amount"
                                                            Hint="Amount"
                                                            Style="{DynamicResource CommonTextInputLayoutStyle}">
                                                            <core:SfNumericEntry
                                                                x:Name="txtInputAmount"
                                                                CustomFormat="c"
                                                                FontSize="14"
                                                                MaximumNumberDecimalDigits="2"
                                                                TextColor="{DynamicResource InputTextFgColor}"
                                                                Value="{Binding IncomeEntryAmount}" />
                                                        </core:SfTextInputLayout>

                                                        <core:SfTextInputLayout
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,0,0,0"
                                                            Hint="Frequency"
                                                            Style="{DynamicResource CommonTextInputLayoutStyle}">

                                                            <editors:SfComboBox
                                                                DropDownBackground="{DynamicResource ComboDropDownBackgroundColor}"
                                                                DropDownItemFontFamily="{DynamicResource DefaultFontFamily}"
                                                                DropDownItemTextColor="{DynamicResource ComboDropDownTextColor}"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="14"
                                                                HighlightedTextColor="{DynamicResource ComboHighlightedTextColor}"
                                                                IsClearButtonVisible="False"
                                                                IsFilteringEnabled="False"
                                                                ItemsSource="{Binding IncomeFrequencyCollection}"
                                                                SelectedDropDownItemBackground="{DynamicResource ComboSelectedDropDownItemColor}"
                                                                SelectedItem="{Binding IncomeExpenseFrequencySelectedIndex, Mode=TwoWay}"
                                                                TextColor="{DynamicResource ComboTextColor}"
                                                                TextHighlightMode="MultipleOccurrence"
                                                                TextSearchMode="Contains">
                                                                <!--<editors:SfComboBox.HeightRequest>
                                            <OnPlatform
x:TypeArguments="x:Double"
Android="60"
WinPhone="32"
iOS="30" />
                                        </editors:SfComboBox.HeightRequest>-->
                                                            </editors:SfComboBox>
                                                        </core:SfTextInputLayout>

                                                        <core:SfButton
                                                            x:Name="AddNewIncome"
                                                            Grid.Row="2"
                                                            Grid.Column="2"
                                                            Clicked="AddNewIncome_Clicked"
                                                            Style="{DynamicResource ButtonStyle}">
                                                            <Grid>
                                                                <Label Style="{DynamicResource ButtonLabelStyle}" Text="Add" />
                                                            </Grid>
                                                        </core:SfButton>

                                                        <core:SfButton
                                                            Grid.Row="2"
                                                            Grid.Column="3"
                                                            Clicked="ResetButton_Clicked"
                                                            Style="{DynamicResource ButtonStyle}">
                                                            <Grid>
                                                                <Label Style="{DynamicResource ButtonLabelStyle}" Text="Reset" />
                                                            </Grid>
                                                        </core:SfButton>
                                                    </Grid>
                                                </StackLayout>
                                            </Grid>
                                        </Border.Content>
                                    </Border>

                                </FlexLayout>

                                <StackLayout>
                                    <editors:SfAutocomplete
                                        x:Name="autoComplete"
                                        Grid.Column="0"
                                        Margin="5,3,5,0"
                                        BackgroundColor="{DynamicResource AutoCompleteBackgroundColor}"
                                        ClearButtonIconColor="{DynamicResource AutoCompleteClearButtonColor}"
                                        Completed="autoComplete_Completed"
                                        DisplayMemberPath="Name"
                                        DropDownBackground="{DynamicResource AutoCompleteDropdownBackgroundColor}"
                                        DropDownItemFontFamily="{DynamicResource DefaultFontFamily}"
                                        DropDownItemTextColor="{DynamicResource AutoCompleteDropdownTextColor}"
                                        DropDownStroke="{DynamicResource AutoCompleteDropdownBorderColor}"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        HighlightedTextColor="{DynamicResource AutoCompleteHighlightedTextColor}"
                                        HighlightedTextFontAttributes="Bold"
                                        IsClearButtonVisible="True"
                                        ItemsSource="{Binding AutocompleteList}"
                                        MinimumPrefixCharacters="2"
                                        NoResultsFoundText="No Results Found"
                                        Placeholder="Enter here to search"
                                        PlaceholderColor="{DynamicResource AutoCompleteWaterColor}"
                                        SelectionChanged="autoComplete_SelectionChanged"
                                        ShowBorder="False"
                                        TextColor="{DynamicResource AutoCompleteTextColor}"
                                        TextHighlightMode="MultipleOccurrence"
                                        TextSearchMode="Contains">
                                        <editors:SfAutocomplete.NoResultsFoundTemplate>
                                            <DataTemplate>
                                                <Label
                                                    Margin="70,10,0,0"
                                                    FontAttributes="Italic"
                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                    FontSize="16"
                                                    Text="Not Found"
                                                    TextColor="{DynamicResource AutoCompleteNoResultsFoundTextColor}" />
                                            </DataTemplate>
                                        </editors:SfAutocomplete.NoResultsFoundTemplate>
                                    </editors:SfAutocomplete>
                                    <!--  ValueChanged="autoComplete_ValueChanged"  -->
                                    <!--  SelectionChanging="autoComplete_SelectionChanging"  -->
                                </StackLayout>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <sfList:SfListView
                                        x:Name="lstEntry"
                                        HeightRequest="300"
                                        ItemSize="60"
                                        ItemsSource="{Binding ExpensesList}"
                                        SelectionMode="None">
                                        <sfList:SfListView.ItemTemplate>
                                            <DataTemplate x:DataType="income:IncomeExpense">
                                                <Frame
                                                    Margin="5,8,5,2"
                                                    Padding="2"
                                                    BackgroundColor="Transparent"
                                                    CornerRadius="4"
                                                    HasShadow="True">
                                                    <Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40*" />
                                                                <ColumnDefinition Width="20*" />
                                                                <ColumnDefinition Width="20*" />
                                                                <ColumnDefinition Width="40" />
                                                                <ColumnDefinition Width="40" />
                                                            </Grid.ColumnDefinitions>

                                                            <Label
                                                                Grid.Column="0"
                                                                Margin="5,0,0,0"
                                                                FontSize="12"
                                                                HorizontalOptions="Start"
                                                                HorizontalTextAlignment="Start"
                                                                Text="{Binding Name}"
                                                                TextColor="{DynamicResource LstForegroundColor}"
                                                                VerticalOptions="Center" />
                                                            <Label
                                                                Grid.Column="1"
                                                                FontSize="12"
                                                                HorizontalOptions="Start"
                                                                HorizontalTextAlignment="Start"
                                                                Text="{Binding AmountString}"
                                                                TextColor="{DynamicResource LstForegroundColor}"
                                                                VerticalOptions="Center" />
                                                            <Label
                                                                Grid.Column="2"
                                                                FontSize="12"
                                                                HorizontalOptions="End"
                                                                Text="{Binding Frequency}"
                                                                TextColor="{DynamicResource LstForegroundColor}"
                                                                VerticalOptions="Center" />

                                                            <buttons:SfButton
                                                                x:Name="btnEditEntry"
                                                                Grid.Column="3"
                                                                AutomationId="{Binding Id}"
                                                                Clicked="btnEditEntry_Clicked"
                                                                Style="{DynamicResource ListIconButtonStyle}">
                                                                <Grid>
                                                                    <Image Margin="10" Source="icon_edit.png" />
                                                                </Grid>
                                                            </buttons:SfButton>
                                                            <buttons:SfButton
                                                                x:Name="btnDeleteEntry"
                                                                Grid.Column="4"
                                                                AutomationId="{Binding Id}"
                                                                Clicked="btnDeleteEntry_Clicked"
                                                                Style="{DynamicResource ListIconButtonStyle}">
                                                                <Grid>
                                                                    <Image Margin="10" Source="icon_delete.png" />
                                                                </Grid>
                                                            </buttons:SfButton>
                                                        </Grid>
                                                    </Grid>
                                                </Frame>
                                            </DataTemplate>
                                        </sfList:SfListView.ItemTemplate>
                                    </sfList:SfListView>
                                </Grid>

                            </StackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <tabView:SfTabItem Header="Insights">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <StackLayout>
                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="20,5,20,5"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="This loan calculator app is intended for informational purposes only and should not be considered a substitute for professional financial advice. It is highly recommended that you consult with your financial adviser before making any financial decisions."
                                        TextColor="{DynamicResource NotificationBgColor}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Grid>

                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <core:SfButton
                                        Grid.Column="0"
                                        CornerRadius="5"
                                        Style="{DynamicResource ButtonStyle}">
                                        <Grid>
                                            <Label Style="{DynamicResource ButtonLabelStyle}" Text="Export Insights" />
                                        </Grid>
                                    </core:SfButton>
                                </Grid>

                                <expander:SfExpander HeaderIconPosition="End" Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Property Insights" />
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <StackLayout>
                                            <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                <Grid>
                                                    <StackLayout Margin="0,0,0,5">
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.PropertyAmount}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.PropertyEstimatedUpfront}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView
                                                            Margin="0,0,0,20"
                                                            InsightItem="{Binding InsightsDetails.PropertyTotalAmount}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                    </StackLayout>
                                                </Grid>
                                            </Border>
                                        </StackLayout>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>

                                <expander:SfExpander
                                    Margin="0,5,0,5"
                                    HeaderIconPosition="End"
                                    Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Loan Insights" />
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <StackLayout>
                                            <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                <Grid>
                                                    <StackLayout Margin="0,0,0,5">
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.LoanAmount}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.DepositAmount}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.TotalRepaymentToBank}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.TotalInterestToBank}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <chart:SfCartesianChart
                                                            x:Name="insightsChart"
                                                            Margin="10,0,20,0"
                                                            BackgroundColor="Transparent"
                                                            HeightRequest="150"
                                                            HorizontalOptions="FillAndExpand"
                                                            IsTransposed="True"
                                                            PaletteBrushes="{Binding CustomChartColors}"
                                                            VerticalOptions="FillAndExpand">
                                                            <!--<chart:SfCartesianChart.Margin>
                                                                <OnPlatform x:TypeArguments="Thickness">
                                                                    <On Platform="Windows" Value="10,0,20,0" />
                                                                    <On Platform="Android" Value="10,0,20,0" />
                                                                    <On Platform="iOS" Value="0,10,20,0" />
                                                                </OnPlatform>
                                                            </chart:SfCartesianChart.Margin>-->
                                                            <chart:SfCartesianChart.Legend>
                                                                <chart:ChartLegend Placement="{OnPlatform Android={OnIdiom Phone=Bottom, Tablet=Left}, iOS={OnIdiom Phone=Bottom, Tablet=Left}, UWP=Bottom}" ToggleSeriesVisibility="True">
                                                                    <chart:ChartLegend.LabelStyle>
                                                                        <chart:ChartLegendLabelStyle
                                                                            FontAttributes="Bold"
                                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                                            TextColor="{DynamicResource ChartLegendTextColor}" />
                                                                    </chart:ChartLegend.LabelStyle>
                                                                </chart:ChartLegend>
                                                            </chart:SfCartesianChart.Legend>
                                                            <chart:SfCartesianChart.XAxes>
                                                                <chart:CategoryAxis IsVisible="False" ShowMajorGridLines="False" />
                                                            </chart:SfCartesianChart.XAxes>
                                                            <chart:SfCartesianChart.YAxes>
                                                                <chart:NumericalAxis IsVisible="False" ShowMajorGridLines="False" />
                                                            </chart:SfCartesianChart.YAxes>
                                                            <chart:SfCartesianChart.Series>
                                                                <chart:StackingColumn100Series
                                                                    EnableAnimation="True"
                                                                    IsVisibleOnLegend="True"
                                                                    ItemsSource="{Binding InsightChartLoanDepositAxis}"
                                                                    Label="Deposit"
                                                                    LabelContext="YValue"
                                                                    LegendIcon="Rectangle"
                                                                    ShowDataLabels="True"
                                                                    Stroke="{DynamicResource ChartColor1}"
                                                                    XBindingPath="Name"
                                                                    YBindingPath="Value">
                                                                    <chart:StackingColumn100Series.DataLabelSettings>
                                                                        <chart:CartesianDataLabelSettings LabelPlacement="Inner">
                                                                            <chart:CartesianDataLabelSettings.LabelStyle>
                                                                                <chart:ChartDataLabelStyle
                                                                                    FontAttributes="Bold"
                                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                                    FontSize="10"
                                                                                    LabelFormat="c"
                                                                                    TextColor="{DynamicResource ChartDataMarkerTextColor}" />
                                                                            </chart:CartesianDataLabelSettings.LabelStyle>
                                                                        </chart:CartesianDataLabelSettings>
                                                                    </chart:StackingColumn100Series.DataLabelSettings>
                                                                </chart:StackingColumn100Series>
                                                                <chart:StackingColumn100Series
                                                                    EnableAnimation="True"
                                                                    ItemsSource="{Binding InsightChartLoanAmountAxis}"
                                                                    Label="Loan"
                                                                    LabelContext="YValue"
                                                                    LegendIcon="Rectangle"
                                                                    ShowDataLabels="True"
                                                                    Stroke="{DynamicResource ChartColor2}"
                                                                    XBindingPath="Name"
                                                                    YBindingPath="Value">
                                                                    <chart:StackingColumn100Series.DataLabelSettings>
                                                                        <chart:CartesianDataLabelSettings LabelPlacement="Inner">
                                                                            <chart:CartesianDataLabelSettings.LabelStyle>
                                                                                <chart:ChartDataLabelStyle
                                                                                    FontAttributes="Bold"
                                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                                    FontSize="10"
                                                                                    LabelFormat="c"
                                                                                    TextColor="{DynamicResource ChartDataMarkerTextColor}" />
                                                                            </chart:CartesianDataLabelSettings.LabelStyle>
                                                                        </chart:CartesianDataLabelSettings>
                                                                    </chart:StackingColumn100Series.DataLabelSettings>
                                                                </chart:StackingColumn100Series>
                                                                <chart:StackingColumn100Series
                                                                    EnableAnimation="True"
                                                                    ItemsSource="{Binding InsightChartLoanInterestAxis}"
                                                                    Label="Interest"
                                                                    LabelContext="YValue"
                                                                    LegendIcon="Rectangle"
                                                                    ShowDataLabels="True"
                                                                    Stroke="{DynamicResource ChartColor3}"
                                                                    XBindingPath="Name"
                                                                    YBindingPath="Value">
                                                                    <chart:StackingColumn100Series.DataLabelSettings>
                                                                        <chart:CartesianDataLabelSettings LabelPlacement="Inner">
                                                                            <chart:CartesianDataLabelSettings.LabelStyle>
                                                                                <chart:ChartDataLabelStyle
                                                                                    FontAttributes="Bold"
                                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                                    FontSize="10"
                                                                                    LabelFormat="c"
                                                                                    TextColor="{DynamicResource ChartDataMarkerTextColor}" />
                                                                            </chart:CartesianDataLabelSettings.LabelStyle>
                                                                        </chart:CartesianDataLabelSettings>
                                                                    </chart:StackingColumn100Series.DataLabelSettings>
                                                                </chart:StackingColumn100Series>
                                                            </chart:SfCartesianChart.Series>
                                                        </chart:SfCartesianChart>

                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.LoanTerm}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.InterestRate}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.RepaymentFrequency}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.RepaymentDetailSelectedFrequency}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView
                                                            Margin="0,0,0,20"
                                                            InsightItem="{Binding InsightsDetails.RepaymentDetailYearly}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                    </StackLayout>
                                                </Grid>
                                            </Border>
                                        </StackLayout>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>

                                <expander:SfExpander HeaderIconPosition="End" Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Expense Income Insights" />
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <StackLayout>
                                            <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                <Grid>
                                                    <StackLayout Margin="0,0,0,5">
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseExistingMonthly}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseExistingYearly}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseThisPropertyMonthly}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseThisPropertyYearly}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseTotalMonthly}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseTotalYearly}" TextColor="{DynamicResource LstForegroundColor}" />

                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeTotalMonthly}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeTotalYearly}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView InsightItem="{Binding InsightsDetails.SavingMonthly}" TextColor="{DynamicResource LstForegroundColor}" />
                                                        <controls:InsightsItemView
                                                            Margin="0,0,0,20"
                                                            InsightItem="{Binding InsightsDetails.SavingYearly}"
                                                            TextColor="{DynamicResource LstForegroundColor}" />
                                                    </StackLayout>
                                                </Grid>
                                            </Border>
                                        </StackLayout>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>
                            </StackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>
            </tabView:SfTabView>
        </Grid>
    </ContentPage.Content>
</ContentPage>