<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="thisPage"
    x:Class="LoanCalculatorMaui.View.WhatIfView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:customControls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:range="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:primaryModels="clr-namespace:LoanCalculator.Core.Models.ViewModels.PrimaryModels;assembly=LoanCalculator.Core"
    xmlns:summary="clr-namespace:LoanCalculator.Core.Models.Income.Summary;assembly=LoanCalculator.Core"
    Title="What If"
    x:DataType="primaryModels:WhatIfViewModel">
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" RowDefinitions="Auto,*">
            <customControls:InAppPurchaseView x:Name="PremiumWindow" Grid.RowSpan="2" />

            <!--
                The title sits at PAGE level, not inside a tab. WhatIfPageTitle is this tab's
                arrival anchor in ShellTabs, so it has to exist whichever sub-tab is selected —
                inside the Scenarios tab it vanished whenever Answer was showing, and every
                GoTo(AppTab.WhatIf) then timed out. Exactly the trap FabWizard had on Loan.
            -->
            <VerticalStackLayout Grid.Row="0" Padding="12,14,12,6" Spacing="2">
                <Label
                    AutomationId="WhatIfPageTitle"
                    FontAttributes="Bold"
                    FontSize="{StaticResource FontSizeHeading}"
                    Text="What If?"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                <Label
                    FontSize="{StaticResource FontSizeSmall}"
                    Opacity="0.55"
                    Text="Explore scenarios based on your current loan"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
            </VerticalStackLayout>


            <tabView:SfTabView
                Grid.Row="1"
                x:Name="tabView"
                HeaderHorizontalTextAlignment="Center"
                SelectionChanging="TabView_OnSelectionChanging">

                <tabView:SfTabItem AutomationId="WhatIfTabAnswer" Header="Answer">
                    <tabView:SfTabItem.Content>

                        <!--
                            ══ Answer ══
                            The affordability verdict leads, because "can I afford this?" is the question the
                            whole app exists to answer and it used to require hunting through the Insights tab
                            on a different destination to find it.

                            Bound to the LoanViewModel rather than this page's WhatIfViewModel — the affordability
                            figures are the loan's, and the sub-tree BindingContext is set in code-behind. Same
                            pattern the Asset-costs tab on Budget uses.
                        -->
                        <ScrollView>
                            <VerticalStackLayout x:Name="AnswerRoot" Padding="12,16,12,32" Spacing="0">

                        <Border
                            AutomationId="WhatIfAnswerCard"
                            Margin="0,0,0,12"
                            Padding="18"
                            Style="{DynamicResource BorderTopHighlightBox}">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    AutomationId="WhatIfAnswerVerdict"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Opacity="0.8"
                                    Text="{Binding AnswerVerdictCaption}"
                                    TextColor="{DynamicResource LoanAppHighlightFgColor}" />
                                <!--
                                    One FormattedString, not three labels: the prototype runs the
                                    symbol, the figure and "/mo spare" together on one line with the
                                    tail at a smaller weight. Spans are also the only way to get the
                                    sign right — AffordabilityCurrencySymbol carries the minus ("-$")
                                    so a negative reads "-$6,328" and not "$-6,328".
                                -->
                                <!--
                                    The hero figure turns red when you are short. IsAffordabilityNegative
                                    rather than the sign of the string: AffordabilityCurrencySymbol
                                    already carries the minus, so the text itself is not a reliable
                                    thing to test.
                                -->
                                <Label AutomationId="WhatIfAnswerAmount" TextColor="{DynamicResource LoanAppHighlightFgColor}">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsAffordabilityNegative}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource LoanAppNegativeValueOnHighlightColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontAttributes="Bold"
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="30"
                                                Text="{Binding AffordabilityCurrencySymbol}" />
                                            <Span
                                                FontAttributes="Bold"
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="30"
                                                Text="{Binding Affordability}" />
                                            <Span
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="15"
                                                Text="{Binding AnswerSpareSuffix}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <!--
                                    One card covers both states: AnswerSpareBasis says what the
                                    figure is net of when there is one, and falls back to the
                                    "record your income & expenses" / trial prompt when there is
                                    not. Same idiom as the Loan summary box, so no inverse-boolean
                                    converter is needed.
                                -->
                                <Label
                                    AutomationId="WhatIfAnswerBasis"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.75"
                                    Text="{Binding AnswerSpareBasis}"
                                    TextColor="{DynamicResource LoanAppHighlightFgColor}" />
                            </VerticalStackLayout>
                        </Border>
                                <Label
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Margin="4,4,4,12"
                                    Opacity="0.5"
                                    Text="{DynamicResource LoanAppEstimateMicrocopy}"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--
                                    The prototype's three boxes under the hero. "of income" is the
                                    MONTHLY repayment as a share of GROSS monthly income — the
                                    standard payment-to-income ratio. The prototype's own 35% does
                                    not reconcile with its $2,792/$6,000 (that is 46.5%), so the
                                    definition is pinned in AnswerRepaymentShareOfIncome rather
                                    than copied from the mock. Both halves of the ratio have to be
                                    monthly, and the display is capped — see the remarks there.
                                -->
                                <Grid
                                    Margin="0,0,0,12"
                                    ColumnDefinitions="*,*,*"
                                    ColumnSpacing="8">
                                    <Border
                                        Grid.Column="0"
                                        Padding="10"
                                        Style="{DynamicResource BorderTopHighlightBox}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label AutomationId="WhatIfAnswerRepayment" HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxAmountStyle}" Text="{Binding AnswerRepaymentDisplay}" />
                                            <Label HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxTextStyle}" Text="repayment" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="10"
                                        Style="{DynamicResource BorderTopHighlightBox}">
                                        <VerticalStackLayout Spacing="2">
                                            <!--
                                                Goes red only when the figure is actually negative,
                                                driven by the VM flag rather than by parsing the
                                                formatted string. On the highlight card, which is
                                                pale in every theme, so the deep variant.
                                            -->
                                            <Label AutomationId="WhatIfAnswerNetIncome" HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxAmountStyle}" Text="{Binding AnswerNetIncomeDisplay}">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding AnswerNetIncomeIsNegative}"
                                                        TargetType="Label"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource LoanAppNegativeValueOnHighlightColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxTextStyle}" Text="net income" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        Padding="10"
                                        Style="{DynamicResource BorderTopHighlightBox}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label AutomationId="WhatIfAnswerIncomeShare" HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxAmountStyle}" Text="{Binding AnswerRepaymentShareOfIncome}" />
                                            <Label HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxTextStyle}" Text="of income" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!--  SCENARIOS  -->
                                <Label
                                    Margin="4,4,4,6"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.45"
                                    Text="SCENARIOS"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--
                                    Single entry point into the nine-row scenario index. Without
                                    it the Scenarios sub-tab is only reachable by noticing the tab
                                    header, which is the discoverability problem the redesign set
                                    out to fix.
                                -->
                                <Border
                                    AutomationId="WhatIfSeeScenariosCard"
                                    Margin="0,0,0,8"
                                    Padding="16,14"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSeeScenariosTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" Text="See all 9 scenarios" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Rate changes, extra repayments, stress tests and more" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" FontSize="{StaticResource FontSizeXL}" Text="›" TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!--
                                    "Where the money goes" — a stacked column per year, interest
                                    on top of principal, so the shift from one to the other over
                                    the term is the thing you see. Fed by AnswerPrincipalByYearAxis
                                    / AnswerInterestByYearAxis, which are the amortisation rows
                                    summed per year (the per-row series would draw one column per
                                    repayment).

                                    Hidden until there is a loan: an empty stacked chart renders as
                                    a bare pair of axes, which reads as a broken chart rather than
                                    as "nothing to show yet".
                                -->
                                <!--
                                    Visibility is set in RefreshAnswerChart alongside the card's,
                                    not bound: the flag lives on LoanViewModel and would have to
                                    raise PropertyChanged off a collection refill to work as a
                                    binding. Two assignments in one place beats that.
                                -->
                                <Label
                                    x:Name="AnswerChartHeader"
                                    Margin="4,10,4,6"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    IsVisible="False"
                                    Opacity="0.45"
                                    Text="WHERE THE MONEY GOES"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Border
                                    x:Name="AnswerChartCard"
                                    Margin="0,0,0,8"
                                    HeightRequest="260"
                                    IsVisible="False"
                                    Style="{DynamicResource LoanAppChartBorderStyle}">
                                    <Border.Content>
                                        <chart:SfCartesianChart Margin="4,8,8,4">
                                            <chart:SfCartesianChart.Legend>
                                                <chart:ChartLegend Placement="Bottom">
                                                    <chart:ChartLegend.LabelStyle>
                                                        <chart:ChartLegendLabelStyle
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{StaticResource FontSizeXS}"
                                                            TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                    </chart:ChartLegend.LabelStyle>
                                                </chart:ChartLegend>
                                            </chart:SfCartesianChart.Legend>
                                            <chart:SfCartesianChart.XAxes>
                                                <!--
                                                    No LabelCreated here on purpose. These labels
                                                    are years, and ChartAxisFormatter.Money parses
                                                    anything numeric — it would render 2027 as
                                                    "$2K".
                                                -->
                                                <chart:CategoryAxis PlotOffsetEnd="4">
                                                    <chart:CategoryAxis.LabelStyle>
                                                        <chart:ChartAxisLabelStyle
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{StaticResource FontSizeXS}"
                                                            TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                    </chart:CategoryAxis.LabelStyle>
                                                </chart:CategoryAxis>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis LabelCreated="OnAnswerChartValueLabelCreated" ShowMajorGridLines="True">
                                                    <chart:NumericalAxis.LabelStyle>
                                                        <chart:ChartAxisLabelStyle
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{StaticResource FontSizeXS}"
                                                            TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                    </chart:NumericalAxis.LabelStyle>
                                                </chart:NumericalAxis>
                                            </chart:SfCartesianChart.YAxes>
                                            <chart:SfCartesianChart.Series>
                                                <chart:StackingColumnSeries
                                                    x:Name="AnswerPrincipalSeries"
                                                    Fill="{DynamicResource LoanAppChartColor1}"
                                                    Label="Principal"
                                                    LegendIcon="Rectangle"
                                                    XBindingPath="Name"
                                                    YBindingPath="Value" />
                                                <chart:StackingColumnSeries
                                                    x:Name="AnswerInterestSeries"
                                                    Fill="{DynamicResource LoanAppChartColor2}"
                                                    Label="Interest"
                                                    LegendIcon="Rectangle"
                                                    XBindingPath="Name"
                                                    YBindingPath="Value" />
                                            </chart:SfCartesianChart.Series>
                                        </chart:SfCartesianChart>
                                    </Border.Content>
                                </Border>

                                <!--
                                    The schedule lives under Loan now, so this is the contextual
                                    pointer to where it went — the same reason Budget carries a
                                    "See the projection" link.
                                -->
                                <Border
                                    AutomationId="WhatIfSeeScheduleCard"
                                    Margin="0,0,0,8"
                                    Padding="16,14"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSeeScheduleTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" Text="See the full schedule" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Year-by-year principal and interest, now under Loan" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" FontSize="{StaticResource FontSizeXL}" Text="›" TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <Border
                                    AutomationId="WhatIfExportCard"
                                    Margin="0,0,0,8"
                                    Padding="16,14"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnExportTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="EXPORT A PDF REPORT" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.4" Text="Everything here, as a document" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" FontSize="{StaticResource FontSizeXL}" Text="›" TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <tabView:SfTabItem AutomationId="WhatIfTabScenarios" Header="Scenarios">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <VerticalStackLayout Padding="12,16,12,32" Spacing="0">
                            <!--  Advisory microcopy — persistent estimate/not-advice reminder  -->
                            <Label
                                IsVisible="{Binding HasLoanData}"
                                Margin="0,0,0,18"
                                FontSize="{StaticResource FontSizeSmall}"
                                Opacity="0.5"
                                Text="{DynamicResource LoanAppEstimateMicrocopy}"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            <!--  No data placeholder  -->
                            <Border
                                AutomationId="WhatIfNoDataPanel"
                                IsVisible="{Binding HasNoLoanData}"
                                Margin="0,20,0,0"
                                Padding="20"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Label
                                        FontSize="{StaticResource FontSizeLarge}"
                                        HorizontalTextAlignment="Center"
                                        Text="No loan data yet"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    <Label
                                        FontSize="{StaticResource FontSizeBody}"
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.6"
                                        Text="Enter your asset value and loan details on the Loan tab first."
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    <!--
                                        The whole point of this panel, per whatif-empty.html: a way
                                        to ACT on the message. It was static text telling the user
                                        where to go without taking them there.
                                    -->
                                    <Button
                                        AutomationId="WhatIfGoToLoanButton"
                                        Margin="0,10,0,0"
                                        BackgroundColor="{DynamicResource LoanAppInputTextFgColor}"
                                        Clicked="OnGoToLoanTapped"
                                        CornerRadius="10"
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizeBody}"
                                        HeightRequest="44"
                                        HorizontalOptions="Center"
                                        Padding="20,0"
                                        Text="Go to Loan ›"
                                        TextColor="{DynamicResource LoanAppAppShellBgColor}" />
                                </VerticalStackLayout>
                            </Border>

                            <!--
                                ══ Scenario index ══
                                These nine rows replace nine full cards that used to be stacked here in
                                one scroll — one card was taller than the screen, so the page ran to
                                roughly nine screens with no way to jump to the scenario you wanted and
                                no way to address one. Each row now opens its scenario full-screen via
                                ScenarioPage; the cards themselves live in Controls/Scenarios/.

                                The accent stripe colours carry over from the cards, so a scenario keeps
                                the same colour identity in the list as it has on its own page.
                            -->
                            <VerticalStackLayout IsVisible="{Binding HasLoanData}" Spacing="0">

                            <Border
                                AutomationId="WhatIfScenarioRateChange"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="RateChange" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor1}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Rate change"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="If rates move up or down"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <!--
                                            The binding path is RateChangeMonthlyDiff, NOT the
                                            AutomationId. This label first shipped binding to a
                                            path spelled the same as its own automation id, and no
                                            such property exists on WhatIfViewModel. (Written
                                            without the literal binding syntax on purpose — in a
                                            comment it reads as a real binding to any audit that
                                            greps for one.) The binding failed silently,
                                            the label rendered empty at zero height, and iOS then
                                            reported no *visible* element with that id at all. So
                                            the symptom was "missing AutomationId", pointing at the
                                            markup attribute that was in fact correct.

                                            Every one of these outcome properties defaults to a
                                            placeholder dash string rather than the empty string,
                                            which is what keeps the row visible (and findable)
                                            before anything has been calculated. Note an XML
                                            comment cannot contain a double hyphen, so that
                                            default cannot be written literally here.
                                        -->
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioRateChangeDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding RateChangeMonthlyDiff}"
                                            TextColor="{DynamicResource LoanAppChartColor2}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding RateChangeDiffIsPositive}" TargetType="Label" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource LoanAppChartColor1}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioExtraRepayment"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="ExtraRepayment" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor2}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Extra repayment"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Pay more each month"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioExtraRepaymentDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding ExtraRepaymentTimeSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioTermComparison"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="TermComparison" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor3}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Loan term"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Shorter term, higher payment"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioTermComparisonDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding TermComparisonMonthlyDiff}"
                                            TextColor="{DynamicResource LoanAppChartColor2}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioDepositScenarios"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="DepositScenarios" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor1}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Deposit"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="What a bigger deposit changes"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioDepositScenariosDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding DepositScenariosMonthlyDiff}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioLumpSum"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="LumpSum" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor2}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Lump sum"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="A one-off payment off the balance"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioLumpSumDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding LumpSumTimeSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioRepaymentFrequency"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="RepaymentFrequency" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor3}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Repayment frequency"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Weekly and fortnightly vs monthly"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioRepaymentFrequencyDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding FreqWeeklyIntSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioOffset"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="Offset" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor1}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Offset account"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Savings offset against the balance"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioOffsetDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding OffsetInterestSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioStressTest"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="StressTest" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor2}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Stress test"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="When does this become unaffordable?"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <!--
                                            A near-match, not an exact one: the prototype shows a
                                            verdict here ("still affordable") and this shows the
                                            rate buffer that verdict would be derived from. There
                                            is no verdict string on WhatIfViewModel today, and
                                            inventing one means choosing the threshold at which
                                            "affordable" flips — a product decision, not a port.
                                        -->
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioStressTestDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding StressTestRateBuffer}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding StressTestHasBuffer}" TargetType="Label" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource LoanAppChartColor2}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioCombined"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="Combined" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor3}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="Combined strategy"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Everything at once"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioCombinedDelta"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Text="{Binding CombinedTimeSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{StaticResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            </VerticalStackLayout>
                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <!--  Moved from Budget: forward-looking, so it belongs with the scenarios.  -->
                <tabView:SfTabItem AutomationId="WhatIfTabProjection" Header="Projection">
                    <tabView:SfTabItem.Content>
                            <ScrollView x:Name="ProjectionRoot" BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
                                <VerticalStackLayout Padding="12,8,12,32" Spacing="12">
                                    <!--
                                        Says what the page is for, per projection.html — and now
                                        also where the horizon is stated. It used to be a whole
                                        summary box holding a two-digit number, which cost the two
                                        currency totals a third of the width each; here it costs
                                        one word in a sentence that wanted a timeframe anyway. The
                                        slider further down remains the control.
                                    -->
                                    <Label
                                        AutomationId="WhatIfProjectionIntro"
                                        x:Name="LblProjectionIntro"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Opacity="0.6"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />


                                    <!--  Summary bar  -->
                                    <customControls:ThreeColumnBorderedContentView x:Name="ProjectionSummaryBar" Box3Visible="False">
                                        <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                            <FormattedString>
                                                <Span x:Name="ProjectionIncomeSpan" Style="{DynamicResource SpanThreeBoxAmountStyle}" />
                                                <Span Text="{Binding NewLine}" />
                                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Projected Income" />
                                            </FormattedString>
                                        </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                        <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                            <FormattedString>
                                                <Span x:Name="ProjectionExpenseSpan" Style="{DynamicResource SpanThreeBoxAmountStyle}" />
                                                <Span Text="{Binding NewLine}" />
                                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Projected Expense" />
                                            </FormattedString>
                                        </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    </customControls:ThreeColumnBorderedContentView>

                                    <!--  Controls  -->
                                    <Border
                                        Margin="0,4,0,0"
                                        Padding="16"
                                        BackgroundColor="{DynamicResource LoanAppAppShellBgColor}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0">
                                        <VerticalStackLayout Spacing="12">

                                            <!--  INCOME PROJECTION  -->
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.7"
                                                Text="INCOME PROJECTION"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                            <!--  Income growth rate stepper  -->
                                            <Grid ColumnSpacing="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    Opacity="0.7"
                                                    Text="Annual growth %"
                                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                    VerticalOptions="Center" />
                                                <Button
                                                    Grid.Column="1"
                                                    BackgroundColor="Transparent"
                                                    Clicked="OnIncomeGrowthRateDecrease"
                                                    FontAttributes="Bold"
                                                    FontSize="{StaticResource FontSizeHeading}"
                                                    Text="−"
                                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                <Label
                                                    x:Name="LblIncomeGrowthRate"
                                                    Grid.Column="2"
                                                    FontAttributes="Bold"
                                                    FontSize="{StaticResource FontSizeHeading}"
                                                    HorizontalOptions="Center"
                                                    HorizontalTextAlignment="Center"
                                                    MinimumWidthRequest="48"
                                                    TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                    VerticalOptions="Center" />
                                                <Button
                                                    Grid.Column="3"
                                                    BackgroundColor="Transparent"
                                                    Clicked="OnIncomeGrowthRateIncrease"
                                                    FontAttributes="Bold"
                                                    FontSize="{StaticResource FontSizeHeading}"
                                                    Text="+"
                                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            </Grid>

                                            <BoxView Style="{DynamicResource LoanAppSeparatorStyle}" />

                                            <!--  Include expenses switch  -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <buttons:SfSwitch
                                                    x:Name="SwitchIncludeExpenses"
                                                    Grid.Column="0"
                                                    HorizontalOptions="Start"
                                                    StateChanged="OnIncludeExpensesChanged">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="ProjIncomeSwitchStates1">
                                                            <VisualState x:Name="On">
                                                                <VisualState.Setters>
                                                                    <Setter Property="SwitchSettings">
                                                                        <Setter.Value>
                                                                            <buttons:SwitchSettings
                                                                                ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                                ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                                TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                                TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Off">
                                                                <VisualState.Setters>
                                                                    <Setter Property="SwitchSettings">
                                                                        <Setter.Value>
                                                                            <buttons:SwitchSettings
                                                                                ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                                ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                                TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                                TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </buttons:SfSwitch>
                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="1"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        Text="Include expenses"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                    <Label
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        Opacity="0.7"
                                                        Text="Deduct living expenses from projection"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <BoxView Style="{DynamicResource LoanAppSeparatorStyle}" />

                                            <!--  Include asset expenses switch (income)  -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <buttons:SfSwitch
                                                    x:Name="SwitchIncludePropertyExpenses"
                                                    Grid.Column="0"
                                                    HorizontalOptions="Start"
                                                    StateChanged="OnIncludePropertyExpensesChanged">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="ProjIncomeSwitchStates2">
                                                            <VisualState x:Name="On">
                                                                <VisualState.Setters>
                                                                    <Setter Property="SwitchSettings">
                                                                        <Setter.Value>
                                                                            <buttons:SwitchSettings
                                                                                ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                                ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                                TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                                TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Off">
                                                                <VisualState.Setters>
                                                                    <Setter Property="SwitchSettings">
                                                                        <Setter.Value>
                                                                            <buttons:SwitchSettings
                                                                                ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                                ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                                TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                                TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </buttons:SfSwitch>
                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="1"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        Text="Include asset expenses"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                    <Label
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        Opacity="0.7"
                                                        Text="Add property loan costs to projection"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <BoxView Style="{DynamicResource LoanAppSeparatorStyle}" />

                                            <!--  EXPENSE PROJECTION  -->
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Opacity="0.7"
                                                Text="EXPENSE PROJECTION"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                            <!--  Expense growth rate stepper  -->
                                            <Grid ColumnSpacing="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    Opacity="0.7"
                                                    Text="Annual growth %"
                                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                    VerticalOptions="Center" />
                                                <Button
                                                    Grid.Column="1"
                                                    BackgroundColor="Transparent"
                                                    Clicked="OnExpenseGrowthRateDecrease"
                                                    FontAttributes="Bold"
                                                    FontSize="{StaticResource FontSizeHeading}"
                                                    Text="−"
                                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                <Label
                                                    x:Name="LblExpenseGrowthRate"
                                                    Grid.Column="2"
                                                    FontAttributes="Bold"
                                                    FontSize="{StaticResource FontSizeHeading}"
                                                    HorizontalOptions="Center"
                                                    HorizontalTextAlignment="Center"
                                                    MinimumWidthRequest="48"
                                                    TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                    VerticalOptions="Center" />
                                                <Button
                                                    Grid.Column="3"
                                                    BackgroundColor="Transparent"
                                                    Clicked="OnExpenseGrowthRateIncrease"
                                                    FontAttributes="Bold"
                                                    FontSize="{StaticResource FontSizeHeading}"
                                                    Text="+"
                                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            </Grid>

                                            <BoxView Style="{DynamicResource LoanAppSeparatorStyle}" />

                                            <!--  Include asset expenses switch (expense)  -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <buttons:SfSwitch
                                                    x:Name="SwitchExpensePropertyExpense"
                                                    Grid.Column="0"
                                                    HorizontalOptions="Start"
                                                    StateChanged="OnExpensePropertyExpenseChanged">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="ProjExpenseSwitchStates1">
                                                            <VisualState x:Name="On">
                                                                <VisualState.Setters>
                                                                    <Setter Property="SwitchSettings">
                                                                        <Setter.Value>
                                                                            <buttons:SwitchSettings
                                                                                ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                                ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                                TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                                TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Off">
                                                                <VisualState.Setters>
                                                                    <Setter Property="SwitchSettings">
                                                                        <Setter.Value>
                                                                            <buttons:SwitchSettings
                                                                                ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                                ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                                TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                                TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </buttons:SfSwitch>
                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="1"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        Text="Include asset expenses"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                    <Label
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        Opacity="0.7"
                                                        Text="Add property loan costs to projection"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <BoxView Style="{DynamicResource LoanAppSeparatorStyle}" />

                                            <!--  Years to project slider  -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    FontSize="{StaticResource FontSizeBody}"
                                                    Text="Years to project"
                                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    AutomationId="BudgetProjectionYearsValue"
                                                    x:Name="LblProjectionYears"
                                                    Grid.Column="1"
                                                    FontAttributes="Bold"
                                                    FontSize="{StaticResource FontSizeMedium}"
                                                    TextColor="{DynamicResource LoanAppHighlightFgColor}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                            <range:SfSlider
                                                HeightRequest="60"
                                                HorizontalOptions="FillAndExpand"
                                                Interval="4"
                                                Maximum="{Binding MaxProjectionYears}"
                                                Minimum="1"
                                                MinorTicksPerInterval="3"
                                                ShowLabels="True"
                                                ShowTicks="True"
                                                StepSize="1"
                                                AutomationId="BudgetProjectionYearsSlider"
                                                ValueChangeEnd="OnProjectionYearsSliderChanged"
                                                Value="{Binding ProjectionYears, Mode=TwoWay}">
                                                <range:SfSlider.ThumbStyle>
                                                    <range:SliderThumbStyle
                                                        Fill="{DynamicResource LoanAppSliderKnobFillColor}"
                                                        OverlapStroke="{DynamicResource LoanAppSliderKnobOverlapColor}"
                                                        Stroke="{DynamicResource LoanAppSliderKnobBorderColor}"
                                                        StrokeThickness="2" />
                                                </range:SfSlider.ThumbStyle>
                                                <range:SfSlider.LabelStyle>
                                                    <range:SliderLabelStyle
                                                        ActiveFontFamily="{DynamicResource DefaultFontFamily}"
                                                        ActiveFontSize="{StaticResource FontSizeBody}"
                                                        ActiveTextColor="{DynamicResource LoanAppRangeSliderLabelTextColor}"
                                                        InactiveFontFamily="{DynamicResource DefaultFontFamily}"
                                                        InactiveFontSize="{StaticResource FontSizeBody}"
                                                        InactiveTextColor="{DynamicResource LoanAppRangeSliderLabelTextColor}" />
                                                </range:SfSlider.LabelStyle>
                                                <range:SfSlider.TrackStyle>
                                                    <range:SliderTrackStyle
                                                        ActiveFill="{DynamicResource LoanAppRangeSliderTrackActiveFillColor}"
                                                        ActiveSize="5"
                                                        InactiveFill="{DynamicResource LoanAppRangeSliderTrackInActiveFillColor}"
                                                        InactiveSize="1" />
                                                </range:SfSlider.TrackStyle>
                                            </range:SfSlider>

                                        </VerticalStackLayout>
                                    </Border>

                                    <!--  Income & Expense Projection chart  -->
                                    <HorizontalStackLayout Margin="20,16,20,4" Spacing="8">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Opacity="0.7"
                                            Text="INCOME &amp; EXPENSE PROJECTION"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                        <!--  Shown while a debounced projection rebuild is catching up  -->
                                        <ActivityIndicator
                                            HeightRequest="14"
                                            WidthRequest="14"
                                            Color="{DynamicResource LoanAppAppShellFgColor}"
                                            IsRunning="{Binding IsProjectionRefreshing}"
                                            IsVisible="{Binding IsProjectionRefreshing}"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontSize="{StaticResource FontSizeSmall}"
                                            IsVisible="{Binding IsProjectionRefreshing}"
                                            Opacity="0.7"
                                            Text="Updating…"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Border Style="{DynamicResource LoanAppChartBorderStyle}">
                                        <Border.Content>
                                            <chart:SfCartesianChart
                                                x:Name="ProjectionChart"
                                                Margin="{OnIdiom Phone='5,12,5,0',
                                                                 Tablet='20,16,20,10',
                                                                 Desktop='20,16,20,10',
                                                                 Default='5,12,5,0'}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="FillAndExpand"
                                                PaletteBrushes="{Binding CustomChartColors}"
                                                VerticalOptions="FillAndExpand">
                                                <chart:SfCartesianChart.XAxes>
                                                    <chart:CategoryAxis
                                                        EdgeLabelsDrawingMode="Fit"
                                                        LabelPlacement="BetweenTicks"
                                                        ShowMajorGridLines="False">
                                                        <chart:CategoryAxis.LabelStyle>
                                                            <chart:ChartAxisLabelStyle
                                                                FontAttributes="Bold"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{StaticResource FontSizeBody}"
                                                                TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                        </chart:CategoryAxis.LabelStyle>
                                                        <chart:CategoryAxis.MajorTickStyle>
                                                            <chart:ChartAxisTickStyle TickSize="8" />
                                                        </chart:CategoryAxis.MajorTickStyle>
                                                    </chart:CategoryAxis>
                                                </chart:SfCartesianChart.XAxes>
                                                <chart:SfCartesianChart.YAxes>
                                                    <chart:NumericalAxis LabelCreated="OnProjectionAxisLabelCreated">
                                                        <chart:NumericalAxis.LabelStyle>
                                                            <chart:ChartAxisLabelStyle
                                                                FontAttributes="Bold"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{StaticResource FontSizeBody}"
                                                                TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                        </chart:NumericalAxis.LabelStyle>
                                                        <chart:NumericalAxis.AxisLineStyle>
                                                            <chart:ChartLineStyle StrokeWidth="0" />
                                                        </chart:NumericalAxis.AxisLineStyle>
                                                        <chart:NumericalAxis.MajorTickStyle>
                                                            <chart:ChartAxisTickStyle TickSize="0" />
                                                        </chart:NumericalAxis.MajorTickStyle>
                                                    </chart:NumericalAxis>
                                                </chart:SfCartesianChart.YAxes>
                                                <chart:SfCartesianChart.Legend>
                                                    <chart:ChartLegend Placement="Bottom" ToggleSeriesVisibility="True">
                                                        <chart:ChartLegend.LabelStyle>
                                                            <chart:ChartLegendLabelStyle
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{StaticResource FontSizeXS}"
                                                                TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                        </chart:ChartLegend.LabelStyle>
                                                    </chart:ChartLegend>
                                                </chart:SfCartesianChart.Legend>
                                                <chart:ColumnSeries
                                                    x:Name="ProjIncomeSeries"
                                                    EnableAnimation="True"
                                                    Label="Income"
                                                    LegendIcon="Rectangle"
                                                    Stroke="{DynamicResource LoanAppChartColor1}"
                                                    XBindingPath="Name"
                                                    YBindingPath="Value" />
                                                <chart:ColumnSeries
                                                    x:Name="ProjExpenseSeries"
                                                    EnableAnimation="True"
                                                    Label="Expenses"
                                                    LegendIcon="Rectangle"
                                                    Stroke="{DynamicResource LoanAppChartColor2}"
                                                    XBindingPath="Name"
                                                    YBindingPath="Value" />
                                            </chart:SfCartesianChart>
                                        </Border.Content>
                                    </Border>
                                    <Label
                                        Margin="0,4,0,12"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{StaticResource FontSizeXS}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.5"
                                        Text="{Binding ChartProjectionSubtitle}"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                    <!--  Income year-by-year breakdown  -->
                                    <Label
                                        Margin="20,16,20,4"
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Opacity="0.7"
                                        Text="INCOME YEAR-BY-YEAR"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <pager:SfDataPager
                                            x:Name="IncomeDataPager"
                                            Grid.Row="0"
                                            Margin="{OnIdiom Phone='0,3,0,3',
                                                             Tablet='0,3,0,14',
                                                             Default='0,3,0,3'}"
                                            ButtonFontSize="{StaticResource FontSizeSmall}"
                                            ButtonShape="Circle"
                                            HorizontalOptions="Center"
                                            NumericButtonsGenerateMode="Auto"
                                            PageSize="5"
                                            Style="{DynamicResource LoanAppDataGridPagerStyle}">
                                            <pager:SfDataPager.DefaultStyle>
                                                <pager:DataPagerStyle
                                                    NavigationButtonBackgroundColor="{DynamicResource LoanAppNavigationButtonBackgroundColor}"
                                                    NavigationButtonDisableBackgroundColor="{DynamicResource LoanAppNavigationButtonDisableBackgroundColor}"
                                                    NavigationButtonDisableIconColor="{DynamicResource LoanAppNavigationButtonDisableIconColor}"
                                                    NavigationButtonIconColor="{DynamicResource LoanAppNavigationButtonIconColor}"
                                                    NumericButtonBackgroundColor="{DynamicResource LoanAppNumericButtonBackgroundColor}"
                                                    NumericButtonSelectionBackgroundColor="{DynamicResource LoanAppNumericButtonSelectionBackgroundColor}"
                                                    NumericButtonSelectionTextColor="{DynamicResource LoanAppNumericButtonSelectionTextColor}"
                                                    NumericButtonTextColor="{DynamicResource LoanAppNumericButtonTextColor}" />
                                            </pager:SfDataPager.DefaultStyle>
                                        </pager:SfDataPager>
                                        <datagrid:SfDataGrid
                                            x:Name="ProjectionGrid"
                                            Grid.Row="1"
                                            AutoGenerateColumnsMode="None"
                                            ColumnWidthMode="Fill"
                                            HorizontalOptions="Fill"
                                            ItemsSource="{Binding PagedSource, Source={x:Reference IncomeDataPager}}"
                                            VerticalOptions="Fill">
                                            <datagrid:SfDataGrid.Columns>
                                                <datagrid:DataGridTemplateColumn HeaderText="Period" MappingName="PaymentPeriod">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Period" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell01}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid01}"
                                                                    Text="{Binding PaymentPeriod}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                                <datagrid:DataGridTemplateColumn HeaderText="Start" MappingName="TermStartAmountRounded">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Start" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell02}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid02}"
                                                                    Text="{Binding TermStartAmountRounded}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                                <datagrid:DataGridTemplateColumn HeaderText="Growth" MappingName="TermGrowthAmountRounded">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Growth" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell03}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid03}"
                                                                    Text="{Binding TermGrowthAmountRounded}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                                <datagrid:DataGridTemplateColumn HeaderText="Deduction" MappingName="TermExpenseDeductionAmountRounded">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Deduction" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell04}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid04}"
                                                                    Text="{Binding TermAdjustmentAmountRounded}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                                <datagrid:DataGridTemplateColumn HeaderText="Sum" MappingName="IncomeExpenseAmountRounded">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Sum" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell05}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid05}"
                                                                    Text="{Binding IncomeExpenseAmountRounded}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                            </datagrid:SfDataGrid.Columns>
                                        </datagrid:SfDataGrid>
                                    </Grid>

                                    <!--  Expense year-by-year breakdown  -->
                                    <Label
                                        Margin="20,16,20,4"
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Opacity="0.7"
                                        Text="EXPENSE YEAR-BY-YEAR"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    <Grid Margin="0,4,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <pager:SfDataPager
                                            x:Name="ExpenseDataPager"
                                            Grid.Row="0"
                                            Margin="{OnIdiom Phone='0,3,0,3',
                                                             Tablet='0,3,0,14',
                                                             Default='0,3,0,3'}"
                                            ButtonFontSize="{StaticResource FontSizeSmall}"
                                            ButtonShape="Circle"
                                            HorizontalOptions="Center"
                                            NumericButtonsGenerateMode="Auto"
                                            PageSize="5"
                                            Style="{DynamicResource LoanAppDataGridPagerStyle}">
                                            <pager:SfDataPager.DefaultStyle>
                                                <pager:DataPagerStyle
                                                    NavigationButtonBackgroundColor="{DynamicResource LoanAppNavigationButtonBackgroundColor}"
                                                    NavigationButtonDisableBackgroundColor="{DynamicResource LoanAppNavigationButtonDisableBackgroundColor}"
                                                    NavigationButtonDisableIconColor="{DynamicResource LoanAppNavigationButtonDisableIconColor}"
                                                    NavigationButtonIconColor="{DynamicResource LoanAppNavigationButtonIconColor}"
                                                    NumericButtonBackgroundColor="{DynamicResource LoanAppNumericButtonBackgroundColor}"
                                                    NumericButtonSelectionBackgroundColor="{DynamicResource LoanAppNumericButtonSelectionBackgroundColor}"
                                                    NumericButtonSelectionTextColor="{DynamicResource LoanAppNumericButtonSelectionTextColor}"
                                                    NumericButtonTextColor="{DynamicResource LoanAppNumericButtonTextColor}" />
                                            </pager:SfDataPager.DefaultStyle>
                                        </pager:SfDataPager>
                                        <datagrid:SfDataGrid
                                            x:Name="ExpenseProjectionGrid"
                                            Grid.Row="1"
                                            AutoGenerateColumnsMode="None"
                                            ColumnWidthMode="Fill"
                                            HorizontalOptions="Fill"
                                            ItemsSource="{Binding PagedSource, Source={x:Reference ExpenseDataPager}}"
                                            VerticalOptions="Fill">
                                            <datagrid:SfDataGrid.Columns>
                                                <datagrid:DataGridTemplateColumn HeaderText="Period" MappingName="PaymentPeriod">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Period" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell01}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid01}"
                                                                    Text="{Binding PaymentPeriod}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                                <datagrid:DataGridTemplateColumn HeaderText="Start" MappingName="TermStartAmountRounded">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Start" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell02}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid02}"
                                                                    Text="{Binding TermStartAmountRounded}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                                <datagrid:DataGridTemplateColumn HeaderText="Growth" MappingName="TermGrowthAmountRounded">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Growth" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell03}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid03}"
                                                                    Text="{Binding TermGrowthAmountRounded}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                                <datagrid:DataGridTemplateColumn HeaderText="Deduction" MappingName="TermExpenseDeductionAmountRounded">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Deduction" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell04}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid04}"
                                                                    Text="{Binding TermAdjustmentAmountRounded}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                                <datagrid:DataGridTemplateColumn HeaderText="Sum" MappingName="IncomeExpenseAmountRounded">
                                                    <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Sum" />
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <datagrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource BorderDataGridCell05}">
                                                                <Label
                                                                    x:DataType="summary:IncomeExpenseProjectionOutput"
                                                                    Style="{DynamicResource LabelCellDataGrid05}"
                                                                    Text="{Binding IncomeExpenseAmountRounded}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </datagrid:DataGridTemplateColumn.CellTemplate>
                                                </datagrid:DataGridTemplateColumn>
                                            </datagrid:SfDataGrid.Columns>
                                        </datagrid:SfDataGrid>
                                    </Grid>

                                </VerticalStackLayout>
                            </ScrollView>
                        </tabView:SfTabItem.Content>
                </tabView:SfTabItem>


                <!--
                    Moved from LoanView's Insights tab. All nine panels are kept: an audit showed
                    the four judged "redundant" were not — Budget's income and expense figures are
                    mutated by the ShowIncomeAfterExpense / ShowPropertyExpense toggles, so these
                    panels are the only place those totals appear unconditionally. Each also
                    carries explanatory copy that exists nowhere else.

                    Binds LoanViewModel (InsightsDetails lives there), set as a sub-tree
                    BindingContext in the constructor.
                -->
                <tabView:SfTabItem AutomationId="WhatIfTabInsights" Header="Insights">
                    <tabView:SfTabItem.Content>
                        <ScrollView x:Name="InsightsRoot">
                            <StackLayout Padding="12,0">
                                <customControls:DisclaimerBannerView
                                    BannerType="Warning"
                                    HeaderText="Disclaimer"
                                    Text="{DynamicResource LoanAppDisclaimerBannerText}" />

                                <!--
                                    Section picker, per export.html. The checkboxes are DISABLED
                                    and pre-ticked on purpose: the export is still fixed-content,
                                    so offering a live choice would be a control that silently
                                    does nothing. They show what the report contains today, and
                                    the note underneath says the choosing is still to come —
                                    which is honest, where an enabled-but-inert checkbox is not.

                                    Checkboxes rather than switches because this reads as a
                                    multi-select list, not six independent on/off settings.
                                -->
                                <Label
                                    Margin="4,10,4,4"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.45"
                                    Text="INCLUDED IN THE REPORT"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Border
                                    Margin="0,0,0,6"
                                    Padding="0"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <VerticalStackLayout
                                        x:Name="ExportSectionList"
                                        BindableLayout.ItemsSource="{Binding ExportSections}"
                                        Spacing="0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="primaryModels:ExportSectionOption">
                                                <Border
                                                    Padding="16,12"
                                                    BackgroundColor="Transparent"
                                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                                    StrokeThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <!--
                                                            A tick glyph, not an SfCheckBox. A
                                                            disabled SfCheckBox rendered as a thin
                                                            vertical sliver here — it draws its box
                                                            into a graphics layer and its disabled
                                                            state has no colour in these themes, so
                                                            there was nothing to see. These rows are
                                                            not interactive anyway (see
                                                            ExportSectionOption), so a glyph is both
                                                            legible and honest: it states inclusion
                                                            rather than impersonating a control that
                                                            cannot be toggled.
                                                        -->
                                                        <Label
                                                            AutomationId="{Binding AutomationId}"
                                                            Grid.Column="0"
                                                            FontSize="{StaticResource FontSizeMedium}"
                                                            Opacity="0.85"
                                                            Text="&#x2713;"
                                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                                            VerticalOptions="Center" />
                                                        <VerticalStackLayout
                                                            Grid.Column="1"
                                                            Spacing="2"
                                                            VerticalOptions="Center">
                                                            <Label
                                                                FontSize="{StaticResource FontSizeBody}"
                                                                Text="{Binding Title}"
                                                                TextColor="{DynamicResource LstForegroundColor}" />
                                                            <Label
                                                                FontSize="{StaticResource FontSizeSmall}"
                                                                Opacity="0.55"
                                                                Text="{Binding Detail}"
                                                                TextColor="{DynamicResource LstForegroundColor}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>

                                <Label
                                    AutomationId="WhatIfExportSelectionNote"
                                    Margin="4,0,4,0"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Opacity="0.5"
                                    Text="Every section above is included. Choosing which to export is coming in a later update."
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <VerticalStackLayout Padding="20,10,20,10">
                                    <Button
                                        AutomationId="LoanInsightsExportButton"
                                        Command="{Binding ExportInsightsReportCommand}"
                                        IsEnabled="{Binding IsActive}"
                                        Style="{DynamicResource ExportButtonStyle}"
                                        Text="Export Detailed Insights" />
                                    <progressBar:SfLinearProgressBar
                                        AnimationEasing="{x:Static Easing.CubicOut}"
                                        IsVisible="{Binding IsGeneratingPdf}"
                                        Progress="{Binding PdfGenerator.Progress}"
                                        ProgressFill="{DynamicResource LoanAppProgressColor}"
                                        ProgressHeight="10"
                                        TrackFill="{DynamicResource LoanAppProgressTrackColor}"
                                        TrackHeight="10" />
                                </VerticalStackLayout>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Key Insights" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Affordability, loan, deposit and repayments at a glance" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}" VerticalOptions="FillAndExpand">
                                                    <StackLayout Margin="0,0,0,5">
                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.AffordabilityMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.AffordabilityYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />

                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.LoanAmount}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.DepositAmount}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />

                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.RepaymentDetailMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.RepaymentDetailYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />

                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeTotalMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeTotalYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />

                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseOverallTotalMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseOverallTotalYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                    </StackLayout>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Asset Insights" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Purchase price, estimated upfront costs and the total" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                    <Grid>
                                                        <StackLayout Margin="0,0,0,5">
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.PropertyAmount}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.PropertyEstimatedUpfront}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                            <customControls:InsightsItemView
                                                                Margin="0,0,0,20"
                                                                InsightItem="{Binding InsightsDetails.PropertyTotalAmount}"
                                                                TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Loan Insights" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Loan, deposit, and what the bank is repaid in total" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                    <Grid>
                                                        <StackLayout Margin="0,0,0,5">
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.LoanAmount}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.DepositAmount}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.TotalRepaymentToBank}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.TotalInterestToBank}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                            <chart:SfCartesianChart
                                                                AutomationId="LoanInsightsChart"
                                                                x:Name="insightsChart"
                                                                Margin="10,0,20,0"
                                                                BackgroundColor="Transparent"
                                                                HeightRequest="150"
                                                                HorizontalOptions="FillAndExpand"
                                                                IsTransposed="True"
                                                                PaletteBrushes="{Binding CustomChartColors}"
                                                                VerticalOptions="FillAndExpand">
                                                                <!--<chart:SfCartesianChart.Margin>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Windows" Value="10,0,20,0" />
                                        <On Platform="Android" Value="10,0,20,0" />
                                        <On Platform="iOS" Value="0,10,20,0" />
                                    </OnPlatform>
                                </chart:SfCartesianChart.Margin>-->
                                                                <chart:SfCartesianChart.Legend>
                                                                    <chart:ChartLegend Placement="{OnIdiom Phone=Bottom, Tablet=Left, Desktop=Left, TV=Left, Default=Bottom}" ToggleSeriesVisibility="True">
                                                                        <chart:ChartLegend.LabelStyle>
                                                                            <!--
                                                                                LoanAppInsightsFgColor, not LoanAppChartLegendTextColor. This chart
                                                                                is BackgroundColor="Transparent" inside BorderInsightsHighlightBox,
                                                                                so its legend sits on the insights card, not on a chart card. The
                                                                                chart legend colour is tuned for the light chart-card fill and in
                                                                                Dark it is #27374D — the exact insights card colour, i.e. invisible.
                                                                            -->
                                                                            <chart:ChartLegendLabelStyle
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                                TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                                        </chart:ChartLegend.LabelStyle>
                                                                    </chart:ChartLegend>
                                                                </chart:SfCartesianChart.Legend>
                                                                <chart:SfCartesianChart.XAxes>
                                                                    <chart:CategoryAxis IsVisible="False" ShowMajorGridLines="False" />
                                                                </chart:SfCartesianChart.XAxes>
                                                                <chart:SfCartesianChart.YAxes>
                                                                    <chart:NumericalAxis IsVisible="False" ShowMajorGridLines="False" />
                                                                </chart:SfCartesianChart.YAxes>
                                                                <chart:SfCartesianChart.Series>
                                                                    <chart:StackingColumn100Series
                                                                        EnableAnimation="True"
                                                                        IsVisibleOnLegend="True"
                                                                        ItemsSource="{Binding InsightChartLoanDepositAxis}"
                                                                        Label="Deposit"
                                                                        LabelContext="YValue"
                                                                        LegendIcon="Rectangle"
                                                                        ShowDataLabels="True"
                                                                        Stroke="{DynamicResource LoanAppChartColor1}"
                                                                        XBindingPath="Name"
                                                                        YBindingPath="Value">
                                                                        <chart:StackingColumn100Series.DataLabelSettings>
                                                                            <chart:CartesianDataLabelSettings LabelPlacement="Inner">
                                                                                <chart:CartesianDataLabelSettings.LabelStyle>
                                                                                    <chart:ChartDataLabelStyle
                                                                                        FontAttributes="Bold"
                                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                                        FontSize="{StaticResource FontSizeXS}"
                                                                                        LabelFormat="c"
                                                                                        TextColor="{DynamicResource LoanAppChartDataMarkerTextColor1}" />
                                                                                </chart:CartesianDataLabelSettings.LabelStyle>
                                                                            </chart:CartesianDataLabelSettings>
                                                                        </chart:StackingColumn100Series.DataLabelSettings>
                                                                    </chart:StackingColumn100Series>
                                                                    <chart:StackingColumn100Series
                                                                        EnableAnimation="True"
                                                                        ItemsSource="{Binding InsightChartLoanAmountAxis}"
                                                                        Label="Loan"
                                                                        LabelContext="YValue"
                                                                        LegendIcon="Rectangle"
                                                                        ShowDataLabels="True"
                                                                        Stroke="{DynamicResource LoanAppChartColor2}"
                                                                        XBindingPath="Name"
                                                                        YBindingPath="Value">
                                                                        <chart:StackingColumn100Series.DataLabelSettings>
                                                                            <chart:CartesianDataLabelSettings LabelPlacement="Inner">
                                                                                <chart:CartesianDataLabelSettings.LabelStyle>
                                                                                    <chart:ChartDataLabelStyle
                                                                                        FontAttributes="Bold"
                                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                                        FontSize="{StaticResource FontSizeXS}"
                                                                                        LabelFormat="c"
                                                                                        TextColor="{DynamicResource LoanAppChartDataMarkerTextColor2}" />
                                                                                </chart:CartesianDataLabelSettings.LabelStyle>
                                                                            </chart:CartesianDataLabelSettings>
                                                                        </chart:StackingColumn100Series.DataLabelSettings>
                                                                    </chart:StackingColumn100Series>
                                                                    <chart:StackingColumn100Series
                                                                        EnableAnimation="True"
                                                                        ItemsSource="{Binding InsightChartLoanInterestAxis}"
                                                                        Label="{Binding ChartInterestCategoryLabel}"
                                                                        LabelContext="YValue"
                                                                        LegendIcon="Rectangle"
                                                                        ShowDataLabels="True"
                                                                        Stroke="{DynamicResource LoanAppChartColor3}"
                                                                        XBindingPath="Name"
                                                                        YBindingPath="Value">
                                                                        <chart:StackingColumn100Series.DataLabelSettings>
                                                                            <chart:CartesianDataLabelSettings LabelPlacement="Inner">
                                                                                <chart:CartesianDataLabelSettings.LabelStyle>
                                                                                    <chart:ChartDataLabelStyle
                                                                                        FontAttributes="Bold"
                                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                                        FontSize="{StaticResource FontSizeXS}"
                                                                                        LabelFormat="c"
                                                                                        TextColor="{DynamicResource LoanAppChartDataMarkerTextColor3}" />
                                                                                </chart:CartesianDataLabelSettings.LabelStyle>
                                                                            </chart:CartesianDataLabelSettings>
                                                                        </chart:StackingColumn100Series.DataLabelSettings>
                                                                    </chart:StackingColumn100Series>
                                                                </chart:SfCartesianChart.Series>
                                                            </chart:SfCartesianChart>
                                                            <Label
                                                                Margin="0,4,0,8"
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{StaticResource FontSizeXS}"
                                                                HorizontalOptions="Center"
                                                                HorizontalTextAlignment="Center"
                                                                Opacity="0.5"
                                                                Text="{Binding ChartInsightSubtitle}"
                                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.LoanTerm}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.InterestRate}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.RepaymentFrequency}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.RepaymentDetailSelectedFrequency}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                            <customControls:InsightsItemView
                                                                Margin="0,0,0,20"
                                                                InsightItem="{Binding InsightsDetails.RepaymentDetailYearly}"
                                                                TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Expenses on cost of new asset ownership" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Monthly and yearly cost of owning the asset" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                    <Grid>
                                                        <StackLayout Margin="0,0,0,5">
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseCostOfNewPropertyOwnershipMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseCostOfNewPropertyOwnershipYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Expenses on Loan financial commitments" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Monthly and yearly cost of servicing the loan" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                    <Grid>
                                                        <StackLayout Margin="0,0,0,5">
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseLoanFinancialCommitmentsMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseLoanFinancialCommitmentsYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Expenses on current financial outflows" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Monthly and yearly total of your recorded expenses" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                    <Grid>
                                                        <StackLayout Margin="0,0,0,5">
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseCurrentFinancialOutflowsMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseCurrentFinancialOutflowsYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Income" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Your recorded income, monthly and yearly" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                    <Grid>
                                                        <StackLayout Margin="0,0,0,5">
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeTotalMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeTotalYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Income after expense" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="What is left once your expenses are taken out" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                    <Grid>
                                                        <StackLayout Margin="0,0,0,5">
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeAfterExpenseMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeAfterExpenseYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>

                                <Border Style="{DynamicResource ExpanderCardStyle}">
                                    <expander:SfExpander
                                        HeaderIconPosition="End"
                                        Style="{DynamicResource CommonExpanderStyle}">
                                        <expander:SfExpander.Header>
                                            <Grid Padding="0,2">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Income after all expenses" />
                                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="What is left after expenses and loan repayments" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </expander:SfExpander.Header>
                                        <expander:SfExpander.Content>
                                            <StackLayout>
                                                <Border Style="{DynamicResource BorderInsightsHighlightBox}">
                                                    <Grid>
                                                        <StackLayout Margin="0,0,0,5">
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeAfterExpenseWithLoanMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" ShowSeparator="False" />
                                                            <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeAfterExpenseWithLoanYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </Border>
                                            </StackLayout>
                                        </expander:SfExpander.Content>
                                    </expander:SfExpander>
                                </Border>
                            </StackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

            </tabView:SfTabView>

            <!--
                Last child of the root Grid so it is topmost, and spanning both rows so the title
                is covered too — a half-covered page reads as a rendering fault rather than as
                loading. Starts hidden; OnAppearing shows it around its own work.
            -->
            <customControls:BusyOverlayView
                x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="2" />

        </Grid>
    </ContentPage.Content>
</ContentPage>
