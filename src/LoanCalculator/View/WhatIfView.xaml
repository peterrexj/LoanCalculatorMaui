<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="thisPage"
    x:Class="LoanCalculatorMaui.View.WhatIfView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:constants="clr-namespace:LoanCalculator.Core.Constants;assembly=LoanCalculator.Core"
    xmlns:customControls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:range="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:primaryModels="clr-namespace:LoanCalculator.Core.Models.ViewModels.PrimaryModels;assembly=LoanCalculator.Core"
    xmlns:summary="clr-namespace:LoanCalculator.Core.Models.Income.Summary;assembly=LoanCalculator.Core"
    Title="What If"
    x:DataType="primaryModels:WhatIfViewModel">
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" RowDefinitions="Auto,*">
            <customControls:InAppPurchaseView x:Name="PremiumWindow" Grid.RowSpan="2" />

            <!--
                The title sits at PAGE level, not inside a tab. WhatIfPageTitle is this tab's
                arrival anchor in ShellTabs, so it has to exist whichever sub-tab is selected —
                inside the Scenarios tab it vanished whenever Answer was showing, and every
                GoTo(AppTab.WhatIf) then timed out. Exactly the trap FabWizard had on Loan.
            -->
            <VerticalStackLayout Grid.Row="0" Padding="12,14,12,6" Spacing="2">
                <Label
                    AutomationId="WhatIfPageTitle"
                    FontAttributes="Bold"
                    FontSize="{DynamicResource FontSizeHeading}"
                    Text="What If?"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                <Label
                    FontSize="{DynamicResource FontSizeSmall}"
                    Opacity="0.55"
                    Text="Explore scenarios based on your current loan"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
            </VerticalStackLayout>


            <tabView:SfTabView
                Grid.Row="1"
                x:Name="tabView"
                HeaderHorizontalTextAlignment="Center"
                SelectionChanging="TabView_OnSelectionChanging">

                <tabView:SfTabItem AutomationId="WhatIfTabAnswer" Header="Answer">
                    <tabView:SfTabItem.Content>

                        <!--
                            ══ Answer ══
                            The affordability verdict leads, because "can I afford this?" is the question the
                            whole app exists to answer and it used to require hunting through the Insights tab
                            on a different destination to find it.

                            Bound to the LoanViewModel rather than this page's WhatIfViewModel — the affordability
                            figures are the loan's, and the sub-tree BindingContext is set in code-behind. Same
                            pattern the Asset-costs tab on Budget uses.
                        -->
                        <ScrollView>
                            <VerticalStackLayout x:Name="AnswerRoot" Padding="12,16,12,32" Spacing="0">

                        <Border
                            AutomationId="WhatIfAnswerCard"
                            Margin="0,0,0,12"
                            Padding="18"
                            Style="{DynamicResource BorderTopHighlightBox}">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    AutomationId="WhatIfAnswerVerdict"
                                    FontSize="{DynamicResource FontSizeBody}"
                                    Opacity="0.8"
                                    Text="{Binding AnswerVerdictCaption}"
                                    TextColor="{DynamicResource LoanAppHighlightFgColor}" />
                                <!--
                                    One FormattedString, not three labels: the prototype runs the
                                    symbol, the figure and "/mo spare" together on one line with the
                                    tail at a smaller weight. Spans are also the only way to get the
                                    sign right — AffordabilityCurrencySymbol carries the minus ("-$")
                                    so a negative reads "-$6,328" and not "$-6,328".
                                -->
                                <!--
                                    The hero figure turns red when you are short. IsAffordabilityNegative
                                    rather than the sign of the string: AffordabilityCurrencySymbol
                                    already carries the minus, so the text itself is not a reliable
                                    thing to test.
                                -->
                                <Label AutomationId="WhatIfAnswerAmount" TextColor="{DynamicResource LoanAppHighlightFgColor}">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsAffordabilityNegative}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource LoanAppNegativeValueOnHighlightColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontAttributes="Bold"
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="{DynamicResource LoanAppTextHeroAnswer}"
                                                Text="{Binding AffordabilityCurrencySymbol}" />
                                            <Span
                                                FontAttributes="Bold"
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="{DynamicResource LoanAppTextHeroAnswer}"
                                                Text="{Binding Affordability}" />
                                            <Span
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="{DynamicResource LoanAppTextHeroAnswerTail}"
                                                Text="{Binding AnswerSpareSuffix}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <!--
                                    One card covers both states: AnswerSpareBasis says what the
                                    figure is net of when there is one, and falls back to the
                                    "record your income & expenses" / trial prompt when there is
                                    not. Same idiom as the Loan summary box, so no inverse-boolean
                                    converter is needed.
                                -->
                                <Label
                                    AutomationId="WhatIfAnswerBasis"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Opacity="0.75"
                                    Text="{Binding AnswerSpareBasis}"
                                    TextColor="{DynamicResource LoanAppHighlightFgColor}" />
                            </VerticalStackLayout>
                        </Border>
                                <Label
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Margin="4,4,4,12"
                                    Opacity="0.5"
                                    Text="{DynamicResource LoanAppEstimateMicrocopy}"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--
                                    The prototype's three boxes under the hero. "of income" is the
                                    MONTHLY repayment as a share of GROSS monthly income — the
                                    standard payment-to-income ratio. The prototype's own 35% does
                                    not reconcile with its $2,792/$6,000 (that is 46.5%), so the
                                    definition is pinned in AnswerRepaymentShareOfIncome rather
                                    than copied from the mock. Both halves of the ratio have to be
                                    monthly, and the display is capped — see the remarks there.
                                -->
                                <Grid
                                    Margin="0,0,0,12"
                                    ColumnDefinitions="*,*,*"
                                    ColumnSpacing="8">
                                    <Border
                                        Grid.Column="0"
                                        Padding="10"
                                        Style="{DynamicResource BorderTopHighlightBox}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label AutomationId="WhatIfAnswerRepayment" HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxAmountStyle}" Text="{Binding AnswerRepaymentDisplay}" />
                                            <Label HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxTextStyle}" Text="repayment" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="10"
                                        Style="{DynamicResource BorderTopHighlightBox}">
                                        <VerticalStackLayout Spacing="2">
                                            <!--
                                                Goes red only when the figure is actually negative,
                                                driven by the VM flag rather than by parsing the
                                                formatted string. On the highlight card, which is
                                                pale in every theme, so the deep variant.
                                            -->
                                            <Label AutomationId="WhatIfAnswerNetIncome" HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxAmountStyle}" Text="{Binding AnswerNetIncomeDisplay}">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding AnswerNetIncomeIsNegative}"
                                                        TargetType="Label"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource LoanAppNegativeValueOnHighlightColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxTextStyle}" Text="net income" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        Padding="10"
                                        Style="{DynamicResource BorderTopHighlightBox}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label AutomationId="WhatIfAnswerIncomeShare" HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxAmountStyle}" Text="{Binding AnswerRepaymentShareOfIncome}" />
                                            <Label HorizontalTextAlignment="Center" Style="{DynamicResource LabelThreeBoxTextStyle}" Text="of income" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                
                                <!--
                                    The same explanation card the nine scenario pages use, with this user's own figures
                                    written into it by LoanViewModel.AnswerPanelsExplanation. A plain text blob was not
                                    enough: a reader asking what "of income" means wants their own numbers walked
                                    through, not a definition.
                                -->
                                <customControls:ScenarioExplainerView
                                    Explanation="{Binding AnswerPanelsExplanation}"
                                    HeaderText="Understanding these numbers" />

                                <!--  SCENARIOS  -->
                                <Label
                                    Margin="4,4,4,6"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Opacity="0.45"
                                    Text="SCENARIOS"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <!--
                                    Single entry point into the nine-row scenario index. Without
                                    it the Scenarios sub-tab is only reachable by noticing the tab
                                    header, which is the discoverability problem the redesign set
                                    out to fix.
                                -->
                                <Border
                                    AutomationId="WhatIfSeeScenariosCard"
                                    Margin="0,0,0,8"
                                    Padding="16,14"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSeeScenariosTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontAttributes="Bold" FontSize="{DynamicResource FontSizeBody}" Text="See all 9 scenarios" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontSize="{DynamicResource FontSizeSmall}" Opacity="0.55" Text="Rate changes, extra repayments, stress tests and more" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" FontSize="{DynamicResource FontSizeXL}" Text="›" TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!--
                                    "Where the money goes" — a stacked column per year, interest
                                    on top of principal, so the shift from one to the other over
                                    the term is the thing you see. Fed by AnswerPrincipalByYearAxis
                                    / AnswerInterestByYearAxis, which are the amortisation rows
                                    summed per year (the per-row series would draw one column per
                                    repayment).

                                    Hidden until there is a loan: an empty stacked chart renders as
                                    a bare pair of axes, which reads as a broken chart rather than
                                    as "nothing to show yet".
                                -->
                                <!--
                                    Visibility is set in RefreshAnswerChart alongside the card's,
                                    not bound: the flag lives on LoanViewModel and would have to
                                    raise PropertyChanged off a collection refill to work as a
                                    binding. Two assignments in one place beats that.
                                -->
                                <Label
                                    x:Name="AnswerChartHeader"
                                    Margin="4,10,4,6"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    IsVisible="False"
                                    Opacity="0.45"
                                    Text="WHERE THE MONEY GOES"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                                <Border
                                    x:Name="AnswerChartCard"
                                    Margin="0,0,0,8"
                                    HeightRequest="260"
                                    IsVisible="False"
                                    Style="{DynamicResource LoanAppChartBorderStyle}">
                                    <Border.Content>
                                        <chart:SfCartesianChart Margin="4,8,8,4">
                                            <chart:SfCartesianChart.Legend>
                                                <chart:ChartLegend Placement="Bottom">
                                                    <chart:ChartLegend.LabelStyle>
                                                        <chart:ChartLegendLabelStyle
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{DynamicResource LoanAppTextChartLegend}"
                                                            TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                    </chart:ChartLegend.LabelStyle>
                                                </chart:ChartLegend>
                                            </chart:SfCartesianChart.Legend>
                                            <chart:SfCartesianChart.XAxes>
                                                <!--
                                                    No LabelCreated here on purpose. These labels
                                                    are years, and ChartAxisFormatter.Money parses
                                                    anything numeric — it would render 2027 as
                                                    "$2K".
                                                -->
                                                <chart:CategoryAxis PlotOffsetEnd="4">
                                                    <chart:CategoryAxis.LabelStyle>
                                                        <chart:ChartAxisLabelStyle
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{DynamicResource FontSizeXS}"
                                                            TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                    </chart:CategoryAxis.LabelStyle>
                                                </chart:CategoryAxis>
                                            </chart:SfCartesianChart.XAxes>
                                            <chart:SfCartesianChart.YAxes>
                                                <chart:NumericalAxis LabelCreated="OnAnswerChartValueLabelCreated" ShowMajorGridLines="True">
                                                    <chart:NumericalAxis.LabelStyle>
                                                        <chart:ChartAxisLabelStyle
                                                            FontFamily="{DynamicResource DefaultFontFamily}"
                                                            FontSize="{DynamicResource FontSizeXS}"
                                                            TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                    </chart:NumericalAxis.LabelStyle>
                                                </chart:NumericalAxis>
                                            </chart:SfCartesianChart.YAxes>
                                            <chart:SfCartesianChart.Series>
                                                <chart:StackingColumnSeries
                                                    x:Name="AnswerPrincipalSeries"
                                                    Fill="{DynamicResource LoanAppChartColor1}"
                                                    Label="Principal"
                                                    LegendIcon="Rectangle"
                                                    XBindingPath="Name"
                                                    YBindingPath="Value" />
                                                <chart:StackingColumnSeries
                                                    x:Name="AnswerInterestSeries"
                                                    Fill="{DynamicResource LoanAppChartColor2}"
                                                    Label="Interest"
                                                    LegendIcon="Rectangle"
                                                    XBindingPath="Name"
                                                    YBindingPath="Value" />
                                            </chart:SfCartesianChart.Series>
                                        </chart:SfCartesianChart>
                                    </Border.Content>
                                </Border>

                                <!--
                                    The schedule lives under Loan now, so this is the contextual
                                    pointer to where it went — the same reason Budget carries a
                                    "See the projection" link.
                                -->
                                <Border
                                    AutomationId="WhatIfSeeScheduleCard"
                                    Margin="0,0,0,8"
                                    Padding="16,14"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSeeScheduleTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontAttributes="Bold" FontSize="{DynamicResource FontSizeBody}" Text="See the full schedule" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontSize="{DynamicResource FontSizeSmall}" Opacity="0.55" Text="Year-by-year principal and interest, now under Loan" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" FontSize="{DynamicResource FontSizeXL}" Text="›" TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <Border
                                    AutomationId="WhatIfExportCard"
                                    Margin="0,0,0,8"
                                    Padding="16,14"
                                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                                    Stroke="{DynamicResource BorderControlGradientBrush}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnExportTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontSize="{DynamicResource FontSizeSmall}" Opacity="0.55" Text="EXPORT A PDF REPORT" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label FontSize="{DynamicResource FontSizeSmall}" Opacity="0.4" Text="Everything here, as a document" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" FontSize="{DynamicResource FontSizeXL}" Text="›" TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <tabView:SfTabItem AutomationId="WhatIfTabScenarios" Header="Scenarios">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <VerticalStackLayout Padding="12,16,12,32" Spacing="0">
                            <!--  Advisory microcopy — persistent estimate/not-advice reminder  -->
                            <Label
                                IsVisible="{Binding HasLoanData}"
                                Margin="0,0,0,18"
                                FontSize="{DynamicResource FontSizeSmall}"
                                Opacity="0.5"
                                Text="{DynamicResource LoanAppEstimateMicrocopy}"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            <!--  No data placeholder  -->
                            <Border
                                AutomationId="WhatIfNoDataPanel"
                                IsVisible="{Binding HasNoLoanData}"
                                Margin="0,20,0,0"
                                Padding="20"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Label
                                        FontSize="{DynamicResource FontSizeLarge}"
                                        HorizontalTextAlignment="Center"
                                        Text="No loan data yet"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    <Label
                                        FontSize="{DynamicResource FontSizeBody}"
                                        HorizontalTextAlignment="Center"
                                        Opacity="0.6"
                                        Text="Enter your asset value and loan details on the Loan tab first."
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    <!--
                                        The whole point of this panel, per whatif-empty.html: a way
                                        to ACT on the message. It was static text telling the user
                                        where to go without taking them there.
                                    -->
                                    <Button
                                        AutomationId="WhatIfGoToLoanButton"
                                        Margin="0,10,0,0"
                                        BackgroundColor="{DynamicResource LoanAppInputTextFgColor}"
                                        Clicked="OnGoToLoanTapped"
                                        CornerRadius="10"
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        HeightRequest="44"
                                        HorizontalOptions="Center"
                                        Padding="20,0"
                                        Text="Go to Loan ›"
                                        TextColor="{DynamicResource LoanAppAppShellBgColor}" />
                                </VerticalStackLayout>
                            </Border>

                            <!--
                                ══ Scenario index ══
                                These nine rows replace nine full cards that used to be stacked here in
                                one scroll — one card was taller than the screen, so the page ran to
                                roughly nine screens with no way to jump to the scenario you wanted and
                                no way to address one. Each row now opens its scenario full-screen via
                                ScenarioPage; the cards themselves live in Controls/Scenarios/.

                                The accent stripe colours carry over from the cards, so a scenario keeps
                                the same colour identity in the list as it has on its own page.
                            -->
                            <VerticalStackLayout IsVisible="{Binding HasLoanData}" Spacing="0">

                            <Border
                                AutomationId="WhatIfScenarioRateChange"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="RateChange" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor1}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Rate change"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="If rates move up or down"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <!--
                                            The binding path is RateChangeMonthlyDiff, NOT the
                                            AutomationId. This label first shipped binding to a
                                            path spelled the same as its own automation id, and no
                                            such property exists on WhatIfViewModel. (Written
                                            without the literal binding syntax on purpose — in a
                                            comment it reads as a real binding to any audit that
                                            greps for one.) The binding failed silently,
                                            the label rendered empty at zero height, and iOS then
                                            reported no *visible* element with that id at all. So
                                            the symptom was "missing AutomationId", pointing at the
                                            markup attribute that was in fact correct.

                                            Every one of these outcome properties defaults to a
                                            placeholder dash string rather than the empty string,
                                            which is what keeps the row visible (and findable)
                                            before anything has been calculated. Note an XML
                                            comment cannot contain a double hyphen, so that
                                            default cannot be written literally here.
                                        -->
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioRateChangeDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding RateChangeMonthlyDiff}"
                                            TextColor="{DynamicResource LoanAppChartColor2}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding RateChangeDiffIsPositive}" TargetType="Label" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource LoanAppChartColor1}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioExtraRepayment"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="ExtraRepayment" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor2}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Extra repayment"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Pay more each month"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioExtraRepaymentDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding ExtraRepaymentTimeSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioTermComparison"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="TermComparison" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor3}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Loan term"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Shorter term, higher payment"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioTermComparisonDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding TermComparisonMonthlyDiff}"
                                            TextColor="{DynamicResource LoanAppChartColor2}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioDepositScenarios"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="DepositScenarios" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor1}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Deposit"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="What a bigger deposit changes"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioDepositScenariosDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding DepositScenariosMonthlyDiff}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioLumpSum"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="LumpSum" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor2}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Lump sum"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="A one-off payment off the balance"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioLumpSumDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding LumpSumTimeSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioRepaymentFrequency"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="RepaymentFrequency" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor3}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Repayment frequency"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Weekly and fortnightly vs monthly"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioRepaymentFrequencyDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding FreqWeeklyIntSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioOffset"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="Offset" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor1}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Offset account"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Savings offset against the balance"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioOffsetDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding OffsetInterestSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioStressTest"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="StressTest" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor2}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Stress test"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="When does this become unaffordable?"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <!--
                                            A near-match, not an exact one: the prototype shows a
                                            verdict here ("still affordable") and this shows the
                                            rate buffer that verdict would be derived from. There
                                            is no verdict string on WhatIfViewModel today, and
                                            inventing one means choosing the threshold at which
                                            "affordable" flips — a product decision, not a port.
                                        -->
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioStressTestDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding StressTestRateBuffer}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding StressTestHasBuffer}" TargetType="Label" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource LoanAppChartColor2}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border
                                AutomationId="WhatIfScenarioCombined"
                                Margin="0,0,0,8"
                                Padding="0"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="Combined" Tapped="OnScenarioTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Grid.Column="0" BackgroundColor="{DynamicResource LoanAppChartColor3}" CornerRadius="12,0,12,0" />
                                    <Grid Grid.Column="1" Padding="14,13" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Text="Combined strategy"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.6"
                                                Text="Everything at once"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            AutomationId="WhatIfScenarioCombinedDelta"
                                            FontAttributes="Bold"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Text="{Binding CombinedTimeSaved, StringFormat='-{0}'}"
                                            TextColor="{DynamicResource LoanAppChartColor1}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Opacity="0.4"
                                            Text="&#x203A;"
                                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            </VerticalStackLayout>
                            </VerticalStackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <!--  Moved from Budget: forward-looking, so it belongs with the scenarios.  -->
                <tabView:SfTabItem AutomationId="WhatIfTabProjection" Header="Projection">
                    <tabView:SfTabItem.Content>
                        <!--
                            Two rows: a pinned header, then everything else scrolling under it.

                            The two totals react to every setting on this tab — RefreshProjection
                            calls UpdateProjectionSummaryBar — but they used to sit INSIDE the
                            ScrollView above the settings, so by the time you had scrolled down to a
                            switch, the only thing that answers it had scrolled off the screen. The
                            feedback existed and was correct; it just was not visible when it
                            mattered. Pinning the row is what makes it do its job.

                            The intro sentence is pinned with them deliberately: it names the time
                            period, and two bare currency totals with no caption are cryptic. It is
                            also the only place the horizon is now stated, since the years slider
                            lives in the collapsed panel below.
                        -->
                        <Grid RowDefinitions="Auto,*">

                            <VerticalStackLayout
                                x:Name="ProjectionPinnedHeader"
                                Grid.Row="0"
                                Padding="12,8,12,4"
                                BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
                                Spacing="8">
                                    <!--
                                        Says what the page is for, per projection.html — and now
                                        also where the horizon is stated. It used to be a whole
                                        summary box holding a two-digit number, which cost the two
                                        currency totals a third of the width each; here it costs
                                        one word in a sentence that wanted a timeframe anyway. The
                                        slider further down remains the control.
                                    -->
                                    <Label
                                        AutomationId="WhatIfProjectionIntro"
                                        x:Name="LblProjectionIntro"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        Opacity="0.6"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />


                                    <!--  Summary bar  -->
                                    <customControls:ThreeColumnBorderedContentView x:Name="ProjectionSummaryBar" Box3Visible="False">
                                        <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                            <FormattedString>
                                                <!--  The break is written with the figure in UpdateProjectionSummaryBar — see the note there.  -->
                                                <Span x:Name="ProjectionIncomeSpan" Style="{DynamicResource SpanThreeBoxAmountStyle}" />
                                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Projected Income" />
                                            </FormattedString>
                                        </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                        <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                            <FormattedString>
                                                <Span x:Name="ProjectionExpenseSpan" Style="{DynamicResource SpanThreeBoxAmountStyle}" />
                                                <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Projected Expense" />
                                            </FormattedString>
                                        </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    </customControls:ThreeColumnBorderedContentView>
                            </VerticalStackLayout>

                            <ScrollView
                                x:Name="ProjectionRoot"
                                Grid.Row="1"
                                BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
                                <VerticalStackLayout Padding="12,8,12,32" Spacing="12">
                                        <customControls:InfoHintView
                                            DetailAutomationId="WhatIfProjectionInfoTotalsDetail"
                                            Detail="{x:Static constants:ProjectionInfo.Totals}"
                                            InfoAutomationId="WhatIfProjectionInfoTotals"
                                            LiveExample="{Binding ProjectionPersonalLine}"
                                            Prompt="What these two totals mean" />


                                        <!--  Income & Expense Projection chart  -->
                                        <HorizontalStackLayout Margin="20,16,20,4" Spacing="8">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Opacity="0.7"
                                                Text="INCOME &amp; EXPENSE PROJECTION"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                VerticalOptions="Center" />
                                            <!--  Shown while a debounced projection rebuild is catching up  -->
                                            <ActivityIndicator
                                                HeightRequest="14"
                                                WidthRequest="14"
                                                Color="{DynamicResource LoanAppAppShellFgColor}"
                                                IsRunning="{Binding IsProjectionRefreshing}"
                                                IsVisible="{Binding IsProjectionRefreshing}"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                IsVisible="{Binding IsProjectionRefreshing}"
                                                Opacity="0.7"
                                                Text="Updating…"
                                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <!--
                                            Margin repeats the control's own negative vertical pull
                                            because this is the one hint that needs a horizontal inset
                                            (its neighbours here are inset by 20). A bare "20,0" would
                                            replace the control's default outright and bring the gap
                                            back — see the note in InfoHintView.xaml.
                                        -->
                                        <customControls:InfoHintView
                                            DetailAutomationId="WhatIfProjectionInfoChartDetail"
                                            Detail="{x:Static constants:ProjectionInfo.Chart}"
                                            InfoAutomationId="WhatIfProjectionInfoChart"
                                            Margin="20,-9,20,-3"
                                            Prompt="How to read this chart" />

                                        <Border Style="{DynamicResource LoanAppChartBorderStyle}">
                                            <Border.Content>
                                                <chart:SfCartesianChart
                                                    x:Name="ProjectionChart"
                                                    Margin="{OnIdiom Phone='5,12,5,0',
                                                                     Tablet='20,16,20,10',
                                                                     Desktop='20,16,20,10',
                                                                     Default='5,12,5,0'}"
                                                    BackgroundColor="Transparent"
                                                    HorizontalOptions="FillAndExpand"
                                                    PaletteBrushes="{Binding CustomChartColors}"
                                                    VerticalOptions="FillAndExpand">
                                                    <chart:SfCartesianChart.XAxes>
                                                        <chart:CategoryAxis
                                                            EdgeLabelsDrawingMode="Fit"
                                                            LabelPlacement="BetweenTicks"
                                                            ShowMajorGridLines="False">
                                                            <chart:CategoryAxis.LabelStyle>
                                                                <chart:ChartAxisLabelStyle
                                                                    FontAttributes="Bold"
                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                    FontSize="{DynamicResource LoanAppTextChartAxis}"
                                                                    TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                            </chart:CategoryAxis.LabelStyle>
                                                            <chart:CategoryAxis.MajorTickStyle>
                                                                <chart:ChartAxisTickStyle TickSize="8" />
                                                            </chart:CategoryAxis.MajorTickStyle>
                                                        </chart:CategoryAxis>
                                                    </chart:SfCartesianChart.XAxes>
                                                    <chart:SfCartesianChart.YAxes>
                                                        <chart:NumericalAxis LabelCreated="OnProjectionAxisLabelCreated">
                                                            <chart:NumericalAxis.LabelStyle>
                                                                <chart:ChartAxisLabelStyle
                                                                    FontAttributes="Bold"
                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                    FontSize="{DynamicResource LoanAppTextChartAxis}"
                                                                    TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                            </chart:NumericalAxis.LabelStyle>
                                                            <chart:NumericalAxis.AxisLineStyle>
                                                                <chart:ChartLineStyle StrokeWidth="0" />
                                                            </chart:NumericalAxis.AxisLineStyle>
                                                            <chart:NumericalAxis.MajorTickStyle>
                                                                <chart:ChartAxisTickStyle TickSize="0" />
                                                            </chart:NumericalAxis.MajorTickStyle>
                                                        </chart:NumericalAxis>
                                                    </chart:SfCartesianChart.YAxes>
                                                    <chart:SfCartesianChart.Legend>
                                                        <chart:ChartLegend Placement="Bottom" ToggleSeriesVisibility="True">
                                                            <chart:ChartLegend.LabelStyle>
                                                                <chart:ChartLegendLabelStyle
                                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                                    FontSize="{DynamicResource LoanAppTextChartLegend}"
                                                                    TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                            </chart:ChartLegend.LabelStyle>
                                                        </chart:ChartLegend>
                                                    </chart:SfCartesianChart.Legend>
                                                    <chart:ColumnSeries
                                                        x:Name="ProjIncomeSeries"
                                                        EnableAnimation="True"
                                                        Label="Income"
                                                        LegendIcon="Rectangle"
                                                        Stroke="{DynamicResource LoanAppChartColor1}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />
                                                    <chart:ColumnSeries
                                                        x:Name="ProjExpenseSeries"
                                                        EnableAnimation="True"
                                                        Label="Expenses"
                                                        LegendIcon="Rectangle"
                                                        Stroke="{DynamicResource LoanAppChartColor2}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />
                                                </chart:SfCartesianChart>
                                            </Border.Content>
                                        </Border>

                                        <!--
                                            Controls — now BELOW the chart and collapsed by default.

                                            They used to come first, which buried the chart and both
                                            tables under a screenful of settings: people changed a
                                            switch and never discovered there was anything below
                                            reacting to it. Results first, adjustments second.

                                            Collapsed rather than merely moved, so the chart sits a
                                            short scroll from the top instead of under 390 lines of
                                            markup. The summary line in the header is what keeps that
                                            honest — a closed panel that hides whether the totals are
                                            before or after the loan would be worse than the original
                                            problem.

                                            A REAL SfExpander now, matching every other disclosure in
                                            the app (Settings, the ⓘ hints' sibling pattern, the
                                            scenario explainer cards) — a hand-rolled tappable Label
                                            with a text-glyph chevron read as unfinished next to
                                            those, and its hit target was smaller than Syncfusion's
                                            own header chrome.

                                            Safe here specifically because OnAppearing already calls
                                            SyncfusionIosTouchFix.ApplyToExpanders(this) for this
                                            page's OTHER expanders (see below), and this one is
                                            static markup present from construction — unlike
                                            Insights, which needed its own extra call because its
                                            content does not exist yet when OnAppearing runs. See
                                            CLAUDE.md: the defect is silent, so if a new expander is
                                            added anywhere that is built AFTER OnAppearing already
                                            ran, it needs that second call too.
                                        -->
                                        <Border Margin="0,10,0,0" Style="{DynamicResource ExpanderCardStyle}">
                                            <expander:SfExpander
                                                HeaderIconPosition="End"
                                                IsExpanded="False"
                                                Style="{DynamicResource CommonExpanderStyle}">

                                                <expander:SfExpander.Header>
                                                    <Grid Padding="0,2">
                                                        <VerticalStackLayout Spacing="2">
                                                            <Label
                                                                AutomationId="WhatIfProjectionSettingsHeader"
                                                                FontSize="{DynamicResource FontSizeBody}"
                                                                Style="{DynamicResource ExpanderHeaderLabelStyle}"
                                                                Text="ADJUST THE SETTINGS" />
                                                            <!--  What is in force right now, so collapsing hides nothing that matters.  -->
                                                            <Label
                                                                AutomationId="WhatIfProjectionSettingsSummary"
                                                                Style="{DynamicResource ExpanderHeaderSubLabelStyle}"
                                                                Text="{Binding ProjectionSettingsSummary}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </expander:SfExpander.Header>

                                                <expander:SfExpander.Content>
                                                    <VerticalStackLayout Padding="16" Spacing="12">

                                                <!--  INCOME PROJECTION  -->
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource FontSizeSmall}"
                                                    Opacity="0.7"
                                                    Text="INCOME PROJECTION"
                                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />


                                                <!--  Income growth rate stepper  -->
                                                <Grid ColumnSpacing="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="44" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        FontSize="{DynamicResource FontSizeSmall}"
                                                        Opacity="0.7"
                                                        Text="Annual growth %"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                                        VerticalOptions="Center" />
                                                    <Button
                                                        Grid.Column="1"
                                                        BackgroundColor="Transparent"
                                                        Clicked="OnIncomeGrowthRateDecrease"
                                                        FontAttributes="Bold"
                                                        FontSize="{DynamicResource FontSizeHeading}"
                                                        Text="−"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                    <Label
                                                        x:Name="LblIncomeGrowthRate"
                                                        Grid.Column="2"
                                                        FontAttributes="Bold"
                                                        FontSize="{DynamicResource FontSizeHeading}"
                                                        HorizontalOptions="Center"
                                                        HorizontalTextAlignment="Center"
                                                        MinimumWidthRequest="48"
                                                        TextColor="{DynamicResource LoanAppInputTextFgColor}"
                                                        VerticalOptions="Center" />
                                                    <Button
                                                        Grid.Column="3"
                                                        BackgroundColor="Transparent"
                                                        Clicked="OnIncomeGrowthRateIncrease"
                                                        FontAttributes="Bold"
                                                        FontSize="{DynamicResource FontSizeHeading}"
                                                        Text="+"
                                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                                </Grid>
                                                <customControls:InfoHintView
                                                    DetailAutomationId="WhatIfProjectionInfoIncomeGrowthDetail"
                                                    Detail="{x:Static constants:ProjectionInfo.IncomeGrowth}"
                                                    InfoAutomationId="WhatIfProjectionInfoIncomeGrowth"
                                                    Prompt="What this growth figure does" />

                                                <BoxView Style="{DynamicResource LoanAppSeparatorStyle}" />

                                                <!--  Include expenses switch  -->
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <buttons:SfSwitch
                                                        x:Name="SwitchIncludeExpenses"
                                                        Grid.Column="0"
                                                        HorizontalOptions="Start"
                                                        StateChanged="OnIncludeExpensesChanged">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="ProjIncomeSwitchStates1">
                                                                <VisualState x:Name="On">
                                                                    <VisualState.Setters>
                                                                        <Setter Property="SwitchSettings">
                                                                            <Setter.Value>
                                                                                <buttons:SwitchSettings
                                                                                    ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                                    ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                                    TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                                    TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Off">
                                                                    <VisualState.Setters>
                                                                        <Setter Property="SwitchSettings">
                                                                            <Setter.Value>
                                                                                <buttons:SwitchSettings
                                                                                    ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                                    ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                                    TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                                    TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                                            </Setter.Value>
                                                                        </Setter>
