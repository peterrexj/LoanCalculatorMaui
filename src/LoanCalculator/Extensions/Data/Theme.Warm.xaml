    <!--  Notifications  -->
    <Color x:Key="LoanAppNotificationWarningBgGradientStart">#F6D0C4</Color>
    <Color x:Key="LoanAppNotificationWarningBgGradientEnd">#F0BCAB</Color>
    <Color x:Key="LoanAppNotificationInformationBgGradientStart">#F6E0E0</Color>
    <Color x:Key="LoanAppNotificationInformationBgGradientEnd">#EAD0D0</Color>
    <Color x:Key="LoanAppNotificationTextColor">#4A2424</Color>
    <Color x:Key="LoanAppNotificationBgColor">#FBEDED</Color>

    <!--  Lists  -->
    <Color x:Key="LstForegroundColor">#4A2424</Color>
    <Color x:Key="LoanAppLstBgGradientStart">#FBEDED</Color>
    <Color x:Key="LoanAppLstBgGradientEnd">#F6E0E0</Color>
    <Color x:Key="LoanAppLstBorderGradientStart">#E0B8B8</Color>
    <Color x:Key="LoanAppLstBorderGradientEnd">#D5B4B4</Color>

    <!--  Style for Lists  -->
    <LinearGradientBrush x:Key="LoanAppLstBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppLstBgGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppLstBgGradientEnd}" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LoanAppLstBorderBrush" Center="0.5,0.5" Radius="0.5">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppLstBorderGradientStart}" />
        <GradientStop Offset="0.7" Color="{StaticResource LoanAppLstBorderGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppLstBorderGradientEnd}" />
    </RadialGradientBrush>

    <!--  Buttons  -->
    <Color x:Key="LoanAppButtonFgColor">#F5EBEB</Color>
    <Color x:Key="LoanAppButtonBgColor">#B5635D</Color>
    <Color x:Key="LoanAppExportButtonBgColor">#B5635D</Color>
    <Color x:Key="LoanAppExportButtonFgColor">#F5EBEB</Color>

    <!--  Charts — distinct pastels (teal / gold / plum) on cream surfaces  -->
    <Color x:Key="LoanAppChartAxisTextColor">#7d4a4a</Color>
    <Color x:Key="LoanAppChartLegendTextColor">#4A2424</Color>
    <Color x:Key="LoanAppChartTitleTextColor">#8F4A45</Color>
    <Color x:Key="LoanAppChartDataMarkerTextColor">#4A2424</Color>
    <Color x:Key="LoanAppDonutCenterTextColor">#4A2424</Color>
    <Color x:Key="LoanAppChartOuterBorderGradientStart">#E0B8B8</Color>
    <Color x:Key="LoanAppChartOuterBorderGradientEnd">#D5B4B4</Color>
    <Color x:Key="LoanAppChartInnerBorderGradientStart">#FBEDED</Color>
    <Color x:Key="LoanAppChartInnerBorderGradientEnd">#F6E0E0</Color>
    <Color x:Key="LoanAppChartColor1">#1A8272</Color>
    <Color x:Key="LoanAppChartDataMarkerTextColor1">#E0F5F0</Color>
    <Color x:Key="LoanAppChartColor2">#9E6210</Color>
    <Color x:Key="LoanAppChartDataMarkerTextColor2">#FFF0E0</Color>
    <Color x:Key="LoanAppChartColor3">#883068</Color>
    <Color x:Key="LoanAppChartDataMarkerTextColor3">#F5E0F0</Color>
    <Color x:Key="LoanAppChartCardBackground">#FBEDED</Color>
    <Color x:Key="LoanAppChartColorSeries1">#1A8272</Color>
    <Color x:Key="LoanAppChartColorSeries2">#9E6210</Color>
    <Color x:Key="LoanAppChartColorSeries3">#883068</Color>

    <!--  Borders  -->
    <Color x:Key="LoanAppBorderTopGradientOuterLineStart">#E0B8B8</Color>
    <Color x:Key="LoanAppBorderTopGradientOuterLineEnd">#C2706B</Color>
    <Color x:Key="LoanAppBorderTopGradientBackgroundStart">#FBEDED</Color>
    <Color x:Key="LoanAppBorderTopGradientBackgroundEnd">#F6E0E0</Color>
    <!--  Danger (negative affordability) box — deeper rose on warm theme  -->
    <Color x:Key="LoanAppBorderTopDangerOuterLineStart">#C04040</Color>
    <Color x:Key="LoanAppBorderTopDangerOuterLineEnd">#8F2525</Color>
    <Color x:Key="LoanAppBorderTopDangerBackgroundStart">#F5C0C0</Color>
    <Color x:Key="LoanAppBorderTopDangerBackgroundEnd">#FBDEDE</Color>
    <Color x:Key="LoanAppBorderTopDangerFgColor">#5C1010</Color>

    <!--  Border controls box styles  -->
    <Color x:Key="LoanAppBorderControlGradientBorderLineStart">#E0B8B8</Color>
    <Color x:Key="LoanAppBorderControlGradientBorderLineEnd">#D5B4B4</Color>
    <Color x:Key="LoanAppBorderControlGradientBackgroundStart">#FBEDED</Color>
    <Color x:Key="LoanAppBorderControlGradientBackgroundEnd">#F6E0E0</Color>

    <!--  Insights controls box styles  -->
    <Color x:Key="LoanAppBorderInsightsGradientOuterLineStart">#E0B8B8</Color>
    <Color x:Key="LoanAppBorderInsightsGradientOuterLineEnd">#C2706B</Color>
    <Color x:Key="LoanAppBorderInsightsGradientBackgroundStart">#FBEDED</Color>
    <Color x:Key="LoanAppBorderInsightsGradientBackgroundEnd">#F6E0E0</Color>
    <Color x:Key="LoanAppInsightsFgColor">#4A2424</Color>

    <!--  Expander styles - cannot move this cuz of the initialization failure, need to repeat in all themes  -->
    <LinearGradientBrush x:Key="BorderInsightsGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppBorderInsightsGradientOuterLineStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppBorderInsightsGradientOuterLineEnd}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BorderInsightsBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppBorderInsightsGradientBackgroundStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppBorderInsightsGradientBackgroundEnd}" />
    </LinearGradientBrush>

    <!--  Expander styles  -->
    <Color x:Key="LoanAppExpanderExpandedGradientStart">#C2706B</Color>
    <Color x:Key="LoanAppExpanderExpandedGradientEnd">#B5635D</Color>
    <Color x:Key="LoanAppExpanderCollapsedGradientStart">#B5635D</Color>
    <Color x:Key="LoanAppExpanderCollapsedGradientEnd">#A85951</Color>
    <Color x:Key="LoanAppExpanderHeaderTextColor">#F5EBEB</Color>

    <!--  Expander styles - cannot move this cuz of the initialization failure, need to repeat in all themes  -->
    <LinearGradientBrush x:Key="LoanAppExpanderExpandedGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppExpanderExpandedGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppExpanderExpandedGradientEnd}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LoanAppExpanderCollapsedGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppExpanderCollapsedGradientStart}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppExpanderCollapsedGradientEnd}" />
    </LinearGradientBrush>

    <!--  Checkbox styles  -->
    <Color x:Key="LoanAppCheckboxBackColor">#B5635D</Color>

    <!--  Notification background brush  -->
    <LinearGradientBrush x:Key="InformationBackgroundGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppNotificationInformationBgGradientStart}" />
        <GradientStop Offset="0.7" Color="{StaticResource LoanAppNotificationInformationBgGradientEnd}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppNotificationInformationBgGradientStart}" />
    </LinearGradientBrush>
    <!--  Notification background brush  -->
    <LinearGradientBrush x:Key="WarningBackgroundGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0.0" Color="{StaticResource LoanAppNotificationWarningBgGradientStart}" />
        <GradientStop Offset="0.7" Color="{StaticResource LoanAppNotificationWarningBgGradientEnd}" />
        <GradientStop Offset="1.0" Color="{StaticResource LoanAppNotificationWarningBgGradientStart}" />
    </LinearGradientBrush>

    <!--  Disclaimer  -->
    <Color x:Key="LoanAppDisclaimerBodyBackgroundColor">#FBEDED</Color>
    <Color x:Key="LoanAppDisclaimerHeaderBackgroundColor">#B5635D</Color>
    <Color x:Key="LoanAppDisclaimerHeaderTextColor">#F5EBEB</Color>
    <Color x:Key="LoanAppDisclaimerHeaderBorderColor">#D5B4B4</Color>
    <Color x:Key="LoanAppDisclaimerContentBackgroundColor">#FBEDED</Color>
    <Color x:Key="LoanAppDisclaimerContentForegroundColor">#4A2424</Color>
    <Color x:Key="LoanAppDisclaimerContentBoxShadowColor">#D5B4B4</Color>
