<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="LoanCalculatorMaui.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LoanCalculatorMaui"
    xmlns:localConverters="clr-namespace:LoanCalculatorMaui.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <localConverters:StringToColorConverter x:Key="StringToBrushConverter" />
            <localConverters:BoolToAddUpdateConverter x:Key="BoolToAddUpdateConverter" />
            <localConverters:BoolToEditAddTitleConverter x:Key="BoolToEditAddTitleConverter" />
            <localConverters:IntToIsEmptyConverter x:Key="IntToIsEmptyConverter" />
            <localConverters:NumberToWordsConverter x:Key="NumberToWordsConverter" />
            <localConverters:AmountToCurrencyConverter x:Key="AmountToCurrencyConverter" />
            <localConverters:BoolToFontAttributesConverter x:Key="BoolToFontAttributesConverter" />
            <localConverters:BoolToDisclaimerFontSizeConverter x:Key="BoolToDisclaimerFontSizeConverter" />
            <localConverters:BoolToDisclaimerMarginConverter x:Key="BoolToDisclaimerMarginConverter" />
            <localConverters:ThemeNameToGradientConverter x:Key="ThemeNameToGradientConverter" />
            <localConverters:ThemeNameToTextColorConverter x:Key="ThemeNameToTextColorConverter" />
            <!--
                Two instances of the same converter, differing only in which negative key they
                resolve — one for ordinary cards, one for the pale BorderTop* highlight cards.
                Spans cannot carry a DataTrigger, which is why these exist at all.
            -->
            <localConverters:NegativeToThemeColorConverter x:Key="NegativeToThemeColorConverter" />
            <localConverters:NegativeToThemeColorConverter x:Key="NegativeToHighlightColorConverter" NegativeKey="LoanAppNegativeValueOnHighlightColor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
