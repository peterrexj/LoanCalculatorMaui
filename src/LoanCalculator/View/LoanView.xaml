                                        VerticalOptions="FillAndExpand">
                                        <sfList:SfListView.ItemTemplate>
                                            <DataTemplate x:DataType="income:IncomeExpense">
                                                <Border Style="{DynamicResource TransactionListItemBorderStyle}" VerticalOptions="Fill">
                                                    <Grid VerticalOptions="Fill">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40*" />
                                                                <ColumnDefinition Width="20*" />
                                                                <ColumnDefinition Width="20*" />
                                                                <ColumnDefinition Width="{OnIdiom Phone=40, Tablet=50, Desktop=60, TV=60, Default=40}" />
                                                                <ColumnDefinition Width="{OnIdiom Phone=40, Tablet=50, Desktop=60, TV=60, Default=40}" />
                                                            </Grid.ColumnDefinitions>

                                                            <Label
                                                                Grid.Column="0"
                                                                Margin="{OnPlatform Android={OnIdiom Phone='5,0,0,0',
                                                                                                     Tablet='15,0,0,0',
                                                                                                     Desktop='15,0,0,0',
                                                                                                     TV='15,0,0,0'},
                                                                                    iOS={OnIdiom Phone='5,0,0,0',
                                                                                                 Tablet='15,0,0,0',
                                                                                                 Desktop='15,0,0,0',
                                                                                                 TV='15,0,0,0'},
                                                                                    Default='5,0,0,0'}"
