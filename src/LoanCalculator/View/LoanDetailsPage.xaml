<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoanCalculatorMaui.View.LoanDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:primaryModels="clr-namespace:LoanCalculator.Core.Models.ViewModels.PrimaryModels;assembly=LoanCalculator.Core"
    x:Name="thisPage"
    Title="Loan Details"
    x:DataType="primaryModels:WizardViewModel">

    <!--
        Replaces the separate Quick Setup and Quick Input pages.

        The page shows only figures you can change HERE. Asset, deposit and loan amount have no
        other typed route — the Asset tab displays them read-only — so they are always present.
        Upfront costs, running costs, income and expenses each have their own screen, so they appear
        only while empty, as a first-run convenience, and vanish once recorded.

        Section A writes the model live, because the three figures derive from each other and the
        user needs to see that happen. Section B is deferred to Apply. Neither binds Entry.Text:
        see the comment on WizardViewModel.WizardAssetText.
    -->
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" RowDefinitions="Auto,*">

            <Grid Grid.Row="0" Padding="16,14,8,4" ColumnDefinitions="*,Auto,Auto">
                <Label Grid.Column="0" Style="{DynamicResource PopupTitleLabelStyle}" Text="Loan Details" />
                <Button
                    AutomationId="QuickInputApplyButton"
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    Clicked="OnApply"
                    FontSize="{DynamicResource FontSizeLarge}"
                    HeightRequest="36"
                    Text="Done"
                    TextColor="{DynamicResource LoanAppTabIndicatorStrokeColor}"
                    WidthRequest="72" />
                <Button
                    AutomationId="WizardCancelButton"
                    Grid.Column="2"
                    Clicked="OnCancel"
                    Style="{DynamicResource PopupDismissButtonStyle}" />
            </Grid>

            <ScrollView Grid.Row="1">
                <!--
                    The large bottom padding is load-bearing. The keyboard overlays the ScrollView
                    rather than insetting it, so without extra content height the tail of the form
                    cannot be scrolled clear of it.
                -->
                <VerticalStackLayout Padding="12,4,12,300" Spacing="0">

                    <!--
                        ══ Section A — always shown: no other way to type these ══

                        Its own card. The A/B split used to be carried only by a slightly larger
                        margin and the comments below, so two groups with different rules read as
                        one list of seven fields. Two cards state it structurally: A is permanent,
                        B disappears field by field as each value gets recorded elsewhere.
                    -->
                    <Border Style="{DynamicResource FormCardStyle}">
                        <VerticalStackLayout Spacing="0">

                            <VerticalStackLayout Spacing="0">
                                <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="{Binding CurrencySymbol, StringFormat='ASSET VALUE {0}'}" />
                                <Border Style="{DynamicResource PopupInputBorderStyle}">
                                    <Entry
                                        x:Name="entryAsset"
                                        AutomationId="AssetEntry"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeXL}"
                                        Keyboard="Numeric"
                                        Placeholder="e.g. 650,000"
                                        PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                        TextChanged="OnAssetTextChanged"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        Unfocused="OnEntryUnfocused" />
                                </Border>
                                <!--
                                    The formatted figure stays alongside the word form here, unlike
                                    on TransactionEntryPage where the card foot restates the same
                                    single amount and the echo was redundant. The foot below states
                                    a DIFFERENT figure (the total), so each field still needs its
                                    own — and this is the only node carrying the currency symbol,
                                    which is what SettingsTests asserts on via LoanFormatted after
                                    switching the currency to Euro.
                                -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label x:Name="lblAssetFormatted" Grid.Column="0" AutomationId="AssetFormatted" Style="{DynamicResource PopupFieldHintStyle}" />
                                    <Label x:Name="lblAssetWords" Grid.Column="1" Margin="6,4,0,0" AutomationId="AssetWords" Style="{DynamicResource PopupFieldHintStyle}" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Margin="0,14,0,0" Spacing="0">
                                <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="{Binding CurrencySymbol, StringFormat='DEPOSIT AMOUNT {0}'}" />
                                <Border Style="{DynamicResource PopupInputBorderStyle}">
                                    <Entry
                                        x:Name="entryDeposit"
                                        AutomationId="DepositEntry"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeXL}"
                                        Keyboard="Numeric"
                                        Placeholder="e.g. 130,000"
                                        PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                        TextChanged="OnDepositTextChanged"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        Unfocused="OnEntryUnfocused" />
                                </Border>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label x:Name="lblDepositFormatted" Grid.Column="0" AutomationId="DepositFormatted" Style="{DynamicResource PopupFieldHintStyle}" />
                                    <Label x:Name="lblDepositWords" Grid.Column="1" Margin="6,4,0,0" AutomationId="DepositWords" Style="{DynamicResource PopupFieldHintStyle}" />
                                </Grid>
                                <!--
                                    Names the cap at the moment it bites. The model silently clamps
                                    deposit and loan to PropertyTotalAmount, and nothing said so —
                                    the figures above simply stopped following what was being typed
                                    and then the field itself jumped on blur. IsVisible is driven
                                    from code beside the clamp read-back, not bound, because the
                                    comparison is between the typed text and what the model
                                    accepted, and the typed text is deliberately unbound here.
                                -->
                                <Label
                                    x:Name="lblDepositCapNote"
                                    AutomationId="DepositCapNote"
                                    IsVisible="False"
                                    Style="{DynamicResource PopupErrorLabelStyle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Margin="0,14,0,0" Spacing="0">
                                <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="{Binding CurrencySymbol, StringFormat='LOAN AMOUNT {0}'}" />
                                <Border Style="{DynamicResource PopupInputBorderStyle}">
                                    <Entry
                                        x:Name="entryLoan"
                                        AutomationId="LoanEntry"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeXL}"
                                        Keyboard="Numeric"
                                        Placeholder="0"
                                        PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                        TextChanged="OnLoanTextChanged"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        Unfocused="OnEntryUnfocused" />
                                </Border>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label x:Name="lblLoanFormatted" Grid.Column="0" AutomationId="LoanFormatted" Style="{DynamicResource PopupFieldHintStyle}" />
                                    <Label x:Name="lblLoanWords" Grid.Column="1" Margin="6,4,0,0" AutomationId="LoanWords" Style="{DynamicResource PopupFieldHintStyle}" />
                                </Grid>
                                <!--  Same clamp note as the deposit field above.  -->
                                <Label
                                    x:Name="lblLoanCapNote"
                                    AutomationId="LoanCapNote"
                                    IsVisible="False"
                                    Style="{DynamicResource PopupErrorLabelStyle}" />
                            </VerticalStackLayout>

                            <!--
                                Card foot: the identity tying the three fields together. These are
                                not three independent amounts — HomeLoanInformation stores a total
                                and ONE split point, so asset + upfront = deposit + loan always
                                holds (see "Cost increases grow the loan" in CLAUDE.md). Stating it
                                is what answers "why is the loan bigger than the asset I typed?":
                                upfront costs are folded into the loan rather than paid separately,
                                so without this line a user who typed 650,000 and sees a 670,003
                                loan has no way to see where the extra went.

                                Moved here from two stacked labels under the asset field, where
                                figures about the whole form sat in the place reserved for hints
                                about that one input. The breakdown line appears only once there is
                                an upfront cost to explain — see WizardShowAssetBreakdown.
                            -->
                            <BoxView IsVisible="{Binding WizardShowAssetTotal}" Style="{DynamicResource FormCardFootRuleStyle}" />
                            <Label
                                IsVisible="{Binding WizardShowAssetTotal}"
                                Style="{DynamicResource FormCardFootLeadStyle}"
                                Text="{Binding WizardAssetTotalLabel}" />
                            <Label
                                Margin="0,3,0,0"
                                IsVisible="{Binding WizardShowAssetBreakdown}"
                                Style="{DynamicResource FormCardFootSubStyle}"
                                Text="{Binding WizardAssetBreakdownLabel}" />

                        </VerticalStackLayout>
                    </Border>

                    <!--
                        ══ Section B — only while empty ══

                        Each of these has its own editing screen, so once a value exists that field
                        disappears; IsVisible binds the *NeedsInput inverse. The CARD binds
                        WizardShowDeferredFields, the aggregate — without it a return visit, where
                        all four have values, would render a bordered padded empty box.
                    -->
                    <Border IsVisible="{Binding WizardShowDeferredFields}" Style="{DynamicResource FormCardStyle}">
                        <VerticalStackLayout Spacing="0">

                            <VerticalStackLayout IsVisible="{Binding WizardUpfrontNeedsInput}" Spacing="0">
                                <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="{Binding CurrencySymbol, StringFormat='UPFRONT COSTS (OPTIONAL) {0}'}" />
                                <Border Style="{DynamicResource PopupInputBorderStyle}">
                                    <Entry
                                        x:Name="entryUpfront"
                                        AutomationId="WizardUpfront"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeXL}"
                                        Keyboard="Numeric"
                                        Placeholder="e.g. 15,000"
                                        PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                        TextChanged="OnDeferredTextChanged"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        Unfocused="OnEntryUnfocused" />
                                </Border>
                                <!--
                                    Standout hint, shown only while this field is visible (i.e. only
                                    until the user commits a value and it disappears for good).
                                    Deliberately NOT styled like the ⓘ "learn more" buttons
                                    elsewhere (WhatIfView's offset/frequency/stress-test buttons):
                                    those are muted because they are secondary, tap-to-expand
                                    explainers. This is the one thing a first-time user needs to
                                    know about this field, so it stays bold and only slightly
                                    receded — .75 against the .45 of an ordinary hint.
                                -->
                                <Label
                                    FontAttributes="Bold"
                                    Opacity="0.75"
                                    Style="{DynamicResource PopupFieldHintStyle}"
                                    Text="ⓘ  Added to your loan amount — not paid separately" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label x:Name="lblUpfrontFormatted" Grid.Column="0" AutomationId="WizardUpfrontFormatted" Style="{DynamicResource PopupFieldHintStyle}" />
                                    <Label x:Name="lblUpfrontWords" Grid.Column="1" Margin="6,4,0,0" AutomationId="WizardUpfrontWords" Style="{DynamicResource PopupFieldHintStyle}" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Margin="0,14,0,0" IsVisible="{Binding WizardRunningCostNeedsInput}" Spacing="0">
                                <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="{Binding CurrencySymbol, StringFormat='MONTHLY RUNNING COST (OPTIONAL) {0}'}" />
                                <Border Style="{DynamicResource PopupInputBorderStyle}">
                                    <Entry
                                        x:Name="entryRunning"
                                        AutomationId="WizardRunning"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeXL}"
                                        Keyboard="Numeric"
                                        Placeholder="e.g. 2,000"
                                        PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                        TextChanged="OnDeferredTextChanged"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        Unfocused="OnEntryUnfocused" />
                                </Border>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label x:Name="lblRunningFormatted" Grid.Column="0" AutomationId="WizardRunningFormatted" Style="{DynamicResource PopupFieldHintStyle}" />
                                    <Label x:Name="lblRunningWords" Grid.Column="1" Margin="6,4,0,0" AutomationId="WizardRunningWords" Style="{DynamicResource PopupFieldHintStyle}" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Margin="0,14,0,0" IsVisible="{Binding WizardIncomeNeedsInput}" Spacing="0">
                                <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="{Binding CurrencySymbol, StringFormat='TOTAL MONTHLY INCOME {0}'}" />
                                <Border Style="{DynamicResource PopupInputBorderStyle}">
                                    <Entry
                                        x:Name="entryIncome"
                                        AutomationId="WizardIncome"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeXL}"
                                        Keyboard="Numeric"
                                        Placeholder="e.g. 5,000"
                                        PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                        TextChanged="OnDeferredTextChanged"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        Unfocused="OnEntryUnfocused" />
                                </Border>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label x:Name="lblIncomeFormatted" Grid.Column="0" AutomationId="WizardIncomeFormatted" Style="{DynamicResource PopupFieldHintStyle}" />
                                    <Label x:Name="lblIncomeWords" Grid.Column="1" Margin="6,4,0,0" AutomationId="WizardIncomeWords" Style="{DynamicResource PopupFieldHintStyle}" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Margin="0,14,0,0" IsVisible="{Binding WizardExpenseNeedsInput}" Spacing="0">
                                <Label Style="{DynamicResource PopupFieldLabelStyle}" Text="{Binding CurrencySymbol, StringFormat='TOTAL MONTHLY EXPENSES {0}'}" />
                                <Border Style="{DynamicResource PopupInputBorderStyle}">
                                    <Entry
                                        x:Name="entryExpense"
                                        AutomationId="WizardExpense"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="{DynamicResource FontSizeXL}"
                                        Keyboard="Numeric"
                                        Placeholder="e.g. 3,500"
                                        PlaceholderColor="{DynamicResource LoanAppInputTextWhenUnFocusedColor}"
                                        TextChanged="OnDeferredTextChanged"
                                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                        Unfocused="OnEntryUnfocused" />
                                </Border>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label x:Name="lblExpenseFormatted" Grid.Column="0" AutomationId="WizardExpenseFormatted" Style="{DynamicResource PopupFieldHintStyle}" />
                                    <Label x:Name="lblExpenseWords" Grid.Column="1" Margin="6,4,0,0" AutomationId="WizardExpenseWords" Style="{DynamicResource PopupFieldHintStyle}" />
                                </Grid>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <!--
                        Deliberately quiet: the figures taken from elsewhere still feed the
                        calculation, so they are named rather than invisible — but they are not
                        what the user came here to change, so they sit below the fold in muted
                        small text rather than as fields.
                    -->
                    <Label
                        AutomationId="LoanDetailsInheritedNote"
                        Margin="4,20,4,0"
                        FontSize="{DynamicResource FontSizeSmall}"
                        IsVisible="{Binding WizardShowInheritedNote}"
                        Opacity="0.45"
                        Text="{Binding WizardInheritedNote}"
                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                    <!--
                        No second "commit" button here, deliberately. There used to be a
                        "Calculate" button at the end of this scrollable content — but Done
                        (top-right, always visible, same OnApply handler) already does exactly
                        the same commit-and-dismiss, every scroll position, with no risk of being
                        docked under the keyboard. A full-screen MAUI page cannot dock a button
                        above the keyboard (see TROUBLESHOOTING.md), which is exactly why Calculate
                        had to live down here in the first place — and exactly why a user who
                        never scrolls this far, or whose keyboard is covering it, could commit
                        nothing and not know it. Two buttons doing the same thing is one too many;
                        keep the one that is never hidden.
                    -->
                    <Label
                        Margin="0,20,0,0"
                        FontSize="{DynamicResource FontSizeSmall}"
                        HorizontalOptions="Center"
                        Opacity="0.4"
                        Text="↑ Tap Done above to save"
                        TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </ContentPage.Content>
</ContentPage>
