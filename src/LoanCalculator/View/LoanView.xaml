                                                                                                       Tablet=17,
                                                                                                       Desktop=17,
                                                                                                       TV=17,
                                                                                                       Watch=10},
                                                                                      iOS={OnIdiom Phone=12,
                                                                                                   Tablet=17,
                                                                                                   Desktop=17,
                                                                                                   TV=17,
                                                                                                   Watch=10},
                                                                                      Default=12}"
                                                                HorizontalOptions="Start"
                                                                HorizontalTextAlignment="Start"
                                                                Text="{Binding Name}"
                                                                TextColor="{DynamicResource LstForegroundColor}"
                                                                VerticalOptions="Center" />
                                                            <Label
                                                                Grid.Column="1"
                                                                FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                       Tablet=17,
                                                                                                       Desktop=17,
                                                                                                       TV=17,
                                                                                                       Watch=10},
                                                                                      iOS={OnIdiom Phone=12,
                                                                                                   Tablet=17,
                                                                                                   Desktop=17,
                                                                                                   TV=17,
                                                                                                   Watch=10},
                                                                                      Default=12}"
                                                                HorizontalOptions="Start"
                                                                HorizontalTextAlignment="Start"
                                                                Text="{Binding AmountString}"
                                                                TextColor="{DynamicResource LstForegroundColor}"
                                                                VerticalOptions="Center" />
                                                            <Label
                                                                Grid.Column="2"
                                                                Margin="{OnPlatform Android={OnIdiom Phone='0,0,5,0',
                                                                                                     Tablet='0,0,20,0',
                                                                                                     Desktop='0,0,20,0',
                                                                                                     TV='0,0,20,0'},
                                                                                    iOS={OnIdiom Phone='0,0,5,0',
                                                                                                 Tablet='0,0,20,0',
                                                                                                 Desktop='0,0,20,0',
                                                                                                 TV='0,0,20,0'},
                                                                                    Default='0,0,5,0'}"
                                                                FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                       Tablet=17,
                                                                                                       Desktop=17,
                                                                                                       TV=17,
                                                                                                       Watch=10},
                                                                                      iOS={OnIdiom Phone=12,
                                                                                                   Tablet=17,
                                                                                                   Desktop=17,
                                                                                                   TV=17,
                                                                                                   Watch=10},
                                                                                      Default=12}"
                                                                HorizontalOptions="End"
                                                                Text="{Binding Frequency}"
                                                                TextColor="{DynamicResource LstForegroundColor}"
                                                                VerticalOptions="Center" />

                                                            <buttons:SfButton
                                                                x:Name="btnEditEntry"
                                                                Grid.Column="3"
                                                                AutomationId="{Binding Id}"
                                                                Clicked="btnEditEntry_Clicked"
                                                                Style="{DynamicResource ListIconButtonStyle}">
                                                                <core:SfButton.Content>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Image Margin="10" Source="icon_edit.png" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </core:SfButton.Content>
                                                            </buttons:SfButton>

                                                            <buttons:SfButton
                                                                x:Name="btnDeleteEntry"
                                                                Grid.Column="4"
                                                                AutomationId="{Binding Id}"
                                                                Clicked="btnDeleteEntry_Clicked"
                                                                Style="{DynamicResource ListIconButtonStyle}">
                                                                <core:SfButton.Content>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Image Margin="10" Source="icon_delete.png" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </core:SfButton.Content>
                                                            </buttons:SfButton>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </sfList:SfListView.ItemTemplate>
                                    </sfList:SfListView>
                                </Grid>

                            </StackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <tabView:SfTabItem Header="Insights">
