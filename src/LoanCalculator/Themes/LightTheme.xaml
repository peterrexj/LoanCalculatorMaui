    <!--<Style TargetType="dataGrid:DataGridHeaderRow">
        <Setter Property="Background" Value="#0074E3" />
    </Style>-->



    <!--  Expander styles  -->
    <LinearGradientBrush x:Key="ExpanderHeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#FFB3E5FC" />
        <GradientStop Offset="1.0" Color="#FFFFF9C4" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CollapsedHeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="DarkKhaki" />
        <GradientStop Offset="1.0" Color="Coral" />
    </LinearGradientBrush>


    

</ResourceDictionary>