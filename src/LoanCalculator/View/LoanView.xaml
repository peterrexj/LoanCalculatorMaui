                                                <chart:SfCircularChart.Legend>
                                                    <chart:ChartLegend Placement="{OnPlatform Android={OnIdiom Phone=Bottom, Tablet=Left}, iOS={OnIdiom Phone=Bottom, Tablet=Left}, UWP=Left}" ToggleSeriesVisibility="True">
                                                        <chart:ChartLegend.LabelStyle>
                                                            <chart:ChartLegendLabelStyle
                                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                                FontSize="{OnPlatform Android={OnIdiom Phone=10,
                                                                                                       Tablet=18,
                                                                                                       Desktop=18,
                                                                                                       TV=18,
                                                                                                       Watch=8},
                                                                                      iOS={OnIdiom Phone=10,
                                                                                                   Tablet=18,
                                                                                                   Desktop=18,
                                                                                                   TV=18,
                                                                                                   Watch=8},
                                                                                      Default=10}"
                                                                TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                        </chart:ChartLegend.LabelStyle>
                                                    </chart:ChartLegend>
                                                </chart:SfCircularChart.Legend>
                                                <chart:SfCircularChart.Series>
                                                    <chart:DoughnutSeries
                                                        ExplodeAll="False"
                                                        ExplodeOnTouch="False"
                                                        InnerRadius="0.5"
                                                        ItemsSource="{Binding ChartPropertyValueWithInterestPayment}"
                                                        LegendIcon="Circle"
                                                        PaletteBrushes="{Binding CustomChartColors}"
                                                        ShowDataLabels="True"
                                                        XBindingPath="Category"
                                                        YBindingPath="Value">
                                                        <chart:DoughnutSeries.DataLabelSettings>
                                                            <chart:CircularDataLabelSettings LabelPosition="Inside" UseSeriesPalette="True">
                                                                <chart:CircularDataLabelSettings.LabelStyle>
                                                                    <chart:ChartDataLabelStyle
                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                        FontSize="{OnPlatform Android={OnIdiom Phone=10,
                                                                                                               Tablet=15,
                                                                                                               Desktop=15,
                                                                                                               TV=15,
                                                                                                               Watch=8},
                                                                                              iOS={OnIdiom Phone=10,
                                                                                                           Tablet=15,
                                                                                                           Desktop=15,
                                                                                                           TV=15,
                                                                                                           Watch=8},
                                                                                              Default=10}"
                                                                        LabelFormat="c" />
                                                                </chart:CircularDataLabelSettings.LabelStyle>
                                                            </chart:CircularDataLabelSettings>
                                                        </chart:DoughnutSeries.DataLabelSettings>

                                                        <chart:DoughnutSeries.CenterView>
                                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                <Label>
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span
                                                                                FontAttributes="Bold"
                                                                                FontSize="{OnPlatform Android={OnIdiom Phone=10,
                                                                                                                       Tablet=15,
                                                                                                                       Desktop=15,
                                                                                                                       TV=15,
                                                                                                                       Watch=8},
                                                                                                      iOS={OnIdiom Phone=10,
                                                                                                                   Tablet=15,
                                                                                                                   Desktop=15,
                                                                                                                   TV=15,
                                                                                                                   Watch=8},
                                                                                                      Default=10}"
                                                                                Text="$"
                                                                                TextColor="{DynamicResource LoanAppChartDataMarkerTextColor}" />
                                                                            <Span
                                                                                FontAttributes="Bold"
                                                                                FontSize="{OnPlatform Android={OnIdiom Phone=10,
                                                                                                                       Tablet=15,
                                                                                                                       Desktop=15,
                                                                                                                       TV=15,
                                                                                                                       Watch=8},
                                                                                                      iOS={OnIdiom Phone=10,
                                                                                                                   Tablet=15,
                                                                                                                   Desktop=15,
                                                                                                                   TV=15,
                                                                                                                   Watch=8},
                                                                                                      Default=10}"
                                                                                Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.HomeLoanInfo.PaymentSummary.Payment.TotalPaymentRoundedWithComma}"
                                                                                TextColor="{DynamicResource LoanAppChartDataMarkerTextColor}" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                            </StackLayout>
                                                        </chart:DoughnutSeries.CenterView>
                                                    </chart:DoughnutSeries>
                                                </chart:SfCircularChart.Series>
                                            </chart:SfCircularChart>
                                        </Border.Content>
                                    </Border>
                                </FlexLayout>
                            </StackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>
                <tabView:SfTabItem Header="Amortisation">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackLayout Grid.Row="0">

                                    <buttons:SfSegmentedControl
                                        x:Name="AmortizationBreadDownFrequencySegmentCtrl"
                                        Margin="{OnPlatform Android={OnIdiom Phone='5',
                                                                             Tablet='20,10,20,10',
                                                                             Desktop='20,10,20,10',
                                                                             TV='20,10,20,10'},
                                                            iOS={OnIdiom Phone='5',
                                                                         Tablet='20,10,20,10',
                                                                         Desktop='20,10,20,10',
                                                                         TV='20,10,20,10'},
                                                            Default='5'}"
                                        ItemsSource="{Binding AmortizationBreakdownFrequencyCollection}"
                                        SelectedIndex="{Binding AmortizationBreakdownFrequencySelectedIndex}"
                                        Style="{DynamicResource SegmentDefaultStyle}"
                                        VisibleSegmentsCount="2" />

                                    <FlexLayout
                                        Margin="0"
                                        AlignItems="Stretch"
                                        Direction="Column"
                                        JustifyContent="Center">
                                        <Border Style="{DynamicResource LoanAppChartBorderStyle}">
                                            <Border.Content>
                                                <Grid
                                                    Padding="10"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill">
                                                    <chart:SfCartesianChart
                                                        BackgroundColor="Transparent"
                                                        HorizontalOptions="FillAndExpand"
                                                        IsVisible="{Binding IsAmortizationYearBased}"
                                                        PaletteBrushes="{Binding CustomChartColors}"
                                                        VerticalOptions="FillAndExpand">
                                                        <chart:SfCartesianChart.Margin>
                                                            <OnPlatform x:TypeArguments="Thickness">
                                                                <On Platform="Windows" Value="0,0,20,0" />
                                                                <On Platform="Android" Value="0,0,20,0" />
                                                                <On Platform="iOS" Value="0,0,20,0" />
                                                            </OnPlatform>
                                                        </chart:SfCartesianChart.Margin>

                                                        <chart:SfCartesianChart.XAxes>
                                                            <chart:CategoryAxis
                                                                EdgeLabelsDrawingMode="Fit"
                                                                LabelPlacement="BetweenTicks"
                                                                ShowMajorGridLines="False">
                                                                <chart:CategoryAxis.LabelStyle>
                                                                    <chart:ChartAxisLabelStyle
                                                                        FontAttributes="Bold"
                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                               Tablet=17,
                                                                                                               Desktop=17,
                                                                                                               TV=17,
                                                                                                               Watch=10},
                                                                                              iOS={OnIdiom Phone=12,
                                                                                                           Tablet=17,
                                                                                                           Desktop=17,
                                                                                                           TV=17,
                                                                                                           Watch=10},
                                                                                              Default=12}"
                                                                        TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                                </chart:CategoryAxis.LabelStyle>
                                                                <chart:CategoryAxis.MajorTickStyle>
                                                                    <chart:ChartAxisTickStyle TickSize="8" />
                                                                </chart:CategoryAxis.MajorTickStyle>
                                                            </chart:CategoryAxis>
                                                        </chart:SfCartesianChart.XAxes>
                                                        <chart:SfCartesianChart.YAxes>
                                                            <chart:NumericalAxis>
                                                                <chart:NumericalAxis.LabelStyle>
                                                                    <chart:ChartAxisLabelStyle
                                                                        FontAttributes="Bold"
                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                               Tablet=17,
                                                                                                               Desktop=17,
                                                                                                               TV=17,
                                                                                                               Watch=10},
                                                                                              iOS={OnIdiom Phone=12,
                                                                                                           Tablet=17,
                                                                                                           Desktop=17,
                                                                                                           TV=17,
                                                                                                           Watch=10},
                                                                                              Default=12}"
                                                                        TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                                </chart:NumericalAxis.LabelStyle>
                                                                <chart:NumericalAxis.AxisLineStyle>
                                                                    <chart:ChartLineStyle StrokeWidth="0" />
                                                                </chart:NumericalAxis.AxisLineStyle>
                                                                <chart:NumericalAxis.MajorTickStyle>
                                                                    <chart:ChartAxisTickStyle TickSize="0" />
                                                                </chart:NumericalAxis.MajorTickStyle>

                                                            </chart:NumericalAxis>
                                                        </chart:SfCartesianChart.YAxes>
                                                        <chart:SfCartesianChart.Legend>
                                                            <chart:ChartLegend Placement="Bottom" ToggleSeriesVisibility="True">
                                                                <chart:ChartLegend.LabelStyle>
                                                                    <chart:ChartLegendLabelStyle
                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                        FontSize="{OnPlatform Android={OnIdiom Phone=10,
                                                                                                               Tablet=18,
                                                                                                               Desktop=18,
                                                                                                               TV=18,
                                                                                                               Watch=8},
                                                                                              iOS={OnIdiom Phone=10,
                                                                                                           Tablet=18,
                                                                                                           Desktop=18,
                                                                                                           TV=18,
                                                                                                           Watch=8},
                                                                                              Default=10}"
                                                                        TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                                </chart:ChartLegend.LabelStyle>
                                                            </chart:ChartLegend>
                                                        </chart:SfCartesianChart.Legend>
                                                        <chart:SfCartesianChart.Series>
                                                            <chart:StackingColumnSeries
                                                                EnableAnimation="True"
                                                                ItemsSource="{Binding AmortizationChartPrincipalAmountAxis}"
                                                                Label="Principal"
                                                                LegendIcon="Rectangle"
                                                                XBindingPath="Name"
                                                                YBindingPath="Value" />
                                                            <chart:StackingColumnSeries
                                                                EnableAnimation="True"
                                                                ItemsSource="{Binding AmortizationChartInterestAmountAxis}"
                                                                Label="Interest"
                                                                LegendIcon="Rectangle"
                                                                XBindingPath="Name"
                                                                YBindingPath="Value" />
                                                        </chart:SfCartesianChart.Series>
                                                    </chart:SfCartesianChart>

                                                    <!--  HeightRequest="200"  -->
                                                    <chart:SfCartesianChart
                                                        BackgroundColor="Transparent"
                                                        HorizontalOptions="FillAndExpand"
                                                        IsVisible="{Binding IsAmortizationTermBased}"
                                                        PaletteBrushes="{Binding CustomChartColors}"
                                                        VerticalOptions="FillAndExpand">
                                                        <!--<chart:SfCartesianChart.Title>
                                                        <Label
                                                            BackgroundColor="Transparent"
                                                            FontSize="{OnPlatform Android={OnIdiom Phone=11, Tablet=16, Desktop=16, TV=16, Watch=9}, iOS={OnIdiom Phone=11, Tablet=16, Desktop=16, TV=16, Watch=9}, Default=11}"
                                                            Text="Loan repayment breakdown"
                                                            TextColor="{DynamicResource LoanAppChartTitleTextColor}" />
                                                    </chart:SfCartesianChart.Title>-->
                                                        <chart:SfCartesianChart.XAxes>
                                                            <chart:CategoryAxis
                                                                EdgeLabelsDrawingMode="Shift"
                                                                LabelPlacement="BetweenTicks"
                                                                ShowMajorGridLines="False">
                                                                <chart:CategoryAxis.LabelStyle>
                                                                    <chart:ChartAxisLabelStyle
                                                                        FontAttributes="Bold"
                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                               Tablet=17,
                                                                                                               Desktop=17,
                                                                                                               TV=17,
                                                                                                               Watch=10},
                                                                                              iOS={OnIdiom Phone=12,
                                                                                                           Tablet=17,
                                                                                                           Desktop=17,
                                                                                                           TV=17,
                                                                                                           Watch=10},
                                                                                              Default=12}"
                                                                        TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                                </chart:CategoryAxis.LabelStyle>
                                                                <chart:CategoryAxis.MajorTickStyle>
                                                                    <chart:ChartAxisTickStyle TickSize="0" />
                                                                </chart:CategoryAxis.MajorTickStyle>
                                                            </chart:CategoryAxis>
                                                        </chart:SfCartesianChart.XAxes>
                                                        <chart:SfCartesianChart.YAxes>
                                                            <chart:NumericalAxis>
                                                                <chart:NumericalAxis.LabelStyle>
                                                                    <chart:ChartAxisLabelStyle
                                                                        FontAttributes="Bold"
                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                        FontSize="{OnPlatform Android={OnIdiom Phone=12,
                                                                                                               Tablet=17,
                                                                                                               Desktop=17,
                                                                                                               TV=17,
                                                                                                               Watch=10},
                                                                                              iOS={OnIdiom Phone=12,
                                                                                                           Tablet=17,
                                                                                                           Desktop=17,
                                                                                                           TV=17,
                                                                                                           Watch=10},
                                                                                              Default=12}"
                                                                        TextColor="{DynamicResource LoanAppChartAxisTextColor}" />
                                                                </chart:NumericalAxis.LabelStyle>
                                                                <chart:NumericalAxis.AxisLineStyle>
                                                                    <chart:ChartLineStyle StrokeWidth="0" />
                                                                </chart:NumericalAxis.AxisLineStyle>
                                                                <chart:NumericalAxis.MajorTickStyle>
                                                                    <chart:ChartAxisTickStyle TickSize="0" />
                                                                </chart:NumericalAxis.MajorTickStyle>
                                                            </chart:NumericalAxis>
                                                        </chart:SfCartesianChart.YAxes>
                                                        <chart:SfCartesianChart.Legend>
                                                            <chart:ChartLegend Placement="Bottom" ToggleSeriesVisibility="True">
                                                                <chart:ChartLegend.LabelStyle>
                                                                    <chart:ChartLegendLabelStyle
                                                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                                                        FontSize="{OnPlatform Android={OnIdiom Phone=10,
                                                                                                               Tablet=18,
                                                                                                               Desktop=18,
                                                                                                               TV=18,
                                                                                                               Watch=8},
                                                                                              iOS={OnIdiom Phone=10,
                                                                                                           Tablet=18,
                                                                                                           Desktop=18,
                                                                                                           TV=18,
                                                                                                           Watch=8},
                                                                                              Default=10}"
                                                                        TextColor="{DynamicResource LoanAppChartLegendTextColor}" />
                                                                </chart:ChartLegend.LabelStyle>
                                                            </chart:ChartLegend>
                                                        </chart:SfCartesianChart.Legend>
                                                        <chart:SfCartesianChart.Series>
                                                            <chart:StackingAreaSeries
                                                                EnableAnimation="True"
                                                                ItemsSource="{Binding AmortizationChartAreaPrincipalAmountAxis}"
                                                                Label="Principal"
                                                                LegendIcon="Rectangle"
                                                                XBindingPath="Name"
                                                                YBindingPath="Value" />
                                                            <chart:StackingAreaSeries
                                                                EnableAnimation="True"
                                                                ItemsSource="{Binding AmortizationChartAreaInterestAmountAxis}"
                                                                Label="Interest"
                                                                LegendIcon="Rectangle"
                                                                XBindingPath="Name"
                                                                YBindingPath="Value" />
                                                        </chart:SfCartesianChart.Series>
                                                    </chart:SfCartesianChart>
                                                </Grid>
                                            </Border.Content>
                                        </Border>
                                    </FlexLayout>

                                </StackLayout>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <pager:SfDataPager
                                        x:Name="dataPager"
                                        Grid.Row="0"
                                        Margin="0,3,0,3"
                                        ButtonFontSize="{OnPlatform Android={OnIdiom Phone=11,
                                                                                     Tablet=16,
                                                                                     Desktop=16,
                                                                                     TV=16,
                                                                                     Watch=9},
                                                                    iOS={OnIdiom Phone=11,
                                                                                 Tablet=16,
                                                                                 Desktop=16,
                                                                                 TV=16,
                                                                                 Watch=9},
                                                                    Default=11}"
                                        ButtonShape="Circle"
                                        HorizontalOptions="Center"
                                        NumericButtonsGenerateMode="Auto"
                                        PageSize="15"
                                        Source="{Binding PaymentAmortization}"
                                        Style="{DynamicResource LoanAppDataGridPagerStyle}">
                                        <pager:SfDataPager.DefaultStyle>
                                            <pager:DataPagerStyle
                                                NavigationButtonBackgroundColor="{DynamicResource LoanAppNavigationButtonBackgroundColor}"
                                                NavigationButtonDisableBackgroundColor="{DynamicResource LoanAppNavigationButtonDisableBackgroundColor}"
                                                NavigationButtonDisableIconColor="{DynamicResource LoanAppNavigationButtonDisableIconColor}"
                                                NavigationButtonIconColor="{DynamicResource LoanAppNavigationButtonIconColor}"
                                                NumericButtonBackgroundColor="{DynamicResource LoanAppNumericButtonBackgroundColor}"
                                                NumericButtonSelectionBackgroundColor="{DynamicResource LoanAppNumericButtonSelectionBackgroundColor}"
                                                NumericButtonSelectionTextColor="{DynamicResource LoanAppNumericButtonSelectionTextColor}"
                                                NumericButtonTextColor="{DynamicResource LoanAppNumericButtonTextColor}" />
                                        </pager:SfDataPager.DefaultStyle>
                                    </pager:SfDataPager>

                                    <datagrid:SfDataGrid
                                        x:Name="dataGrid"
                                        Grid.Row="1"
                                        AutoGenerateColumnsMode="None"
                                        ColumnWidthMode="Fill"
                                        HorizontalOptions="Fill"
                                        ItemsSource="{Binding Source={x:Reference dataPager}, Path=PagedSource}"
                                        VerticalOptions="Fill">
                                        <datagrid:SfDataGrid.Columns>

                                            <datagrid:DataGridTemplateColumn HeaderText="Period" MappingName="PaymentPeriod">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Period" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell01}">
                                                            <Label
                                                                x:DataType="models:PaymentAmortisationOutput"
                                                                Style="{DynamicResource LabelCellDataGrid01}"
                                                                Text="{Binding PaymentPeriod}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Principal" MappingName="PrincipalAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Principal" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell02}">
                                                            <Label
                                                                x:DataType="models:PaymentAmortisationOutput"
                                                                Style="{DynamicResource LabelCellDataGrid02}"
                                                                Text="{Binding PrincipalAmountRounded}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Interest" MappingName="InterestAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Interest" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell03}">
                                                            <Label
                                                                x:DataType="models:PaymentAmortisationOutput"
                                                                Style="{DynamicResource LabelCellDataGrid03}"
                                                                Text="{Binding InterestAmountRounded}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>

                                            <datagrid:DataGridTemplateColumn HeaderText="Balance" MappingName="BalanceAmountRounded">
                                                <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Label Style="{DynamicResource LabelHeaderDataGridCell}" Text="Balance" />
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <datagrid:DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{DynamicResource BorderDataGridCell04}">
                                                            <Label
                                                                x:DataType="models:PaymentAmortisationOutput"
                                                                Style="{DynamicResource LabelCellDataGrid04}"
                                                                Text="{Binding BalanceAmountRounded}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </datagrid:DataGridTemplateColumn.CellTemplate>
                                            </datagrid:DataGridTemplateColumn>
                                        </datagrid:SfDataGrid.Columns>
                                    </datagrid:SfDataGrid>

                                </Grid>
                            </Grid>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>

                <tabView:SfTabItem Header="Expense on Property">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <StackLayout>
                                <customControls:DisclaimerBannerView
                                    BannerType="Information"
                                    HeaderText="Instructions"
                                    Text="Enter the anticipated ongoing costs for this property (such as maintenance, insurance, and taxes) after purchase, excluding mortgage payments." />

                                <customControls:ThreeColumnBorderedContentView LineHeightBox3="2.0">
                                    <customControls:ThreeColumnBorderedContentView.FormattedText1>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalMonthlyExpenseWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Monthly this property (expense)" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText1>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText2>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalYearlyExpenseWithComma}" />
                                            <Span Text="{Binding NewLine}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text="Yearly this property (expense)" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText2>
                                    <customControls:ThreeColumnBorderedContentView.FormattedText3>
                                        <FormattedString>
                                            <Span Style="{DynamicResource SpanThreeBoxCurrencyStyle}" Text="{Binding CurrencySymbol}" />
                                            <Span Style="{DynamicResource SpanThreeBoxAmountStyle}" Text="{Binding TotalMonthlyOverallExpense}" />

                                            <Span
                                                FontSize="{OnPlatform Android={OnIdiom Phone=10,
                                                                                       Tablet=15,
                                                                                       Desktop=15,
                                                                                       TV=15,
                                                                                       Watch=8},
                                                                      iOS={OnIdiom Phone=10,
                                                                                   Tablet=15,
                                                                                   Desktop=15,
                                                                                   TV=15,
                                                                                   Watch=8},
                                                                      Default=10}"
                                                Style="{DynamicResource SpanThreeBoxAmountStyle}"
                                                Text="{Binding TotalMonthlyOverallExpenseBreakdownWithComma}" />
                                            <Span Style="{DynamicResource SpanThreeBoxTextStyle}" Text=" monthly new property overall expense" />
                                        </FormattedString>
                                    </customControls:ThreeColumnBorderedContentView.FormattedText3>
