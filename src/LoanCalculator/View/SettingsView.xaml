<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoanCalculatorMaui.View.SettingsView"
    x:Name="thisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:LoanCalculatorMaui.Controls"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:primaryModels="clr-namespace:LoanCalculator.Core.Models.ViewModels.PrimaryModels;assembly=LoanCalculator.Core"
    xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
    Title="Settings">

    <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" IsEnabled="{Binding IsFree}">

        <!--
            Disclaimer and Privacy Policy popups.

            Colour keys below are the LoanAppPopup* family — the same one PopupDisclaimerView (the
            first-launch disclaimer) uses, deliberately matched rather than reusing the generic
            LoanAppDefaultBackgroundColor/BorderControlBackgroundGradientBrush/
            LoanAppDefaultForegroundColor tokens those used before. Those generic tokens are high
            contrast on their own (checked against every theme), but something in this exact
            nested SfPopup ContentTemplate — a Border inside a BindableLayout inside a ScrollView,
            two DataTemplates deep — made the card wash out to a near-illegible pale tint in
            testing, Dark theme in particular. LoanAppPopup* already renders correctly in the
            identical structural position (PopupDisclaimerView has the same DataTemplate nesting),
            so matching it is the fix, independent of root-causing exactly which Syncfusion/MAUI
            interaction broke the generic tokens here.

            AcceptButtonText="Accept" was also removed from both (previously present only on
            these two, not on the working reference). It is SfPopup's OWN built-in one/two-button
            footer API, which does nothing here since both popups already supply a custom
            FooterTemplate with their own Close button bound to a Command — the two mechanisms
            were never meant to be set together.
        -->

        <!--  Disclaimer Popup  -->
        <sfPopup:SfPopup
            x:Name="PopupDisclaimer"
            Padding="10,25,10,20"
            AnimationMode="Zoom"
            AppearanceMode="OneButton"
            BackgroundColor="{DynamicResource LoanAppPopupBg}"
            IsFullScreen="True"
            IsOpen="{Binding IsPopupRequired}"
            ShowCloseButton="False"
            ShowFooter="True"
            ShowHeader="True"
            StaysOpen="True">
            <sfPopup:SfPopup.HeaderTemplate>
                <DataTemplate>
                    <!--  Top padding clears the iOS status bar / notch (full-screen popup).  -->
                    <Grid
                        Padding="{OnPlatform iOS='0,50,0,8', MacCatalyst='0,50,0,8', Default='0,8,0,8'}"
                        BackgroundColor="{DynamicResource LoanAppPopupBg}">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="{StaticResource FontSizeXL}"
                            HorizontalTextAlignment="Center"
                            Text="Disclaimer"
                            TextColor="{DynamicResource LoanAppPopupFg}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </sfPopup:SfPopup.HeaderTemplate>
            <sfPopup:SfPopup.FooterTemplate>
                <DataTemplate>
                    <Grid BackgroundColor="{DynamicResource LoanAppPopupBg}">
                        <Button
                            BackgroundColor="Transparent"
                            AutomationId="SettingsDisclaimerCloseButton"
                            Command="{Binding PopupCloseCommand}"
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="{StaticResource FontSizeLarge}"
                            IsVisible="{Binding IsActive}"
                            Text="Close"
                            TextColor="{DynamicResource LoanAppPopupFg}" />
                    </Grid>
                </DataTemplate>
            </sfPopup:SfPopup.FooterTemplate>
            <sfPopup:SfPopup.ContentTemplate>
                <DataTemplate>
                    <!--  Native text (no WebView): a WebView inside a full-screen SfPopup left a
                          native surface behind on close that blocked tab navigation, and would
                          not scroll on Android. Sections come from SettingsViewModel.DisclaimerSections.  -->
                    <ScrollView BindingContext="{Binding Source={x:Reference thisPage}, Path=BindingContext}">
                        <VerticalStackLayout Padding="12,8,12,8" Spacing="0">
                            <Border
                                Padding="16"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12">
                                <Border.Stroke>
                                    <SolidColorBrush Color="{DynamicResource LoanAppPopupMuted}" />
                                </Border.Stroke>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DisclaimerSections}" Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="primaryModels:DisclaimerSection">
                                            <Label
                                                Margin="{Binding IsHeader, Converter={StaticResource BoolToDisclaimerMarginConverter}}"
                                                FontAttributes="{Binding IsHeader, Converter={StaticResource BoolToFontAttributesConverter}}"
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="{Binding IsHeader, Converter={StaticResource BoolToDisclaimerFontSizeConverter}}"
                                                Text="{Binding Text}"
                                                TextColor="{DynamicResource LoanAppPopupAccent}">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsHeader}"
                                                        TargetType="Label"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource LoanAppPopupFg}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </ScrollView>
                </DataTemplate>
            </sfPopup:SfPopup.ContentTemplate>
        </sfPopup:SfPopup>

        <!--  Privacy Policy Popup  -->
        <sfPopup:SfPopup
            x:Name="PopupPrivacyPolicy"
            Padding="10,25,10,20"
            AnimationMode="Zoom"
            AppearanceMode="OneButton"
            BackgroundColor="{DynamicResource LoanAppPopupBg}"
            IsFullScreen="True"
            IsOpen="{Binding IsPrivacyPopupRequired}"
            ShowCloseButton="False"
            ShowFooter="True"
            ShowHeader="True"
            StaysOpen="True">
            <sfPopup:SfPopup.HeaderTemplate>
                <DataTemplate>
                    <!--  Top padding clears the iOS status bar / notch (full-screen popup).  -->
                    <Grid
                        Padding="{OnPlatform iOS='0,50,0,8', MacCatalyst='0,50,0,8', Default='0,8,0,8'}"
                        BackgroundColor="{DynamicResource LoanAppPopupBg}">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="{StaticResource FontSizeXL}"
                            HorizontalTextAlignment="Center"
                            Text="Privacy Policy"
                            TextColor="{DynamicResource LoanAppPopupFg}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </sfPopup:SfPopup.HeaderTemplate>
            <sfPopup:SfPopup.FooterTemplate>
                <DataTemplate>
                    <Grid BackgroundColor="{DynamicResource LoanAppPopupBg}">
                        <Button
                            AutomationId="SettingsPrivacyCloseButton"
                            BackgroundColor="Transparent"
                            Command="{Binding PrivacyPolicyCloseCommand}"
                            FontAttributes="Bold"
                            FontFamily="{DynamicResource DefaultFontFamily}"
                            FontSize="{StaticResource FontSizeLarge}"
                            IsVisible="{Binding IsActive}"
                            Text="Close"
                            TextColor="{DynamicResource LoanAppPopupFg}" />
                    </Grid>
                </DataTemplate>
            </sfPopup:SfPopup.FooterTemplate>
            <sfPopup:SfPopup.ContentTemplate>
                <DataTemplate>
                    <!--  Native text (no WebView) — same rationale as the disclaimer popup above.
                          Sections come from SettingsViewModel.PrivacyPolicySections.  -->
                    <ScrollView BindingContext="{Binding Source={x:Reference thisPage}, Path=BindingContext}">
                        <VerticalStackLayout Padding="12,8,12,8" Spacing="0">
                            <Border
                                Padding="16"
                                BackgroundColor="{DynamicResource LoanAppPopupSurface}"
                                StrokeShape="RoundRectangle 12">
                                <Border.Stroke>
                                    <SolidColorBrush Color="{DynamicResource LoanAppPopupMuted}" />
                                </Border.Stroke>
                                <VerticalStackLayout Spacing="0">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PrivacyPolicySections}" Spacing="0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="primaryModels:DisclaimerSection">
                                                <Label
                                                    Margin="{Binding IsHeader, Converter={StaticResource BoolToDisclaimerMarginConverter}}"
                                                    FontAttributes="{Binding IsHeader, Converter={StaticResource BoolToFontAttributesConverter}}"
                                                    FontFamily="{DynamicResource DefaultFontFamily}"
                                                    FontSize="{Binding IsHeader, Converter={StaticResource BoolToDisclaimerFontSizeConverter}}"
                                                    Text="{Binding Text}"
                                                    TextColor="{DynamicResource LoanAppPopupAccent}">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsHeader}"
                                                            TargetType="Label"
                                                            Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource LoanAppPopupFg}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!--  Tappable link to the hosted policy (opens in the system browser).  -->
                                    <Label
                                        Margin="0,16,0,0"
                                        FontAttributes="Bold"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        FontSize="{StaticResource FontSizeBody}"
                                        Text="View the online privacy policy ›"
                                        TextColor="{DynamicResource LoanAppPopupFg}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyUrlCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </ScrollView>
                </DataTemplate>
            </sfPopup:SfPopup.ContentTemplate>
        </sfPopup:SfPopup>

        <controls:InAppPurchaseView x:Name="PremiumWindow" />

        <!--  Main scrollable content  -->
        <ScrollView>
            <VerticalStackLayout Padding="12,0" Spacing="0">

                <!--  ── Page Header ──────────────────────────────────────────  -->
                <Grid
                    Padding="8,20,8,16"
                    BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource LoanAppAppShellBgColor}"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        WidthRequest="48">
                        <Image
                            HeightRequest="28"
                            HorizontalOptions="Center"
                            Source="icon_settings.png"
                            VerticalOptions="Center"
                            WidthRequest="28" />
                    </Border>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="{StaticResource FontSizeHeading}"
                            AutomationId="SettingsPageTitle"
                            Text="Settings"
                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                        <Label
                            FontSize="{StaticResource FontSizeSmall}"
                            Opacity="0.55"
                            Text="Manage your preferences"
                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                    </VerticalStackLayout>
                </Grid>

                <!--  ── Section: Appearance ──────────────────────────────────  -->
                <Label
                    CharacterSpacing="{StaticResource TrackingSectionHeader}"
                    Margin="4,20,4,8"
                    FontSize="{StaticResource FontSizeSmall}"
                    Opacity="0.45"
                    Text="APPEARANCE"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                <Border
                    Margin="0,0"
                    Padding="16"
                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="16">

                        <!--  Theme  -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                FontSize="{StaticResource FontSizeBody}"
                                Text="Theme"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            <editors:SfComboBox
                                BackgroundColor="Transparent"
                                IsClearButtonVisible="False"
                                IsEditable="False"
                                ItemsSource="{Binding Themes}"
                                AutomationId="SettingsThemeCombo"
                                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                Style="{DynamicResource SfComboBoxStyle}">
                                <!--
                                    A swatch plus the name, rather than painting each row full-bleed
                                    in its own theme's gradient.

                                    The preview is the point and it survives — but as a contained
                                    chip. Full-bleed rows meant four hard colour slabs with square
                                    edges running the width of the popup, which fought every other
                                    list in the app; worse, they painted over the control's own
                                    `SelectedDropDownItemBackground`, so there was no indication of
                                    which theme was currently applied. With the row background left
                                    to the control, that highlight shows again and marks the
                                    selection for free.

                                    The swatch is stroked in the theme's own foreground colour so a
                                    pale theme still has a visible edge against a pale popup, and
                                    the two existing converters supply both values — no new colour
                                    data, which matters because these hexes are already a duplicate
                                    of the theme files.
                                -->
                                <editors:SfComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Padding="12,0"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="12"
                                            MinimumHeightRequest="44"
                                            VerticalOptions="Fill">
                                            <Border
                                                Grid.Column="0"
                                                HeightRequest="22"
                                                WidthRequest="34"
                                                Background="{Binding ., Converter={StaticResource ThemeNameToGradientConverter}}"
                                                Stroke="{Binding ., Converter={StaticResource ThemeNameToTextColorConverter}}"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="1"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="{Binding .}"
                                                TextColor="{DynamicResource LoanAppComboDropDownTextColor}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </editors:SfComboBox.ItemTemplate>
                            </editors:SfComboBox>
                        </VerticalStackLayout>

                        <!--  Font  -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                FontSize="{StaticResource FontSizeBody}"
                                Text="Font"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            <editors:SfComboBox
                                BackgroundColor="Transparent"
                                IsClearButtonVisible="False"
                                IsEditable="False"
                                ItemsSource="{Binding FontFamilies}"
                                AutomationId="SettingsFontCombo"
                                SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"
                                Style="{DynamicResource SfComboBoxStyle}">
                                <editors:SfComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            MinimumHeightRequest="44"
                                            VerticalOptions="Fill">
                                            <Label
                                                Padding="12,0"
                                                FontFamily="{Binding .}"
                                                FontSize="{StaticResource FontSizeMedium}"
                                                Text="{Binding .}"
                                                TextColor="{DynamicResource LoanAppComboDropDownTextColor}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </editors:SfComboBox.ItemTemplate>
                            </editors:SfComboBox>
                        </VerticalStackLayout>

                        <!--  Currency  -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                FontSize="{StaticResource FontSizeBody}"
                                Text="Currency"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            <editors:SfComboBox
                                BackgroundColor="Transparent"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding Currencies}"
                                AutomationId="SettingsCurrencyCombo"
                                SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                                SelectedValuePath="Symbol"
                                Style="{DynamicResource SfComboBoxStyle}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!--  ── Section: Stepper Increments ─────────────────────────────  -->
                <Label
                    Margin="4,24,4,8"
                    FontAttributes="Bold"
                    FontSize="{StaticResource FontSizeSmall}"
                    Opacity="0.55"
                    Text="STEP SIZES"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                <Border
                    Margin="0,0"
                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <expander:SfExpander HeaderIconPosition="End" Style="{DynamicResource CommonExpanderStyle}">
                        <expander:SfExpander.Header>
                            <Grid Padding="0,2">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontSize="{StaticResource FontSizeBody}" Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="How much each +/− press changes a value" />
                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="How much each +/− press changes a value" />
                                </VerticalStackLayout>
                            </Grid>
                        </expander:SfExpander.Header>
                        <expander:SfExpander.Content>
                            <VerticalStackLayout Padding="0,4,0,8" Spacing="0">

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Loan interest rate" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Grid Grid.Column="1" ColumnSpacing="4" VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Entry Grid.Column="0" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding LoanRateStepText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" Text="%" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="What-If rate" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Grid Grid.Column="1" ColumnSpacing="4" VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Entry Grid.Column="0" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding WhatIfRateStepText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" Text="%" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Monthly repayment" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding WhatIfMonthlyStepText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Lump sum" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding WhatIfLumpSumStepText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Offset balance" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding WhatIfOffsetStepText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Growth rate" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Grid Grid.Column="1" ColumnSpacing="4" VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Entry Grid.Column="0" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding GrowthRateStepText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" Text="%" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>

                            </VerticalStackLayout>
                        </expander:SfExpander.Content>
                    </expander:SfExpander>
                </Border>

                <!--  ── Section: What-If Defaults ──────────────────────────────  -->
                <Label
                    Margin="4,24,4,8"
                    FontAttributes="Bold"
                    FontSize="{StaticResource FontSizeSmall}"
                    Opacity="0.55"
                    Text="WHAT-IF DEFAULTS"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                <Border
                    Margin="0,0"
                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <expander:SfExpander HeaderIconPosition="End" Style="{DynamicResource CommonExpanderStyle}">
                        <expander:SfExpander.Header>
                            <Grid Padding="0,2">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontSize="{StaticResource FontSizeBody}" Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="What What If opens with" />
                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Initial values shown when What-If page loads" />
                                </VerticalStackLayout>
                            </Grid>
                        </expander:SfExpander.Header>
                        <expander:SfExpander.Content>
                            <VerticalStackLayout Padding="0,4,0,8" Spacing="0">

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Rate change delta" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Grid Grid.Column="1" ColumnSpacing="4" VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Entry Grid.Column="0" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding WhatIfRateDeltaText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" Text="%" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Extra repayment" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding WhatIfExtraRepaymentText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Lump sum" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding WhatIfLumpSumText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" FontSize="{StaticResource FontSizeBody}" Text="Offset balance" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding WhatIfOffsetBalanceText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                </Grid>

                            </VerticalStackLayout>
                        </expander:SfExpander.Content>
                    </expander:SfExpander>
                </Border>

                <!--  ── Section: Calculator Defaults ──────────────────────────  -->
                <Label
                    Margin="4,24,4,8"
                    FontAttributes="Bold"
                    FontSize="{StaticResource FontSizeSmall}"
                    Opacity="0.55"
                    Text="CALCULATOR DEFAULTS"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                <Border
                    Margin="0,0"
                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <expander:SfExpander HeaderIconPosition="End" Style="{DynamicResource CommonExpanderStyle}">
                        <expander:SfExpander.Header>
                            <Grid Padding="0,2">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontSize="{StaticResource FontSizeBody}" Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Pre-filled values and limits" />
                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Pre-filled values and limits for the calculator" />
                                </VerticalStackLayout>
                            </Grid>
                        </expander:SfExpander.Header>
                        <expander:SfExpander.Content>
                            <VerticalStackLayout Padding="0,4,0,8" Spacing="0">

                                <!--  Australian mode  -->
                                <!--  Australian mode and its stamp-duty switch are retired from the UI: the feature stays in the code (see SettingsViewModel.LoadAustralianModeSetting) but per-jurisdiction tax rules are not something this app maintains.  -->
                                <Grid IsVisible="False" Padding="16,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <buttons:SfSwitch
                                        Grid.Column="0"
                                        HorizontalOptions="Start"
                                        IsOn="{Binding IsAustralianModeEnabled, Mode=TwoWay}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="AusSwitchStates">
                                                <VisualState x:Name="On">
                                                    <VisualState.Setters>
                                                        <Setter Property="SwitchSettings">
                                                            <Setter.Value>
                                                                <buttons:SwitchSettings
                                                                    ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                    ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                    TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                    TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Off">
                                                    <VisualState.Setters>
                                                        <Setter Property="SwitchSettings">
                                                            <Setter.Value>
                                                                <buttons:SwitchSettings
                                                                    ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                    ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                    TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                    TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </buttons:SfSwitch>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeBody}" Text="Australian property mode" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Enables stamp duty calculator by state on the Loan tab" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <!--  Stamp Duty toggle  -->
                                <!--  Australian mode and its stamp-duty switch are retired from the UI: the feature stays in the code (see SettingsViewModel.LoadAustralianModeSetting) but per-jurisdiction tax rules are not something this app maintains.  -->
                                <Grid IsVisible="False" Padding="16,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <buttons:SfSwitch
                                        Grid.Column="0"
                                        HorizontalOptions="Start"
                                        IsEnabled="{Binding IsStampDutyToggleEnabled}"
                                        IsOn="{Binding IsStampDutyEnabled, Mode=TwoWay}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="StampDutySwitchStates">
                                                <VisualState x:Name="On">
                                                    <VisualState.Setters>
                                                        <Setter Property="SwitchSettings">
                                                            <Setter.Value>
                                                                <buttons:SwitchSettings
                                                                    ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOn}"
                                                                    ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOn}"
                                                                    TrackBackground="{DynamicResource LoanAppSwitchTrackColorOn}"
                                                                    TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOn}" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Off">
                                                    <VisualState.Setters>
                                                        <Setter Property="SwitchSettings">
                                                            <Setter.Value>
                                                                <buttons:SwitchSettings
                                                                    ThumbBackground="{DynamicResource LoanAppSwitchThumbColorOff}"
                                                                    ThumbStroke="{DynamicResource LoanAppSwitchThumbBorderColorOff}"
                                                                    TrackBackground="{DynamicResource LoanAppSwitchTrackColorOff}"
                                                                    TrackStroke="{DynamicResource LoanAppSwitchTrackBorderColorOff}" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </buttons:SfSwitch>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeBody}" Text="Show Stamp Duty" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Show stamp duty field in upfront costs" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" IsVisible="{Binding IsAustralianModeEnabled}" Opacity="0.45" Text="Always on — required when Australian mode is active" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <!--  Default interest rate  -->
                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeBody}" Text="Default interest rate" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Pre-filled rate when starting fresh" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                    <Grid Grid.Column="1" ColumnSpacing="4" VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Entry Grid.Column="0" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Keyboard="Numeric" Text="{Binding DefaultInterestRateText, Mode=TwoWay}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" Text="%" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <!--  Default loan term  -->
                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeBody}" Text="Default loan term" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Pre-filled years when starting fresh" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" Stroke="{DynamicResource BorderControlGradientBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="1" VerticalOptions="Center">
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" BackgroundColor="Transparent" Padding="0" Clicked="OnDefaultLoanTermDecrement" FontSize="{StaticResource FontSizeMedium}" Text="−" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding DefaultLoanTermYears}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                            <Button Grid.Column="2" BackgroundColor="Transparent" Padding="0" Clicked="OnDefaultLoanTermIncrement" FontSize="{StaticResource FontSizeMedium}" Text="+" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <!--  Max loan term  -->
                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeBody}" Text="Max loan term" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Upper limit for term inputs (10–50 yrs)" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" Stroke="{DynamicResource BorderControlGradientBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="1" VerticalOptions="Center">
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" BackgroundColor="Transparent" Padding="0" Clicked="OnMaxLoanTermDecrement" FontSize="{StaticResource FontSizeMedium}" Text="−" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding MaxLoanTermYears}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                            <Button Grid.Column="2" BackgroundColor="Transparent" Padding="0" Clicked="OnMaxLoanTermIncrement" FontSize="{StaticResource FontSizeMedium}" Text="+" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <!--  Default projection years  -->
                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeBody}" Text="Default projection years" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Starting value for projection sliders" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" Stroke="{DynamicResource BorderControlGradientBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="1" VerticalOptions="Center">
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" BackgroundColor="Transparent" Padding="0" Clicked="OnDefaultProjectionYearsDecrement" FontSize="{StaticResource FontSizeMedium}" Text="−" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding DefaultProjectionYears}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                            <Button Grid.Column="2" BackgroundColor="Transparent" Padding="0" Clicked="OnDefaultProjectionYearsIncrement" FontSize="{StaticResource FontSizeMedium}" Text="+" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                                <!--  Max projection years  -->
                                <Grid Padding="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label FontSize="{StaticResource FontSizeBody}" Text="Max projection years" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        <Label FontSize="{StaticResource FontSizeSmall}" Opacity="0.55" Text="Upper limit for projection sliders (5–50)" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource LoanAppAppShellBgColor}" Stroke="{DynamicResource BorderControlGradientBrush}" StrokeShape="RoundRectangle 8" StrokeThickness="1" VerticalOptions="Center">
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" BackgroundColor="Transparent" Padding="0" Clicked="OnMaxProjectionYearsDecrement" FontSize="{StaticResource FontSizeMedium}" Text="−" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                            <Label Grid.Column="1" FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center" Text="{Binding MaxProjectionYears}" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" VerticalOptions="Center" />
                                            <Button Grid.Column="2" BackgroundColor="Transparent" Padding="0" Clicked="OnMaxProjectionYearsIncrement" FontSize="{StaticResource FontSizeMedium}" Text="+" TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                            </VerticalStackLayout>
                        </expander:SfExpander.Content>
                    </expander:SfExpander>
                </Border>

                <!--  ── Section: Support ─────────────────────────────────────  -->
                <Label
                    Margin="4,24,4,8"
                    FontAttributes="Bold"
                    FontSize="{StaticResource FontSizeSmall}"
                    Opacity="0.55"
                    Text="SUPPORT"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                <Border
                    Margin="0,0"
                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="0">

                        <!--  Disclaimer  -->
                        <Grid AutomationId="SettingsDisclaimerRow" Padding="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowDisclaimerCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="Disclaimer"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.55"
                                    Text="Legal information and terms"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{StaticResource FontSizeMedium}"
                                Opacity="0.4"
                                Text="›"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                        <!--  Privacy Policy  -->
                        <Grid AutomationId="SettingsPrivacyRow" Padding="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowPrivacyPolicyCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="Privacy Policy"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.55"
                                    Text="How your data is handled"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{StaticResource FontSizeMedium}"
                                Opacity="0.4"
                                Text="›"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                        <!--  Share  -->
                        <Grid Padding="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnShareAppRequestCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="Share the app"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.55"
                                    Text="Recommend to friends and family"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                FontSize="{StaticResource FontSizeMedium}"
                                Opacity="0.4"
                                Text="›"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource LoanAppSeparatorInsetStyle}" />

                        <!--  Feedback  -->
                        <Grid Padding="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnRateAppRequestCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="Send feedback"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                                <Label
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Opacity="0.55"
                                    Text="Rate us or report an issue"
                                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                FontSize="{StaticResource FontSizeMedium}"
                                Opacity="0.4"
                                Text="›"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!--  ── Section: Purchases ───────────────────────────────────  -->
                <Label
                    Margin="4,24,4,8"
                    FontAttributes="Bold"
                    FontSize="{StaticResource FontSizeSmall}"
                    Opacity="0.55"
                    Text="PURCHASES"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                <Border
                    Margin="0,0"
                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <Grid Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPremiumShow_Clicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                FontSize="{StaticResource FontSizeBody}"
                                Text="Restore purchase"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                            <Label
                                FontSize="{StaticResource FontSizeSmall}"
                                Opacity="0.55"
                                Text="Already bought premium? Restore here"
                                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="1"
                            FontSize="{StaticResource FontSizeMedium}"
                            Opacity="0.4"
                            Text="›"
                            TextColor="{DynamicResource LoanAppDefaultForegroundColor}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!--  ── Section: Danger Zone ──────────────────────────────────  -->
                <Label
                    Margin="4,24,4,8"
                    FontAttributes="Bold"
                    FontSize="{StaticResource FontSizeSmall}"
                    Opacity="0.55"
                    Text="DATA"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

                <Border
                    Margin="0,0,0,32"
                    Background="{DynamicResource BorderControlBackgroundGradientBrush}"
                    Stroke="{DynamicResource BorderControlGradientBrush}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <expander:SfExpander
                        HeaderIconPosition="End"
                        Style="{DynamicResource CommonExpanderStyle}">
                        <expander:SfExpander.Header>
                            <Grid Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="{StaticResource FontSizeBody}"
                                        Style="{DynamicResource ExpanderHeaderLabelStyle}"
                                        AutomationId="SettingsDeleteDataHeader"
                                        Text="Delete your data" />
                                    <Label Style="{DynamicResource ExpanderHeaderSubLabelStyle}" Text="Permanently remove saved records" />
                                </VerticalStackLayout>
                            </Grid>
                        </expander:SfExpander.Header>
                        <expander:SfExpander.Content>
                            <Grid Margin="16,8,16,16" ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    AutomationId="SettingsDeleteLoanButton"
                                    Command="{Binding DeleteLoanDataCommand}"
                                    CornerRadius="8"
                                    Style="{DynamicResource MauiButtonStyle}"
                                    Text="Loan" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    AutomationId="SettingsDeleteExpensesButton"
                                    Command="{Binding DeleteExpenseDataCommand}"
                                    CornerRadius="8"
                                    Style="{DynamicResource MauiButtonStyle}"
                                    Text="Expenses" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    AutomationId="SettingsDeleteIncomeButton"
                                    Command="{Binding DeleteIncomeDataCommand}"
                                    CornerRadius="8"
                                    Style="{DynamicResource MauiButtonStyle}"
                                    Text="Income" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    AutomationId="SettingsDeleteAllDataButton"
                                    Command="{Binding DeleteAllDataCommand}"
                                    CornerRadius="8"
                                    IsVisible="{Binding IsAllDataDeleteVisible}"
                                    Style="{DynamicResource MauiButtonStyle}"
                                    Text="All Data"
                                    TextColor="{DynamicResource LoanAppInputErrorTextFgColor}" />
                            </Grid>
                        </expander:SfExpander.Content>
                    </expander:SfExpander>
                </Border>

                <!--
                    Version string, per settings.html. Bound rather than hard-coded so it cannot
                    drift from the shipped build.
                -->
                <Label
                    AutomationId="SettingsVersionLabel"
                    Margin="4,16,4,0"
                    FontSize="{StaticResource FontSizeSmall}"
                    HorizontalTextAlignment="Center"
                    Opacity="0.5"
                    Text="{Binding AppVersionDisplay}"
                    TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />

            </VerticalStackLayout>
        </ScrollView>

        <!--  Loading overlay  -->
        <Grid
            BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}"
            InputTransparent="False"
            IsVisible="{Binding IsPageBusy}"
            Opacity="0.85">
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="12"
                VerticalOptions="Center">
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsPageBusy}"
                    Color="{DynamicResource LoanAppAppShellFgColor}" />
                <Label
                    FontSize="{StaticResource FontSizeMedium}"
                    HorizontalOptions="Center"
                    Text="Loading..."
                    TextColor="{DynamicResource LoanAppPrimaryTextColor}" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
