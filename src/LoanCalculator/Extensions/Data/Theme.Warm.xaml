    <Color x:Key="LoanAppDataGridHeaderBackgroundColor">#B5635D</Color>
    <Color x:Key="LoanAppDataGridHeaderTextColor">#F5EBEB</Color>
    <Color x:Key="LoanAppDataGridCellTextColor">#4A2424</Color>
    <Color x:Key="LoanAppDataGridCellBackgroundColor">#FBEDED</Color>
    <Color x:Key="LoanAppDataGridCellBg1">#FBEDED</Color>
