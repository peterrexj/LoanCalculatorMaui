<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="LoanCalculatorMaui.Controls.BusyOverlayView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="thisView"
    IsVisible="False">
    <!--
        A scrim, deliberately. While a page is doing its arrival work the controls underneath are
        bound to stale or empty data, so letting taps through means acting on figures that are
        about to change — and tapping a navigation link twice pushes two pages.

        No animations: per CLAUDE.md a MAUI animation whose completion never arrives parks the
        awaiting task forever, and this sits on the navigation path where that cost real time.
    -->
    <Grid BackgroundColor="{DynamicResource LoanAppDefaultBackgroundColor}" Opacity="0.72">
        <VerticalStackLayout
            HorizontalOptions="Center"
            Spacing="12"
            VerticalOptions="Center">
            <ActivityIndicator
                HeightRequest="34"
                WidthRequest="34"
                Color="{DynamicResource LoanAppAppShellFgColor}"
                HorizontalOptions="Center"
                IsRunning="{Binding Source={x:Reference thisView}, Path=IsVisible}" />
            <Label
                FontFamily="{DynamicResource DefaultFontFamily}"
                FontSize="{DynamicResource FontSizeSmall}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Opacity="0.75"
                Text="{Binding Source={x:Reference thisView}, Path=Message}"
                TextColor="{DynamicResource LoanAppDefaultForegroundColor}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
