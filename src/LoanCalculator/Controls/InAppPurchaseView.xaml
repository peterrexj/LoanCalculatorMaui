<ContentView
    x:Class="LoanCalculatorMaui.Controls.InAppPurchaseView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup">

    <sfPopup:SfPopup
        Padding="10,25,10,20"
        AnimationMode="Zoom"
        Closing="SfPopup_OnClosing"
        HeaderTitle=""
        IsFullScreen="True"
        IsOpen="{Binding ShowPremiumBuyWindow}"
        ShowCloseButton="False"
        StaysOpen="True">
        <sfPopup:SfPopup.PopupStyle>
            <sfPopup:PopupStyle
                HasShadow="True"
                OverlayColor="{DynamicResource LoanAppPurchasePopupOverlayBgColor}"
                PopupBackground="{DynamicResource LoanAppPurchaseGradientBrush}" />
        </sfPopup:SfPopup.PopupStyle>
        <sfPopup:SfPopup.ContentTemplate>
            <DataTemplate>
                <!--  Top padding clears the iOS status bar / notch since the popup is full-screen.
                      No close button — the user dismisses via "Maybe later".  -->
                <ScrollView Padding="{OnPlatform iOS='0,12,0,0', MacCatalyst='0,12,0,0', Default='0,4,0,0'}">
                    <Grid Padding="24,4,24,16" RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

                        <!--  ── Hero: icon badge + title + subtitle ──  -->
                        <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="8">
                            <!--  Circular icon badge  -->
                            <Border
                                HeightRequest="68"
                                WidthRequest="68"
                                HorizontalOptions="Center"
                                BackgroundColor="{DynamicResource LoanAppPurchaseButtonPrimaryBgColor}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="34" />
                                </Border.StrokeShape>
                                <Image
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Source="icon_premium.png" />
                            </Border>

                            <Label
                                FontAttributes="Bold"
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{OnIdiom Phone=26, Tablet=34, Desktop=34, TV=34, Watch=20, Default=26}"
                                HorizontalTextAlignment="Center"
                                Text="Try Premium"
                                TextColor="{DynamicResource LoanAppPurchaseTextFontColor}" />

                            <Label
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{OnIdiom Phone=13, Tablet=18, Desktop=18, TV=18, Watch=11, Default=13}"
                                HorizontalTextAlignment="Center"
                                Opacity="0.75"
                                Text="Unlock every feature and get the most out of your numbers."
                                TextColor="{DynamicResource LoanAppPurchaseTextFontColor}" />
                        </VerticalStackLayout>

                        <!--  ── Features card ──  -->
                        <Border
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="16,10"
                            VerticalOptions="Start"
                            BackgroundColor="{DynamicResource LoanAppPurchaseButtonSecondaryBgColor}"
                            Stroke="{DynamicResource LoanAppPurchaseButtonSecondaryBorderColor}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <StackLayout
                                BindableLayout.ItemsSource="{Binding Features}"
                                Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HeightRequest="{OnIdiom Phone=15, Tablet=19, Desktop=19, TV=19, Watch=11, Default=15}"
                                                VerticalOptions="Center"
                                                Source="icon_ticks.png"
                                                WidthRequest="{OnIdiom Phone=15, Tablet=19, Desktop=19, TV=19, Watch=11, Default=15}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="{DynamicResource DefaultFontFamily}"
                                                FontSize="{OnIdiom Phone=14, Tablet=19, Desktop=19, TV=19, Watch=11, Default=14}"
                                                Text="{Binding}"
                                                TextColor="{DynamicResource LoanAppPurchaseTextFontColor}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                        </Border>

                        <!--  ── Actions ──  -->
                        <VerticalStackLayout Grid.Row="2" Margin="0,14,0,0" Spacing="10">
                            <Button
                                HeightRequest="54"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{OnIdiom Phone=17, Tablet=22, Desktop=22, TV=22, Watch=13, Default=17}"
                                Background="{DynamicResource LoanAppPurchaseButtonPrimaryBgColor}"
                                Command="{Binding PurchaseCommand}"
                                Text="Buy Now"
                                TextColor="{DynamicResource LoanAppPurchaseButtonPrimaryFgColor}" />

                            <Button
                                HeightRequest="50"
                                CornerRadius="14"
                                BorderWidth="1"
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{OnIdiom Phone=16, Tablet=21, Desktop=21, TV=21, Watch=12, Default=16}"
                                Background="{DynamicResource LoanAppPurchaseButtonSecondaryBgColor}"
                                BorderColor="{DynamicResource LoanAppPurchaseButtonSecondaryBorderColor}"
                                Command="{Binding RestoreCommand}"
                                Text="Restore purchases"
                                TextColor="{DynamicResource LoanAppPurchaseButtonSecondaryFgColor}" />

                            <Button
                                Margin="0,4,0,0"
                                BackgroundColor="Transparent"
                                FontFamily="{DynamicResource DefaultFontFamily}"
                                FontSize="{OnIdiom Phone=14, Tablet=19, Desktop=19, TV=19, Watch=11, Default=14}"
                                Command="{Binding IgnoreOfferCommand}"
                                Opacity="0.7"
                                Text="Continue with current version"
                                TextColor="{DynamicResource LoanAppPurchaseTextFontColor}" />
                        </VerticalStackLayout>
                    </Grid>
                </ScrollView>
            </DataTemplate>
        </sfPopup:SfPopup.ContentTemplate>
    </sfPopup:SfPopup>
</ContentView>

