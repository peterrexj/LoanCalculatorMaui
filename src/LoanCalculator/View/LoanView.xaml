                                                            <chart:DoughnutSeries.SelectionBehavior>
                                                                <chart:DataPointSelectionBehavior SelectionBrush="#314A6E" />
                                                            </chart:DoughnutSeries.SelectionBehavior>
                                                            <chart:DoughnutSeries.DataLabelSettings>
                                                                <chart:CircularDataLabelSettings LabelPosition="Outside" SmartLabelAlignment="Shift">
                                                                    <chart:CircularDataLabelSettings.ConnectorLineSettings>
                                                                        <chart:ConnectorLineStyle
                                                                            ConnectorType="Curve"
                                                                            Stroke="DarkGray"
                                                                            StrokeWidth="3" />
                                                                    </chart:CircularDataLabelSettings.ConnectorLineSettings>
                                                                </chart:CircularDataLabelSettings>
                                                            </chart:DoughnutSeries.DataLabelSettings>
                                                            <!--<chart:PieSeries.ColorModel>
                                                            <chart:ChartColorModel CustomBrushes="{Binding CustomPaletteColors}" Palette="Custom" />
                                                        </chart:PieSeries.ColorModel>-->
                                                            <chart:DoughnutSeries.CenterView>
                                                                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                    <Label
                                                                        FontAttributes="Bold"
                                                                        FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamily}"
                                                                        FontSize="10"
                                                                        TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.ChartDataMarkerColor, Converter={StaticResource StringToColorConverter}}">
                                                                        <Label.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Text="$" />
                                                                                <Span Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.HomeLoanInfo.PaymentSummary.Payment.TotalPaymentRoundedWithComma}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>
                                                                </StackLayout>
                                                            </chart:DoughnutSeries.CenterView>



                                                            <!--<chart:DoughnutSeries.DataMarker>
                                                            <chart:ChartDataMarker ="True">
                                                                <chart:ChartDataMarker.LabelTemplate>
                                                                    <DataTemplate>
                                                                        <StackLayout Orientation="Vertical">
                                                                            <Label>
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span
                                                                                            FontAttributes="Bold"
                                                                                            FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamily}"
                                                                                            FontSize="10"
                                                                                            Text="{Binding Converter={StaticResource doubleToMoneyConverter}}"
                                                                                            TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.ChartDataMarkerColor, Converter={StaticResource StringToColorConverter}}" />
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                        </StackLayout>
                                                                    </DataTemplate>
                                                                </chart:ChartDataMarker.LabelTemplate>
                                                            </chart:ChartDataMarker>
                                                        </chart:DoughnutSeries.DataMarker>-->
                                                        </chart:DoughnutSeries>
                                                    </chart:SfCircularChart.Series>
                                                </chart:SfCircularChart>

                                            </Grid>
                                        </Border.Content>



                                    </Border>
                                </FlexLayout>
                            </StackLayout>
                        </ScrollView>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>
                <tabView:SfTabItem Header="Amortisation">
                    <tabView:SfTabItem.Content>
                        <StackLayout>

                            <buttons:SfSegmentedControl
                                x:Name="AmortizationBreadDownFrequencySegmentCtrl"
                                Margin="5"
                                CornerRadius="15"
                                ItemsSource="{Binding AmortizationBreakdownFrequencyCollection}"
                                SelectedIndex="{Binding AmortizationBreakdownFrequencySelectedIndex}"
                                Stroke="{Binding DefaultStyle.SegBorderColor, Converter={StaticResource StringToColorConverter}}"
                                StrokeThickness="2"
                                TextStyle="{buttons:SegmentTextStyle TextColor={Binding DefaultStyle.SegTextFgColor,
                                                                                        Converter={StaticResource StringToColorConverter}},
                                                                     FontFamily={Binding DefaultStyle.DefaultFontFamily}}"
                                VisibleSegmentsCount="2">
                                <!--
                                    Color="{Binding DefaultStyle.SegBgColor, Converter={StaticResource StringToColorConverter}}"
                                    SelectionTextColor="{Binding DefaultStyle.SegSelectedTextFgColor, Converter={StaticResource StringToColorConverter}}"
                                -->
                                <buttons:SfSegmentedControl.SelectionIndicatorSettings>
                                    <buttons:SelectionIndicatorSettings Background="{Binding DefaultStyle.SegSelectedBgColor, Converter={StaticResource StringToColorConverter}}" SelectionIndicatorPlacement="Fill" />
                                </buttons:SfSegmentedControl.SelectionIndicatorSettings>
                            </buttons:SfSegmentedControl>

                            <FlexLayout
                                Margin="0"
                                AlignItems="Stretch"
                                Direction="Column"
                                JustifyContent="Center">
                                <Border
                                    Margin="12,5,12,2"
                                    HeightRequest="250"
                                    HorizontalOptions="Fill"
                                    StrokeShape="RoundRectangle 12,12,12,12"
                                    StrokeThickness="2"
                                    VerticalOptions="Center">
                                    <Border.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0.0" Color="#FF009FFF" />
                                            <GradientStop Offset="1.0" Color="#FFec2F4B" />
                                        </LinearGradientBrush>
                                    </Border.Stroke>
                                    <Border.Content>
                                        <Grid Padding="10" HorizontalOptions="Fill">
                                            <chart:SfCartesianChart
                                                BackgroundColor="Transparent"
                                                HeightRequest="200"
                                                HorizontalOptions="FillAndExpand"
                                                IsVisible="{Binding IsAmortizationYearBased}"
                                                VerticalOptions="FillAndExpand">
                                                <!--<chart:SfCartesianChart.Margin>
                                                    <OnPlatform x:TypeArguments="Thickness" WinPhone="0,0,20,0" />
                                                </chart:SfCartesianChart.Margin>-->
                                                <chart:SfCartesianChart.Title>
                                                    <Label
                                                        BackgroundColor="Transparent"
                                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                        Text="Gross Domestic Product Growth"
                                                        TextColor="{Binding DefaultStyle.ChartTitleColor, Converter={StaticResource StringToColorConverter}}" />
                                                </chart:SfCartesianChart.Title>
                                                <chart:SfCartesianChart.XAxes>
                                                    <chart:CategoryAxis
                                                        EdgeLabelsDrawingMode="Fit"
                                                        LabelPlacement="BetweenTicks"
                                                        ShowMajorGridLines="False">
                                                        <chart:CategoryAxis.LabelStyle>
                                                            <chart:ChartAxisLabelStyle
                                                                FontAttributes="Bold"
                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                FontSize="12"
                                                                TextColor="{Binding DefaultStyle.ChartAxisColor, Converter={StaticResource StringToColorConverter}}" />
                                                        </chart:CategoryAxis.LabelStyle>
                                                        <chart:CategoryAxis.MajorTickStyle>
                                                            <chart:ChartAxisTickStyle TickSize="8" />
                                                        </chart:CategoryAxis.MajorTickStyle>
                                                    </chart:CategoryAxis>
                                                </chart:SfCartesianChart.XAxes>
                                                <chart:SfCartesianChart.YAxes>
                                                    <chart:NumericalAxis>
                                                        <chart:NumericalAxis.LabelStyle>
                                                            <chart:ChartAxisLabelStyle
                                                                x:Name="amortYearSecondaryAxisLabelStyle"
                                                                FontAttributes="Bold"
                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                FontSize="12"
                                                                TextColor="{Binding DefaultStyle.ChartAxisColor, Converter={StaticResource StringToColorConverter}}" />
                                                        </chart:NumericalAxis.LabelStyle>
                                                        <chart:NumericalAxis.AxisLineStyle>
                                                            <chart:ChartLineStyle StrokeWidth="0" />
                                                        </chart:NumericalAxis.AxisLineStyle>
                                                        <chart:NumericalAxis.MajorTickStyle>
                                                            <chart:ChartAxisTickStyle TickSize="0" />
                                                        </chart:NumericalAxis.MajorTickStyle>
                                                    </chart:NumericalAxis>
                                                </chart:SfCartesianChart.YAxes>
                                                <chart:SfCartesianChart.Legend>
                                                    <chart:ChartLegend Placement="{OnPlatform Android={OnIdiom Phone=Bottom, Tablet=Left}, iOS={OnIdiom Phone=Bottom, Tablet=Left}, UWP=Left}" ToggleSeriesVisibility="True" />
                                                    <!--
                                                        IconHeight="14"
                                                        IconWidth="14"
                                                    -->
                                                </chart:SfCartesianChart.Legend>
                                                <chart:SfCartesianChart.Series>
                                                    <chart:StackingColumnSeries
                                                        EnableAnimation="True"
                                                        ItemsSource="{Binding AmortizationChartInterestAmountAxis}"
                                                        LegendIcon="SeriesType"
                                                        Stroke="{Binding DefaultStyle.ChartColor1, Converter={StaticResource StringToColorConverter}}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />
                                                    <chart:StackingColumnSeries
                                                        EnableAnimation="True"
                                                        ItemsSource="{Binding AmortizationChartPrincipalAmountAxis}"
                                                        LegendIcon="SeriesType"
                                                        Stroke="{Binding DefaultStyle.ChartColor2, Converter={StaticResource StringToColorConverter}}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />
                                                </chart:SfCartesianChart.Series>
                                            </chart:SfCartesianChart>

                                            <chart:SfCartesianChart
                                                BackgroundColor="Transparent"
                                                HeightRequest="200"
                                                HorizontalOptions="FillAndExpand"
                                                IsVisible="{Binding IsAmortizationTermBased}"
                                                VerticalOptions="FillAndExpand">
                                                <!--<chart:SfCartesianChart.Margin>
                                                    <OnPlatform x:TypeArguments="Thickness" WinPhone="0,0,20,0" />
                                                </chart:SfCartesianChart.Margin>-->
                                                <chart:SfCartesianChart.Title>
                                                    <Label
                                                        BackgroundColor="Transparent"
                                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                        Text="Gross Domestic Product Growth"
                                                        TextColor="{Binding DefaultStyle.ChartTitleColor, Converter={StaticResource StringToColorConverter}}" />

                                                </chart:SfCartesianChart.Title>
                                                <chart:SfCartesianChart.XAxes>
                                                    <chart:CategoryAxis
                                                        EdgeLabelsDrawingMode="Shift"
                                                        LabelPlacement="BetweenTicks"
                                                        ShowMajorGridLines="False">
                                                        <chart:CategoryAxis.LabelStyle>
                                                            <chart:ChartAxisLabelStyle
                                                                FontAttributes="Bold"
                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                FontSize="12"
                                                                TextColor="{Binding DefaultStyle.ChartAxisColor, Converter={StaticResource StringToColorConverter}}" />
                                                        </chart:CategoryAxis.LabelStyle>
                                                        <chart:CategoryAxis.MajorTickStyle>
                                                            <chart:ChartAxisTickStyle TickSize="0" />
                                                        </chart:CategoryAxis.MajorTickStyle>
                                                    </chart:CategoryAxis>
                                                </chart:SfCartesianChart.XAxes>
                                                <chart:SfCartesianChart.YAxes>
                                                    <chart:NumericalAxis>
                                                        <chart:NumericalAxis.LabelStyle>
                                                            <chart:ChartAxisLabelStyle
                                                                x:Name="amortTermSecondaryAxisLabelStyle"
                                                                FontAttributes="Bold"
                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                FontSize="12"
                                                                TextColor="{Binding DefaultStyle.ChartAxisColor, Converter={StaticResource StringToColorConverter}}" />
                                                        </chart:NumericalAxis.LabelStyle>
                                                        <chart:NumericalAxis.AxisLineStyle>
                                                            <chart:ChartLineStyle StrokeWidth="0" />
                                                        </chart:NumericalAxis.AxisLineStyle>
                                                        <chart:NumericalAxis.MajorTickStyle>
                                                            <chart:ChartAxisTickStyle TickSize="0" />
                                                        </chart:NumericalAxis.MajorTickStyle>
                                                    </chart:NumericalAxis>
                                                </chart:SfCartesianChart.YAxes>
                                                <chart:SfCartesianChart.Legend>
                                                    <chart:ChartLegend Placement="{OnPlatform Android={OnIdiom Phone=Bottom, Tablet=Left}, iOS={OnIdiom Phone=Bottom, Tablet=Left}, UWP=Left}" ToggleSeriesVisibility="True" />
                                                </chart:SfCartesianChart.Legend>
                                                <chart:SfCartesianChart.Series>

                                                    <chart:StackingAreaSeries
                                                        EnableAnimation="True"
                                                        ItemsSource="{Binding AmortizationChartAreaInterestAmountAxis}"
                                                        LegendIcon="SeriesType"
                                                        Stroke="{Binding DefaultStyle.ChartColor1, Converter={StaticResource StringToColorConverter}}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />
                                                    <chart:StackingAreaSeries
                                                        EnableAnimation="True"
                                                        ItemsSource="{Binding AmortizationChartAreaPrincipalAmountAxis}"
                                                        LegendIcon="SeriesType"
                                                        Stroke="{Binding DefaultStyle.ChartColor2, Converter={StaticResource StringToColorConverter}}"
                                                        XBindingPath="Name"
                                                        YBindingPath="Value" />

                                                </chart:SfCartesianChart.Series>
                                            </chart:SfCartesianChart>
                                        </Grid>
                                    </Border.Content>
                                </Border>



                            </FlexLayout>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  below is for paging in the grid  -->
                                <!--  AppearanceManager="{StaticResource customAppearance}"  -->
                                <!--<OnPlatform
                                    x:TypeArguments="x:Double"
                                    Android="50"
                                    WinPhone="70"
                                    iOS="50" />-->
                                <pager:SfDataPager
                                    x:Name="dataPager"
                                    Grid.Row="0"
                                    NumericButtonsGenerateMode="Auto"
                                    PageSize="15"
                                    Source="{Binding PaymentAmortization}">

                                    <pager:SfDataPager.HeightRequest />
                                </pager:SfDataPager>

                                <!--  AlternationRowCount="2"  -->
                                <!--  AutoGenerateColumnsMode="None"  -->
                                <!--  EnableDataVirtualization="True"  -->
                                <!--  ColumnWidthMode="Fill"  -->
                                <!--
                                    SelectionMode="None"
                                    ShowRowHeader="True"
                                -->
                                <!--  ScrollingMode="PixelLine"  -->
                                <datagrid:SfDataGrid
                                    x:Name="dataGrid"
                                    Grid.Row="1"
                                    AutoGenerateColumnsMode="None"
                                    BackgroundColor="Transparent"
                                    GridLinesVisibility="Both"
                                    HeaderGridLinesVisibility="Both"
                                    ItemsSource="{Binding Source={x:Reference dataPager}, Path=PagedSource}">
                                    <!--<datagrid:SfDataGrid.Margin>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="Android, iOS" Value="-20,0,0,0" />
                                            <On Platform="UWP" Value="0,0,0,0" />
                                        </OnPlatform>
                                    </datagrid:SfDataGrid.Margin>-->
                                    <datagrid:SfDataGrid.Columns>
                                        <datagrid:DataGridTemplateColumn HeaderText="Period" MappingName="PaymentPeriod">
                                            <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                        Text="Period" />
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                            <datagrid:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label
                                                        FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamily}"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding PaymentPeriod}"
                                                        TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DataGridRowForegroundColor, Converter={StaticResource StringToColorConverter}}"
                                                        VerticalTextAlignment="Center" />
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.CellTemplate>
                                        </datagrid:DataGridTemplateColumn>

                                        <datagrid:DataGridTemplateColumn HeaderText="Principal" MappingName="PrincipalAmountRounded">
                                            <datagrid:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label
                                                        FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamily}"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding PrincipalAmountRounded}"
                                                        TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DataGridRowForegroundColor, Converter={StaticResource StringToColorConverter}}"
                                                        VerticalTextAlignment="Center" />
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.CellTemplate>
                                        </datagrid:DataGridTemplateColumn>
                                        <datagrid:DataGridTemplateColumn HeaderText="Interest" MappingName="InterestAmountRounded">
                                            <datagrid:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label
                                                        FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamily}"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding InterestAmountRounded}"
                                                        TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DataGridRowForegroundColor, Converter={StaticResource StringToColorConverter}}"
                                                        VerticalTextAlignment="Center" />
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.CellTemplate>
                                        </datagrid:DataGridTemplateColumn>
                                        <datagrid:DataGridTemplateColumn HeaderText="Balance" MappingName="BalanceAmountRounded">
                                            <datagrid:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label
                                                        FontFamily="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DefaultFontFamily}"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding BalanceAmountRounded}"
                                                        TextColor="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DefaultStyle.DataGridRowForegroundColor, Converter={StaticResource StringToColorConverter}}"
                                                        VerticalTextAlignment="Center" />
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.CellTemplate>
                                        </datagrid:DataGridTemplateColumn>
                                    </datagrid:SfDataGrid.Columns>

                                    <!--  AlternatingRowColor="Yellow"  -->
                                    <datagrid:SfDataGrid.DefaultStyle>
                                        <core:DataGridStyle
                                            AlternateRowBackground="Yellow"
                                            GridLineStrokeThickness="3"
                                            HeaderRowBackground="{Binding DefaultStyle.DataGridHeaderBackgroundColor, Converter={StaticResource StringToColorConverter}}"
                                            HeaderRowTextColor="{Binding DefaultStyle.DataGridHeaderForegroundColor, Converter={StaticResource StringToColorConverter}}"
                                            RowBackground="{Binding DefaultStyle.DataGridRowBackgroundColor, Converter={StaticResource StringToColorConverter}}"
                                            RowTextColor="{Binding DefaultStyle.DataGridRowForegroundColor, Converter={StaticResource StringToColorConverter}}" />
                                    </datagrid:SfDataGrid.DefaultStyle>

                                    <!--  GridCellBorderColor="{Binding DefaultStyle.DataGridGridCellBorderColor, Converter={StaticResource StringToColorConverter}}"  -->
                                    <!--  GridCellBorderWidth="1"  -->
                                    <!--  GridLinesVisibility="Horizontal"  -->
                                </datagrid:SfDataGrid>

                            </Grid>
                        </StackLayout>
                    </tabView:SfTabItem.Content>
                </tabView:SfTabItem>
            </tabView:SfTabView>
        </Grid>
    </ContentPage.Content>
</ContentPage>