<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoanCalculatorMaui.View.LoanView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:core="http://schemas.syncfusion.com/maui"
    xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:pager="clr-namespace:Syncfusion.Maui.DataGrid.DataPager;assembly=Syncfusion.Maui.DataGrid"
    xmlns:range="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:viewmodel="clr-namespace:LoanCalculatorMaui.ViewModel"
    Title="LoanView"
    x:DataType="viewmodel:LoanViewModel">
    <ContentPage.Content>
        <Grid>
            <tabView:SfTabView
                x:Name="TabView"
                IndicatorPlacement="Bottom"
                IndicatorStrokeThickness="10"
                SelectionChanged="OnTabSelectionChanged"
                TabBarBackground="Transparent">
                <tabView:SfTabView.IndicatorBackground>
                    <SolidColorBrush Color="{Binding DefaultStyle.DefaultTabStrokeColor, Converter={StaticResource StringToBrushConverter}}" />
                </tabView:SfTabView.IndicatorBackground>
                <tabView:SfTabItem x:Name="tabDefinitions" Header="Property">
                    <tabView:SfTabItem.Content>
                        <ScrollView>
                            <StackLayout>

                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="20,5,20,5"
                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="This loan calculator app is intended for informational purposes only and should not be considered a substitute for professional financial advice. It is highly recommended that you consult with your financial adviser before making any financial decisions."
                                        TextColor="{Binding DefaultStyle.NotificationBgColor, Converter={StaticResource StringToColorConverter}}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Grid>

                                <FlexLayout Margin="0,5,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="33*" />
                                            <ColumnDefinition Width="33*" />
                                            <ColumnDefinition Width="33*" />
                                            <ColumnDefinition Width="10" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Stroke="{Binding DefaultStyle.HighlightBoxBorderColor, Converter={StaticResource StringToColorConverter}}"
                                            StrokeThickness="2"
                                            Style="{StaticResource SfBorderTopHighlightBox}">
                                            <ContentView>
                                                <Grid>
                                                    <StackLayout>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="10" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="10" />
                                                            </Grid.RowDefinitions>
                                                            <StackLayout
                                                                Grid.Row="1"
                                                                HorizontalOptions="Fill"
                                                                VerticalOptions="Fill">
                                                                <Label
                                                                    Margin="5,0,5,0"
                                                                    HorizontalTextAlignment="Center"
                                                                    TextColor="{Binding DefaultStyle.HighlightFgColor, Converter={StaticResource StringToColorConverter}}"
                                                                    VerticalTextAlignment="Center">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span
                                                                                CharacterSpacing="1"
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="{Binding DefaultStyle.BoxItemCurrencyFontSize}"
                                                                                Text="{Binding CurrencySymbol}" />
                                                                            <!--<Span Text=" " />-->
                                                                            <Span
                                                                                CharacterSpacing="-1"
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="{Binding DefaultStyle.BoxItemHighlightNumberFontSize}"
                                                                                Text="{Binding HomeLoanInfo.PaymentSummary.Payment.TermPaymentRoundedWithComma}" />
                                                                            <Span Text="{Binding NewLine}" />
                                                                            <!--<Span FontFamily="{Binding DefaultStyle.DefaultFontFamily}" Text=" per" />-->
                                                                            <Span
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="12"
                                                                                Text="{Binding RepaymentFrequencySelected}" />
                                                                            <Span Text=" " />

                                                                            <!--<Span
                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                FontSize="12"
                Text=" for " />-->
                                                                            <Span
                                                                                CharacterSpacing="-1"
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="16"
                                                                                Text="{Binding LoanTermInYears}" />
                                                                            <Span Text=" " />
                                                                            <Span
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="12"
                                                                                Text=" years" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                            </StackLayout>
                                                        </Grid>
                                                    </StackLayout>
                                                </Grid>
                                            </ContentView>
                                        </Border>
                                        <Border
                                            Grid.Column="2"
                                            Stroke="{Binding DefaultStyle.HighlightBoxBorderColor, Converter={StaticResource StringToColorConverter}}"
                                            StrokeThickness="2"
                                            Style="{StaticResource SfBorderTopHighlightBox}">
                                            <ContentView />
                                        </Border>

                                        <Border
                                            Grid.Column="2"
                                            Stroke="{Binding DefaultStyle.HighlightBoxBorderColor, Converter={StaticResource StringToColorConverter}}"
                                            Style="{StaticResource SfBorderTopHighlightBox}">
                                            <ContentView>
                                                <Grid>
                                                    <StackLayout>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="10" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="10" />
                                                            </Grid.RowDefinitions>
                                                            <StackLayout Grid.Row="1">
                                                                <Label
                                                                    Margin="5,0,5,0"
                                                                    HorizontalTextAlignment="Center"
                                                                    TextColor="{Binding DefaultStyle.HighlightFgColor, Converter={StaticResource StringToColorConverter}}"
                                                                    VerticalTextAlignment="Center">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span
                                                                                CharacterSpacing="1"
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="17"
                                                                                Text="{Binding CurrencySymbol}" />
                                                                            <Span Text="" />
                                                                            <Span
                                                                                CharacterSpacing="-1"
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="18"
                                                                                Text="{Binding HomeLoanInfo.PaymentSummary.Payment.TotalInterestPaymentRoundedWithComma}" />
                                                                            <Span
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="12"
                                                                                Text=" total interest payable over " />
                                                                            <Span
                                                                                CharacterSpacing="-1"
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="15"
                                                                                Text="{Binding LoanTermInYears}" />
                                                                            <Span FontSize="12" Text=" years" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                            </StackLayout>
                                                        </Grid>
                                                    </StackLayout>
                                                </Grid>
                                            </ContentView>
                                        </Border>

                                        <Border
                                            Grid.Column="3"
                                            Stroke="{Binding DefaultStyle.HighlightBoxBorderColor, Converter={StaticResource StringToColorConverter}}"
                                            StrokeThickness="2"
                                            Style="{StaticResource SfBorderTopHighlightBox}">
                                            <ContentView>
                                                <Grid>
                                                    <StackLayout>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="10" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="10" />
                                                            </Grid.RowDefinitions>
                                                            <StackLayout Grid.Row="1">
                                                                <Label
                                                                    Margin="5,0,5,0"
                                                                    HorizontalTextAlignment="Center"
                                                                    TextColor="{Binding DefaultStyle.HighlightFgColor, Converter={StaticResource StringToColorConverter}}"
                                                                    VerticalTextAlignment="Center">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span
                                                                                CharacterSpacing="1"
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="17"
                                                                                Text="{Binding CurrencySymbol}" />
                                                                            <Span Text="" />
                                                                            <Span
                                                                                CharacterSpacing="-1"
                                                                                FontAttributes="Bold"
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="18"
                                                                                Text="{Binding HomeLoanInfo.PaymentSummary.Payment.TotalPaymentRoundedWithComma}" />
                                                                            <Span
                                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                                FontSize="12"
                                                                                Text=" total repayment (principal + interest)" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                            </StackLayout>
                                                        </Grid>
                                                    </StackLayout>
                                                </Grid>
                                            </ContentView>
                                        </Border>
                                    </Grid>
                                </FlexLayout>

                                <FlexLayout>

                                    <Border
                                        Margin="12,5,12,2"
                                        HorizontalOptions="Center"
                                        Stroke="{Binding DefaultStyle.BoxBorderColor, Converter={StaticResource StringToColorConverter}}"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">
                                        <ContentView>
                                            <Grid>
                                                <StackLayout>

                                                    <Grid Grid.Row="0" Margin="5,0,5,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50*" />
                                                            <ColumnDefinition Width="50*" />
                                                        </Grid.ColumnDefinitions>
                                                        <core:SfTextInputLayout
                                                            Grid.Column="0"
                                                            Margin="0,0,0,-15"
                                                            BackgroundColor="Transparent"
                                                            ContainerBackground="Transparent"
                                                            Hint="Property Value"
                                                            HorizontalOptions="Start"
                                                            Stroke="{Binding DefaultStyle.InputTextWhenFocusedColor, Converter={StaticResource StringToColorConverter}}">
                                                            <core:SfTextInputLayout.HintLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.HintLabelStyle>
                                                            <core:SfTextInputLayout.ErrorLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.ErrorLabelStyle>
                                                            <core:SfTextInputLayout.HelperLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.HelperLabelStyle>
                                                            <editors:SfNumericEntry
                                                                CustomFormat="c"
                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                MaximumNumberDecimalDigits="0"
                                                                TextColor="{Binding DefaultStyle.InputTextFgColor, Converter={StaticResource StringToColorConverter}}"
                                                                Value="{Binding PropertyAmount}" />
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="{Binding DefaultStyle.InputTextWhenUnFocusedColor, Converter={StaticResource StringToColorConverter}}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState Name="Focused">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="{Binding DefaultStyle.InputTextWhenFocusedColor, Converter={StaticResource StringToColorConverter}}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState Name="Error">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="#B3261E" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </core:SfTextInputLayout>

                                                        <Label
                                                            Grid.Column="1"
                                                            Margin="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            TextColor="{Binding DefaultStyle.InputTextFgColor, Converter={StaticResource StringToColorConverter}}"
                                                            VerticalOptions="Center">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span
                                                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                        FontSize="12"
                                                                        Text="Total property amount" />
                                                                    <Span Text="{x:Static system:Environment.NewLine}" />
                                                                    <Span
                                                                        FontAttributes="Bold"
                                                                        FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                        FontSize="16"
                                                                        Text="{Binding PropertyTotalAmount}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Margin="5,0,5,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50*" />
                                                            <ColumnDefinition Width="50*" />
                                                        </Grid.ColumnDefinitions>

                                                        <core:SfTextInputLayout
                                                            Grid.Column="0"
                                                            Margin="0,0,0,-10"
                                                            Padding="2,0,2,0"
                                                            BackgroundColor="Transparent"
                                                            ContainerBackground="Transparent"
                                                            ContainerType="None"
                                                            Hint="Interest Rate"
                                                            OutlineCornerRadius="8"
                                                            Stroke="{Binding DefaultStyle.InputTextWhenFocusedColor, Converter={StaticResource StringToColorConverter}}">
                                                            <core:SfTextInputLayout.HintLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.HintLabelStyle>
                                                            <core:SfTextInputLayout.ErrorLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.ErrorLabelStyle>
                                                            <core:SfTextInputLayout.HelperLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.HelperLabelStyle>

                                                            <editors:SfNumericEntry
                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                FontSize="14"
                                                                LargeChange="1"
                                                                Maximum="100"
                                                                Minimum="0"
                                                                PercentDisplayMode="Value"
                                                                SmallChange="0.05"
                                                                TextColor="{Binding DefaultStyle.InputTextFgColor, Converter={StaticResource StringToColorConverter}}"
                                                                UpDownPlacementMode="InlineVertical"
                                                                Value="{Binding InterestRate}" />
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="{Binding DefaultStyle.InputTextWhenUnFocusedColor, Converter={StaticResource StringToColorConverter}}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState Name="Focused">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="{Binding DefaultStyle.InputTextWhenFocusedColor, Converter={StaticResource StringToColorConverter}}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState Name="Error">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="#B3261E" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </core:SfTextInputLayout>

                                                        <core:SfTextInputLayout
                                                            Grid.Column="1"
                                                            Margin="0,0,0,-10"
                                                            BackgroundColor="Transparent"
                                                            ContainerBackground="Transparent"
                                                            ContainerType="None"
                                                            Hint="Loan Term"
                                                            OutlineCornerRadius="8"
                                                            Stroke="{Binding DefaultStyle.InputTextWhenFocusedColor, Converter={StaticResource StringToColorConverter}}">
                                                            <core:SfTextInputLayout.HintLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.HintLabelStyle>
                                                            <core:SfTextInputLayout.ErrorLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.ErrorLabelStyle>
                                                            <core:SfTextInputLayout.HelperLabelStyle>
                                                                <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                            </core:SfTextInputLayout.HelperLabelStyle>

                                                            <editors:SfNumericEntry
                                                                CustomFormat="years"
                                                                FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                FontSize="14"
                                                                LargeChange="5"
                                                                Maximum="30"
                                                                MaximumNumberDecimalDigits="0"
                                                                Minimum="0"
                                                                SmallChange="1"
                                                                TextColor="{Binding DefaultStyle.InputTextFgColor, Converter={StaticResource StringToColorConverter}}"
                                                                UpDownPlacementMode="InlineVertical"
                                                                Value="{Binding LoanTermInYears}" />
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="{Binding DefaultStyle.InputTextWhenUnFocusedColor, Converter={StaticResource StringToColorConverter}}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState Name="Focused">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="{Binding DefaultStyle.InputTextWhenFocusedColor, Converter={StaticResource StringToColorConverter}}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState Name="Error">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Stroke" Value="#B3261E" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </core:SfTextInputLayout>
                                                    </Grid>







                                                    <buttons:SfSegmentedControl
                                                        x:Name="segmentedRepaymentFrequency"
                                                        Grid.Row="2"
                                                        Margin="15,0,15,10"
                                                        CornerRadius="15"
                                                        ItemsSource="{Binding RepaymentFrequencyCollection}"
                                                        SelectedIndex="{Binding RepaymentFrequencySelectedIndex}"
                                                        Stroke="{Binding DefaultStyle.SegBorderColor, Converter={StaticResource StringToColorConverter}}"
                                                        StrokeThickness="2"
                                                        TextStyle="{buttons:SegmentTextStyle TextColor={Binding DefaultStyle.SegTextFgColor,
                                                                                                                Converter={StaticResource StringToColorConverter}},
                                                                                             FontFamily={Binding DefaultStyle.DefaultFontFamily}}"
                                                        VisibleSegmentsCount="3">
                                                        <!--  SelectedSegmentTextColor="{Binding DefaultStyle.SegSelectedTextFgColor, Converter={StaticResource StringToColorConverter}}"  -->
                                                        <!--  Background="{Binding DefaultStyle.SegBgColor, Converter={StaticResource StringToColorConverter}}"  -->

                                                        <!--  SelectionTextColor="{Binding DefaultStyle.SegSelectedTextFgColor, Converter={StaticResource StringToColorConverter}}"  -->
                                                        <!--  Color="{Binding DefaultStyle.SegBgColor, Converter={StaticResource StringToColorConverter}}"  -->
                                                        <buttons:SfSegmentedControl.SelectionIndicatorSettings>
                                                            <buttons:SelectionIndicatorSettings Background="{Binding DefaultStyle.SegSelectedBgColor, Converter={StaticResource StringToColorConverter}}" SelectionIndicatorPlacement="Fill" />
                                                        </buttons:SfSegmentedControl.SelectionIndicatorSettings>
                                                    </buttons:SfSegmentedControl>

                                                </StackLayout>

                                            </Grid>
                                        </ContentView>
                                    </Border>


                                </FlexLayout>

                                <expander:SfExpander HeaderIconPosition="End">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label
                                                Margin="15,0,0,0"
                                                HeightRequest="30"
                                                TextColor="{Binding DefaultStyle.ExpanderHeaderTextColor, Converter={StaticResource StringToColorConverter}}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text="Deposit: " />
                                                        <Span FontFamily="{Binding DefaultStyle.DefaultFontFamily}" Text="{Binding DepositAmountStrFormatted}" />
                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text=" (" />
                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text="{Binding DepositPercentage, StringFormat='{0:F2}'}" />
                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text=" %)" />

                                                        <Span FontSize="Micro" Text="  " />

                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text="Loan: " />
                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text=" " />
                                                        <Span FontFamily="{Binding DefaultStyle.DefaultFontFamily}" Text="{Binding LoanAmountStrFormatted}" />
                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text=" (" />
                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text="{Binding LoanAmountPercentage, StringFormat='{0:F2}'}" />
                                                        <Span
                                                            FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                            FontSize="10"
                                                            Text=" %)" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <StackLayout BackgroundColor="Transparent">

                                            <Border
                                                Margin="12,5,12,5"
                                                HorizontalOptions="Center"
                                                Stroke="{Binding DefaultStyle.BoxBorderColor, Converter={StaticResource StringToColorConverter}}"
                                                StrokeThickness="1"
                                                VerticalOptions="Center">
                                                <Grid>

                                                    <!--<sfGradient:SfGradientView>
            <sfGradient:SfGradientView.BackgroundBrush>
                <sfGradient:SfLinearGradientBrush>
                    <sfGradient:SfLinearGradientBrush.GradientStops>
                        <sfGradient:SfGradientStop Offset="0.0" Color="#B3B6B7" />
                        <sfGradient:SfGradientStop Offset="1.0" Color="#EBF5FB" />
                    </sfGradient:SfLinearGradientBrush.GradientStops>
                </sfGradient:SfLinearGradientBrush>
            </sfGradient:SfGradientView.BackgroundBrush>
        </sfGradient:SfGradientView>-->
                                                    <StackLayout>
                                                        <Grid Margin="5,0,5,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="50*" />
                                                                <ColumnDefinition Width="50*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="59" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>

                                                            <core:SfTextInputLayout
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Margin="0,0,0,-20"
                                                                BackgroundColor="Transparent"
                                                                ContainerBackground="Transparent"
                                                                Hint="Deposit value (direct)">
                                                                <core:SfTextInputLayout.HintLabelStyle>
                                                                    <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                                </core:SfTextInputLayout.HintLabelStyle>
                                                                <core:SfTextInputLayout.ErrorLabelStyle>
                                                                    <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                                </core:SfTextInputLayout.ErrorLabelStyle>
                                                                <core:SfTextInputLayout.HelperLabelStyle>
                                                                    <core:LabelStyle FontFamily="{Binding DefaultStyle.DefaultFontFamily}" />
                                                                </core:SfTextInputLayout.HelperLabelStyle>
                                                                <editors:SfNumericEntry
                                                                    CustomFormat="c"
                                                                    FontFamily="{Binding DefaultStyle.DefaultFontFamily}"
                                                                    MaximumNumberDecimalDigits="0"
                                                                    TextColor="{Binding DefaultStyle.InputTextFgColor, Converter={StaticResource StringToColorConverter}}"
                                                                    Value="{Binding DepositAmountDirectInput}" />
                                                                <VisualStateManager.VisualStateGroups>
                                                                    <VisualStateGroupList>
                                                                        <VisualStateGroup x:Name="CommonStates">
                                                                            <VisualState Name="Normal">
                                                                                <VisualState.Setters>
                                                                                    <Setter Property="Stroke" Value="{Binding DefaultStyle.InputTextWhenUnFocusedColor, Converter={StaticResource StringToColorConverter}}" />
                                                                                </VisualState.Setters>
                                                                            </VisualState>
                                                                            <VisualState Name="Focused">
                                                                                <VisualState.Setters>
                                                                                    <Setter Property="Stroke" Value="{Binding DefaultStyle.InputTextWhenFocusedColor, Converter={StaticResource StringToColorConverter}}" />
                                                                                </VisualState.Setters>
                                                                            </VisualState>
                                                                            <VisualState Name="Error">
                                                                                <VisualState.Setters>
