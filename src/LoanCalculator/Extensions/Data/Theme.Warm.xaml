    <Color x:Key="LoanAppPurchaseButtonSecondaryBorderColor">#8F4A45</Color>
    <Color x:Key="LoanAppPurchaseWindowBgStart">#F6E0E0</Color>
    <Color x:Key="LoanAppPurchaseWindowBgEnd">#F1D9D9</Color>
