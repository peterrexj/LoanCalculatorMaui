                                <VerticalStackLayout Padding="20,10,20,10">
                                    <Button
                                        Command="{Binding ExportInsightsReportCommand}"
                                        IsEnabled="{Binding IsActive}"
                                        Style="{DynamicResource ExportButtonStyle}"
                                        Text="Export Detailed Insights" />
                                    <progressBar:SfLinearProgressBar
                                        AnimationEasing="{x:Static Easing.CubicOut}"
                                        IsVisible="{Binding IsGeneratingPdf}"
                                        Progress="{Binding PdfGenerator.Progress}"
                                        ProgressFill="{DynamicResource LoanAppProgressColor}"
                                        ProgressHeight="10"
                                        TrackFill="{DynamicResource LoanAppProgressTrackColor}"
                                        TrackHeight="10" />
                                </VerticalStackLayout>

                                <expander:SfExpander
                                    Margin="0,5,0,5"
                                    HeaderIconPosition="End"
                                    Style="{DynamicResource CommonExpanderStyle}">
                                    <expander:SfExpander.Header>
                                        <Grid>
                                            <Label Style="{DynamicResource ExpanderHeaderLabelStyle}" Text="Key Insights" />
                                        </Grid>
                                    </expander:SfExpander.Header>
                                    <expander:SfExpander.Content>
                                        <StackLayout>
                                            <Border Style="{DynamicResource BorderInsightsHighlightBox}" VerticalOptions="FillAndExpand">
                                                <StackLayout Margin="0,0,0,5">
                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.AffordabilityMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.AffordabilityYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />

                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.LoanAmount}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.DepositAmount}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />

                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.RepaymentDetailMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.RepaymentDetailYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />

                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeTotalMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.IncomeTotalYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />

                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseOverallTotalMonthly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                    <customControls:InsightsItemView InsightItem="{Binding InsightsDetails.ExpenseOverallTotalYearly}" TextColor="{DynamicResource LoanAppInsightsFgColor}" />
                                                </StackLayout>
                                            </Border>
                                        </StackLayout>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>

                                <expander:SfExpander
                                    Margin="0,5,0,5"
                                    HeaderIconPosition="End"
                                    Style="{DynamicResource CommonExpanderStyle}">
